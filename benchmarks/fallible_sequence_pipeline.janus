import std.array
import std.iterator
import std.option
import std.result

def keepEven(value : int) : Option[long] {
    if value % 2 == 0 {
        return Option.Some[long](long(value))
    }
    return Option.None[long]()
}

def add(total : long, value : long) : Result[long, int] {
    return Result.Ok[long, int](total + value)
}

def main() : int {
    val values : Array[int] = new Array[int](usize(50000))
    var value : int = 0
    while value < 50000 {
        values.push(value)
        value = value + 1
    }

    val total : Result[long, int] = values.intoIterator()
    .drop(usize(1000))
    .takeWhile((borrow item : int) => item < 49000)
    .filterMap[long]((item : int) => keepEven(item))
    .tryFold[long, int](
        long(0),
        (sum : long, item : long) => add(sum, item)
    )
    println(match total {
            Ok(sum) => sum,
            Error(error) => long(-1)
    })
    return 0
}
