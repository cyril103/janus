import std.array

class ComparisonCounter(private var count : int) {
    def less(left : int, right : int) : bool {
        count = count + 1
        return left < right
    }

    def value() : int {
        return count
    }
}

def insertionSort(borrow var values : Array[int], borrow var counter : ComparisonCounter) : Unit {
    var index : usize = usize(1)
    while index < values.size() {
        val candidate : int = values.get(index)
        var destination : usize = index
        while destination > usize(0) &&
        counter.less(candidate, values.get(destination - usize(1))) {
            values.set(
            destination,
            values.get(destination - usize(1))
            )
            destination = destination - usize(1)
        }
        values.set(destination, candidate)
        index = index + usize(1)
    }
}

def main() : int {
    val values : Array[int] = new Array[int](usize(100000))
    defer delete values
    var state : int = 1729
    var before : long = long(0)
    var index : int = 0
    while index < 100000 {
        state = (state * 25173 + 13849) % 65521
        values.push(state)
        before = before + long(state)
        index = index + 1
    }

    values.sortWith((left : int, right : int) => left < right)
    var sorted : bool = true
    var after : long = long(0)
    var cursor : usize = usize(0)
    while cursor < values.size() {
        val value : int = values.get(cursor)
        after = after + long(value)
        if cursor > usize(0) && value < values.get(cursor - usize(1)) {
            sorted = false
        }
        cursor = cursor + usize(1)
    }
    val comparisonSize : int = 2048
    val hybrid : Array[int] = new Array[int](usize(2048))
    defer delete hybrid
    val naive : Array[int] = new Array[int](usize(2048))
    defer delete naive
    index = 0
    while index < comparisonSize {
        val value : int = comparisonSize - index
        hybrid.push(value)
        naive.push(value)
        index = index + 1
    }

    val hybridCounter : ComparisonCounter = new ComparisonCounter(0)
    defer delete hybridCounter
    val comparison : (borrow int, borrow int) => bool =
    (borrow left : int, borrow right : int) => hybridCounter.less(left, right)
    hybrid.sortWith(move comparison)

    val insertionCounter : ComparisonCounter = new ComparisonCounter(0)
    defer delete insertionCounter
    insertionSort(naive, insertionCounter)

    println(sorted && before == after &&
    hybridCounter.value() < insertionCounter.value())
    return 0
}
