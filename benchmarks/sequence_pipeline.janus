import std.array

def main() : int {
    val values : Array[int] = new Array[int](usize(20000))
    var value : int = 0
    while value < 20000 {
        values.push(value)
        value = value + 1
    }

    val total : long = values.intoIterator()
    .filter((item : int) => item % 3 == 0)
    .map[long]((item : int) => long(item))
    .fold[long](
    long(0),
    (sum : long, item : long) => sum + item
    )
    println(total)
    return 0
}
