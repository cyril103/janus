module algorithms


def triangular(value : int) : int {
    return value * (value + 1) / 2
}


def accumulate(limit : int) : int {
    var total : int = 0
    var value : int = 0
    while value <= limit {
        total = total + value
        value = value + 1
    }
    return total
}


def boundedGcd(left : int, right : int) : int {
    var a : int = left
    var b : int = right
    while b != 0 {
        val remainder : int = a % b
        a = b
        b = remainder
    }
    return a
}
