/// Expose des fichiers natifs non tamponnés et une représentation commune des erreurs système.
///
/// [[SystemFile]] possède son descripteur et le ferme à sa destruction. Les lectures
/// et écritures peuvent être partielles ; leur interprétation et les chemins suivent
/// la plateforme hôte.
/// @example
/// ```janus
/// val opened = openSystemFile("journal.bin", SystemOpenMode.Read)
/// match opened {
///     Ok(file) => file.close(),
///     Error(error) => println(error.context)
/// }
/// ```
module std.system

import std.result

private extern def janus_system_open(
path : Ptr[byte],
length : usize,
mode : int
) : isize
private extern def janus_system_read(
handle : isize,
data : Ptr[byte],
capacity : usize
) : isize
private extern def janus_system_write(
handle : isize,
data : Ptr[byte],
size : usize
) : isize
private extern def janus_system_close(handle : isize) : int
private extern def janus_system_remove(
path : Ptr[byte],
length : usize
) : int
private extern def janus_system_error_code() : uint
private extern def janus_system_error_category() : int

/// Classe les erreurs natives en catégories portables utilisables par les services standard.
enum SystemErrorCategory
derives Copy, Equality, Debug {
    /// La cible demandée ou un composant de son chemin est introuvable.
    NotFound,
    /// Les droits ou la politique de l’hôte refusent l’opération.
    PermissionDenied,
    /// Une ressource incompatible existe déjà à la destination.
    AlreadyExists,
    /// Un argument, un chemin ou l’état de la ressource est invalide ; les appels sur un objet fermé utilisent aussi cette catégorie.
    InvalidInput,
    /// L’opération native a été interrompue avant son achèvement.
    Interrupted,
    /// L’opération ne peut progresser immédiatement sur une ressource non bloquante.
    WouldBlock,
    /// Le support de stockage ne dispose plus de l’espace requis.
    OutOfSpace,
    /// La taille demandée dépasse une limite de la plateforme ou du système de fichiers.
    TooLarge,
    /// La plateforme ou la ressource ne prend pas l’opération en charge.
    Unsupported,
    /// Une ressource de processus, telle que mémoire ou descripteurs, est épuisée.
    ResourceExhausted,
    /// L’erreur native ne correspond à aucune catégorie portable précédente.
    Other
}

/// Sélectionne la politique d’ouverture appliquée par [[openSystemFile]].
enum SystemOpenMode derives Copy, Equality, Debug {
    /// Ouvre un fichier existant pour la lecture.
    Read,
    /// Ouvre le fichier pour l’écriture selon la politique native de création et de troncature.
    Write,
    /// Ouvre le fichier pour ajouter les écritures en fin de contenu selon la plateforme.
    Append
}

/// Décrit un échec système sans perdre le code natif qui l’a provoqué.
///
/// `category` permet un traitement portable tandis que `nativeCode`, `operation`
/// et `context` servent au diagnostic. Les chaînes sont des vues copiées dans la valeur.
struct SystemError(
/// Nom stable de l’opération Janus ayant échoué.
val operation : string,
/// Classe portable de l’échec.
val category : SystemErrorCategory,
/// Code brut fourni par la plateforme, ou zéro pour une erreur synthétique.
val nativeCode : uint,
/// Ressource concernée, généralement un chemin ou un nom de flux.
val context : string
) derives Copy, Equality, Debug {}

private def currentSystemError(
operation : string,
context : string
) : SystemError {
    return new SystemError(
    operation,
    SystemErrorCategory(janus_system_error_category()),
    janus_system_error_code(),
    context
    )
}

private def closedSystemError(
operation : string,
context : string
) : SystemError {
    return new SystemError(
    operation,
    SystemErrorCategory.InvalidInput,
    uint(0),
    context
    )
}

/// Fichier natif propriétaire offrant des entrées-sorties directes non tamponnées.
///
/// [[close]] invalide immédiatement le descripteur, même si sa fermeture native
/// échoue. Le destructeur ferme silencieusement tout descripteur encore ouvert.
class SystemFile(
private var nativeHandle : isize,
private val fileContext : string
) {
    /// Indique si le fichier natif est ouvert.
    /// @return `true` tant que [[close]] n’a pas été appelé.
    def isOpen() : bool {
        return nativeHandle >= isize(0)
    }

    /// Lit au plus `capacity` octets à la position courante du fichier.
    /// @param data Zone inscriptible d’au moins `capacity` octets ; sa validité incombe à l’appelant.
    /// @param capacity Nombre maximal d’octets à lire.
    /// @return `Ok` avec le nombre effectivement lu, zéro pouvant signaler la fin, ou `Error(SystemError)` pour un fichier fermé ou un échec natif.
    def read(
    data : Ptr[byte],
    capacity : usize
    ) : Result[usize, SystemError] {
        if nativeHandle < isize(0) {
            return Result.Error[usize, SystemError](
            closedSystemError("read", fileContext)
            )
        }
        val count : isize =
        janus_system_read(nativeHandle, data, capacity)
        if count < isize(0) {
            return Result.Error[usize, SystemError](
            currentSystemError("read", fileContext)
            )
        }
        return Result.Ok[usize, SystemError](usize(count))
    }

    /// Écrit jusqu’à `size` octets à la position courante du fichier.
    /// @param data Zone lisible d’au moins `size` octets ; elle reste détenue par l’appelant.
    /// @param size Nombre d’octets demandés.
    /// @return `Ok` avec le nombre effectivement écrit, potentiellement inférieur à `size`, ou `Error(SystemError)`.
    def write(
    data : Ptr[byte],
    size : usize
    ) : Result[usize, SystemError] {
        if nativeHandle < isize(0) {
            return Result.Error[usize, SystemError](
            closedSystemError("write", fileContext)
            )
        }
        val count : isize =
        janus_system_write(nativeHandle, data, size)
        if count < isize(0) {
            return Result.Error[usize, SystemError](
            currentSystemError("write", fileContext)
            )
        }
        return Result.Ok[usize, SystemError](usize(count))
    }

    /// Ferme le descripteur et rend ce [[SystemFile]] inutilisable.
    /// @return `Ok(true)` si la fermeture réussit, ou `Error(SystemError)` ; un second appel renvoie `InvalidInput`.
    def close() : Result[bool, SystemError] {
        if nativeHandle < isize(0) {
            return Result.Error[bool, SystemError](
            closedSystemError("close", fileContext)
            )
        }
        val handle : isize = nativeHandle
        nativeHandle = isize(-1)
        if janus_system_close(handle) != 0 {
            return Result.Error[bool, SystemError](
            currentSystemError("close", fileContext)
            )
        }
        return Result.Ok[bool, SystemError](true)
    }

    destructor {
        if nativeHandle >= isize(0) {
            val handle : isize = nativeHandle
            nativeHandle = isize(-1)
            janus_system_close(handle)
        }
    }
}

/// Ouvre un fichier natif et transfère la propriété du descripteur à un [[SystemFile]].
/// @param path Chemin interprété par la plateforme, sans normalisation préalable par ce module.
/// @param mode Politique de lecture, écriture ou ajout.
/// @return `Ok(SystemFile)` si l’ouverture réussit, ou `Error(SystemError)` avec l’opération `open`.
def openSystemFile(
path : string,
mode : SystemOpenMode
) : Result[SystemFile, SystemError] {
    val handle : isize = janus_system_open(
    stringData(path),
    stringLength(path),
    int(mode)
    )
    if handle < isize(0) {
        return Result.Error[SystemFile, SystemError](
        currentSystemError("open", path)
        )
    }
    return Result.Ok[SystemFile, SystemError](
    new SystemFile(handle, path)
    )
}

/// Demande à la plateforme de supprimer le fichier désigné.
/// @param path Chemin natif du fichier ; les répertoires ne sont pas pris en charge par cette fonction.
/// @return `Ok(true)` après succès natif, ou `Error(SystemError)` avec l’opération `remove`.
def removeSystemFile(
path : string
) : Result[bool, SystemError] {
    if janus_system_remove(
    stringData(path),
    stringLength(path)
    ) != 0 {
        return Result.Error[bool, SystemError](
        currentSystemError("remove", path)
        )
    }
    return Result.Ok[bool, SystemError](true)
}
