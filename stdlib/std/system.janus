/// Expose les fichiers natifs et les erreurs système structurées.
module std.system

import std.result

private extern def janus_system_open(
path : Ptr[byte],
length : usize,
mode : int
) : isize
private extern def janus_system_read(
handle : isize,
data : Ptr[byte],
capacity : usize
) : isize
private extern def janus_system_write(
handle : isize,
data : Ptr[byte],
size : usize
) : isize
private extern def janus_system_close(handle : isize) : int
private extern def janus_system_remove(
path : Ptr[byte],
length : usize
) : int
private extern def janus_system_error_code() : uint
private extern def janus_system_error_category() : int

/// Énumère les états publics de `SystemErrorCategory`.
enum SystemErrorCategory
derives Copy, Equality, Debug {
    /// Représente le cas `NotFound`.
    NotFound,
    /// Représente le cas `PermissionDenied`.
    PermissionDenied,
    /// Représente le cas `AlreadyExists`.
    AlreadyExists,
    /// Représente le cas `InvalidInput`.
    InvalidInput,
    /// Représente le cas `Interrupted`.
    Interrupted,
    /// Représente le cas `WouldBlock`.
    WouldBlock,
    /// Représente le cas `OutOfSpace`.
    OutOfSpace,
    /// Représente le cas `TooLarge`.
    TooLarge,
    /// Représente le cas `Unsupported`.
    Unsupported,
    /// Représente le cas `ResourceExhausted`.
    ResourceExhausted,
    /// Représente le cas `Other`.
    Other
}

/// Énumère les états publics de `SystemOpenMode`.
enum SystemOpenMode derives Copy, Equality, Debug {
    /// Représente le cas `Read`.
    Read,
    /// Représente le cas `Write`.
    Write,
    /// Représente le cas `Append`.
    Append
}

/// Représente le type public `SystemError`.
struct SystemError(
/// Expose le membre public `operation`.
val operation : string,
/// Expose le membre public `category`.
val category : SystemErrorCategory,
/// Expose le membre public `nativeCode`.
val nativeCode : uint,
/// Expose le membre public `context`.
val context : string
) derives Copy, Equality, Debug {}

private def currentSystemError(
operation : string,
context : string
) : SystemError {
    return new SystemError(
    operation,
    SystemErrorCategory(janus_system_error_category()),
    janus_system_error_code(),
    context
    )
}

private def closedSystemError(
operation : string,
context : string
) : SystemError {
    return new SystemError(
    operation,
    SystemErrorCategory.InvalidInput,
    uint(0),
    context
    )
}

/// Représente le type public `SystemFile`.
class SystemFile(
private var nativeHandle : isize,
private val fileContext : string
) {
    /// Indique si le fichier natif est ouvert.
    def isOpen() : bool {
        return nativeHandle >= isize(0)
    }

    /// Lit des octets depuis le fichier natif.
    def read(
    data : Ptr[byte],
    capacity : usize
    ) : Result[usize, SystemError] {
        if nativeHandle < isize(0) {
            return Result.Error[usize, SystemError](
            closedSystemError("read", fileContext)
            )
        }
        val count : isize =
        janus_system_read(nativeHandle, data, capacity)
        if count < isize(0) {
            return Result.Error[usize, SystemError](
            currentSystemError("read", fileContext)
            )
        }
        return Result.Ok[usize, SystemError](usize(count))
    }

    /// Écrit des octets dans le fichier natif.
    def write(
    data : Ptr[byte],
    size : usize
    ) : Result[usize, SystemError] {
        if nativeHandle < isize(0) {
            return Result.Error[usize, SystemError](
            closedSystemError("write", fileContext)
            )
        }
        val count : isize =
        janus_system_write(nativeHandle, data, size)
        if count < isize(0) {
            return Result.Error[usize, SystemError](
            currentSystemError("write", fileContext)
            )
        }
        return Result.Ok[usize, SystemError](usize(count))
    }

    /// Ferme le fichier natif.
    def close() : Result[bool, SystemError] {
        if nativeHandle < isize(0) {
            return Result.Error[bool, SystemError](
            closedSystemError("close", fileContext)
            )
        }
        val handle : isize = nativeHandle
        nativeHandle = isize(-1)
        if janus_system_close(handle) != 0 {
            return Result.Error[bool, SystemError](
            currentSystemError("close", fileContext)
            )
        }
        return Result.Ok[bool, SystemError](true)
    }

    destructor {
        if nativeHandle >= isize(0) {
            val handle : isize = nativeHandle
            nativeHandle = isize(-1)
            janus_system_close(handle)
        }
    }
}

/// Ouvre un fichier natif dans le mode demandé.
def openSystemFile(
path : string,
mode : SystemOpenMode
) : Result[SystemFile, SystemError] {
    val handle : isize = janus_system_open(
    stringData(path),
    stringLength(path),
    int(mode)
    )
    if handle < isize(0) {
        return Result.Error[SystemFile, SystemError](
        currentSystemError("open", path)
        )
    }
    return Result.Ok[SystemFile, SystemError](
    new SystemFile(handle, path)
    )
}

/// Supprime un fichier natif.
def removeSystemFile(
path : string
) : Result[bool, SystemError] {
    if janus_system_remove(
    stringData(path),
    stringLength(path)
    ) != 0 {
        return Result.Error[bool, SystemError](
        currentSystemError("remove", path)
        )
    }
    return Result.Ok[bool, SystemError](true)
}
