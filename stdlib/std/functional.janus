/// Transfère une fonction binaire vers deux applications explicites.
/// @param function Callback transférée à l'application partielle lors du premier appel.
/// @return Closure affine produisant une closure `FnOnce` ; aucun clonage de callback.
def curry2[A <: Copy, B, C](function : pure FnOnce (A, B) => C) : pure FnOnce (A) => pure FnOnce (B) => C {
    return owningCapture[pure FnOnce (A, B) => C](function, (first : A) => {
        val state = new PartialState[pure FnOnce (A, B) => C, A](move function, move first)
        val result : pure FnOnce (B) => C = owningCapture[PartialState[pure FnOnce (A, B) => C, A]](state, (second : B) => {
            return match move state {
            PartialState(callback, fixed) => applyPartial1[A, B, C](move callback, move fixed, move second)
        }
        })
        return move result
    })
}

private def applyUncurried00000[A, B, C](borrow function : Fn (A) => Fn (B) => C, left : A, right : B) : C {
    val finish = owningCapture[B](right, (next : Fn (B) => C) => {
        val innerCallback : Fn (B) => C = move next
        defer delete innerCallback
        return innerCallback(move right)
    })
    defer delete finish
    return finish(function(move left))
}

/// Applique une fonction curryfiée à la paire canonique `OptionPair`.
/// @param function Callback propriétaire produisant la seconde étape.
/// @return Closure `Fn`, consommant les champs de la paire de gauche à droite.
def uncurry2[A, B, C](function : Fn (A) => Fn (B) => C) : Fn (OptionPair[A, B]) => C {
    return owningCapture[Fn (A) => Fn (B) => C](function, (pair : OptionPair[A, B]) => {
        return match move pair {
            OptionPair(left, right) => applyUncurried00000[A, B, C](function, move left, move right)
        }
    })
}

private def applyUncurried00010[A, B, C](borrow function : Fn (A) => pure Fn (B) => C, left : A, right : B) : C {
    val finish = owningCapture[B](right, (next : pure Fn (B) => C) => {
        val innerCallback : pure Fn (B) => C = move next
        defer delete innerCallback
        return innerCallback(move right)
    })
    defer delete finish
    return finish(function(move left))
}

