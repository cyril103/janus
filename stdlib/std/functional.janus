/// Fixe le premier argument, évalué une fois pendant la construction.
/// @param function Callback binaire propriétaire.
/// @param first Valeur fixée ; un propriétaire exige un `move` explicite.
/// @return Closure `FnOnce`, possédant un seul environnement supplémentaire.
def partialFirst2[A, B, C](function : Fn (A, B) => C, first : A) : FnOnce (B) => C {
    val state = new PartialState[Fn (A, B) => C, A](move function, move first)
    return owningCapture[PartialState[Fn (A, B) => C, A]](state, (second : B) => {
        return match move state {
            PartialState(callback, fixed) => applyPartial0[A, B, C](move callback, move fixed, move second)
        }
    })
}

/// Transfère une fonction binaire vers deux applications explicites.
/// @param function Callback transférée à l'application partielle lors du premier appel.
/// @return Closure affine produisant une closure `FnOnce` ; aucun clonage de callback.
def curry2[A, B, C](function : Fn (A, B) => C) : FnOnce (A) => FnOnce (B) => C {
    return owningCapture[Fn (A, B) => C](function, (first : A) => {
        val state = new PartialState[Fn (A, B) => C, A](move function, move first)
        val result : FnOnce (B) => C = owningCapture[PartialState[Fn (A, B) => C, A]](state, (second : B) => {
            return match move state {
            PartialState(callback, fixed) => applyPartial0[A, B, C](move callback, move fixed, move second)
        }
        })
        return move result
    })
}

/// Fixe le premier argument, évalué une fois pendant la construction.
/// @param function Callback binaire propriétaire.
/// @param first Valeur fixée ; un propriétaire exige un `move` explicite.
/// @return Closure `Fn`, possédant un seul environnement supplémentaire.
def partialFirst2[A <: Copy, B, C](function : Fn (A, B) => C, first : A) : Fn (B) => C {
    val state = new PartialState[Fn (A, B) => C, A](move function, move first)
    return owningCapture[PartialState[Fn (A, B) => C, A]](state, (second : B) => {
        borrow val callback : Fn (A, B) => C = state.function
        return callback(state.first, move second)
    })
}

