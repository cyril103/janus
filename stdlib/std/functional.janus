def curry2[A <: Copy, B, C](function : Fn (A, B) => C) : FnOnce (A) => Fn (B) => C {
    return owningCapture[Fn (A, B) => C](function, (first : A) => {
        val state = new PartialState[Fn (A, B) => C, A](move function, move first)
        val result : Fn (B) => C = owningCapture[PartialState[Fn (A, B) => C, A]](state, (second : B) => {
            borrow val callback : Fn (A, B) => C = state.function
        return callback(state.first, move second)
        })
        return move result
    })
}

