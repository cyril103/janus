def compose[A, B, C](outer : FnMut (B) => C, inner : FnMut (A) => B) : FnMut (A) => C {
    var state = new CompositionState[FnMut (B) => C, FnMut (A) => B](move outer, move inner)
    return owningCapture[CompositionState[FnMut (B) => C, FnMut (A) => B]](state, (value : A) => {
        borrow var outerCallback : FnMut (B) => C = state.outer
        borrow var innerCallback : FnMut (A) => B = state.inner
        return outerCallback(innerCallback(move value))
    })
}

