private struct CompositionState[Outer, Inner](var outer : Outer, var inner : Inner) {}
private struct PartialState[Callback, First](var function : Callback, val first : First) {}

private def applyComposition00[A, B, C](value : A, outer : FnOnce (B) => C, inner : FnOnce (A) => B) : C {
    val outerCallback : FnOnce (B) => C = move outer
    defer delete outerCallback
    val innerCallback : FnOnce (A) => B = move inner
    defer delete innerCallback
    return outerCallback(innerCallback(move value))
}

private def applyComposition01[A, B, C](value : A, outer : FnOnce (B) => C, inner : pure FnOnce (A) => B) : C {
    val outerCallback : FnOnce (B) => C = move outer
    defer delete outerCallback
    val innerCallback : pure FnOnce (A) => B = move inner
    defer delete innerCallback
    return outerCallback(innerCallback(move value))
}

private def applyComposition10[A, B, C](value : A, outer : pure FnOnce (B) => C, inner : FnOnce (A) => B) : C {
    val outerCallback : pure FnOnce (B) => C = move outer
    defer delete outerCallback
    val innerCallback : FnOnce (A) => B = move inner
    defer delete innerCallback
    return outerCallback(innerCallback(move value))
}

private pure def applyComposition11[A, B, C](value : A, outer : pure FnOnce (B) => C, inner : pure FnOnce (A) => B) : C {
    val outerCallback : pure FnOnce (B) => C = move outer
    defer delete outerCallback
    val innerCallback : pure FnOnce (A) => B = move inner
    defer delete innerCallback
    return outerCallback(innerCallback(move value))
}

private def applyPartial0[A, B, C](function : FnOnce (A, B) => C, first : A, second : B) : C {
    val callback : FnOnce (A, B) => C = move function
    defer delete callback
    return callback(move first, move second)
}

private pure def applyPartial1[A, B, C](function : pure FnOnce (A, B) => C, first : A, second : B) : C {
    val callback : pure FnOnce (A, B) => C = move function
    defer delete callback
    return callback(move first, move second)
}

/// Construit une composition propriétaire, `inner` avant `outer`.
/// @param outer Seconde transformation, transférée une fois.
/// @param inner Première transformation, transférée une fois.
/// @return Closure `Fn` ; détruire les résultats réutilisables avec `defer delete`.
def compose[A, B, C](outer : Fn (B) => C, inner : Fn (A) => B) : Fn (A) => C {
    val state = new CompositionState[Fn (B) => C, Fn (A) => B](move outer, move inner)
    return owningCapture[CompositionState[Fn (B) => C, Fn (A) => B]](state, (value : A) => {
        borrow val outerCallback : Fn (B) => C = state.outer
        borrow val innerCallback : Fn (A) => B = state.inner
        return outerCallback(innerCallback(move value))
    })
}

/// Construit une composition propriétaire dans l'ordre de lecture.
/// @param first Première transformation, transférée une fois.
/// @param after Seconde transformation, transférée une fois.
/// @return Closure `Fn` ; même contrat de nettoyage que `compose`.
def andThen[A, B, C](first : Fn (A) => B, after : Fn (B) => C) : Fn (A) => C {
    return compose[A, B, C](move after, move first)
}

