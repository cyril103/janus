/// Fournit un ensemble propriétaire fondé sur le hachage.
///
/// [[HashSet]] conserve au plus une valeur par classe d’égalité définie par une
/// stratégie [[Hashing]]. Le sondage linéaire donne des opérations amorties
/// constantes avec des hachages bien répartis; le parcours suit les cases
/// internes et ne garantit aucun ordre d’insertion.
/// @example
/// ```janus
/// val ids : HashSet[int, IntHashing] =
///     new HashSet[int, IntHashing](usize(8), new IntHashing())
/// val inserted : bool = ids.add(42)
/// val present : bool = ids.contains(42)
/// ```
module std.hashset
import std.array
import std.builder
import std.hash_probe
import std.hashing
import std.iterator
import std.option

/// Décrit l’état interne d’une case de l’ensemble à adressage ouvert.
private enum SetSlot[T] {
    /// Case jamais occupée, qui termine une recherche par sondage.
    Empty,
    /// Case possédant une valeur actuellement membre de l’ensemble.
    Occupied(T),
    /// Tombstone préservant la chaîne de sondage après une suppression.
    Deleted
}

private class HashSetIteratorState[T <: Copy, H <: Hashing[T]](
private borrow val source : HashSet[T, H],
private var index : usize
) {
    def next() : Option[T] {
        var result : Option[T] = Option.None[T]()
        while index < source.storageSize() && match result {
            Some(value) => false,
            None => true
        } {
            result = source.valueAt(index)
            index = index + usize(1)
        }
        return result
    }

    def dispose() : Unit {
        delete this
    }
}

private class HashSetIntoIteratorState[T, H <: Hashing[T]](
private val source : HashSet[T, H],
private var index : usize
) {
    def next() : Option[T] {
        while index < source.storageSize() {
            val result : Option[T] = source.takeValueAt(index)
            index = index + usize(1)
            if isSome[T](result) {
                return move result
            }
            delete result
        }
        return Option.None[T]()
    }

    def dispose() : Unit {
        delete this
    }

    destructor {
        delete source
    }
}

/// Ensemble propriétaire à adressage ouvert et sondage linéaire.
///
/// L’ensemble possède ses valeurs et emprunte la stratégie `hashing`. La capacité est au
/// minimum 8 et une insertion réorganise la table lorsque membres et tombstones
/// approchent 75 % des cases. Les observations copient les valeurs et nécessitent
/// donc `Copy`; [[HashSet.intoIterator]] consomme l’ensemble pour transférer des
/// valeurs de tout type.
/// @param initialCapacity Capacité souhaitée, normalisée à un minimum de 8.
/// @param hashing Stratégie d’égalité et de hachage empruntée par l’ensemble; elle doit rester vivante aussi longtemps que lui.
class HashSet[T, H <: Hashing[T]](
initialCapacity : usize,
private borrow val hashing : H
) extends Iterable[T], IntoIterable[T] {
    private var slotCapacity : usize =
    normalizedHashCapacity(initialCapacity)
    private var slots : Array[SetSlot[T]] =
    new Array[SetSlot[T]](slotCapacity)
    private var length : usize = usize(0)
    private var deletedCount : usize = usize(0)

    private def initializeSlots() : Unit {
        while slots.size() < slotCapacity {
            slots.push(SetSlot.Empty[T]())
        }
    }

    private def matchesAt(
    index : usize,
    borrow value : T
    ) : bool {
        borrow val slot : SetSlot[T] = slots.getBorrowed(index)
        return match slot {
            Occupied(existing) => hashing.equals(existing, value),
            Empty => false,
            Deleted => false
        }
    }

    private borrow def isEmptyAt(index : usize) : bool {
        borrow val slot : SetSlot[T] = slots.getBorrowed(index)
        return match slot {
            Empty => true,
            Occupied(existing) => false,
            Deleted => false
        }
    }

    private borrow def isDeletedAt(index : usize) : bool {
        borrow val slot : SetSlot[T] = slots.getBorrowed(index)
        return match slot {
            Deleted => true,
            Empty => false,
            Occupied(existing) => false
        }
    }

    private def restore(slot : SetSlot[T]) : bool {
        return match move slot {
            Occupied(value) => this.add(move value),
            Empty => false,
            Deleted => false
        }
    }

    private def resize(requested : usize) : Unit {
        val previous : Array[SetSlot[T]] = move slots
        slotCapacity = normalizedHashCapacity(requested)
        slots = new Array[SetSlot[T]](slotCapacity)
        length = usize(0)
        deletedCount = usize(0)
        this.initializeSlots()

        while !previous.isEmpty() {
            val slot : SetSlot[T] = previous.pop()
            this.restore(move slot)
        }
        delete previous
    }

    /// Retourne le nombre de valeurs stockées.
    /// @return Nombre de cases occupées, hors tombstones.
    borrow def size() : usize {
        return length
    }

    /// Indique si l’ensemble est vide.
    /// @return `true` lorsque [[HashSet.size]] vaut zéro.
    borrow def isEmpty() : bool {
        return length == usize(0)
    }

    internal borrow def storageSize() : usize {
        return slotCapacity
    }

    internal borrow def valueAt(
    index : usize
    ) : Option[T] where T <: Copy {
        if index >= slots.size() {
            return Option.None[T]()
        }
        borrow val slot : SetSlot[T] = slots.getBorrowed(index)
        return match slot {
            Occupied(value) => Option.Some[T](value),
            Empty => Option.None[T](),
            Deleted => Option.None[T]()
        }
    }

    private def restoreDeletedValue(index : usize) : Option[T] {
        slots.set(index, SetSlot.Deleted[T]())
        return Option.None[T]()
    }

    private def finishTakeValue(value : T) : Option[T] {
        length = length - usize(1)
        deletedCount = deletedCount + usize(1)
        return Option.Some[T](move value)
    }

    private def restoreEmptyTake(index : usize) : Option[T] {
        slots.set(index, SetSlot.Empty[T]())
        return Option.None[T]()
    }

    internal def takeValueAt(index : usize) : Option[T] {
        this.initializeSlots()
        if index >= slotCapacity {
            return Option.None[T]()
        }
        val slot : SetSlot[T] =
        slots.replace(index, SetSlot.Deleted[T]())
        return match move slot {
            Occupied(value) => this.finishTakeValue(move value),
            Empty => this.restoreEmptyTake(index),
            Deleted => this.restoreDeletedValue(index)
        }
    }

    /// Indique si la valeur appartient à l’ensemble.
    ///
    /// `value` est observée et comparée selon la stratégie. Le coût est amorti
    /// constant avec un bon hachage, mais peut devenir linéaire sous collisions.
    /// @param value Valeur à hacher puis comparer aux membres stockés.
    /// @return `true` si une valeur égale est présente.
    def contains(borrow value : T) : bool {
        if length == usize(0) {
            return false
        }
        var probe : HashProbe = hashProbe(hashing.hash(value), slotCapacity)
        while probe.hasNext() {
            val index : usize = probe.next()
            if this.matchesAt(index, value) {
                return true
            }
            if this.isEmptyAt(index) {
                return false
            }
        }
        return false
    }

    /// Observe la valeur canonique stockée égale à `value`.
    ///
    /// Cette opération ne copie ni la requête ni le membre de l'ensemble et
    /// fonctionne donc avec les types propriétaires.
    /// @param value Valeur observée servant à la recherche.
    /// @param action Callback borné recevant le membre effectivement stocké.
    /// @return `true` si un membre égal a été trouvé et observé.
    def withValue(
    borrow value : T,
    scoped action : (borrow T) => Unit
    ) : bool {
        defer delete action
        if length == usize(0) {
            return false
        }
        var probe : HashProbe = hashProbe(hashing.hash(value), slotCapacity)
        while probe.hasNext() {
            val index : usize = probe.next()
            borrow val slot : SetSlot[T] = slots.getBorrowed(index)
            val found : bool = match slot {
                Occupied(existing) =>
                this.observeEqual(existing, value, action),
                Empty => false,
                Deleted => false
            }
            if found {
                return true
            }
            if this.isEmptyAt(index) {
                return false
            }
        }
        return false
    }

    private def observeEqual(
    borrow existing : T,
    borrow query : T,
    borrow action : (borrow T) => Unit
    ) : bool {
        if hashing.equals(existing, query) {
            action(existing)
            return true
        }
        return false
    }

    /// Ajoute une valeur.
    ///
    /// En cas de succès, la propriété de `value` est transférée à l’ensemble. Si
    /// un membre égal existe, la valeur fournie est détruite et la collection ne
    /// change pas. Une insertion peut redimensionner ou nettoyer la table.
    /// @param value Valeur possédée proposée comme nouveau membre.
    /// @return `true` si elle a été insérée, `false` si un équivalent existait déjà.
    def add(value : T) : bool {
        this.initializeSlots()
        var probe : HashProbe = hashProbe(hashing.hash(value), slotCapacity)
        var firstDeleted : usize = usize(0)
        var hasDeleted : bool = false
        var destination : usize = slotCapacity
        var duplicate : bool = false
        while probe.hasNext() {
            val index : usize = probe.next()
            if this.matchesAt(index, value) {
                duplicate = true
                break
            }
            if this.isDeletedAt(index) && !hasDeleted {
                firstDeleted = index
                hasDeleted = true
            }
            if this.isEmptyAt(index) {
                destination = if hasDeleted {
                    firstDeleted
                } else {
                    index
                }
                break
            }
        }

        if duplicate {
            delete value
            return false
        }
        if hashTableShouldGrow(length, deletedCount, slotCapacity) {
            val requested : usize =
            if hashTableShouldGrow(
            length,
            usize(0),
            slotCapacity
            ) {
                slotCapacity * usize(2)
            } else {
                slotCapacity
            }
            this.resize(requested)
            return this.add(move value)
        }
        if destination < slotCapacity {
            slots.set(destination, SetSlot.Occupied[T](move value))
            length = length + usize(1)
            if hasDeleted {
                deletedCount = deletedCount - usize(1)
            }
            return true
        }
        if hasDeleted {
            slots.set(firstDeleted, SetSlot.Occupied[T](move value))
            length = length + usize(1)
            deletedCount = deletedCount - usize(1)
            return true
        }
        this.resize(slotCapacity * usize(2))
        return this.add(move value)
    }

    /// Retire la valeur et indique si elle était présente.
    ///
    /// La valeur de recherche est seulement observée. Le membre stocké est
    /// détruit lorsqu’il est trouvé et sa case devient un tombstone.
    /// @param value Valeur à rechercher selon la stratégie de l’ensemble.
    /// @return `true` si un membre a été trouvé et détruit, sinon `false`.
    def remove(borrow value : T) : bool {
        if length == usize(0) {
            return false
        }
        var probe : HashProbe = hashProbe(hashing.hash(value), slotCapacity)
        while probe.hasNext() {
            val index : usize = probe.next()
            if this.matchesAt(index, value) {
                val removed : SetSlot[T] =
                slots.replace(index, SetSlot.Deleted[T]())
                delete removed
                length = length - usize(1)
                deletedCount = deletedCount + usize(1)
                return true
            }
            if this.isEmptyAt(index) {
                return false
            }
        }
        return false
    }

    /// Détruit tous les membres tout en conservant la capacité réservée.
    ///
    /// Les tombstones sont également supprimés. Le coût est linéaire dans la
    /// capacité de stockage.
    def clear() : Unit {
        this.initializeSlots()
        var index : usize = usize(0)
        while index < slotCapacity {
            slots.set(index, SetSlot.Empty[T]())
            index = index + usize(1)
        }
        length = usize(0)
        deletedCount = usize(0)
    }

    /// Crée un parcours observant de copies des membres.
    ///
    /// L’ensemble reste propriétaire de ses valeurs et doit vivre pendant le
    /// parcours. L’ordre reflète les cases internes et peut changer après toute
    /// réorganisation.
    /// @return Un [[Iterator]] de copies des membres; exige `T <: Copy`.
    borrow def iterator() : Iterator[T] where T <: Copy {
        val state : HashSetIteratorState[T, H] =
        new HashSetIteratorState[T, H](this, usize(0))
        return new Iterator[T](
        () => state.next(),
        owningCapture[HashSetIteratorState[T, H]](
        state, () => state.dispose()
        )
        )
    }

    /// Consomme l’ensemble et transfère ses membres à un parcours.
    ///
    /// Les valeurs sont déplacées hors des cases sans copie. Si le parcours est
    /// détruit avant épuisement, l’ensemble source détruit les membres restants.
    /// @return Un [[Iterator]] propriétaire parcourant les membres dans l’ordre interne.
    consume def intoIterator() : Iterator[T] {
        val state : HashSetIntoIteratorState[T, H] =
        new HashSetIntoIteratorState[T, H](move this, usize(0))
        return new Iterator[T](
        () => state.next(),
        owningCapture[HashSetIntoIteratorState[T, H]](
        state, () => state.dispose()
        )
        )
    }

    destructor {
        delete slots
    }
}

/// Constructeur mutable de [[HashSet]] à partir d’une suite de valeurs.
///
/// Il possède l’ensemble en cours et consomme chaque valeur ajoutée. Les doublons
/// sont détruits conformément à [[HashSet.add]]. [[SetBuilder.result]] transfère
/// le résultat puis réinitialise le constructeur à une capacité de 8.
/// @param initialCapacity Capacité initiale souhaitée pour l’ensemble accumulé.
/// @param hashing Stratégie empruntée et réutilisée après chaque résultat.
class SetBuilder[T, H <: Hashing[T]](
initialCapacity : usize,
private borrow val hashing : H
) extends Builder[T, HashSet[T, H]] {
    private var values : HashSet[T, H] =
    new HashSet[T, H](initialCapacity, hashing)

    /// Ajoute une valeur.
    ///
    /// La valeur est consommée; elle est stockée si elle est nouvelle, sinon
    /// détruite comme doublon.
    /// @param value Valeur dont la propriété est transférée au constructeur.
    def add(value : T) : Unit {
        values.add(move value)
    }

    /// Ajoute tous les éléments de la source.
    ///
    /// La source est parcourue sans être consommée et fournit donc des copies de
    /// ses éléments. Les doublons sont éliminés par la stratégie de l’ensemble.
    /// @param source Source [[Iterable]] observée dans son ordre de parcours.
    def addAll[C <: Iterable[T]](
    borrow source : C
    ) : Unit where T <: Copy {
        for value in source {
            this.add(value)
        }
    }

    /// Retourne le nombre de valeurs accumulées.
    /// @return Nombre de membres distincts dans l’ensemble en cours.
    borrow def size() : usize {
        return values.size()
    }

    /// Détruit toutes les valeurs accumulées sans changer la capacité.
    def clear() : Unit {
        values.clear()
    }

    /// Produit l’ensemble construit.
    ///
    /// L’ensemble courant est déplacé vers l’appelant. Le constructeur reste
    /// utilisable avec un nouvel ensemble vide de capacité initiale 8.
    /// @return [[HashSet]] possédant les membres accumulés.
    def result() : HashSet[T, H] {
        val completed : HashSet[T, H] = move values
        values = new HashSet[T, H](usize(8), hashing)
        return completed
    }

    destructor {
        delete values
    }
}
