/// Fournit un ensemble haché propriétaire et ses parcours.
module std.hashset
import std.array
import std.builder
import std.hash_probe
import std.hashing
import std.iterator
import std.option

private enum SetSlot[T] {
    Empty,
    Occupied(T),
    Deleted
}

private class HashSetIteratorState[T <: Copy, H <: Hashing[T]](
private val source : HashSet[T, H],
private var index : usize
) {
    def next() : Option[T] {
        var result : Option[T] = Option.None[T]()
        while index < source.storageSize() && match result {
            Some(value) => false,
            None => true
        } {
            result = source.valueAt(index)
            index = index + usize(1)
        }
        return result
    }

    def dispose() : Unit {
        delete this
    }
}

private class HashSetIntoIteratorState[T, H <: Hashing[T]](
private val source : HashSet[T, H],
private var index : usize
) {
    def next() : Option[T] {
        var result : Option[T] = Option.None[T]()
        while index < source.storageSize() && match result {
            Some(value) => false,
            None => true
        } {
            result = source.takeValueAt(index)
            index = index + usize(1)
        }
        return result
    }

    def dispose() : Unit {
        delete this
    }

    destructor {
        delete source
    }
}

/// Représente le type public `HashSet`.
class HashSet[T, H <: Hashing[T]](
initialCapacity : usize,
private val hashing : H
) extends Iterable[T] {
    private var slotCapacity : usize =
    normalizedHashCapacity(initialCapacity)
    private var slots : Array[SetSlot[T]] =
    new Array[SetSlot[T]](slotCapacity)
    private var length : usize = usize(0)
    private var deletedCount : usize = usize(0)

    private def initializeSlots() : Unit {
        while slots.size() < slotCapacity {
            slots.push(SetSlot.Empty[T]())
        }
    }

    private def restoreOccupied(
    index : usize,
    existing : T,
    value : T
    ) : bool {
        val result : bool = hashing.equals(existing, value)
        slots.set(index, SetSlot.Occupied[T](move existing))
        return result
    }

    private def restoreDeleted(index : usize) : bool {
        slots.set(index, SetSlot.Deleted[T]())
        return false
    }

    private def restoreOccupiedFalse(
    index : usize,
    existing : T
    ) : bool {
        slots.set(index, SetSlot.Occupied[T](move existing))
        return false
    }

    private def matchesAt(index : usize, value : T) : bool {
        val slot : SetSlot[T] =
        slots.replace(index, SetSlot.Empty[T]())
        return match move slot {
            Occupied(existing) =>
            this.restoreOccupied(index, move existing, value),
            Empty => false,
            Deleted => this.restoreDeleted(index)
        }
    }

    private def isEmptyAt(index : usize) : bool {
        val slot : SetSlot[T] =
        slots.replace(index, SetSlot.Empty[T]())
        return match move slot {
            Empty => true,
            Occupied(existing) =>
            this.restoreOccupiedFalse(index, move existing),
            Deleted => this.restoreDeleted(index)
        }
    }

    private def isDeletedAt(index : usize) : bool {
        val slot : SetSlot[T] =
        slots.replace(index, SetSlot.Empty[T]())
        return match move slot {
            Deleted => this.restoreDeleted(index) || true,
            Empty => false,
            Occupied(existing) =>
            this.restoreOccupiedFalse(index, move existing)
        }
    }

    private def restore(slot : SetSlot[T]) : bool {
        return match move slot {
            Occupied(value) => this.add(move value),
            Empty => false,
            Deleted => false
        }
    }

    private def resize(requested : usize) : Unit {
        val previous : Array[SetSlot[T]] = move slots
        slotCapacity = normalizedHashCapacity(requested)
        slots = new Array[SetSlot[T]](slotCapacity)
        length = usize(0)
        deletedCount = usize(0)
        this.initializeSlots()

        while !previous.isEmpty() {
            val slot : SetSlot[T] = previous.pop()
            this.restore(move slot)
        }
        delete previous
    }

    /// Retourne le nombre de valeurs stockées.
    def size() : usize {
        return length
    }

    /// Indique si l’ensemble est vide.
    def isEmpty() : bool {
        return length == usize(0)
    }

    internal def storageSize() : usize {
        this.initializeSlots()
        return slotCapacity
    }

    internal def valueAt(index : usize) : Option[T] {
        this.initializeSlots()
        if index >= slotCapacity {
            return Option.None[T]()
        }
        val slot : SetSlot[T] =
        slots.replace(index, SetSlot.Empty[T]())
        return match move slot {
            Occupied(value) =>
            this.restoreAndCopyValue(index, move value),
            Empty => Option.None[T](),
            Deleted => this.restoreDeletedValue(index)
        }
    }

    private def restoreAndCopyValue(
    index : usize,
    value : T
    ) : Option[T] {
        val result : Option[T] = Option.Some[T](value)
        slots.set(index, SetSlot.Occupied[T](move value))
        return result
    }

    private def restoreDeletedValue(index : usize) : Option[T] {
        slots.set(index, SetSlot.Deleted[T]())
        return Option.None[T]()
    }

    private def finishTakeValue(value : T) : Option[T] {
        length = length - usize(1)
        deletedCount = deletedCount + usize(1)
        return Option.Some[T](move value)
    }

    private def restoreEmptyTake(index : usize) : Option[T] {
        slots.set(index, SetSlot.Empty[T]())
        return Option.None[T]()
    }

    internal def takeValueAt(index : usize) : Option[T] {
        this.initializeSlots()
        if index >= slotCapacity {
            return Option.None[T]()
        }
        val slot : SetSlot[T] =
        slots.replace(index, SetSlot.Deleted[T]())
        return match move slot {
            Occupied(value) => this.finishTakeValue(move value),
            Empty => this.restoreEmptyTake(index),
            Deleted => this.restoreDeletedValue(index)
        }
    }

    /// Indique si la valeur appartient à l’ensemble.
    def contains(value : T) : bool {
        this.initializeSlots()
        var probe : HashProbe = hashProbe(hashing.hash(value), slotCapacity)
        while probe.hasNext() {
            val index : usize = probe.next()
            if this.matchesAt(index, value) {
                return true
            }
            if this.isEmptyAt(index) {
                return false
            }
        }
        return false
    }

    /// Ajoute une valeur.
    def add(value : T) : bool {
        this.initializeSlots()
        var probe : HashProbe = hashProbe(hashing.hash(value), slotCapacity)
        var firstDeleted : usize = usize(0)
        var hasDeleted : bool = false
        var destination : usize = slotCapacity
        var duplicate : bool = false
        while probe.hasNext() {
            val index : usize = probe.next()
            if this.matchesAt(index, value) {
                duplicate = true
                break
            }
            if this.isDeletedAt(index) && !hasDeleted {
                firstDeleted = index
                hasDeleted = true
            }
            if this.isEmptyAt(index) {
                destination = if hasDeleted {
                    firstDeleted
                } else {
                    index
                }
                break
            }
        }

        if duplicate {
            delete value
            return false
        }
        if hashTableShouldGrow(length, deletedCount, slotCapacity) {
            val requested : usize =
            if hashTableShouldGrow(
            length,
            usize(0),
            slotCapacity
            ) {
                slotCapacity * usize(2)
            } else {
                slotCapacity
            }
            this.resize(requested)
            return this.add(move value)
        }
        if destination < slotCapacity {
            slots.set(destination, SetSlot.Occupied[T](move value))
            length = length + usize(1)
            if hasDeleted {
                deletedCount = deletedCount - usize(1)
            }
            return true
        }
        if hasDeleted {
            slots.set(firstDeleted, SetSlot.Occupied[T](move value))
            length = length + usize(1)
            deletedCount = deletedCount - usize(1)
            return true
        }
        this.resize(slotCapacity * usize(2))
        return this.add(move value)
    }

    /// Retire la valeur et indique si elle était présente.
    def remove(value : T) : bool {
        this.initializeSlots()
        var probe : HashProbe = hashProbe(hashing.hash(value), slotCapacity)
        while probe.hasNext() {
            val index : usize = probe.next()
            if this.matchesAt(index, value) {
                val removed : SetSlot[T] =
                slots.replace(index, SetSlot.Deleted[T]())
                delete removed
                length = length - usize(1)
                deletedCount = deletedCount + usize(1)
                return true
            }
            if this.isEmptyAt(index) {
                return false
            }
        }
        return false
    }

    /// Réinitialise l’état.
    def clear() : Unit {
        this.initializeSlots()
        var index : usize = usize(0)
        while index < slotCapacity {
            slots.set(index, SetSlot.Empty[T]())
            index = index + usize(1)
        }
        length = usize(0)
        deletedCount = usize(0)
    }

    /// Exécute l’opération publique `iterator`.
    def iterator() : Iterator[T] {
        val state : HashSetIteratorState[T, H] =
        new HashSetIteratorState[T, H](this, usize(0))
        return new Iterator[T](
        () => state.next(),
        () => state.dispose()
        )
    }

    /// Exécute l’opération publique `intoIterator`.
    consume def intoIterator() : Iterator[T] {
        val state : HashSetIntoIteratorState[T, H] =
        new HashSetIntoIteratorState[T, H](move this, usize(0))
        return new Iterator[T](
        () => state.next(),
        () => state.dispose()
        )
    }

    destructor {
        delete slots
    }
}

/// Représente le type public `SetBuilder`.
class SetBuilder[T, H <: Hashing[T]](
initialCapacity : usize,
private val hashing : H
) extends Builder[T, HashSet[T, H]] {
    private var values : HashSet[T, H] =
    new HashSet[T, H](initialCapacity, hashing)

    /// Ajoute une valeur.
    def add(value : T) : Unit {
        values.add(move value)
    }

    /// Ajoute tous les éléments de la source.
    def addAll[C <: Iterable[T]](source : C) : Unit {
        for value in source {
            this.add(value)
        }
    }

    /// Retourne le nombre de valeurs accumulées.
    def size() : usize {
        return values.size()
    }

    /// Réinitialise l’état.
    def clear() : Unit {
        values.clear()
    }

    /// Produit l’ensemble construit.
    def result() : HashSet[T, H] {
        val completed : HashSet[T, H] = move values
        values = new HashSet[T, H](usize(8), hashing)
        return completed
    }

    destructor {
        delete values
    }
}
