/// Mesure des durées en nanosecondes et des instants monotones.
///
/// Les conversions entières tronquent les fractions. Les constructeurs mis à l’échelle paniquent
/// en cas de débordement; [[Instant.durationSince]] exige un instant antérieur ou égal.
/// @example
/// ```janus
/// val started : Instant = monotonicNow()
/// val elapsed : Duration = started.elapsed()
/// ```
module std.time

private extern def janus_monotonic_nanoseconds() : usize

/// Stocke une durée non négative sous forme d’un nombre entier de nanosecondes.
///
/// @param value Nombre exact de nanosecondes à conserver.
struct Duration(private val value : usize) {
    /// Lit la représentation exacte en nanosecondes.
    ///
    /// @return Nombre de nanosecondes stocké.
    def nanoseconds() : usize {
        return value
    }

    /// Convertit la durée en microsecondes entières.
    ///
    /// @return Quotient par 1 000; les nanosecondes restantes sont tronquées.
    def microseconds() : usize {
        return value / usize(1000)
    }

    /// Convertit la durée en millisecondes entières.
    ///
    /// @return Quotient par 1 000 000; la fraction restante est tronquée.
    def milliseconds() : usize {
        return value / usize(1000000)
    }

    /// Convertit la durée en secondes à virgule flottante.
    ///
    /// @return Nombre de nanosecondes divisé par 1 000 000 000.
    def seconds() : double {
        return double(value) / double(1000000000.0)
    }
}

/// Représente une lecture opaque de l’horloge monotone en nanosecondes.
///
/// @param value Lecture native de l’horloge monotone à conserver.
struct Instant(private val value : usize) {
    /// Soustrait un instant antérieur de cet instant.
    ///
    /// @param earlier Instant à soustraire; une valeur postérieure à `this` provoque une panique.
    /// @return Écart non négatif entre les deux lectures, en nanosecondes.
    def durationSince(earlier : Instant) : Duration {
        if value < earlier.value {
            panic("instant precedes earlier instant\n")
        }
        return new Duration(value - earlier.value)
    }

    /// Mesure la durée entre cet instant et une nouvelle lecture monotone.
    ///
    /// @return Différence en nanosecondes entre [[monotonicNow]] et cet instant.
    def elapsed() : Duration {
        val current : Instant = monotonicNow()
        return new Duration(current.value - value)
    }
}

/// Construit une durée directement exprimée en nanosecondes.
///
/// @param value Nombre de nanosecondes à stocker sans conversion.
/// @return Durée contenant exactement `value` nanosecondes.
def nanoseconds(value : usize) : Duration {
    return new Duration(value)
}

private def scaledDuration(
value : usize,
scale : usize
) : Duration {
    val max : usize = usize(0) - usize(1)
    if value > max / scale {
        panic("duration overflow\n")
    }
    return new Duration(value * scale)
}

/// Convertit des microsecondes entières en nanosecondes.
///
/// @param value Nombre de microsecondes; une multiplication hors de `usize` provoque une panique.
/// @return Durée de `value * 1 000` nanosecondes.
def microseconds(value : usize) : Duration {
    return scaledDuration(value, usize(1000))
}

/// Convertit des millisecondes entières en nanosecondes.
///
/// @param value Nombre de millisecondes; une multiplication hors de `usize` provoque une panique.
/// @return Durée de `value * 1 000 000` nanosecondes.
def milliseconds(value : usize) : Duration {
    return scaledDuration(value, usize(1000000))
}

/// Convertit des secondes entières en nanosecondes.
///
/// @param value Nombre de secondes; une multiplication hors de `usize` provoque une panique.
/// @return Durée de `value * 1 000 000 000` nanosecondes.
def seconds(value : usize) : Duration {
    return scaledDuration(value, usize(1000000000))
}

/// Lit l’horloge monotone native.
///
/// @return Instant construit avec la lecture courante en nanosecondes.
def monotonicNow() : Instant {
    return new Instant(janus_monotonic_nanoseconds())
}
