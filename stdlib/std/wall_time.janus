/// Lit le temps civil écoulé depuis l’époque Unix.
///
/// Contrairement à [[Instant]], cette horloge peut refléter les corrections du système. Les
/// conversions entières en secondes ou millisecondes tronquent leur fraction.
/// @example
/// ```janus
/// val timestamp : WallTime = wallNow()
/// println(timestamp.unixSeconds())
/// ```
module std.wall_time

private extern def janus_wall_nanoseconds() : usize

/// Stocke un horodatage civil comme nanosecondes écoulées depuis l’époque Unix.
///
/// @param value Nombre de nanosecondes écoulées depuis l’époque Unix.
struct WallTime(private val value : usize) {
    /// Lit l’horodatage exact en nanosecondes Unix.
    ///
    /// @return Nombre de nanosecondes stocké depuis l’époque Unix.
    borrow def unixNanoseconds() : usize {
        return value
    }

    /// Convertit l’horodatage en millisecondes Unix entières.
    ///
    /// @return Quotient des nanosecondes par 1 000 000, avec troncature du reste.
    borrow def unixMilliseconds() : usize {
        return value / usize(1000000)
    }

    /// Convertit l’horodatage en secondes Unix entières.
    ///
    /// @return Quotient des nanosecondes par 1 000 000 000, avec troncature du reste.
    borrow def unixSeconds() : usize {
        return value / usize(1000000000)
    }
}

/// Lit l’horloge civile native en nanosecondes depuis l’époque Unix.
///
/// @return Horodatage construit avec la lecture courante du système.
def wallNow() : WallTime {
    return new WallTime(janus_wall_nanoseconds())
}
