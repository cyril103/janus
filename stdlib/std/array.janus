/// Fournit un tableau dynamique propriétaire et ses opérations séquentielles.
///
/// [[Array]] conserve les valeurs dans une zone contiguë, agrandit sa capacité
/// selon les besoins et détruit les éléments encore stockés avec le tableau. Les
/// accès sont constants; une suppression au milieu et les transformations
/// complètes sont linéaires.
/// @example
/// ```janus
/// val values : Array[int] = new Array[int](usize(2))
/// values.push(10)
/// values.push(20)
/// val doubled : Array[int] = values.map[int]((value : int) => value * 2)
/// ```
module std.array
import std.option
import std.iterator

private class ArrayIteratorState[T <: Copy](
private borrow val source : Array[T],
private var index : usize
) {
    def next() : Option[T] {
        if index >= source.size() {
            return Option.None[T]()
        }
        val value : Option[T] = source.getOption(index)
        index = index + usize(1)
        return value
    }

    def dispose() : Unit {
        delete this
    }
}

private class ArrayIntoIteratorState[T](
private val source : Array[T],
private var index : usize
) {
    def next() : Option[T] {
        if index >= source.size() {
            return Option.None[T]()
        }
        val current : usize = index
        index = index + usize(1)
        return Option.Some[T](
        source.takeForConsumingIterator(current)
        )
    }

    def dispose() : Unit {
        delete this
    }

    destructor {
        source.releaseConsumingIteratorFrom(index)
        delete source
    }
}

/// Tableau dynamique contigu qui possède ses éléments.
///
/// `initialCapacity` réserve de la mémoire sans créer d’élément. Les insertions
/// déplacent les valeurs dans le tableau; le remplacement, l’effacement et la
/// destruction appellent `delete` sur les valeurs abandonnées. Les parcours
/// observants exigent `T <: Copy`, tandis que [[Array.intoIterator]] consomme le
/// tableau et peut transférer des valeurs non copiables.
/// @param initialCapacity Nombre initial d’emplacements réservés.
class Array[T](initialCapacity : usize) extends Iterable[T] {
    private var data : Ptr[T] = alloc[T](initialCapacity)
    private var length : usize = usize(0)
    private var allocated : usize = initialCapacity

    private def tryResize(requested : usize) : bool {
        var next : usize = requested
        if next == usize(0) {
            next = usize(1)
        }

        val resized : Ptr[T] = reallocPreserving[T](data, next)
        if resized == null[T]() {
            freeStorage(resized)
            return false
        }

        data = adoptReallocation[T](data, resized)
        allocated = next
        return true
    }

    private def resize(requested : usize) : Unit {
        if !this.tryResize(requested) {
            panic("Array allocation failed\n")
        }
    }

    /// Retourne le nombre d’éléments stockés.
    /// @return Nombre de valeurs initialisées, distinct de la capacité.
    def size() : usize {
        return length
    }

    /// Retourne la capacité actuellement réservée.
    /// @return Nombre d’éléments pouvant être stockés sans nouvelle allocation.
    def capacity() : usize {
        return allocated
    }

    /// Indique si le tableau est vide.
    /// @return `true` lorsque [[Array.size]] vaut zéro.
    def isEmpty() : bool {
        return length == usize(0)
    }

    /// Crée un parcours observant les éléments dans l’ordre des indices.
    ///
    /// Cette méthode ne consomme pas le tableau et chaque valeur produite est une
    /// copie; elle n’est disponible que lorsque `T` satisfait `Copy`. Le tableau
    /// doit rester vivant pendant le parcours.
    /// @return Un nouvel [[Iterator]] positionné avant l’indice zéro.
    def iterator() : Iterator[T] {
        val state : ArrayIteratorState[T] =
        new ArrayIteratorState[T](this, usize(0))
        return new Iterator[T](
        () => state.next(),
        owningCapture[ArrayIteratorState[T]](
        state, () => state.dispose()
        )
        )
    }

    /// Consomme le tableau et transfère ses éléments à un itérateur.
    ///
    /// Chaque appel à `next` déplace la valeur suivante sans la copier. Détruire
    /// prématurément l’itérateur détruit tous les éléments non encore produits,
    /// puis libère le tableau source.
    /// @return Un [[Iterator]] propriétaire parcourant les valeurs par indice croissant.
    consume def intoIterator() : Iterator[T] {
        val state : ArrayIntoIteratorState[T] =
        new ArrayIntoIteratorState[T](move this, usize(0))
        return new Iterator[T](
        () => state.next(),
        owningCapture[ArrayIntoIteratorState[T]](
        state, () => state.dispose()
        )
        )
    }

    internal def takeForConsumingIterator(index : usize) : T {
        val value : T = data.load(index)
        return move value
    }

    internal def releaseConsumingIteratorFrom(first : usize) : Unit {
        var cursor : usize = length
        while cursor > first {
            cursor = cursor - usize(1)
            val value : T = data.load(cursor)
            delete value
        }
        length = usize(0)
    }

    /// Retourne l’élément situé à l’index demandé.
    ///
    /// L’accès est en temps constant et produit une copie de la valeur stockée.
    /// Déclenche `panic` si `index` est hors limites.
    /// @param index Position de l’élément, à partir de zéro.
    /// @return Copie de l’élément à cette position.
    def get(index : usize) : T {
        if index >= length {
            panic("Array index out of bounds\n")
        }
        return data.load(index)
    }

    /// Retourne l’élément demandé, ou `None` si l’index est hors limites.
    /// @param index Position recherchée, à partir de zéro.
    /// @return `Some` avec une copie de l’élément, ou `None` si `index >= size()`.
    def getOption(index : usize) : Option[T] {
        return if index < length {
            Option.Some[T](data.load(index))
        } else {
            Option.None[T]()
        }
    }

    /// Remplace l’élément situé à l’index demandé.
    ///
    /// La nouvelle valeur est déplacée dans le tableau et l’ancienne est
    /// détruite. Si l’indice est invalide, `value` est détruite avant `panic`.
    /// @param index Position existante à modifier.
    /// @param value Nouvelle valeur dont la propriété est transférée au tableau.
    def set(index : usize, value : T) : Unit {
        if index < length {
            val previous : T = data.load(index)
            data.overwrite(index, move value)
            delete previous
            return
        }
        delete value
        panic("Array index out of bounds\n")
    }

    /// Remplace un élément et transfère l’ancienne valeur à l’appelant.
    ///
    /// L’opération est constante. Si l’indice est invalide, la nouvelle `value`
    /// est détruite puis l’exécution s’arrête par `panic`.
    /// @param index Position existante à modifier.
    /// @param value Nouvelle valeur déplacée dans le tableau.
    /// @return Ancienne valeur possédée, retirée de cette position.
    def replace(index : usize, value : T) : T {
        if index < length {
            val previous : T = data.load(index)
            data.overwrite(index, move value)
            return move previous
        }
        delete value
        panic("Array index out of bounds\n")
    }

    private def pushAllocated(value : T) : usize {
        if length < allocated {
            data.initialize(length, move value)
            length = length + usize(1)
            return length
        }
        val next : usize = allocated * usize(2)
        if next >= allocated && this.tryResize(next) {
            data.initialize(length, move value)
            length = length + usize(1)
            return length
        }
        delete value
        panic("Array allocation failed or capacity overflow\n")
    }

    /// Ajoute une valeur.
    ///
    /// La valeur est déplacée à la fin. La capacité double lorsqu’elle est
    /// épuisée; un dépassement de capacité ou un échec d’allocation détruit
    /// `value` puis déclenche `panic`.
    /// @param value Valeur dont le tableau prend possession.
    /// @return Nouvelle taille du tableau après insertion.
    def push(value : T) : usize {
        if data != null[T]() {
            return this.pushAllocated(move value)
        }
        if this.tryResize(allocated) {
            return this.pushAllocated(move value)
        }
        delete value
        panic("Array allocation failed\n")
    }

    /// Retire et retourne le dernier élément.
    ///
    /// L’opération est constante et ne réduit pas la capacité. Déclenche `panic`
    /// lorsque le tableau est vide.
    /// @return Dernière valeur, déplacée hors du tableau.
    def pop() : T {
        if length == usize(0) {
            panic("cannot pop an empty Array\n")
        }
        length = length - usize(1)
        val value : T = data.load(length)
        return move value
    }

    /// Retire sans erreur le dernier élément s’il existe.
    ///
    /// L’opération est constante et conserve la capacité réservée.
    /// @return `Some` avec la dernière valeur possédée, ou `None` si le tableau est vide.
    def popOption() : Option[T] {
        if length == usize(0) {
            return Option.None[T]()
        }
        length = length - usize(1)
        val value : T = data.load(length)
        return Option.Some[T](move value)
    }

    /// Retire et retourne l’élément situé à l’index demandé.
    ///
    /// Les éléments suivants sont décalés d’une case, soit un coût linéaire dans
    /// leur nombre. Déclenche `panic` si `index` est hors limites.
    /// @param index Position de la valeur à retirer.
    /// @return Valeur possédée retirée du tableau.
    def remove(index : usize) : T {
        if index >= length {
            panic("Array index out of bounds\n")
        }
        val removed : T = data.load(index)
        length = length - usize(1)
        var cursor : usize = index
        while cursor < length {
            val shifted : T = data.load(cursor + usize(1))
            data.overwrite(cursor, move shifted)
            cursor = cursor + usize(1)
        }
        return move removed
    }

    /// Garantit une capacité au moins égale à `requested`.
    ///
    /// Les éléments et la taille sont préservés. La capacité n’est jamais réduite
    /// et un échec d’allocation déclenche `panic`.
    /// @param requested Capacité minimale souhaitée.
    def reserve(requested : usize) : Unit {
        if data == null[T]() {
            this.resize(allocated)
        }
        if requested > allocated {
            this.resize(requested)
        }
    }

    /// Détruit tous les éléments sans libérer la capacité réservée.
    ///
    /// L’opération est linéaire dans la taille actuelle; le tableau reste prêt à
    /// recevoir de nouvelles valeurs.
    def clear() : Unit {
        while length > usize(0) {
            length = length - usize(1)
            val value : T = data.load(length)
            delete value
        }
    }

    /// Exécute une action sur une copie de l’élément à un indice donné.
    ///
    /// Le tableau conserve son élément. Déclenche `panic` si `index` est hors
    /// limites.
    /// @param index Position de la valeur à observer.
    /// @param action Fonction appelée une fois avec une copie de la valeur.
    def withValue(index : usize, action : (T) => Unit) : Unit {
        if index >= length {
            panic("Array index out of bounds\n")
        }
        action(data.load(index))
    }

    /// Applique une action à des copies de tous les éléments, dans l’ordre.
    /// @param action Fonction appelée une fois par élément, de l’indice zéro à la fin.
    def foreach(action : (T) => Unit) : Unit {
        var index : usize = usize(0)
        while index < length {
            action(data.load(index))
            index = index + usize(1)
        }
    }

    /// Construit un tableau en transformant chaque élément dans l’ordre.
    ///
    /// La source n’est pas modifiée; `transform` reçoit une copie par élément. Le
    /// coût est linéaire et le résultat réserve initialement la taille source.
    /// @param transform Fonction produisant une valeur du résultat depuis une copie source.
    /// @return Nouveau tableau possédant toutes les valeurs transformées.
    def map[U <: Copy](transform : (T) => U) : Array[U] {
        val result : Array[U] = new Array[U](length)
        var index : usize = usize(0)
        while index < length {
            result.push(transform(data.load(index)))
            index = index + usize(1)
        }
        return result
    }

    /// Copie dans un nouveau tableau les éléments acceptés par le prédicat.
    ///
    /// La source reste inchangée. Le prédicat et la copie suivent l’ordre des
    /// indices; l’opération est linéaire.
    /// @param predicate Fonction d’acceptation appelée sur une copie de chaque élément.
    /// @return Nouveau tableau contenant les copies acceptées.
    def filter(predicate : (T) => bool) : Array[T] {
        val result : Array[T] = new Array[T](length)
        var index : usize = usize(0)
        while index < length {
            val value : T = data.load(index)
            if predicate(value) {
                result.push(value)
            }
            index = index + usize(1)
        }
        return result
    }

    /// Recherche le premier élément qui satisfait le prédicat.
    ///
    /// La recherche s’arrête au premier succès et ne modifie pas le tableau.
    /// @param predicate Fonction testée dans l’ordre des indices.
    /// @return `Some` avec une copie du premier élément trouvé, sinon `None`.
    def find(predicate : (T) => bool) : Option[T] {
        var index : usize = usize(0)
        while index < length {
            val value : T = data.load(index)
            if predicate(value) {
                return Option.Some[T](value)
            }
            index = index + usize(1)
        }
        return Option.None[T]()
    }

    /// Réduit les valeurs avec un accumulateur.
    ///
    /// Les éléments sont copiés et combinés de l’indice zéro au dernier; le
    /// tableau reste inchangé.
    /// @param initial Valeur initiale de l’accumulateur.
    /// @param combine Fonction produisant l’accumulateur suivant depuis une copie d’élément.
    /// @return Accumulateur final, ou `initial` si le tableau est vide.
    def fold[U](initial : U, combine : (U, T) => U) : U {
        var accumulator : U = initial
        var index : usize = usize(0)
        while index < length {
            accumulator = combine(move accumulator, data.load(index))
            index = index + usize(1)
        }
        return accumulator
    }

    /// Indique si au moins un élément satisfait le prédicat.
    ///
    /// L’évaluation s’arrête au premier succès.
    /// @param predicate Fonction testée dans l’ordre sur des copies des éléments.
    /// @return `true` si un élément est accepté, sinon `false`.
    def any(predicate : (T) => bool) : bool {
        var index : usize = usize(0)
        while index < length {
            if predicate(data.load(index)) {
                return true
            }
            index = index + usize(1)
        }
        return false
    }

    /// Indique si tous les éléments satisfont le prédicat.
    ///
    /// L’évaluation s’arrête au premier échec; un tableau vide rend `true`.
    /// @param predicate Fonction testée dans l’ordre sur des copies des éléments.
    /// @return `true` si aucun élément ne viole le prédicat.
    def all(predicate : (T) => bool) : bool {
        var index : usize = usize(0)
        while index < length {
            if !predicate(data.load(index)) {
                return false
            }
            index = index + usize(1)
        }
        return true
    }

    /// Compte les éléments qui satisfont le prédicat.
    /// @param predicate Fonction testée une fois sur une copie de chaque élément.
    /// @return Nombre d’éléments acceptés.
    def count(predicate : (T) => bool) : usize {
        var matches : usize = usize(0)
        var index : usize = usize(0)
        while index < length {
            if predicate(data.load(index)) {
                matches = matches + usize(1)
            }
            index = index + usize(1)
        }
        return matches
    }

    private def insertionSortRange(
    first : usize,
    last : usize,
    less : (T, T) => bool
    ) : Unit {
        var index : usize = first + usize(1)
        while index < last {
            val candidate : T = data.load(index)
            var destination : usize = index
            while destination > first &&
            less(candidate, data.load(destination - usize(1))) {
                this.set(
                destination,
                data.load(destination - usize(1))
                )
                destination = destination - usize(1)
            }
            this.set(destination, move candidate)
            index = index + usize(1)
        }
    }

    private def mergeRange(
    buffer : Array[T],
    first : usize,
    middle : usize,
    last : usize,
    less : (T, T) => bool
    ) : Unit {
        var left : usize = first
        var right : usize = middle
        var output : usize = first
        while left < middle && right < last {
            if less(data.load(right), data.load(left)) {
                buffer.set(output, data.load(right))
                right = right + usize(1)
            } else {
                buffer.set(output, data.load(left))
                left = left + usize(1)
            }
            output = output + usize(1)
        }
        while left < middle {
            buffer.set(output, data.load(left))
            left = left + usize(1)
            output = output + usize(1)
        }
        while right < last {
            buffer.set(output, data.load(right))
            right = right + usize(1)
            output = output + usize(1)
        }
    }

    /// Trie le tableau sur place selon un ordre total strict et conserve la stabilité.
    ///
    /// `less(left, right)` doit définir de façon cohérente si `left` précède
    /// strictement `right`. Deux valeurs sont équivalentes lorsque le comparateur renvoie
    /// `false` dans les deux sens; leur ordre d’origine est alors préservé.
    /// L’algorithme hybride trie de petits segments par insertion puis les
    /// fusionne. Son coût est `O(n log n)` dans le pire cas, `O(n)` en mémoire
    /// auxiliaire, et le tableau vide ou singleton est laissé inchangé. Cette
    /// méthode observe et duplique temporairement les éléments et exige donc que
    /// `T` satisfasse `Copy`.
    /// @param less Comparateur strict cohérent avec un ordre total.
    def sortWith(less : (T, T) => bool) : Unit {
        if length < usize(2) {
            return
        }

        val insertionRun : usize = usize(16)
        var first : usize = usize(0)
        while first < length {
            var last : usize = first + insertionRun
            if last < first || last > length {
                last = length
            }
            this.insertionSortRange(first, last, less)
            first = last
        }

        val buffer : Array[T] = new Array[T](length)
        defer delete buffer
        var index : usize = usize(0)
        while index < length {
            buffer.push(data.load(index))
            index = index + usize(1)
        }

        var width : usize = insertionRun
        while width < length {
            first = usize(0)
            while first < length {
                var middle : usize = first + width
                if middle < first || middle > length {
                    middle = length
                }
                var last : usize = middle + width
                if last < middle || last > length {
                    last = length
                }
                this.mergeRange(buffer, first, middle, last, less)
                first = last
            }
            index = usize(0)
            while index < length {
                this.set(index, buffer.data.load(index))
                index = index + usize(1)
            }
            if width > length / usize(2) {
                width = length
            } else {
                width = width * usize(2)
            }
        }
    }

    destructor {
        this.clear()
        freeStorage(data)
    }
}
