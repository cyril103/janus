/// Fournit un tableau dynamique propriétaire et ses opérations séquentielles.
///
/// [[Array]] conserve les valeurs dans une zone contiguë, agrandit sa capacité
/// selon les besoins et détruit les éléments encore stockés avec le tableau. Les
/// accès sont constants; une suppression au milieu et les transformations
/// complètes sont linéaires.
/// @example
/// ```janus
/// val values : Array[int] = new Array(2)
/// values.push(10)
/// values.push(20)
/// val doubled : Array[int] = values.map[int]((value : int) => value * 2)
/// ```
module std.array
import std.option
import std.iterator
import std.ordering
import std.error
import std.result

private class ArrayIteratorState[T <: Copy](
private borrow val source : Array[T],
private var index : usize
) {
    def next() : Option[T] {
        if index >= source.size() {
            return Option.None[T]()
        }
        val value : Option[T] = source.getOption(index)
        index = index + usize(1)
        return value
    }

    def dispose() : Unit {
        delete this
    }
}

private class ArrayIntoIteratorState[T](
private val source : Array[T],
private var index : usize
) {
    def next() : Option[T] {
        if index >= source.size() {
            return Option.None[T]()
        }
        val current : usize = index
        index = index + usize(1)
        return Option.Some[T](
        source.takeForConsumingIterator(current)
        )
    }

    def dispose() : Unit {
        delete this
    }

    destructor {
        source.releaseConsumingIteratorFrom(index)
        delete source
    }
}

private def checkedArrayCapacity[T](count : usize) : usize {
    if count > usize(-1) / sizeof[T]() {
        panic("Array capacity overflow\n")
    }
    return count
}

/// Tableau dynamique contigu qui possède ses éléments.
///
/// `initialCapacity` réserve de la mémoire sans créer d’élément. Les insertions
/// déplacent les valeurs dans le tableau; le remplacement, l’effacement et la
/// destruction appellent `delete` sur les valeurs abandonnées. Les parcours
/// observants exigent `T <: Copy`, tandis que [[Array.intoIterator]] consomme le
/// tableau et peut transférer des valeurs non copiables.
/// @param initialCapacity Nombre initial d’emplacements réservés.
class Array[T](initialCapacity : usize) extends Iterable[T], IntoIterable[T] {
    private var data : Ptr[T] = alloc[T](initialCapacity)
    private var length : usize = usize(0)
    private var allocated : usize = initialCapacity

    private def tryResize(requested : usize) : bool {
        var next : usize = requested
        if next == usize(0) {
            next = usize(1)
        }

        val resized : Ptr[T] = reallocPreserving[T](data, next)
        if resized == null[T]() {
            freeStorage(resized)
            return false
        }

        data = adoptReallocation[T](data, resized)
        allocated = next
        return true
    }

    private def resize(requested : usize) : Unit {
        if !this.tryResize(requested) {
            panic("Array allocation failed\n")
        }
    }

    /// Retourne le nombre d’éléments stockés.
    /// @return Nombre de valeurs initialisées, distinct de la capacité.
    pure borrow def size() : usize {
        return length
    }

    /// Retourne la capacité actuellement réservée.
    /// @return Nombre d’éléments pouvant être stockés sans nouvelle allocation.
    pure borrow def capacity() : usize {
        return allocated
    }

    /// Indique si le tableau est vide.
    /// @return `true` lorsque [[Array.size]] vaut zéro.
    pure borrow def isEmpty() : bool {
        return length == usize(0)
    }

    /// Crée un parcours observant les éléments dans l’ordre des indices.
    ///
    /// Cette méthode ne consomme pas le tableau et chaque valeur produite est une
    /// copie; elle n’est disponible que lorsque `T` satisfait `Copy`. Le tableau
    /// doit rester vivant pendant le parcours.
    /// @return Un nouvel [[Iterator]] positionné avant l’indice zéro.
    borrow def iterator() : Iterator[T] where T <: Copy {
        val state : ArrayIteratorState[T] =
        new ArrayIteratorState[T](this, usize(0))
        return new Iterator[T](
        () => state.next(),
        owningCapture[ArrayIteratorState[T]](
        state, () => state.dispose()
        )
        )
    }

    /// Consomme le tableau et transfère ses éléments à un itérateur.
    ///
    /// Chaque appel à `next` déplace la valeur suivante sans la copier. Détruire
    /// prématurément l’itérateur détruit tous les éléments non encore produits,
    /// puis libère le tableau source.
    /// @return Un [[Iterator]] propriétaire parcourant les valeurs par indice croissant.
    consume def intoIterator() : Iterator[T] {
        val state : ArrayIntoIteratorState[T] =
        new ArrayIntoIteratorState[T](move this, usize(0))
        return new Iterator[T](
        () => state.next(),
        owningCapture[ArrayIntoIteratorState[T]](
        state, () => state.dispose()
        )
        )
    }

    internal def takeForConsumingIterator(index : usize) : T {
        val value : T = data.load(index)
        return move value
    }

    internal def releaseConsumingIteratorFrom(first : usize) : Unit {
        var cursor : usize = length
        while cursor > first {
            cursor = cursor - usize(1)
            val value : T = data.load(cursor)
            delete value
        }
        length = usize(0)
    }

    /// Retourne l’élément situé à l’index demandé.
    ///
    /// L’accès est en temps constant et produit une copie de la valeur stockée.
    /// Déclenche `panic` si `index` est hors limites.
    /// @param index Position de l’élément, à partir de zéro.
    /// @return Copie de l’élément à cette position.
    borrow def get(index : usize) : T where T <: Copy {
        if index >= length {
            panic("Array index out of bounds\n")
        }
        return data.load(index)
    }

    /// Retourne un emprunt partagé sur l'élément demandé.
    ///
    /// L'emprunt reste lié au tableau : celui-ci ne peut pas être modifié,
    /// déplacé ou détruit tant que l'alias est vivant. Cette opération ne
    /// requiert pas `Copy` et déclenche `panic` si l'indice est hors limites.
    /// @param index Position de l'élément, à partir de zéro.
    /// @return Emprunt partagé sur la valeur stockée.
    borrow def getBorrowed(index : usize) : borrow T {
        if index >= length {
            panic("Array index out of bounds\n")
        }
        return data.load(index)
    }

    /// Retourne un emprunt mutable exclusif sur l'élément demandé.
    ///
    /// Tant que l'emprunt est vivant, le tableau ne peut pas être consulté,
    /// redimensionné, déplacé ou détruit. Cette opération ne requiert pas
    /// `Copy` et déclenche `panic` si l'indice est hors limites.
    /// @param index Position de l'élément, à partir de zéro.
    /// @return Emprunt mutable sur la valeur stockée.
    def getMutable(index : usize) : borrow var T {
        if index >= length {
            panic("Array index out of bounds\n")
        }
        return data.load(index)
    }

    /// Retourne l’élément demandé, ou `None` si l’index est hors limites.
    /// @param index Position recherchée, à partir de zéro.
    /// @return `Some` avec une copie de l’élément, ou `None` si `index >= size()`.
    borrow def getOption(index : usize) : Option[T] where T <: Copy {
        return if index < length {
            Option.Some[T](data.load(index))
        } else {
            Option.None[T]()
        }
    }

    /// Remplace l’élément situé à l’index demandé.
    ///
    /// La nouvelle valeur est déplacée dans le tableau et l’ancienne est
    /// détruite. Si l’indice est invalide, `value` est détruite avant `panic`.
    /// @param index Position existante à modifier.
    /// @param value Nouvelle valeur dont la propriété est transférée au tableau.
    def set(index : usize, value : T) : Unit {
        if index < length {
            val previous : T = data.load(index)
            data.overwrite(index, move value)
            delete previous
            return
        }
        delete value
        panic("Array index out of bounds\n")
    }

    /// Remplace un élément et transfère l’ancienne valeur à l’appelant.
    ///
    /// L’opération est constante. Si l’indice est invalide, la nouvelle `value`
    /// est détruite puis l’exécution s’arrête par `panic`.
    /// @param index Position existante à modifier.
    /// @param value Nouvelle valeur déplacée dans le tableau.
    /// @return Ancienne valeur possédée, retirée de cette position.
    def replace(index : usize, value : T) : T {
        if index < length {
            val previous : T = data.load(index)
            data.overwrite(index, move value)
            return move previous
        }
        delete value
        panic("Array index out of bounds\n")
    }

    /// Échange deux éléments sans les copier ni les détruire.
    ///
    /// L'opération est constante et convient aux valeurs propriétaires. Elle
    /// déclenche `panic` si l'un des indices est hors limites.
    /// @param left Premier emplacement existant.
    /// @param right Second emplacement existant.
    def swap(left : usize, right : usize) : Unit {
        if left >= length || right >= length {
            panic("Array index out of bounds\n")
        }
        if left == right {
            return
        }
        val leftValue : T = data.load(left)
        val rightValue : T = data.load(right)
        data.overwrite(left, move rightValue)
        data.overwrite(right, move leftValue)
    }

    private def pushAllocated(value : T) : usize {
        if length < allocated {
            data.initialize(length, move value)
            length = length + usize(1)
            return length
        }
        val next : usize = allocated * usize(2)
        if next >= allocated && this.tryResize(next) {
            data.initialize(length, move value)
            length = length + usize(1)
            return length
        }
        delete value
        panic("Array allocation failed or capacity overflow\n")
    }

    /// Ajoute une valeur.
    ///
    /// La valeur est déplacée à la fin. La capacité double lorsqu’elle est
    /// épuisée; un dépassement de capacité ou un échec d’allocation détruit
    /// `value` puis déclenche `panic`.
    /// @param value Valeur dont le tableau prend possession.
    /// @return Nouvelle taille du tableau après insertion.
    def push(value : T) : usize {
        if data != null[T]() {
            return this.pushAllocated(move value)
        }
        if this.tryResize(allocated) {
            return this.pushAllocated(move value)
        }
        delete value
        panic("Array allocation failed\n")
    }

    /// Retire et retourne le dernier élément.
    ///
    /// L’opération est constante et ne réduit pas la capacité. Déclenche `panic`
    /// lorsque le tableau est vide.
    /// @return Dernière valeur, déplacée hors du tableau.
    def pop() : T {
        if length == usize(0) {
            panic("cannot pop an empty Array\n")
        }
        length = length - usize(1)
        val value : T = data.load(length)
        return move value
    }

    /// Retire sans erreur le dernier élément s’il existe.
    ///
    /// L’opération est constante et conserve la capacité réservée.
    /// @return `Some` avec la dernière valeur possédée, ou `None` si le tableau est vide.
    def popOption() : Option[T] {
        if length == usize(0) {
            return Option.None[T]()
        }
        length = length - usize(1)
        val value : T = data.load(length)
        return Option.Some[T](move value)
    }

    /// Retire le dernier élément avec une erreur commune si le tableau est vide.
    /// @return `Ok` avec la valeur possédée, ou `Error(AccessError.Empty)`.
    def tryPop() : Result[T, AccessError] {
        if length == usize(0) {
            return Result.Error[T, AccessError](AccessError.Empty)
        }
        return Result.Ok[T, AccessError](this.pop())
    }

    /// Retire et retourne l’élément situé à l’index demandé.
    ///
    /// Les éléments suivants sont décalés d’une case, soit un coût linéaire dans
    /// leur nombre. Déclenche `panic` si `index` est hors limites.
    /// @param index Position de la valeur à retirer.
    /// @return Valeur possédée retirée du tableau.
    def remove(index : usize) : T {
        if index >= length {
            panic("Array index out of bounds\n")
        }
        val removed : T = data.load(index)
        length = length - usize(1)
        var cursor : usize = index
        while cursor < length {
            val shifted : T = data.load(cursor + usize(1))
            data.overwrite(cursor, move shifted)
            cursor = cursor + usize(1)
        }
        return move removed
    }

    /// Garantit une capacité au moins égale à `requested`.
    ///
    /// Les éléments et la taille sont préservés. La capacité n’est jamais réduite
    /// et un échec d’allocation déclenche `panic`.
    /// @param requested Capacité minimale souhaitée.
    def reserve(requested : usize) : Unit {
        if data == null[T]() {
            this.resize(allocated)
        }
        if requested > allocated {
            this.resize(requested)
        }
    }

    /// Tente de réserver une capacité sans déclencher de panique d'allocation.
    /// @param requested Capacité minimale souhaitée.
    /// @return `Ok(true)` après croissance, `Ok(false)` si elle était suffisante, ou une [[CapacityError]].
    def tryReserve(requested : usize) : Result[bool, CapacityError] {
        if requested > usize(-1) / sizeof[T]() {
            return Result.Error[bool, CapacityError](
            CapacityError.CapacityOverflow
            )
        }
        if data == null[T]() {
            if !this.tryResize(allocated) {
                return Result.Error[bool, CapacityError](
                CapacityError.AllocationFailed
                )
            }
        }
        if requested <= allocated {
            return Result.Ok[bool, CapacityError](false)
        }
        if !this.tryResize(requested) {
            return Result.Error[bool, CapacityError](
            CapacityError.AllocationFailed
            )
        }
        return Result.Ok[bool, CapacityError](true)
    }

    /// Détruit tous les éléments sans libérer la capacité réservée.
    ///
    /// L’opération est linéaire dans la taille actuelle; le tableau reste prêt à
    /// recevoir de nouvelles valeurs.
    def clear() : Unit {
        while length > usize(0) {
            length = length - usize(1)
            val value : T = data.load(length)
            delete value
        }
    }

    private borrow def keepAt(
    index : usize,
    scoped borrow predicate : (borrow T) => bool
    ) : bool {
        return predicate(data.load(index))
    }

    /// Conserve uniquement les éléments qui satisfont le prédicat.
    ///
    /// Les éléments refusés sont détruits immédiatement et l'ordre relatif des
    /// éléments conservés reste inchangé.
    /// @param predicate Callback borné observant chaque élément une fois.
    /// @return Nombre d'éléments conservés.
    def retain(scoped predicate : (borrow T) => bool) : usize {
        defer delete predicate
        var index : usize = usize(0)
        while index < length {
            if this.keepAt(index, predicate) {
                index = index + usize(1)
            } else {
                val removed : T = this.remove(index)
                delete removed
            }
        }
        return length
    }

    /// Ajoute toutes les valeurs d'un parcours consommé.
    /// @param source Itérateur dont chaque valeur est transférée au tableau.
    /// @return Nouvelle taille du tableau.
    def extend(source : Iterator[T]) : usize {
        for value in move source {
            this.push(move value)
        }
        return length
    }

    /// Consomme le tableau et transfère ses éléments dans l'ordre des indices.
    /// @return Itérateur propriétaire équivalent à [[Array.intoIterator]].
    consume def drain() : Iterator[T] {
        return this.intoIterator()
    }

    /// Exécute une action sur un emprunt partagé de l’élément demandé.
    ///
    /// Le tableau conserve son élément. Déclenche `panic` si `index` est hors
    /// limites.
    /// @param index Position de la valeur à observer.
    /// @param action Fonction appelée une fois avec un emprunt sur la valeur.
    borrow def withValue(
    index : usize,
    scoped action : (borrow T) => Unit
    ) : Unit {
        defer delete action
        if index >= length {
            panic("Array index out of bounds\n")
        }
        action(data.load(index))
    }

    /// Exécute une action sur un emprunt mutable exclusif de l’élément.
    ///
    /// La modification porte directement sur le stockage du tableau. L'action
    /// est bornée à l'appel et ne peut ni conserver ni transférer l'emprunt.
    /// Déclenche `panic` si `index` est hors limites.
    /// @param index Position de la valeur à modifier.
    /// @param action Fonction synchrone recevant l'emprunt mutable.
    def withMutable(
    index : usize,
    scoped action : (borrow var T) => Unit
    ) : Unit {
        defer delete action
        if index >= length {
            panic("Array index out of bounds\n")
        }
        action(data.load(index))
    }

    /// Transforme contextuellement deux éléments sans les extraire.
    ///
    /// `transform` observe les deux valeurs pendant l'appel uniquement. Le
    /// tableau conserve leur propriété, y compris lorsque `T` n'est pas
    /// copiable. Les deux indices peuvent être identiques. Déclenche `panic`
    /// si l'un d'eux est hors limites.
    /// @param left Premier emplacement observé.
    /// @param right Second emplacement observé.
    /// @param transform Fonction produisant le résultat depuis les deux observations.
    /// @return Résultat produit par `transform`.
    borrow def withValues[U](
    left : usize,
    right : usize,
    scoped transform : (borrow T, borrow T) => U
    ) : U {
        defer delete transform
        if left >= length || right >= length {
            panic("Array index out of bounds\n")
        }
        return transform(data.load(left), data.load(right))
    }

    /// Applique une action empruntée à tous les éléments, dans l’ordre.
    /// @param action Fonction observant chaque élément sans en prendre possession.
    borrow def foreach(scoped action : (borrow T) => Unit) : Unit {
        defer delete action
        var index : usize = usize(0)
        while index < length {
            action(data.load(index))
            index = index + usize(1)
        }
    }

    /// Construit un tableau en transformant chaque élément dans l’ordre.
    ///
    /// La source n’est pas modifiée; `transform` reçoit un emprunt par élément.
    /// Le coût est linéaire et le résultat réserve initialement la taille source.
    /// @param transform Fonction produisant une valeur depuis une observation source.
    /// @return Nouveau tableau possédant toutes les valeurs transformées.
    borrow def map[U](scoped transform : (borrow T) => U) : Array[U] {
        defer delete transform
        val result : Array[U] = new Array[U](length)
        var index : usize = usize(0)
        while index < length {
            result.push(transform(data.load(index)))
            index = index + usize(1)
        }
        return move result
    }

    /// Copie dans un nouveau tableau les éléments acceptés par le prédicat.
    ///
    /// La source reste inchangée. Le prédicat et la copie suivent l’ordre des
    /// indices; l’opération est linéaire.
    /// @param predicate Fonction d’acceptation observant chaque élément.
    /// @return Nouveau tableau contenant les copies acceptées.
    borrow def filter(
    scoped predicate : (borrow T) => bool
    ) : Array[T] where T <: Copy {
        defer delete predicate
        val result : Array[T] = new Array[T](length)
        var index : usize = usize(0)
        while index < length {
            val value : T = data.load(index)
            if predicate(value) {
                result.push(value)
            }
            index = index + usize(1)
        }
        return move result
    }

    /// Recherche le premier élément qui satisfait le prédicat.
    ///
    /// La recherche s’arrête au premier succès et ne modifie pas le tableau.
    /// @param predicate Fonction testée dans l’ordre des indices.
    /// @return `Some` avec une copie du premier élément trouvé, sinon `None`.
    borrow def find(
    scoped predicate : (borrow T) => bool
    ) : Option[T] where T <: Copy {
        defer delete predicate
        var index : usize = usize(0)
        while index < length {
            val value : T = data.load(index)
            if predicate(value) {
                return Option.Some[T](value)
            }
            index = index + usize(1)
        }
        return Option.None[T]()
    }

    /// Réduit les valeurs avec un accumulateur.
    ///
    /// Les éléments sont empruntés et combinés de l’indice zéro au dernier; le
    /// tableau reste inchangé.
    /// @param initial Valeur initiale de l’accumulateur.
    /// @param combine Fonction consommant l'accumulateur et observant l'élément.
    /// @return Accumulateur final, ou `initial` si le tableau est vide.
    borrow def fold[U](
    initial : U,
    scoped combine : (U, borrow T) => U
    ) : U {
        defer delete combine
        var accumulator : U = move initial
        var index : usize = usize(0)
        while index < length {
            accumulator = combine(move accumulator, data.load(index))
            index = index + usize(1)
        }
        return move accumulator
    }

    /// Indique si au moins un élément satisfait le prédicat.
    ///
    /// L’évaluation s’arrête au premier succès.
    /// @param predicate Fonction observant les éléments dans l’ordre.
    /// @return `true` si un élément est accepté, sinon `false`.
    borrow def any(scoped predicate : (borrow T) => bool) : bool {
        defer delete predicate
        var index : usize = usize(0)
        while index < length {
            if predicate(data.load(index)) {
                return true
            }
            index = index + usize(1)
        }
        return false
    }

    /// Indique si tous les éléments satisfont le prédicat.
    ///
    /// L’évaluation s’arrête au premier échec; un tableau vide rend `true`.
    /// @param predicate Fonction observant les éléments dans l’ordre.
    /// @return `true` si aucun élément ne viole le prédicat.
    borrow def all(scoped predicate : (borrow T) => bool) : bool {
        defer delete predicate
        var index : usize = usize(0)
        while index < length {
            if !predicate(data.load(index)) {
                return false
            }
            index = index + usize(1)
        }
        return true
    }

    /// Compte les éléments qui satisfont le prédicat.
    /// @param predicate Fonction observant chaque élément une fois.
    /// @return Nombre d’éléments acceptés.
    borrow def count(scoped predicate : (borrow T) => bool) : usize {
        defer delete predicate
        var matches : usize = usize(0)
        var index : usize = usize(0)
        while index < length {
            if predicate(data.load(index)) {
                matches = matches + usize(1)
            }
            index = index + usize(1)
        }
        return matches
    }

    private def insertionSortRange(
    first : usize,
    last : usize,
    scoped borrow less : (borrow T, borrow T) => bool
    ) : Unit where T <: Copy {
        var index : usize = first + usize(1)
        while index < last {
            val candidate : T = data.load(index)
            var destination : usize = index
            while destination > first &&
            less(candidate, data.load(destination - usize(1))) {
                this.set(
                destination,
                data.load(destination - usize(1))
                )
                destination = destination - usize(1)
            }
            this.set(destination, move candidate)
            index = index + usize(1)
        }
    }

    private def mergeRange(
    borrow var buffer : Array[T],
    first : usize,
    middle : usize,
    last : usize,
    scoped borrow less : (borrow T, borrow T) => bool
    ) : Unit where T <: Copy {
        var left : usize = first
        var right : usize = middle
        var output : usize = first
        while left < middle && right < last {
            if less(data.load(right), data.load(left)) {
                buffer.set(output, data.load(right))
                right = right + usize(1)
            } else {
                buffer.set(output, data.load(left))
                left = left + usize(1)
            }
            output = output + usize(1)
        }
        while left < middle {
            buffer.set(output, data.load(left))
            left = left + usize(1)
            output = output + usize(1)
        }
        while right < last {
            buffer.set(output, data.load(right))
            right = right + usize(1)
            output = output + usize(1)
        }
    }

    /// Trie le tableau sur place selon un ordre total strict et conserve la stabilité.
    ///
    /// `less(left, right)` doit définir de façon cohérente si `left` précède
    /// strictement `right`. Deux valeurs sont équivalentes lorsque le comparateur renvoie
    /// `false` dans les deux sens; leur ordre d’origine est alors préservé.
    /// L’algorithme hybride trie de petits segments par insertion puis les
    /// fusionne. Son coût est `O(n log n)` dans le pire cas, `O(n)` en mémoire
    /// auxiliaire, et le tableau vide ou singleton est laissé inchangé. Cette
    /// méthode observe et duplique temporairement les éléments et exige donc que
    /// `T` satisfasse `Copy`.
    /// @param less Comparateur strict cohérent avec un ordre total.
    def sortWith(
    scoped less : (borrow T, borrow T) => bool
    ) : Unit where T <: Copy {
        defer delete less
        if length < usize(2) {
            return
        }

        val insertionRun : usize = usize(16)
        var first : usize = usize(0)
        while first < length {
            var last : usize = first + insertionRun
            if last < first || last > length {
                last = length
            }
            this.insertionSortRange(first, last, less)
            first = last
        }

        val buffer : Array[T] = new Array[T](length)
        defer delete buffer
        var index : usize = usize(0)
        while index < length {
            buffer.push(data.load(index))
            index = index + usize(1)
        }

        var width : usize = insertionRun
        while width < length {
            first = usize(0)
            while first < length {
                var middle : usize = first + width
                if middle < first || middle > length {
                    middle = length
                }
                var last : usize = middle + width
                if last < middle || last > length {
                    last = length
                }
                this.mergeRange(buffer, first, middle, last, less)
                first = last
            }
            index = usize(0)
            while index < length {
                this.set(index, buffer.data.load(index))
                index = index + usize(1)
            }
            if width > length / usize(2) {
                width = length
            } else {
                width = width * usize(2)
            }
        }
    }

    /// Trie le tableau avec une stratégie d'ordre total réutilisable.
    /// @param ordering Comparateur trichotomique observé pendant le tri.
    def sortBy[O <: Ordering[T]](
    borrow ordering : O
    ) : Unit where T <: Copy {
        var index : usize = usize(1)
        while index < length {
            val candidate : T = data.load(index)
            var destination : usize = index
            while destination > usize(0) &&
            orderedBefore[T, O](
            ordering,
            candidate,
            data.load(destination - usize(1))
            ) {
                data.overwrite(
                destination,
                data.load(destination - usize(1))
                )
                destination = destination - usize(1)
            }
            data.overwrite(destination, candidate)
            index = index + usize(1)
        }
    }

    destructor {
        this.clear()
        freeStorage(data)
    }
}

private class ArrayFactoryState[T](private var result : Array[T]) {
    def push(value : T) : Unit {
        result.push(move value)
    }

    def finish() : Array[T] {
        val completed : Array[T] = move result
        result = new Array[T](usize(0))
        return move completed
    }

    destructor {
        delete result
    }
}

/// Construit un tableau contenant `count` copies de `value`.
///
/// `T` doit satisfaire `Copy` afin que chaque emplacement possède une copie
/// indépendante. Le tableau réserve `count` emplacements puis les initialise
/// dans l’ordre; sa taille logique finale vaut `count`. Le coût temporel est
/// `O(count)` et l’espace utilisé est celui du tableau retourné. Un échec
/// d’allocation déclenche le même `panic` que [[Array.push]]; le préfixe déjà
/// construit est alors détruit.
/// @param count Nombre d’éléments à construire; zéro produit un tableau vide valide.
/// @param value Valeur copiée dans chaque emplacement.
/// @return Nouveau tableau propriétaire de taille `count`.
/// @example
/// ```janus
/// val bytes : Array[byte] =
/// filledArray[byte](4, byte(0))
/// defer delete bytes
/// ```
def filledArray[T <: Copy](count : usize, value : T) : Array[T] {
    val state : ArrayFactoryState[T] =
    new ArrayFactoryState[T](new Array[T](checkedArrayCapacity[T](count)))
    defer delete state
    var index : usize = usize(0)
    while index < count {
        state.push(value)
        index = index + usize(1)
    }
    return state.finish()
}

/// Construit un tableau en appelant `factory` une fois par index croissant.
///
/// Les appels couvrent exactement `[0, count)`, dans l’ordre. Chaque résultat
/// est déplacé dans le tableau, ce qui autorise les types non `Copy` sans
/// duplication implicite. Le coût temporel est `O(count)` et l’espace utilisé
/// est celui du tableau retourné. Un `panic` de `factory` est propagé après
/// destruction du préfixe déjà construit. Hors `panic`, la propriété de chaque
/// résultat est transférée exactement une fois au tableau retourné.
/// @param count Nombre d’éléments à produire; zéro n’appelle pas `factory`.
/// @param factory Fonction appelée exactement une fois avec chaque index croissant.
/// @return Nouveau tableau propriétaire de taille `count`.
/// @example
/// ```janus
/// val squares : Array[int] = generateArray[int](
/// 4,
/// (index : usize) => int(index * index)
/// )
/// defer delete squares
/// ```
def generateArray[T](count : usize, scoped factory : (usize) => T) : Array[T] {
    defer delete factory
    val state : ArrayFactoryState[T] =
    new ArrayFactoryState[T](new Array[T](checkedArrayCapacity[T](count)))
    defer delete state
    var index : usize = usize(0)
    while index < count {
        state.push(factory(index))
        index = index + usize(1)
    }
    return state.finish()
}
