/// Modélise une valeur présente avec [[Option.Some]] ou absente avec [[Option.None]].
///
/// Les combinateurs consomment leur option et transfèrent la propriété de la branche conservée.
/// @example
/// ```janus
/// val item : Option[int] = Option.Some[int](42)
/// val value : int = unwrapOr[int](move item, 0)
/// ```
module std.option

/// Énumère les valeurs de [[Option]] reconnues par le backend ou l’algorithme.
enum Option[T] {
    /// Variante `Some`, correspondant à cette valeur précise.
    Some(T),
    /// Variante `None`, correspondant à cette valeur précise.
    None
}

private class OptionFallback[T](private var value : T) {
    private var available : bool = true

    def discardAndReturn[U](result : U) : U {
        val discarded : T = move value
        available = false
        delete discarded
        return move result
    }

    def take() : T {
        available = false
        return move value
    }

    destructor {
        if available {
            delete value
        }
    }
}

/// Indique si l’option contient une valeur.
///
/// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[bool]].
def isSome[T](value : Option[T]) : bool {
    return match value {
        Some(item) => true,
        None => false
    }
}

/// Indique si l’option est vide.
///
/// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[bool]].
def isNone[T](value : Option[T]) : bool {
    return match value {
        Some(item) => false,
        None => true
    }
}

/// Transforme la valeur ou la séquence avec la fonction fournie.
///
/// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param transform Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[OptionU]].
def map[T, U](
value : Option[T],
transform : (T) => U
) : Option[U] {
    defer delete transform
    return match move value {
        Some(item) => Option.Some[U](transform(move item)),
        None => Option.None[U]()
    }
}

/// Fournit la sémantique de [[andThen]].
///
/// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param transform Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[OptionU]].
def andThen[T, U](
value : Option[T],
transform : (T) => Option[U]
) : Option[U] {
    defer delete transform
    return match move value {
        Some(item) => transform(move item),
        None => Option.None[U]()
    }
}

/// Fournit la sémantique de [[orElse]].
///
/// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param fallback Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[OptionT]].
def orElse[T](
value : Option[T],
fallback : Option[T]
) : Option[T] {
    val state : OptionFallback[Option[T]] =
    new OptionFallback[Option[T]](move fallback)
    defer delete state
    return match move value {
        Some(item) => state.discardAndReturn[Option[T]](
        Option.Some[T](move item)
        ),
        None => state.take()
    }
}

/// Fournit la sémantique de [[unwrapOr]].
///
/// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param fallback Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[T]].
def unwrapOr[T](value : Option[T], fallback : T) : T {
    val state : OptionFallback[T] =
    new OptionFallback[T](move fallback)
    defer delete state
    return match move value {
        Some(item) => state.discardAndReturn[T](move item),
        None => state.take()
    }
}
