/// Modélise une valeur présente avec [[Option.Some]] ou absente avec [[Option.None]].
///
/// Les combinateurs consomment leur option et transfèrent la propriété de la branche conservée.
/// @example
/// ```janus
/// val item : Option[int] = Option.Some[int](42)
/// val value : int = unwrapOr[int](move item, 0)
/// ```
module std.option

/// Représente soit une valeur propriétaire, soit son absence.
enum Option[T] {
    /// Contient une valeur de type `T`.
    Some(T),
    /// Ne contient aucune valeur.
    None
}

private class OptionFallback[T](private var value : Option[T]) {
    private def takeOption() : Option[T] {
        val previous : Option[T] = move value
        value = Option.None[T]()
        return move previous
    }

    def discardAndReturn[U](result : U) : U {
        val discarded : Option[T] = this.takeOption()
        delete discarded
        return move result
    }

    def take() : T {
        val previous : Option[T] = this.takeOption()
        return match move previous {
            Some(item) => move item,
            None => this.take()
        }
    }

    destructor {
        delete value
    }
}

/// Indique si l’option contient une valeur.
///
/// @param value Option inspectée sans déplacer son contenu.
/// @return `true` pour `Some`, `false` pour `None`.
def isSome[T](borrow value : Option[T]) : bool {
    return match value {
        Some(item) => true,
        None => false
    }
}

/// Indique si l’option est vide.
///
/// @param value Option inspectée sans déplacer son contenu.
/// @return `true` pour `None`, `false` pour `Some`.
def isNone[T](borrow value : Option[T]) : bool {
    return match value {
        Some(item) => false,
        None => true
    }
}

/// Transforme une valeur présente en l'observant sans consommer l'option.
///
/// La closure est appelée au plus une fois et détruite avant le retour. La
/// valeur contenue reste la propriété de `value`, y compris pour un type non
/// `Copy`.
/// @param value Option observée sans déplacement de sa variante active.
/// @param transform Fonction bornée recevant un emprunt du contenu de `Some`.
/// @return `Some` du résultat produit, ou `None` sans appeler `transform`.
def mapBorrowed[T, U](
    borrow value : Option[T],
    scoped transform : (borrow T) => U
) : Option[U] {
    defer delete transform
    return match value {
        Some(item) => Option.Some[U](transform(item)),
        None => Option.None[U]()
    }
}

/// Consomme l’option et transforme son contenu lorsqu’il existe.
///
/// @param value Option consommée par l’opération.
/// @param transform Fonction propriétaire appelée une fois avec la valeur déplacée pour `Some`, puis détruite.
/// @return `Some` du résultat de `transform`, ou `None` sans appeler `transform`.
def map[T, U](
    value : Option[T],
    scoped transform : (T) => U
) : Option[U] {
    defer delete transform
    return match move value {
        Some(item) => Option.Some[U](transform(move item)),
        None => Option.None[U]()
    }
}

/// Enchaîne une opération optionnelle sur la branche présente.
///
/// @param value Option consommée par l’opération.
/// @param transform Fonction propriétaire appelée une fois avec le contenu déplacé pour `Some`, puis détruite.
/// @return Résultat de `transform` pour `Some`, ou `None` sans appeler `transform`.
def andThen[T, U](
    value : Option[T],
    scoped transform : (T) => Option[U]
) : Option[U] {
    defer delete transform
    return match move value {
        Some(item) => transform(move item),
        None => Option.None[U]()
    }
}

/// Conserve la première valeur présente entre deux options consommées.
///
/// @param value Option prioritaire, consommée.
/// @param fallback Option consommée et détruite si `value` est `Some`, sinon retournée.
/// @return `value` lorsqu’elle est présente, sinon `fallback`.
def orElse[T](
    value : Option[T],
    fallback : Option[T]
) : Option[T] {
    val state : OptionFallback[Option[T]] =
    new OptionFallback[Option[T]](
        Option.Some[Option[T]](move fallback)
    )
    defer delete state
    return match move value {
        Some(item) => state.discardAndReturn[Option[T]](
            Option.Some[T](move item)
        ),
        None => state.take()
    }
}

/// Extrait le contenu présent ou adopte une valeur de remplacement.
///
/// @param value Option consommée.
/// @param fallback Valeur consommée et détruite pour `Some`, retournée pour `None`.
/// @return Contenu déplacé de `Some`, sinon `fallback`.
def unwrapOr[T](value : Option[T], fallback : T) : T {
    val state : OptionFallback[T] =
    new OptionFallback[T](Option.Some[T](move fallback))
    defer delete state
    return match move value {
        Some(item) => state.discardAndReturn[T](move item),
        None => state.take()
    }
}

/// Surface de méthodes statiques pour composer les options avec `.`.
extend[T] Option[T] {
    /// Indique si cette option contient une valeur.
    /// @return `true` pour `Some`, sinon `false`.
    borrow def isSome() : bool {
        return isSome[T](this)
    }

    /// Indique si cette option est vide.
    /// @return `true` pour `None`, sinon `false`.
    borrow def isNone() : bool {
        return isNone[T](this)
    }

    /// Transforme le contenu en l'observant sans consommer l'option.
    /// @param transform Fonction bornée recevant un emprunt du contenu.
    /// @return Option contenant le résultat transformé, ou `None`.
    borrow def mapBorrowed[U](
        scoped transform : (borrow T) => U
    ) : Option[U] {
        return mapBorrowed[T, U](this, move transform)
    }

    /// Consomme cette option et transforme son contenu présent.
    /// @param transform Fonction bornée recevant le contenu déplacé.
    /// @return Option contenant le résultat transformé, ou `None`.
    consume def map[U](scoped transform : (T) => U) : Option[U] {
        return map[T, U](move this, move transform)
    }

    /// Consomme cette option et enchaîne une opération optionnelle.
    /// @param transform Fonction bornée recevant le contenu déplacé.
    /// @return Résultat de `transform`, ou `None`.
    consume def andThen[U](
        scoped transform : (T) => Option[U]
    ) : Option[U] {
        return andThen[T, U](move this, move transform)
    }

    /// Consomme cette option et adopte une option de remplacement si vide.
    /// @param fallback Option de remplacement consommée.
    /// @return Cette option si présente, sinon `fallback`.
    consume def orElse(fallback : Option[T]) : Option[T] {
        return orElse[T](move this, move fallback)
    }

    /// Extrait le contenu ou adopte une valeur de remplacement.
    /// @param fallback Valeur de remplacement consommée.
    /// @return Contenu présent, sinon `fallback`.
    consume def unwrapOr(fallback : T) : T {
        return unwrapOr[T](move this, move fallback)
    }
}
