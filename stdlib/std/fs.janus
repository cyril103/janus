/// Fournit des opérations propriétaires sur fichiers, répertoires et métadonnées.
///
/// Les chemins restent des chaînes natives sauf lorsque l’API retourne un [[Path]].
/// Les échecs de la plateforme sont conservés dans [[SystemError]]. Les buffers de
/// [[FileData]] et les parcours [[DirectoryIterator]] libèrent leurs ressources à la destruction.
/// @example
/// ```janus
/// val loaded = readFile("config/app.toml")
/// match loaded {
///     Ok(file) => println(file.view()),
///     Error(error) => println(error.context)
/// }
/// ```
module std.fs

import std.option
import std.path
import std.result
import std.system

private extern def janus_fs_read_file(
path : Ptr[byte],
length : usize,
output : Ptr[Ptr[byte]],
outputLength : Ptr[usize]
) : int
private extern def janus_fs_write_file_atomic(
path : Ptr[byte],
length : usize,
data : Ptr[byte],
size : usize
) : int
private extern def janus_fs_create_directory(
path : Ptr[byte],
length : usize,
recursive : int
) : int
private extern def janus_fs_create_temporary_directory(
prefix : Ptr[byte],
prefixLength : usize,
output : Ptr[Ptr[byte]],
outputLength : Ptr[usize]
) : int
private extern def janus_fs_remove_directory(
path : Ptr[byte],
length : usize
) : int
private extern def janus_fs_metadata(
path : Ptr[byte],
length : usize,
kind : Ptr[int],
size : Ptr[usize]
) : int
private extern def janus_fs_directory_open(
path : Ptr[byte],
length : usize
) : isize
private extern def janus_fs_directory_next(
handle : isize,
output : Ptr[Ptr[byte]],
outputLength : Ptr[usize]
) : int
private extern def janus_fs_directory_close(
handle : isize
) : int
private extern def janus_fs_last_error_code() : uint
private extern def janus_fs_last_error_category() : int
private extern def janus_file_free(data : Ptr[byte]) : Unit

/// Identifie la nature d’une entrée telle que rapportée par [[metadata]].
enum FileType derives Copy, Equality, Debug {
    /// Fichier régulier contenant une suite d’octets.
    File,
    /// Répertoire pouvant contenir des entrées.
    Directory,
    /// Lien symbolique rapporté comme tel par la plateforme.
    SymbolicLink,
    /// Type natif distinct des fichiers, répertoires et liens symboliques.
    Other
}

/// Instantané copiable des métadonnées minimales d’une entrée.
///
/// Il contient uniquement le type et la taille renvoyés par l’hôte ; leur sens
/// précis pour les répertoires, liens et autres objets dépend de la plateforme.
struct FileMetadata(
/// Nature de l’entrée.
val kind : FileType,
/// Taille native en octets, dont la signification dépend de [[kind]].
val size : usize
) derives Copy, Equality, Debug {}

private def fsError(
operation : string,
context : string
) : SystemError {
    return new SystemError(
    operation,
    SystemErrorCategory(janus_fs_last_error_category()),
    janus_fs_last_error_code(),
    context
    )
}

private def closedDirectoryError(
operation : string,
context : string
) : SystemError {
    return new SystemError(
    operation,
    SystemErrorCategory.InvalidInput,
    uint(0),
    context
    )
}

private def pointerOutput() : Ptr[Ptr[byte]] {
    val output : Ptr[Ptr[byte]] =
    alloc[Ptr[byte]](usize(1))
    if output == null[Ptr[byte]]() {
        panic("filesystem output allocation failed\n")
    }
    return output
}

private def sizeOutput() : Ptr[usize] {
    val output : Ptr[usize] = alloc[usize](usize(1))
    if output == null[usize]() {
        panic("filesystem size allocation failed\n")
    }
    return output
}

/// Contenu binaire propriétaire chargé intégralement par [[readFile]].
///
/// Les vues et pointeurs obtenus sont empruntés et deviennent invalides à la
/// destruction. Aucune validation d’encodage n’est effectuée.
/// @param nativeData Allocation native dont l’objet prend possession.
/// @param nativeSize Nombre d’octets lisibles à partir de `nativeData`.
class FileData(
private var nativeData : Ptr[byte],
private val nativeSize : usize
) {
    /// Emprunte le premier octet du contenu.
    /// @return Pointeur lisible sur [[size]] octets pendant la vie de ce [[FileData]].
    def data() : Ptr[byte] {
        return nativeData
    }

    /// Retourne la taille du fichier en octets.
    /// @return Nombre d’octets accessibles par [[data]] et [[view]].
    def size() : usize {
        return nativeSize
    }

    /// Emprunte le contenu comme chaîne binaire de longueur explicite.
    /// @return Vue non validée UTF-8, valable jusqu’à la destruction du propriétaire.
    def view() : string {
        return stringView(nativeData, nativeSize)
    }

    destructor {
        janus_file_free(nativeData)
        nativeData = null[byte]()
    }
}

/// Parcours propriétaire et à usage unique des entrées d’un répertoire.
///
/// Chaque [[next]] alloue un [[Path]] indépendant. [[close]] ou le destructeur
/// libère le handle natif ; l’ordre des entrées est celui fourni par la plateforme.
/// @param nativeHandle Handle de parcours natif dont l’itérateur prend possession.
/// @param directoryContext Chemin conservé pour contextualiser les erreurs de parcours.
class DirectoryIterator(
private var nativeHandle : isize,
private val directoryContext : string
) {
    /// Avance le parcours d’une entrée.
    /// @return `Ok(Some(Path))` pour une entrée, `Ok(None)` à la fin, ou `Error(SystemError)` en cas d’échec ou après fermeture.
    def next(
    ) : Result[Option[Path], SystemError] {
        if nativeHandle < isize(0) {
            return Result.Error[Option[Path], SystemError](
            closedDirectoryError("directory.next", directoryContext)
            )
        }
        val output : Ptr[Ptr[byte]] = pointerOutput()
        defer free(output)
        val outputLength : Ptr[usize] = sizeOutput()
        defer free(outputLength)
        val status : int = janus_fs_directory_next(
        nativeHandle,
        output,
        outputLength
        )
        if status < 0 {
            return Result.Error[Option[Path], SystemError](
            fsError("directory.next", directoryContext)
            )
        }
        if status == 0 {
            return Result.Ok[Option[Path], SystemError](
            Option.None[Path]()
            )
        }
        return Result.Ok[Option[Path], SystemError](
        Option.Some[Path](
        new Path(
        output.load(usize(0)),
        outputLength.load(usize(0))
        )
        )
        )
    }

    /// Ferme le handle du parcours et invalide l’itérateur.
    /// @return `Ok(true)` en cas de succès, ou `Error(SystemError)` ; un nouvel appel renvoie `InvalidInput`.
    def close() : Result[bool, SystemError] {
        if nativeHandle < isize(0) {
            return Result.Error[bool, SystemError](
            closedDirectoryError("directory.close", directoryContext)
            )
        }
        val handle : isize = nativeHandle
        nativeHandle = isize(-1)
        if janus_fs_directory_close(handle) != 0 {
            return Result.Error[bool, SystemError](
            fsError("directory.close", directoryContext)
            )
        }
        return Result.Ok[bool, SystemError](true)
    }

    destructor {
        if nativeHandle >= isize(0) {
            val handle : isize = nativeHandle
            nativeHandle = isize(-1)
            janus_fs_directory_close(handle)
        }
    }
}

/// Lit intégralement un fichier dans un tampon propriétaire.
/// @param path Chemin natif du fichier à lire.
/// @return `Ok(FileData)` possédant tous les octets, ou `Error(SystemError)` avec l’opération `file.read`.
def readFile(
path : string
) : Result[FileData, SystemError] {
    val output : Ptr[Ptr[byte]] = pointerOutput()
    defer free(output)
    val outputLength : Ptr[usize] = sizeOutput()
    defer free(outputLength)
    if janus_fs_read_file(
    stringData(path),
    stringLength(path),
    output,
    outputLength
    ) != 0 {
        return Result.Error[FileData, SystemError](
        fsError("file.read", path)
        )
    }
    return Result.Ok[FileData, SystemError](
    new FileData(
    output.load(usize(0)),
    outputLength.load(usize(0))
    )
    )
}

/// Écrit un tampon dans un fichier par remplacement atomique.
///
/// L’atomicité est celle fournie par l’implémentation native ; cette API ne promet
/// ni durabilité après panne ni conservation particulière des métadonnées.
/// @param path Chemin natif de destination.
/// @param data Zone lisible contenant les octets à écrire ; elle reste détenue par l’appelant.
/// @param size Nombre d’octets lisibles depuis `data`.
/// @return `Ok(true)` après remplacement, ou `Error(SystemError)` avec l’opération `file.writeAtomic`.
def writeFileAtomic(
path : string,
data : Ptr[byte],
size : usize
) : Result[bool, SystemError] {
    if janus_fs_write_file_atomic(
    stringData(path),
    stringLength(path),
    data,
    size
    ) != 0 {
        return Result.Error[bool, SystemError](
        fsError("file.writeAtomic", path)
        )
    }
    return Result.Ok[bool, SystemError](true)
}

/// Écrit un texte dans un fichier par remplacement atomique.
/// @param path Chemin natif de destination.
/// @param content Octets de la chaîne Janus à écrire, sans terminateur ajouté.
/// @return Le résultat de [[writeFileAtomic]], avec les mêmes garanties et erreurs.
def writeTextFileAtomic(
path : string,
content : string
) : Result[bool, SystemError] {
    return writeFileAtomic(
    path,
    stringData(content),
    stringLength(content)
    )
}

/// Crée le répertoire demandé.
/// @param path Chemin natif du répertoire à créer.
/// @param recursive Si `true`, demande aussi la création des parents manquants ; sinon, crée seulement le dernier composant.
/// @return `Ok(true)` après création, ou `Error(SystemError)` avec l’opération `directory.create`.
def createDirectory(
path : string,
recursive : bool
) : Result[bool, SystemError] {
    if janus_fs_create_directory(
    stringData(path),
    stringLength(path),
    if recursive { 1 } else { 0 }
    ) != 0 {
        return Result.Error[bool, SystemError](
        fsError("directory.create", path)
        )
    }
    return Result.Ok[bool, SystemError](true)
}

/// Crée un répertoire temporaire unique.
///
/// Le répertoire est effectivement créé et reste à supprimer par l’appelant.
/// @param prefix Préfixe transmis à la plateforme pour nommer le répertoire.
/// @return `Ok(Path)` propriétaire vers le répertoire créé, ou `Error(SystemError)` avec l’opération `directory.temporary`.
def createTemporaryDirectory(
prefix : string
) : Result[Path, SystemError] {
    val output : Ptr[Ptr[byte]] = pointerOutput()
    defer free(output)
    val outputLength : Ptr[usize] = sizeOutput()
    defer free(outputLength)
    if janus_fs_create_temporary_directory(
    stringData(prefix),
    stringLength(prefix),
    output,
    outputLength
    ) != 0 {
        return Result.Error[Path, SystemError](
        fsError("directory.temporary", prefix)
        )
    }
    return Result.Ok[Path, SystemError](
    new Path(
    output.load(usize(0)),
    outputLength.load(usize(0))
    )
    )
}

/// Supprime le répertoire demandé.
/// @param path Chemin natif du répertoire ; aucun parcours récursif n’est réalisé par cette fonction.
/// @return `Ok(true)` après suppression, ou `Error(SystemError)` avec l’opération `directory.remove`.
def removeDirectory(
path : string
) : Result[bool, SystemError] {
    if janus_fs_remove_directory(
    stringData(path),
    stringLength(path)
    ) != 0 {
        return Result.Error[bool, SystemError](
        fsError("directory.remove", path)
        )
    }
    return Result.Ok[bool, SystemError](true)
}

/// Supprime le fichier demandé.
/// @param path Chemin natif transmis à [[removeSystemFile]].
/// @return `Ok(true)` après suppression, ou l’`Error(SystemError)` renvoyée par le service système.
def removeFile(
path : string
) : Result[bool, SystemError] {
    return removeSystemFile(path)
}

/// Consulte le type et la taille natifs d’une entrée.
/// @param path Chemin natif à interroger.
/// @return `Ok(FileMetadata)` en cas de succès, ou `Error(SystemError)` avec l’opération `metadata`.
def metadata(
path : string
) : Result[FileMetadata, SystemError] {
    val kind : Ptr[int] = alloc[int](usize(1))
    if kind == null[int]() {
        panic("filesystem metadata allocation failed\n")
    }
    defer free(kind)
    val size : Ptr[usize] = sizeOutput()
    defer free(size)
    if janus_fs_metadata(
    stringData(path),
    stringLength(path),
    kind,
    size
    ) != 0 {
        return Result.Error[FileMetadata, SystemError](
        fsError("metadata", path)
        )
    }
    return Result.Ok[FileMetadata, SystemError](
    new FileMetadata(
    FileType(kind.load(usize(0))),
    size.load(usize(0))
    )
    )
}

/// Ouvre un parcours sur les entrées du répertoire.
/// @param path Chemin natif du répertoire à énumérer.
/// @return `Ok(DirectoryIterator)` propriétaire, ou `Error(SystemError)` avec l’opération `directory.open`.
def readDirectory(
path : string
) : Result[DirectoryIterator, SystemError] {
    val handle : isize = janus_fs_directory_open(
    stringData(path),
    stringLength(path)
    )
    if handle < isize(0) {
        return Result.Error[DirectoryIterator, SystemError](
        fsError("directory.open", path)
        )
    }
    return Result.Ok[DirectoryIterator, SystemError](
    new DirectoryIterator(handle, path)
    )
}
