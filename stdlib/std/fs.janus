module std.fs

import std.option
import std.path
import std.result
import std.system

private extern def janus_fs_read_file(
path : Ptr[byte],
length : usize,
output : Ptr[Ptr[byte]],
outputLength : Ptr[usize]
) : int
private extern def janus_fs_write_file_atomic(
path : Ptr[byte],
length : usize,
data : Ptr[byte],
size : usize
) : int
private extern def janus_fs_create_directory(
path : Ptr[byte],
length : usize,
recursive : int
) : int
private extern def janus_fs_create_temporary_directory(
prefix : Ptr[byte],
prefixLength : usize,
output : Ptr[Ptr[byte]],
outputLength : Ptr[usize]
) : int
private extern def janus_fs_remove_directory(
path : Ptr[byte],
length : usize
) : int
private extern def janus_fs_metadata(
path : Ptr[byte],
length : usize,
kind : Ptr[int],
size : Ptr[usize]
) : int
private extern def janus_fs_directory_open(
path : Ptr[byte],
length : usize
) : isize
private extern def janus_fs_directory_next(
handle : isize,
output : Ptr[Ptr[byte]],
outputLength : Ptr[usize]
) : int
private extern def janus_fs_directory_close(
handle : isize
) : int
private extern def janus_fs_last_error_code() : uint
private extern def janus_fs_last_error_category() : int
private extern def janus_file_free(data : Ptr[byte]) : Unit

enum FileType derives Copy, Equality, Debug {
    File,
    Directory,
    SymbolicLink,
    Other
}

struct FileMetadata(
val kind : FileType,
val size : usize
) derives Copy, Equality, Debug {}

private def fsError(
operation : string,
context : string
) : SystemError {
    return new SystemError(
    operation,
    SystemErrorCategory(janus_fs_last_error_category()),
    janus_fs_last_error_code(),
    context
    )
}

private def closedDirectoryError(
operation : string,
context : string
) : SystemError {
    return new SystemError(
    operation,
    SystemErrorCategory.InvalidInput,
    uint(0),
    context
    )
}

private def pointerOutput() : Ptr[Ptr[byte]] {
    val output : Ptr[Ptr[byte]] =
    alloc[Ptr[byte]](usize(1))
    if output == null[Ptr[byte]]() {
        panic("filesystem output allocation failed\n")
    }
    return output
}

private def sizeOutput() : Ptr[usize] {
    val output : Ptr[usize] = alloc[usize](usize(1))
    if output == null[usize]() {
        panic("filesystem size allocation failed\n")
    }
    return output
}

class FileData(
private var nativeData : Ptr[byte],
private val nativeSize : usize
) {
    def data() : Ptr[byte] {
        return nativeData
    }

    def size() : usize {
        return nativeSize
    }

    def view() : string {
        return stringView(nativeData, nativeSize)
    }

    destructor {
        janus_file_free(nativeData)
        nativeData = null[byte]()
    }
}

class DirectoryIterator(
private var nativeHandle : isize,
private val directoryContext : string
) {
    def next(
    ) : Result[Option[Path], SystemError] {
        if nativeHandle < isize(0) {
            return Result.Error[Option[Path], SystemError](
            closedDirectoryError("directory.next", directoryContext)
            )
        }
        val output : Ptr[Ptr[byte]] = pointerOutput()
        defer free(output)
        val outputLength : Ptr[usize] = sizeOutput()
        defer free(outputLength)
        val status : int = janus_fs_directory_next(
        nativeHandle,
        output,
        outputLength
        )
        if status < 0 {
            return Result.Error[Option[Path], SystemError](
            fsError("directory.next", directoryContext)
            )
        }
        if status == 0 {
            return Result.Ok[Option[Path], SystemError](
            Option.None[Path]()
            )
        }
        return Result.Ok[Option[Path], SystemError](
        Option.Some[Path](
        new Path(
        output.load(usize(0)),
        outputLength.load(usize(0))
        )
        )
        )
    }

    def close() : Result[bool, SystemError] {
        if nativeHandle < isize(0) {
            return Result.Error[bool, SystemError](
            closedDirectoryError("directory.close", directoryContext)
            )
        }
        val handle : isize = nativeHandle
        nativeHandle = isize(-1)
        if janus_fs_directory_close(handle) != 0 {
            return Result.Error[bool, SystemError](
            fsError("directory.close", directoryContext)
            )
        }
        return Result.Ok[bool, SystemError](true)
    }

    destructor {
        if nativeHandle >= isize(0) {
            val handle : isize = nativeHandle
            nativeHandle = isize(-1)
            janus_fs_directory_close(handle)
        }
    }
}

def readFile(
path : string
) : Result[FileData, SystemError] {
    val output : Ptr[Ptr[byte]] = pointerOutput()
    defer free(output)
    val outputLength : Ptr[usize] = sizeOutput()
    defer free(outputLength)
    if janus_fs_read_file(
    stringData(path),
    stringLength(path),
    output,
    outputLength
    ) != 0 {
        return Result.Error[FileData, SystemError](
        fsError("file.read", path)
        )
    }
    return Result.Ok[FileData, SystemError](
    new FileData(
    output.load(usize(0)),
    outputLength.load(usize(0))
    )
    )
}

def writeFileAtomic(
path : string,
data : Ptr[byte],
size : usize
) : Result[bool, SystemError] {
    if janus_fs_write_file_atomic(
    stringData(path),
    stringLength(path),
    data,
    size
    ) != 0 {
        return Result.Error[bool, SystemError](
        fsError("file.writeAtomic", path)
        )
    }
    return Result.Ok[bool, SystemError](true)
}

def writeTextFileAtomic(
path : string,
content : string
) : Result[bool, SystemError] {
    return writeFileAtomic(
    path,
    stringData(content),
    stringLength(content)
    )
}

def createDirectory(
path : string,
recursive : bool
) : Result[bool, SystemError] {
    if janus_fs_create_directory(
    stringData(path),
    stringLength(path),
    if recursive { 1 } else { 0 }
    ) != 0 {
        return Result.Error[bool, SystemError](
        fsError("directory.create", path)
        )
    }
    return Result.Ok[bool, SystemError](true)
}

def createTemporaryDirectory(
prefix : string
) : Result[Path, SystemError] {
    val output : Ptr[Ptr[byte]] = pointerOutput()
    defer free(output)
    val outputLength : Ptr[usize] = sizeOutput()
    defer free(outputLength)
    if janus_fs_create_temporary_directory(
    stringData(prefix),
    stringLength(prefix),
    output,
    outputLength
    ) != 0 {
        return Result.Error[Path, SystemError](
        fsError("directory.temporary", prefix)
        )
    }
    return Result.Ok[Path, SystemError](
    new Path(
    output.load(usize(0)),
    outputLength.load(usize(0))
    )
    )
}

def removeDirectory(
path : string
) : Result[bool, SystemError] {
    if janus_fs_remove_directory(
    stringData(path),
    stringLength(path)
    ) != 0 {
        return Result.Error[bool, SystemError](
        fsError("directory.remove", path)
        )
    }
    return Result.Ok[bool, SystemError](true)
}

def removeFile(
path : string
) : Result[bool, SystemError] {
    return removeSystemFile(path)
}

def metadata(
path : string
) : Result[FileMetadata, SystemError] {
    val kind : Ptr[int] = alloc[int](usize(1))
    if kind == null[int]() {
        panic("filesystem metadata allocation failed\n")
    }
    defer free(kind)
    val size : Ptr[usize] = sizeOutput()
    defer free(size)
    if janus_fs_metadata(
    stringData(path),
    stringLength(path),
    kind,
    size
    ) != 0 {
        return Result.Error[FileMetadata, SystemError](
        fsError("metadata", path)
        )
    }
    return Result.Ok[FileMetadata, SystemError](
    new FileMetadata(
    FileType(kind.load(usize(0))),
    size.load(usize(0))
    )
    )
}

def readDirectory(
path : string
) : Result[DirectoryIterator, SystemError] {
    val handle : isize = janus_fs_directory_open(
    stringData(path),
    stringLength(path)
    )
    if handle < isize(0) {
        return Result.Error[DirectoryIterator, SystemError](
        fsError("directory.open", path)
        )
    }
    return Result.Ok[DirectoryIterator, SystemError](
    new DirectoryIterator(handle, path)
    )
}
