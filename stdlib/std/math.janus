/// Fournit le PGCD, le PPCM et des outils sur les nombres premiers pour `usize`.
///
/// [[lcm]] renvoie zéro si un opérande est nul et panique si le produit réduit déborde.
/// [[prime_factors]] renvoie les facteurs croissants avec leur multiplicité.
/// @example
/// ```janus
/// val divisor : usize = gcd(usize(84), usize(30))
/// val factors : Array[usize] = prime_factors(usize(84))
/// ```
module std.math
import std.array

/// Calcule le plus grand diviseur commun par l’algorithme d’Euclide.
///
/// @param left Premier entier non signé, éventuellement nul.
/// @param right Second entier non signé, éventuellement nul.
/// @return Plus grand diviseur commun; zéro lorsque les deux arguments valent zéro.
def gcd(left : usize, right : usize) : usize {
    var current : usize = left
    var next : usize = right

    while next != usize(0) {
        val remainder : usize = current % next
        current = next
        next = remainder
    }

    return current
}

/// Calcule le plus petit commun multiple sans faire déborder silencieusement le produit réduit.
///
/// @param left Premier entier non signé.
/// @param right Second entier non signé.
/// @return Zéro si un argument est nul, sinon leur plus petit commun multiple.
def lcm(left : usize, right : usize) : usize {
    if left == usize(0) {
        return usize(0)
    }
    if right == usize(0) {
        return usize(0)
    }

    val reduced : usize = left / gcd(left, right)
    val max : usize = usize(0) - usize(1)
    if reduced > max / right {
        panic("lcm overflow\n")
    }

    return reduced * right
}

/// Indique si la valeur est un nombre premier.
///
/// @param value Entier à tester; zéro et un ne sont pas premiers.
/// @return `true` exactement lorsque `value` n’a que 1 et lui-même comme diviseurs.
def is_prime(value : usize) : bool {
    if value < usize(2) {
        return false
    }
    if value == usize(2) {
        return true
    }
    if value % usize(2) == usize(0) {
        return false
    }

    var divisor : usize = usize(3)
    while divisor <= value / divisor {
        if value % divisor == usize(0) {
            return false
        }
        divisor = divisor + usize(2)
    }

    return true
}

/// Décompose un entier en facteurs premiers croissants, avec répétition des multiplicités.
///
/// @param value Entier à factoriser.
/// @return Tableau vide pour zéro ou un; sinon facteurs dont le produit vaut `value`.
def prime_factors(value : usize) : Array[usize] {
    val factors : Array[usize] = new Array[usize](usize(8))
    var remaining : usize = value

    while remaining > usize(1) && remaining % usize(2) == usize(0) {
        factors.push(usize(2))
        remaining = remaining / usize(2)
    }

    var candidate : usize = usize(3)
    while candidate <= remaining / candidate {
        while remaining % candidate == usize(0) {
            factors.push(candidate)
            remaining = remaining / candidate
        }
        candidate = candidate + usize(2)
    }

    if remaining > usize(1) {
        factors.push(remaining)
    }

    return factors
}
