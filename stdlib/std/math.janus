/// Fournit les mathématiques scalaires usuelles pour `double`, `float` et `usize`.
///
/// Les fonctions flottantes suivent la sémantique de la bibliothèque mathématique C.
/// Une variante terminée par `f` travaille en `float`; la variante sans suffixe
/// travaille en `double`.
/// [[lcm]] renvoie zéro si un opérande est nul et panique si le produit réduit déborde.
/// [[prime_factors]] renvoie les facteurs croissants avec leur multiplicité.
/// @example
/// ```janus
/// val divisor : usize = gcd(usize(84), usize(30))
/// val factors : Array[usize] = prime_factors(usize(84))
/// ```
module std.math
import std.array

/// Rapport de la circonférence d’un cercle à son diamètre, en double précision.
val PI : double = 3.14159265358979323846264338327950288
/// Constante d’Euler, base du logarithme naturel, en double précision.
val E : double = 2.71828182845904523536028747135266250
/// Tour complet en radians, égal à deux fois [[PI]].
val TAU : double = 6.28318530717958647692528676655900576
/// Variante simple précision de [[PI]].
val PIF : float = float(3.14159265358979323846264338327950288)
/// Variante simple précision de [[E]].
val EF : float = float(2.71828182845904523536028747135266250)
/// Variante simple précision de [[TAU]].
val TAUF : float = float(6.28318530717958647692528676655900576)

