/// Modélise un succès [[Result.Ok]] ou une erreur [[Result.Error]].
///
/// Les combinateurs consomment le résultat et transfèrent la propriété de la branche conservée.
/// @example
/// ```janus
/// val item : Result[int, string] = Result.Ok[int, string](42)
/// val value : int = unwrapOr[int, string](move item, 0)
/// ```
module std.result

import std.option

/// Représente une valeur de succès ou une erreur, chacune propriétaire.
enum Result[T, E] extends Try {
    /// La valeur produite dans la branche de succès.
    type Output = T
    /// L'erreur transférée lors d'un retour anticipé.
    type Residual = E
    /// Contient la valeur produite en cas de succès.
    Ok(T),
    /// Contient l’erreur produite en cas d’échec.
    Error(E)
}

/// Paire propriétaire produite par [[zip]].
/// @param left Valeur du premier succès.
/// @param right Valeur du second succès.
struct ResultPair[A, B](
    /// Valeur provenant du premier résultat.
    val left : A,
    /// Valeur provenant du second résultat.
    val right : B
) {}

private def resultInvariant[T]() : T {
    panic("Result ownership state invariant violated\n")
}

private def resultInvariantDiscard[T, U](value : U) : T {
    delete value
    panic("Result branch invariant violated\n")
}

private class ResultFallback[T](private var value : Option[T]) {
    private def takeOption() : Option[T] {
        val previous : Option[T] = move value
        value = Option.None[T]()
        return move previous
    }

    def discardAndReturn[U](result : U) : U {
        val discarded : Option[T] = this.takeOption()
        delete discarded
        return move result
    }

    def discardAndTake[U](discarded : U) : T {
        delete discarded
        return this.take()
    }

    def take() : T {
        val previous : Option[T] = this.takeOption()
        return match move previous {
            Some(item) => move item,
            None => resultInvariant[T]()
        }
    }

    destructor {
        delete value
    }
}

private class ResultState[T, E](
    private var value : Option[Result[T, E]]
) {
    borrow def isOk() : bool {
        return match value {
            Some(result) => match result {
                Ok(item) => true,
                Error(error) => false
            },
            None => false
        }
    }

    private def takeResult() : Result[T, E] {
        val previous : Option[Result[T, E]] = move value
        value = Option.None[Result[T, E]]()
        return match move previous {
            Some(result) => move result,
            None => resultInvariant[Result[T, E]]()
        }
    }

    def takeOk() : T {
        val result : Result[T, E] = this.takeResult()
        return match move result {
            Ok(item) => move item,
            Error(error) => resultInvariantDiscard[T, E](move error)
        }
    }

    def takeError() : E {
        val result : Result[T, E] = this.takeResult()
        return match move result {
            Ok(item) => resultInvariantDiscard[E, T](move item),
            Error(error) => move error
        }
    }

    destructor {
        delete value
    }
}

private def discardAndNone[T, E](error : E) : Option[T] {
    delete error
    return Option.None[T]()
}

private def observeValue[T](
    borrow value : T,
    borrow action : (borrow T) => Unit
) : bool {
    action(value)
    return true
}

private def observeOk[T, E](
    borrow value : Result[T, E],
    scoped action : (borrow T) => Unit
) : Unit {
    defer delete action
    val observed : bool = match value {
        Ok(item) => observeValue[T](item, action),
        Error(error) => false
    }
    if observed { return }
}

private def observeError[T, E](
    borrow value : Result[T, E],
    scoped action : (borrow E) => Unit
) : Unit {
    defer delete action
    val observed : bool = match value {
        Ok(item) => false,
        Error(error) => observeValue[E](error, action)
    }
    if observed { return }
}

/// Indique si le résultat contient une valeur de succès.
///
/// @param value Résultat inspecté sans déplacer sa branche.
/// @return `true` pour `Ok`, `false` pour `Error`.
pure def isOk[T, E](borrow value : Result[T, E]) : bool {
    return match value {
        Ok(item) => true,
        Error(error) => false
    }
}

/// Indique si le résultat contient une erreur.
///
/// @param value Résultat inspecté sans déplacer sa branche.
/// @return `true` pour `Error`, `false` pour `Ok`.
pure def isError[T, E](borrow value : Result[T, E]) : bool {
    return match value {
        Ok(item) => false,
        Error(error) => true
    }
}

/// Transforme un succès en l'observant sans consommer le résultat.
/// @param value Résultat observé; sa variante reste possédée par l'appelant.
/// @param transform Fonction bornée recevant un emprunt de la valeur `Ok`.
/// @return `Some` du résultat transformé, ou `None` pour `Error`.
def mapBorrowed[T, U, E](
    borrow value : Result[T, E],
    scoped transform : (borrow T) => U
) : Option[U] {
    defer delete transform
    return match value {
        Ok(item) => Option.Some[U](transform(item)),
        Error(error) => Option.None[U]()
    }
}

/// Transforme une erreur en l'observant sans consommer le résultat.
/// @param value Résultat observé; sa variante reste possédée par l'appelant.
/// @param transform Fonction bornée recevant un emprunt de la valeur `Error`.
/// @return `Some` du résultat transformé pour `Error`, ou `None` pour `Ok`.
def mapErrorBorrowed[T, E, F](
    borrow value : Result[T, E],
    scoped transform : (borrow E) => F
) : Option[F] {
    defer delete transform
    return match value {
        Ok(item) => Option.None[F](),
        Error(error) => Option.Some[F](transform(error))
    }
}

/// Consomme le résultat et transforme uniquement sa valeur de succès.
///
/// @param value Résultat consommé.
/// @param transform Fonction propriétaire appelée avec la valeur déplacée pour `Ok`, puis détruite.
/// @return `Ok` transformé, ou l’erreur d’origine déplacée sans appeler `transform`.
def map[T, U, E](
    value : Result[T, E],
    scoped transform : (T) => U
) : Result[U, E] {
    defer delete transform
    return match move value {
        Ok(item) => Result.Ok[U, E](transform(move item)),
        Error(error) => Result.Error[U, E](move error)
    }
}

/// Consomme le résultat et transforme uniquement son erreur.
///
/// @param value Résultat consommé.
/// @param transform Fonction propriétaire appelée avec l’erreur déplacée pour `Error`, puis détruite.
/// @return Erreur transformée, ou valeur de succès d’origine déplacée sans appeler `transform`.
def mapError[T, E, F](
    value : Result[T, E],
    scoped transform : (E) => F
) : Result[T, F] {
    defer delete transform
    return match move value {
        Ok(item) => Result.Ok[T, F](move item),
        Error(error) => Result.Error[T, F](transform(move error))
    }
}

/// Enchaîne une opération susceptible d’échouer sur la branche de succès.
///
/// @param value Résultat consommé.
/// @param transform Fonction propriétaire appelée avec la valeur déplacée pour `Ok`, puis détruite.
/// @return Résultat de `transform`, ou erreur d’origine déplacée sans appeler `transform`.
def andThen[T, U, E](
    value : Result[T, E],
    scoped transform : (T) => Result[U, E]
) : Result[U, E] {
    defer delete transform
    return match move value {
        Ok(item) => transform(move item),
        Error(error) => Result.Error[U, E](move error)
    }
}

/// Supprime un niveau d'imbrication d'un résultat consommé.
/// @example
/// ```janus
/// val flat : Result[int, int] = flatten[int, int](Result.Ok[Result[int, int], int](Result.Ok[int, int](1)))
/// ```
/// @param value Résultat extérieur consommé.
/// @return Résultat intérieur déplacé pour `Ok`, ou erreur extérieure déplacée.
def flatten[T, E](value : Result[Result[T, E], E]) : Result[T, E] {
    return match move value {
        Ok(inner) => move inner,
        Error(error) => Result.Error[T, E](move error)
    }
}

/// Réduit les deux branches d'un résultat vers un même type.
///
/// Les callbacks sont évalués avant l'appel puis détruits avant le retour;
/// seule la fonction correspondant à la branche active est appelée.
/// @example
/// ```janus
/// val value : int = fold[int, int, int](Result.Ok[int, int](1), (item : int) => item, (error : int) => -error)
/// ```
/// @param value Résultat consommé.
/// @param onOk Fonction bornée appelée pour `Ok`.
/// @param onError Fonction bornée appelée pour `Error`.
/// @return Projection de la branche active.
def fold[T, E, U](
    value : Result[T, E],
    scoped onOk : (T) => U,
    scoped onError : (E) => U
) : U {
    defer delete onOk
    defer delete onError
    return match move value {
        Ok(item) => onOk(move item),
        Error(error) => onError(move error)
    }
}

/// Regroupe les succès de deux résultats.
///
/// `left` puis `right` sont évalués avant l'appel. La branche gauche est
/// inspectée en premier; sa première erreur gagne et le résultat droit restant
/// est alors détruit. Sinon la branche droite est inspectée.
/// @example
/// ```janus
/// val pair : Result[ResultPair[int, int], int] = zip[int, int, int](Result.Ok[int, int](1), Result.Ok[int, int](2))
/// ```
/// @param left Premier résultat consommé.
/// @param right Second résultat consommé.
/// @return Paire des succès, ou première erreur dans l'ordre gauche-droite.
def zip[T, U, E](
    left : Result[T, E],
    right : Result[U, E]
) : Result[ResultPair[T, U], E] {
    val leftState : ResultState[T, E] = new ResultState[T, E](
        Option.Some[Result[T, E]](move left)
    )
    defer delete leftState
    val rightState : ResultState[U, E] = new ResultState[U, E](
        Option.Some[Result[U, E]](move right)
    )
    defer delete rightState
    if !leftState.isOk() {
        return Result.Error[ResultPair[T, U], E](leftState.takeError())
    }
    if !rightState.isOk() {
        return Result.Error[ResultPair[T, U], E](rightState.takeError())
    }
    return Result.Ok[ResultPair[T, U], E](
        new ResultPair[T, U](leftState.takeOk(), rightState.takeOk())
    )
}

/// Combine les succès de deux résultats.
///
/// L'ordre d'évaluation et de sélection de l'erreur est identique à [[zip]].
/// `combine` n'est appelée que lorsque les deux résultats sont `Ok`.
/// @example
/// ```janus
/// val sum : Result[int, int] = map2[int, int, int, int](Result.Ok[int, int](1), Result.Ok[int, int](2), (a : int, b : int) => a + b)
/// ```
/// @param left Premier résultat consommé.
/// @param right Second résultat consommé.
/// @param combine Fonction bornée recevant les deux succès dans l'ordre.
/// @return Succès combiné ou première erreur gauche-droite.
def map2[T, U, E, V](
    left : Result[T, E],
    right : Result[U, E],
    scoped combine : (T, U) => V
) : Result[V, E] {
    defer delete combine
    val leftState : ResultState[T, E] = new ResultState[T, E](
        Option.Some[Result[T, E]](move left)
    )
    defer delete leftState
    val rightState : ResultState[U, E] = new ResultState[U, E](
        Option.Some[Result[U, E]](move right)
    )
    defer delete rightState
    if !leftState.isOk() {
        return Result.Error[V, E](leftState.takeError())
    }
    if !rightState.isOk() {
        return Result.Error[V, E](rightState.takeError())
    }
    return Result.Ok[V, E](combine(leftState.takeOk(), rightState.takeOk()))
}

/// Observe un succès sans modifier le résultat de la chaîne.
/// @example
/// ```janus
/// val kept : Result[int, int] = inspect[int, int](Result.Ok[int, int](1), (borrow item : int) => println(item))
/// ```
/// @param value Résultat consommé puis retourné.
/// @param action Action bornée appelée uniquement pour `Ok`.
/// @return Le résultat d'origine avec sa propriété transférée.
def inspect[T, E](
    value : Result[T, E],
    scoped action : (borrow T) => Unit
) : Result[T, E] {
    observeOk[T, E](value, move action)
    return move value
}

/// Observe une erreur sans modifier le résultat de la chaîne.
/// @example
/// ```janus
/// val kept : Result[int, int] = inspectError[int, int](Result.Error[int, int](1), (borrow error : int) => println(error))
/// ```
/// @param value Résultat consommé puis retourné.
/// @param action Action bornée appelée uniquement pour `Error`.
/// @return Le résultat d'origine avec sa propriété transférée.
def inspectError[T, E](
    value : Result[T, E],
    scoped action : (borrow E) => Unit
) : Result[T, E] {
    observeError[T, E](value, move action)
    return move value
}

/// Extrait le succès ou calcule un remplacement depuis l'erreur.
/// @example
/// ```janus
/// val value : int = unwrapOrElse[int, int](Result.Error[int, int](2), (error : int) => error + 40)
/// ```
/// @param value Résultat consommé.
/// @param fallback Fonction bornée appelée uniquement pour `Error`.
/// @return Succès déplacé ou remplacement calculé.
def unwrapOrElse[T, E](
    value : Result[T, E],
    scoped fallback : (E) => T
) : T {
    defer delete fallback
    return match move value {
        Ok(item) => move item,
        Error(error) => fallback(move error)
    }
}

/// Tente une récupération uniquement sur la branche d’erreur.
///
/// @param value Résultat consommé.
/// @param transform Fonction propriétaire appelée avec l’erreur déplacée pour `Error`, puis détruite.
/// @return Résultat de `transform`, ou succès d’origine déplacé sans appeler `transform`.
def orElse[T, E, F](
    value : Result[T, E],
    scoped transform : (E) => Result[T, F]
) : Result[T, F] {
    defer delete transform
    return match move value {
        Ok(item) => Result.Ok[T, F](move item),
        Error(error) => transform(move error)
    }
}

/// Extrait la valeur de succès ou adopte une valeur de remplacement.
///
/// @param value Résultat consommé; son erreur est détruite si elle existe.
/// @param fallback Valeur consommée et détruite pour `Ok`, retournée pour `Error`.
/// @return Valeur déplacée de `Ok`, sinon `fallback`.
def unwrapOr[T, E](value : Result[T, E], fallback : T) : T {
    val state : ResultFallback[T] =
    new ResultFallback[T](Option.Some[T](move fallback))
    defer delete state
    return match move value {
        Ok(item) => state.discardAndReturn[T](move item),
        Error(error) => state.discardAndTake[E](move error)
    }
}

/// Convertit un résultat consommé en option en supprimant l’information d’erreur.
///
/// @param value Résultat consommé.
/// @return `Some` avec la valeur déplacée pour `Ok`; `None` après destruction de l’erreur.
def toOption[T, E](value : Result[T, E]) : Option[T] {
    return match move value {
        Ok(item) => Option.Some[T](move item),
        Error(error) => discardAndNone[T, E](move error)
    }
}

/// Convertit une option consommée en résultat à l’aide d’une erreur de remplacement.
///
/// @param value Option consommée.
/// @param error Erreur consommée et détruite pour `Some`, déplacée dans `Error` pour `None`.
/// @return `Ok` avec le contenu déplacé de `Some`, sinon `Error(error)`.
def fromOption[T, E](value : Option[T], error : E) : Result[T, E] {
    val state : ResultFallback[E] =
    new ResultFallback[E](Option.Some[E](move error))
    defer delete state
    return match move value {
        Some(item) => state.discardAndReturn[Result[T, E]](
            Result.Ok[T, E](move item)
        ),
        None => Result.Error[T, E](state.take())
    }
}

/// Convertit une option consommée en résultat.
///
/// Cette forme nommée depuis `Option` est définie dans `std.result` afin
/// d'éviter un cycle de modules. Elle est équivalente à [[fromOption]].
/// @example
/// ```janus
/// val value : Result[int, int] = toResult[int, int](Option.Some[int](1), 0)
/// ```
/// @param value Option consommée.
/// @param error Erreur détruite pour `Some`, déplacée pour `None`.
/// @return `Ok` avec le contenu, sinon `Error(error)`.
def toResult[T, E](value : Option[T], error : E) : Result[T, E] {
    return fromOption[T, E](move value, move error)
}

/// Distribue un résultat optionnel vers une option de résultat.
/// @example
/// ```janus
/// val value : Option[Result[int, int]] = transpose[int, int](Result.Ok[Option[int], int](Option.Some[int](1)))
/// ```
/// @param value Résultat consommé.
/// @return `Some(Ok)` pour `Ok(Some)`, `None` pour `Ok(None)`, ou `Some(Error)`.
def transpose[T, E](
    value : Result[Option[T], E]
) : Option[Result[T, E]] {
    return match move value {
        Ok(option) => match move option {
            Some(item) => Option.Some[Result[T, E]](
                Result.Ok[T, E](move item)
            ),
            None => Option.None[Result[T, E]]()
        },
        Error(error) => Option.Some[Result[T, E]](
            Result.Error[T, E](move error)
        )
    }
}

/// Surface de méthodes statiques pour composer les résultats avec `.`.
extend[T, E] Result[T, E] {
    /// Indique si ce résultat contient un succès.
    /// @return `true` pour `Ok`, sinon `false`.
    borrow def isOk() : bool {
        return isOk[T, E](this)
    }

    /// Indique si ce résultat contient une erreur.
    /// @return `true` pour `Error`, sinon `false`.
    borrow def isError() : bool {
        return isError[T, E](this)
    }

    /// Transforme le succès en l'observant sans consommer le résultat.
    /// @param transform Fonction bornée recevant un emprunt du succès.
    /// @return Option contenant le résultat transformé pour `Ok`.
    borrow def mapBorrowed[U](
        scoped transform : (borrow T) => U
    ) : Option[U] {
        return mapBorrowed[T, U, E](this, move transform)
    }

    /// Transforme l'erreur en l'observant sans consommer le résultat.
    /// @param transform Fonction bornée recevant un emprunt de l'erreur.
    /// @return Option contenant le résultat transformé pour `Error`.
    borrow def mapErrorBorrowed[F](
        scoped transform : (borrow E) => F
    ) : Option[F] {
        return mapErrorBorrowed[T, E, F](this, move transform)
    }

    /// Consomme ce résultat et transforme sa valeur de succès.
    /// @param transform Fonction bornée recevant le succès déplacé.
    /// @return Résultat contenant le succès transformé ou l'erreur d'origine.
    consume def map[U](scoped transform : (T) => U) : Result[U, E] {
        return map[T, U, E](move this, move transform)
    }

    /// Consomme ce résultat et transforme son erreur.
    /// @param transform Fonction bornée recevant l'erreur déplacée.
    /// @return Résultat contenant le succès d'origine ou l'erreur transformée.
    consume def mapError[F](
        scoped transform : (E) => F
    ) : Result[T, F] {
        return mapError[T, E, F](move this, move transform)
    }

    /// Consomme ce résultat et enchaîne une opération faillible.
    /// @param transform Fonction bornée recevant le succès déplacé.
    /// @return Résultat de `transform`, ou l'erreur d'origine.
    consume def andThen[U](
        scoped transform : (T) => Result[U, E]
    ) : Result[U, E] {
        return andThen[T, U, E](move this, move transform)
    }

    /// Réduit la branche active vers un même type.
    /// @param onOk Fonction bornée appelée pour `Ok`.
    /// @param onError Fonction bornée appelée pour `Error`.
    /// @return Projection de la branche active.
    consume def fold[U](
        scoped onOk : (T) => U,
        scoped onError : (E) => U
    ) : U {
        return fold[T, E, U](move this, move onOk, move onError)
    }

    /// Regroupe ce succès avec celui d'un second résultat.
    /// @param other Second résultat consommé après le receiver.
    /// @return Paire des succès ou première erreur gauche-droite.
    consume def zip[U](
        other : Result[U, E]
    ) : Result[ResultPair[T, U], E] {
        return zip[T, U, E](move this, move other)
    }

    /// Combine ce succès avec celui d'un second résultat.
    /// @param other Second résultat consommé après le receiver.
    /// @param combine Fonction bornée recevant les succès dans l'ordre.
    /// @return Succès combiné ou première erreur gauche-droite.
    consume def map2[U, V](
        other : Result[U, E],
        scoped combine : (T, U) => V
    ) : Result[V, E] {
        return map2[T, U, E, V](move this, move other, move combine)
    }

    /// Observe le succès sans interrompre une chaîne.
    /// @param action Action bornée appelée uniquement pour `Ok`.
    /// @return Ce résultat consommé puis retransmis.
    consume def inspect(
        scoped action : (borrow T) => Unit
    ) : Result[T, E] {
        return inspect[T, E](move this, move action)
    }

    /// Observe l'erreur sans interrompre une chaîne.
    /// @param action Action bornée appelée uniquement pour `Error`.
    /// @return Ce résultat consommé puis retransmis.
    consume def inspectError(
        scoped action : (borrow E) => Unit
    ) : Result[T, E] {
        return inspectError[T, E](move this, move action)
    }

    /// Consomme ce résultat et tente une récupération de l'erreur.
    /// @param transform Fonction bornée recevant l'erreur déplacée.
    /// @return Succès d'origine ou résultat de `transform`.
    consume def orElse[F](
        scoped transform : (E) => Result[T, F]
    ) : Result[T, F] {
        return orElse[T, E, F](move this, move transform)
    }

    /// Extrait le succès ou adopte une valeur de remplacement.
    /// @param fallback Valeur de remplacement consommée.
    /// @return Succès contenu, sinon `fallback`.
    consume def unwrapOr(fallback : T) : T {
        return unwrapOr[T, E](move this, move fallback)
    }

    /// Extrait le succès ou calcule un remplacement depuis l'erreur.
    /// @param fallback Fonction bornée appelée uniquement pour `Error`.
    /// @return Succès déplacé ou remplacement calculé.
    consume def unwrapOrElse(scoped fallback : (E) => T) : T {
        return unwrapOrElse[T, E](move this, move fallback)
    }

    /// Convertit ce résultat consommé en option.
    /// @return `Some` pour `Ok`, sinon `None` après destruction de l'erreur.
    consume def toOption() : Option[T] {
        return toOption[T, E](move this)
    }
}

/// Méthodes disponibles uniquement pour un résultat imbriqué homogène.
extend[T, E] Result[Result[T, E], E] {
    /// Supprime un niveau d'imbrication.
    /// @return Résultat intérieur ou erreur extérieure.
    consume def flatten() : Result[T, E] {
        return flatten[T, E](move this)
    }
}

/// Méthodes disponibles pour un résultat contenant une option.
extend[T, E] Result[Option[T], E] {
    /// Distribue ce résultat vers une option de résultat.
    /// @return Option contenant le résultat distribué.
    consume def transpose() : Option[Result[T, E]] {
        return transpose[T, E](move this)
    }
}
