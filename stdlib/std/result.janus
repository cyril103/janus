/// Modélise un succès [[Result.Ok]] ou une erreur [[Result.Error]].
///
/// Les combinateurs consomment le résultat et transfèrent la propriété de la branche conservée.
/// @example
/// ```janus
/// val item : Result[int, string] = Result.Ok[int, string](42)
/// val value : int = unwrapOr[int, string](move item, 0)
/// ```
module std.result

import std.option

/// Représente une valeur de succès ou une erreur, chacune propriétaire.
enum Result[T, E] {
    /// Contient la valeur produite en cas de succès.
    Ok(T),
    /// Contient l’erreur produite en cas d’échec.
    Error(E)
}

private class ResultFallback[T](private var value : Option[T]) {
    private def takeOption() : Option[T] {
        val previous : Option[T] = move value
        value = Option.None[T]()
        return move previous
    }

    def discardAndReturn[U](result : U) : U {
        val discarded : Option[T] = this.takeOption()
        delete discarded
        return move result
    }

    def discardAndTake[U](discarded : U) : T {
        delete discarded
        return this.take()
    }

    def take() : T {
        val previous : Option[T] = this.takeOption()
        return match move previous {
            Some(item) => move item,
            None => this.take()
        }
    }

    destructor {
        delete value
    }
}

private def discardAndNone[T, E](error : E) : Option[T] {
    delete error
    return Option.None[T]()
}

/// Indique si le résultat contient une valeur de succès.
///
/// @param value Résultat inspecté sans déplacer sa branche.
/// @return `true` pour `Ok`, `false` pour `Error`.
def isOk[T, E](borrow value : Result[T, E]) : bool {
    return match value {
        Ok(item) => true,
        Error(error) => false
    }
}

/// Indique si le résultat contient une erreur.
///
/// @param value Résultat inspecté sans déplacer sa branche.
/// @return `true` pour `Error`, `false` pour `Ok`.
def isError[T, E](borrow value : Result[T, E]) : bool {
    return match value {
        Ok(item) => false,
        Error(error) => true
    }
}

/// Transforme un succès en l'observant sans consommer le résultat.
/// @param value Résultat observé; sa variante reste possédée par l'appelant.
/// @param transform Fonction bornée recevant un emprunt de la valeur `Ok`.
/// @return `Some` du résultat transformé, ou `None` pour `Error`.
def mapBorrowed[T, U, E](
borrow value : Result[T, E],
scoped transform : (borrow T) => U
) : Option[U] {
    defer delete transform
    return match value {
        Ok(item) => Option.Some[U](transform(item)),
        Error(error) => Option.None[U]()
    }
}

/// Transforme une erreur en l'observant sans consommer le résultat.
/// @param value Résultat observé; sa variante reste possédée par l'appelant.
/// @param transform Fonction bornée recevant un emprunt de la valeur `Error`.
/// @return `Some` du résultat transformé pour `Error`, ou `None` pour `Ok`.
def mapErrorBorrowed[T, E, F](
borrow value : Result[T, E],
scoped transform : (borrow E) => F
) : Option[F] {
    defer delete transform
    return match value {
        Ok(item) => Option.None[F](),
        Error(error) => Option.Some[F](transform(error))
    }
}

/// Consomme le résultat et transforme uniquement sa valeur de succès.
///
/// @param value Résultat consommé.
/// @param transform Fonction propriétaire appelée avec la valeur déplacée pour `Ok`, puis détruite.
/// @return `Ok` transformé, ou l’erreur d’origine déplacée sans appeler `transform`.
def map[T, U, E](
value : Result[T, E],
scoped transform : (T) => U
) : Result[U, E] {
    defer delete transform
    return match move value {
        Ok(item) => Result.Ok[U, E](transform(move item)),
        Error(error) => Result.Error[U, E](move error)
    }
}

/// Consomme le résultat et transforme uniquement son erreur.
///
/// @param value Résultat consommé.
/// @param transform Fonction propriétaire appelée avec l’erreur déplacée pour `Error`, puis détruite.
/// @return Erreur transformée, ou valeur de succès d’origine déplacée sans appeler `transform`.
def mapError[T, E, F](
value : Result[T, E],
scoped transform : (E) => F
) : Result[T, F] {
    defer delete transform
    return match move value {
        Ok(item) => Result.Ok[T, F](move item),
        Error(error) => Result.Error[T, F](transform(move error))
    }
}

/// Enchaîne une opération susceptible d’échouer sur la branche de succès.
///
/// @param value Résultat consommé.
/// @param transform Fonction propriétaire appelée avec la valeur déplacée pour `Ok`, puis détruite.
/// @return Résultat de `transform`, ou erreur d’origine déplacée sans appeler `transform`.
def andThen[T, U, E](
value : Result[T, E],
scoped transform : (T) => Result[U, E]
) : Result[U, E] {
    defer delete transform
    return match move value {
        Ok(item) => transform(move item),
        Error(error) => Result.Error[U, E](move error)
    }
}

/// Tente une récupération uniquement sur la branche d’erreur.
///
/// @param value Résultat consommé.
/// @param transform Fonction propriétaire appelée avec l’erreur déplacée pour `Error`, puis détruite.
/// @return Résultat de `transform`, ou succès d’origine déplacé sans appeler `transform`.
def orElse[T, E, F](
value : Result[T, E],
scoped transform : (E) => Result[T, F]
) : Result[T, F] {
    defer delete transform
    return match move value {
        Ok(item) => Result.Ok[T, F](move item),
        Error(error) => transform(move error)
    }
}

/// Extrait la valeur de succès ou adopte une valeur de remplacement.
///
/// @param value Résultat consommé; son erreur est détruite si elle existe.
/// @param fallback Valeur consommée et détruite pour `Ok`, retournée pour `Error`.
/// @return Valeur déplacée de `Ok`, sinon `fallback`.
def unwrapOr[T, E](value : Result[T, E], fallback : T) : T {
    val state : ResultFallback[T] =
    new ResultFallback[T](Option.Some[T](move fallback))
    defer delete state
    return match move value {
        Ok(item) => state.discardAndReturn[T](move item),
        Error(error) => state.discardAndTake[E](move error)
    }
}

/// Convertit un résultat consommé en option en supprimant l’information d’erreur.
///
/// @param value Résultat consommé.
/// @return `Some` avec la valeur déplacée pour `Ok`; `None` après destruction de l’erreur.
def toOption[T, E](value : Result[T, E]) : Option[T] {
    return match move value {
        Ok(item) => Option.Some[T](move item),
        Error(error) => discardAndNone[T, E](move error)
    }
}

/// Convertit une option consommée en résultat à l’aide d’une erreur de remplacement.
///
/// @param value Option consommée.
/// @param error Erreur consommée et détruite pour `Some`, déplacée dans `Error` pour `None`.
/// @return `Ok` avec le contenu déplacé de `Some`, sinon `Error(error)`.
def fromOption[T, E](value : Option[T], error : E) : Result[T, E] {
    val state : ResultFallback[E] =
    new ResultFallback[E](Option.Some[E](move error))
    defer delete state
    return match move value {
        Some(item) => state.discardAndReturn[Result[T, E]](
        Result.Ok[T, E](move item)
        ),
        None => Result.Error[T, E](state.take())
    }
}
