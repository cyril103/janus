/// Modélise un succès [[Result.Ok]] ou une erreur [[Result.Error]].
///
/// Les combinateurs consomment le résultat et transfèrent la propriété de la branche conservée.
/// @example
/// ```janus
/// val item : Result[int, string] = Result.Ok[int, string](42)
/// val value : int = unwrapOr[int, string](move item, 0)
/// ```
module std.result

import std.option

/// Énumère les valeurs de [[Result]] reconnues par le backend ou l’algorithme.
enum Result[T, E] {
    /// Variante `Ok`, correspondant à cette valeur précise.
    Ok(T),
    /// Variante `Error`, correspondant à cette valeur précise.
    Error(E)
}

private class ResultFallback[T](private var value : T) {
    private var available : bool = true

    def discardAndReturn[U](result : U) : U {
        val discarded : T = move value
        available = false
        delete discarded
        return move result
    }

    def discardAndTake[U](discarded : U) : T {
        delete discarded
        available = false
        return move value
    }

    def take() : T {
        available = false
        return move value
    }

    destructor {
        if available {
            delete value
        }
    }
}

private def discardAndNone[T, E](error : E) : Option[T] {
    delete error
    return Option.None[T]()
}

/// Indique si le résultat contient une valeur de succès.
///
/// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[bool]].
def isOk[T, E](value : Result[T, E]) : bool {
    return match value {
        Ok(item) => true,
        Error(error) => false
    }
}

/// Indique si le résultat contient une erreur.
///
/// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[bool]].
def isError[T, E](value : Result[T, E]) : bool {
    return match value {
        Ok(item) => false,
        Error(error) => true
    }
}

/// Transforme la valeur ou la séquence avec la fonction fournie.
///
/// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param transform Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[ResultU,]].
def map[T, U, E](
value : Result[T, E],
transform : (T) => U
) : Result[U, E] {
    defer delete transform
    return match move value {
        Ok(item) => Result.Ok[U, E](transform(move item)),
        Error(error) => Result.Error[U, E](move error)
    }
}

/// Transforme la valeur ou la séquence avec la fonction fournie.
///
/// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param transform Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[ResultT,]].
def mapError[T, E, F](
value : Result[T, E],
transform : (E) => F
) : Result[T, F] {
    defer delete transform
    return match move value {
        Ok(item) => Result.Ok[T, F](move item),
        Error(error) => Result.Error[T, F](transform(move error))
    }
}

/// Fournit la sémantique de [[andThen]].
///
/// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param transform Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[ResultU,]].
def andThen[T, U, E](
value : Result[T, E],
transform : (T) => Result[U, E]
) : Result[U, E] {
    defer delete transform
    return match move value {
        Ok(item) => transform(move item),
        Error(error) => Result.Error[U, E](move error)
    }
}

/// Fournit la sémantique de [[orElse]].
///
/// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param transform Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[ResultT,]].
def orElse[T, E, F](
value : Result[T, E],
transform : (E) => Result[T, F]
) : Result[T, F] {
    defer delete transform
    return match move value {
        Ok(item) => Result.Ok[T, F](move item),
        Error(error) => transform(move error)
    }
}

/// Fournit la sémantique de [[unwrapOr]].
///
/// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param fallback Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[T]].
def unwrapOr[T, E](value : Result[T, E], fallback : T) : T {
    val state : ResultFallback[T] =
    new ResultFallback[T](move fallback)
    defer delete state
    return match move value {
        Ok(item) => state.discardAndReturn[T](move item),
        Error(error) => state.discardAndTake[E](move error)
    }
}

/// Fournit la sémantique de [[toOption]].
///
/// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[OptionT]].
def toOption[T, E](value : Result[T, E]) : Option[T] {
    return match move value {
        Ok(item) => Option.Some[T](move item),
        Error(error) => discardAndNone[T, E](move error)
    }
}

/// Fournit la sémantique de [[fromOption]].
///
/// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param error Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[ResultT,]].
def fromOption[T, E](value : Option[T], error : E) : Result[T, E] {
    val state : ResultFallback[E] =
    new ResultFallback[E](move error)
    defer delete state
    return match move value {
        Some(item) => state.discardAndReturn[Result[T, E]](
        Result.Ok[T, E](move item)
        ),
        None => Result.Error[T, E](state.take())
    }
}
