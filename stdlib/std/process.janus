/// Consulte le contexte du processus courant et lance des processus enfants.
///
/// Les chaînes d’arguments du programme sont empruntées au runtime. Les valeurs
/// d’environnement et résultats de commande possèdent en revanche leurs buffers.
/// [[runProcess]] attend la fin de l’enfant et peut capturer ses sorties en octets.
/// @example
/// ```janus
/// val args = new Array[string](usize(1))
/// args.push("--version")
/// val result = runProcess("janus", args, "", true, true)
/// ```
module std.process

import std.array
import std.option
import std.result
import std.system

private extern def janus_process_argument_count() : usize
private extern def janus_process_argument_data(index : usize) : borrow Ptr[byte]
private extern def janus_process_argument_size(index : usize) : usize
private extern def janus_process_environment(
borrow name : Ptr[byte],
length : usize
) : isize
private extern def janus_process_text_data(text : isize) : borrow Ptr[byte]
private extern def janus_process_text_size(text : isize) : usize
private extern def janus_process_text_destroy(text : isize) : Unit
private extern def janus_process_run(
borrow executable : Ptr[byte],
executableLength : usize,
borrow arguments : Ptr[Ptr[byte]],
borrow argumentLengths : Ptr[usize],
argumentCount : usize,
borrow workingDirectory : Ptr[byte],
workingDirectoryLength : usize,
captureStdout : bool,
captureStderr : bool
) : isize
private extern def janus_process_result_exit_code(result : isize) : int
private extern def janus_process_result_stdout_data(
result : isize
) : borrow Ptr[byte]
private extern def janus_process_result_stdout_size(
result : isize
) : usize
private extern def janus_process_result_stderr_data(
result : isize
) : borrow Ptr[byte]
private extern def janus_process_result_stderr_size(
result : isize
) : usize
private extern def janus_process_result_destroy(result : isize) : Unit
private extern def janus_process_last_error_code() : uint
private extern def janus_process_last_error_category() : int

private def processError(
operation : string,
context : string
) : SystemError {
    return new SystemError(
    operation,
    SystemErrorCategory(janus_process_last_error_category()),
    janus_process_last_error_code(),
    context
    )
}

private def processMemoryError(
context : string
) : SystemError {
    return new SystemError(
    "process.run",
    SystemErrorCategory.ResourceExhausted,
    uint(0),
    context
    )
}

/// Retourne le nombre d’arguments du processus courant, nom du programme compris selon le runtime.
/// @return Nombre d’indices acceptés par [[programArgument]].
def programArgumentCount() : usize {
    return janus_process_argument_count()
}

/// Emprunte un argument du processus courant.
/// @param index Indice à partir de zéro.
/// @return `Some(string)` pour un indice valide, sinon `None`; la vue reste détenue par le runtime.
def programArgument(index : usize) : Option[string] {
    val data : Ptr[byte] = janus_process_argument_data(index)
    if data == null[byte]() {
        return Option.None[string]()
    }
    return Option.Some[string](
    stringView(data, janus_process_argument_size(index))
    )
}

/// Valeur d’environnement propriétaire obtenue par [[environmentVariable]].
///
/// Sa vue emprunte un stockage natif libéré avec l’objet.
/// @param nativeText Stockage natif transféré par l’API de processus.
class EnvironmentValue(private var nativeText : isize) {
    /// Emprunte le contenu exact de la variable, sans interpréter son encodage.
    /// @return Vue valide jusqu’à la destruction de cette [[EnvironmentValue]].
    def view() : string {
        return stringView(
        janus_process_text_data(nativeText),
        janus_process_text_size(nativeText)
        )
    }

    /// Retourne la longueur de la valeur d’environnement.
    /// @return Taille en octets de [[view]].
    def size() : usize {
        return janus_process_text_size(nativeText)
    }

    destructor {
        janus_process_text_destroy(nativeText)
        nativeText = isize(0)
    }
}

/// Recherche une variable dans l’environnement du processus courant.
/// @param name Nom exact de la variable, encodé comme une chaîne Janus.
/// @return `Ok(Some(value))` si elle existe, `Ok(None)` si elle est absente, ou `Error(SystemError)` si la consultation native échoue.
def environmentVariable(
name : string
) : Result[Option[EnvironmentValue], SystemError] {
    val text : isize = janus_process_environment(
    stringData(name),
    stringLength(name)
    )
    if text < isize(0) {
        return Result.Error[Option[EnvironmentValue], SystemError](
        processError("process.environment", name)
        )
    }
    if text == isize(0) {
        return Result.Ok[Option[EnvironmentValue], SystemError](
        Option.None[EnvironmentValue]()
        )
    }
    return Result.Ok[Option[EnvironmentValue], SystemError](
    Option.Some[EnvironmentValue](new EnvironmentValue(text))
    )
}

/// Résultat propriétaire d’un processus terminé et de ses sorties éventuellement capturées.
///
/// Les pointeurs retournés par les accesseurs de sortie sont empruntés et deviennent
/// invalides à la destruction. Les données sont brutes et ne sont pas validées UTF-8.
/// @param nativeResult Résultat natif propriétaire contenant le statut et les captures.
class ProcessResult(private var nativeResult : isize) {
    /// Retourne le code de terminaison rapporté par l’hôte.
    /// @return Code de sortie natif de l’enfant.
    def exitCode() : int {
        return janus_process_result_exit_code(nativeResult)
    }

    /// Emprunte le début de la sortie standard capturée.
    /// @return Pointeur lisible sur [[stdoutSize]] octets, valide pendant la vie de ce résultat.
    def stdoutData() : Ptr[byte] {
        return janus_process_result_stdout_data(nativeResult)
    }

    /// Retourne la taille de la sortie standard capturée.
    /// @return Nombre d’octets disponibles via [[stdoutData]], zéro si rien n’a été capturé.
    def stdoutSize() : usize {
        return janus_process_result_stdout_size(nativeResult)
    }

    /// Emprunte le début de la sortie d’erreur capturée.
    /// @return Pointeur lisible sur [[stderrSize]] octets, valide pendant la vie de ce résultat.
    def stderrData() : Ptr[byte] {
        return janus_process_result_stderr_data(nativeResult)
    }

    /// Retourne la taille de la sortie d’erreur capturée.
    /// @return Nombre d’octets disponibles via [[stderrData]], zéro si rien n’a été capturé.
    def stderrSize() : usize {
        return janus_process_result_stderr_size(nativeResult)
    }

    destructor {
        janus_process_result_destroy(nativeResult)
        nativeResult = isize(0)
    }
}

/// Lance un processus, attend sa terminaison et restitue son résultat propriétaire.
/// @param executable Chemin ou nom de l’exécutable interprété par la plateforme.
/// @param arguments Arguments transmis à l’enfant, sans ajout implicite documenté du nom de l’exécutable.
/// @param workingDirectory Répertoire de travail demandé ; le sens d’une chaîne vide dépend de l’implémentation native.
/// @param captureStdout Active la collecte de la sortie standard dans [[ProcessResult]].
/// @param captureStderr Active la collecte de la sortie d’erreur dans [[ProcessResult]].
/// @return `Ok(ProcessResult)` même si l’enfant termine avec un code non nul, ou `Error(SystemError)` si l’allocation ou le lancement échoue.
def runProcess(
executable : string,
arguments : Array[string],
workingDirectory : string,
captureStdout : bool,
captureStderr : bool
) : Result[ProcessResult, SystemError] {
    val count : usize = arguments.size()
    val argumentData : Ptr[Ptr[byte]] =
    alloc[Ptr[byte]](count)
    defer freeStorage(argumentData)
    if argumentData == null[Ptr[byte]]() && count != usize(0) {
        return Result.Error[ProcessResult, SystemError](
        processMemoryError(executable)
        )
    }
    val argumentLengths : Ptr[usize] = alloc[usize](count)
    defer free(argumentLengths)
    if argumentLengths == null[usize]() && count != usize(0) {
        return Result.Error[ProcessResult, SystemError](
        processMemoryError(executable)
        )
    }
    var index : usize = usize(0)
    while index < count {
        val argument : string = arguments.get(index)
        argumentData.initialize(index, stringData(argument))
        argumentLengths.store(index, stringLength(argument))
        index = index + usize(1)
    }
    val result : isize = janus_process_run(
    stringData(executable),
    stringLength(executable),
    argumentData,
    argumentLengths,
    count,
    stringData(workingDirectory),
    stringLength(workingDirectory),
    captureStdout,
    captureStderr
    )
    if result < isize(0) {
        return Result.Error[ProcessResult, SystemError](
        processError("process.run", executable)
        )
    }
    return Result.Ok[ProcessResult, SystemError](
    new ProcessResult(result)
    )
}
