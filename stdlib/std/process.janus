/// Consulte le contexte du processus courant et lance des processus enfants.
///
/// Les chaînes d’arguments du programme sont empruntées au runtime. Les valeurs
/// d’environnement et résultats de commande possèdent en revanche leurs buffers.
/// [[runProcess]] attend la fin de l’enfant et peut capturer ses sorties en octets.
/// @example
/// ```janus
/// val args = new Array[string](usize(1))
/// args.push("--version")
/// val result = runProcess("janus", args, "", true, true)
/// ```
module std.process

import std.array
import std.option
import std.result
import std.system

private extern def janus_process_argument_count() : usize
private extern def janus_process_argument_data(index : usize) : borrow Ptr[byte]
private extern def janus_process_argument_size(index : usize) : usize
private extern def janus_process_environment(
borrow name : Ptr[byte],
length : usize
) : isize
private extern def janus_process_current_directory() : isize
private extern def janus_process_text_data(text : isize) : borrow Ptr[byte]
private extern def janus_process_text_size(text : isize) : usize
private extern def janus_process_text_destroy(text : isize) : Unit
private extern def janus_process_run(
borrow executable : Ptr[byte],
executableLength : usize,
borrow arguments : Ptr[Ptr[byte]],
borrow argumentLengths : Ptr[usize],
argumentCount : usize,
borrow workingDirectory : Ptr[byte],
workingDirectoryLength : usize,
captureStdout : bool,
captureStderr : bool
) : isize
private extern def janus_process_spawn(
borrow executable : Ptr[byte],
executableLength : usize,
borrow arguments : Ptr[Ptr[byte]],
borrow argumentLengths : Ptr[usize],
argumentCount : usize,
borrow workingDirectory : Ptr[byte],
workingDirectoryLength : usize
) : isize
private extern def janus_process_child_write(
process : isize,
borrow data : Ptr[byte],
size : usize
) : isize
private extern def janus_process_child_read(
process : isize,
borrow data : Ptr[byte],
size : usize
) : isize
private extern def janus_process_child_try_write(
process : isize,
borrow data : Ptr[byte],
size : usize
) : isize
private extern def janus_process_child_try_read(
process : isize,
borrow data : Ptr[byte],
size : usize
) : isize
private extern def janus_process_child_close_input(process : isize) : int
private extern def janus_process_child_terminate(process : isize) : int
private extern def janus_process_child_try_wait(
process : isize,
borrow exitCode : Ptr[int]
) : int
private extern def janus_process_child_destroy(process : isize) : Unit
private extern def janus_process_result_exit_code(result : isize) : int
private extern def janus_process_result_stdout_data(
result : isize
) : borrow Ptr[byte]
private extern def janus_process_result_stdout_size(
result : isize
) : usize
private extern def janus_process_result_stderr_data(
result : isize
) : borrow Ptr[byte]
private extern def janus_process_result_stderr_size(
result : isize
) : usize
private extern def janus_process_result_destroy(result : isize) : Unit
private extern def janus_process_last_error_code() : uint
private extern def janus_process_last_error_category() : int

private def processError(
operation : string,
context : string
) : SystemError {
    return new SystemError(
    operation,
    SystemErrorCategory(janus_process_last_error_category()),
    janus_process_last_error_code(),
    context
    )
}

private def processMemoryError(
context : string
) : SystemError {
    return new SystemError(
    "process.run",
    SystemErrorCategory.ResourceExhausted,
    uint(0),
    context
    )
}

private def processSpawnMemoryError(context : string) : SystemError {
    return new SystemError(
    "process.spawn",
    SystemErrorCategory.ResourceExhausted,
    uint(0),
    context
    )
}

/// Retourne le nombre d’arguments du processus courant, nom du programme compris selon le runtime.
/// @return Nombre d’indices acceptés par [[programArgument]].
def programArgumentCount() : usize {
    return janus_process_argument_count()
}

/// Emprunte un argument du processus courant.
/// @param index Indice à partir de zéro.
/// @return `Some(string)` pour un indice valide, sinon `None`; la vue reste détenue par le runtime.
def programArgument(index : usize) : Option[string] {
    val data : Ptr[byte] = janus_process_argument_data(index)
    if data == null[byte]() {
        return Option.None[string]()
    }
    return Option.Some[string](
    stringView(data, janus_process_argument_size(index))
    )
}

/// Valeur d’environnement propriétaire obtenue par [[environmentVariable]].
///
/// Sa vue emprunte un stockage natif libéré avec l’objet.
/// @param nativeText Stockage natif transféré par l’API de processus.
class EnvironmentValue(private var nativeText : isize) {
    /// Emprunte le contenu exact de la variable, sans interpréter son encodage.
    /// @return Vue valide jusqu’à la destruction de cette [[EnvironmentValue]].
    borrow def view() : string {
        return stringView(
        janus_process_text_data(nativeText),
        janus_process_text_size(nativeText)
        )
    }

    /// Retourne la longueur de la valeur d’environnement.
    /// @return Taille en octets de [[view]].
    borrow def size() : usize {
        return janus_process_text_size(nativeText)
    }

    destructor {
        janus_process_text_destroy(nativeText)
        nativeText = isize(0)
    }
}

/// Répertoire de travail courant possédant sa représentation native UTF-8.
/// @param nativeText Stockage natif transféré par l’API de processus.
class WorkingDirectory(private var nativeText : isize) {
    /// Emprunte le chemin courant jusqu’à la destruction de cette valeur.
    /// @return Vue UTF-8 valide pendant la vie de cette [[WorkingDirectory]].
    borrow def view() : string {
        return stringView(
        janus_process_text_data(nativeText),
        janus_process_text_size(nativeText)
        )
    }

    destructor {
        janus_process_text_destroy(nativeText)
        nativeText = isize(0)
    }
}

/// Recherche une variable dans l’environnement du processus courant.
/// @param name Nom exact de la variable, encodé comme une chaîne Janus.
/// @return `Ok(Some(value))` si elle existe, `Ok(None)` si elle est absente, ou `Error(SystemError)` si la consultation native échoue.
def environmentVariable(
name : string
) : Result[Option[EnvironmentValue], SystemError] {
    val text : isize = janus_process_environment(
    stringData(name),
    stringLength(name)
    )
    if text < isize(0) {
        return Result.Error[Option[EnvironmentValue], SystemError](
        processError("process.environment", name)
        )
    }
    if text == isize(0) {
        return Result.Ok[Option[EnvironmentValue], SystemError](
        Option.None[EnvironmentValue]()
        )
    }
    return Result.Ok[Option[EnvironmentValue], SystemError](
    Option.Some[EnvironmentValue](new EnvironmentValue(text))
    )
}

/// Capture le répertoire de travail courant du processus.
/// @return Chemin UTF-8 propriétaire, ou une erreur système si l’hôte ne peut pas le fournir.
def currentWorkingDirectory(
) : Result[WorkingDirectory, SystemError] {
    val text : isize = janus_process_current_directory()
    if text < isize(0) {
        return Result.Error[WorkingDirectory, SystemError](
        processError("process.currentDirectory", "current directory")
        )
    }
    return Result.Ok[WorkingDirectory, SystemError](
    new WorkingDirectory(text)
    )
}

/// Résultat propriétaire d’un processus terminé et de ses sorties éventuellement capturées.
///
/// Les pointeurs retournés par les accesseurs de sortie sont empruntés et deviennent
/// invalides à la destruction. Les données sont brutes et ne sont pas validées UTF-8.
/// @param nativeResult Résultat natif propriétaire contenant le statut et les captures.
class ProcessResult(private var nativeResult : isize) {
    /// Retourne le code de terminaison rapporté par l’hôte.
    /// @return Code de sortie natif de l’enfant.
    borrow def exitCode() : int {
        return janus_process_result_exit_code(nativeResult)
    }

    /// Emprunte le début de la sortie standard capturée.
    /// @return Pointeur lisible sur [[stdoutSize]] octets, valide pendant la vie de ce résultat.
    borrow def stdoutData() : Ptr[byte] {
        return janus_process_result_stdout_data(nativeResult)
    }

    /// Retourne la taille de la sortie standard capturée.
    /// @return Nombre d’octets disponibles via [[stdoutData]], zéro si rien n’a été capturé.
    borrow def stdoutSize() : usize {
        return janus_process_result_stdout_size(nativeResult)
    }

    /// Emprunte le début de la sortie d’erreur capturée.
    /// @return Pointeur lisible sur [[stderrSize]] octets, valide pendant la vie de ce résultat.
    borrow def stderrData() : Ptr[byte] {
        return janus_process_result_stderr_data(nativeResult)
    }

    /// Retourne la taille de la sortie d’erreur capturée.
    /// @return Nombre d’octets disponibles via [[stderrData]], zéro si rien n’a été capturé.
    borrow def stderrSize() : usize {
        return janus_process_result_stderr_size(nativeResult)
    }

    destructor {
        janus_process_result_destroy(nativeResult)
        nativeResult = isize(0)
    }
}

/// Processus enfant persistant relié par des tubes à son entrée et sa sortie standard.
///
/// [[ChildProcess.read]] est bloquante, tandis que [[tryRead]] retourne immédiatement. Le
/// destructeur ferme les tubes et termine l’enfant s’il n’a pas déjà quitté ;
/// [[closeInput]] permet de lui signaler une fin de flux.
/// Cet objet propriétaire est mono-thread et non thread-safe : aucun autre thread
/// ne doit effectuer d’entrée-sortie concurrente sur ses handles.
/// @param nativeProcess Handle natif propriétaire créé par [[spawnProcess]].
class ChildProcess(private var nativeProcess : isize) {
    /// Demande la terminaison immédiate de l’enfant sans attendre sa sortie.
    ///
    /// Envoie `SIGKILL` sur POSIX et appelle `TerminateProcess` sur Windows.
    /// Utilisez [[tryWait]] pour observer ensuite la terminaison sans bloquer.
    /// @return `Ok(true)` si la demande a réussi ou si l’enfant était déjà terminé,
    /// sinon une erreur système.
    def terminate() : Result[bool, SystemError] {
        if janus_process_child_terminate(nativeProcess) != 0 {
            return Result.Error[bool, SystemError](
            processError("process.terminate", "child")
            )
        }
        return Result.Ok[bool, SystemError](true)
    }

    /// Observe la terminaison de l’enfant sans bloquer.
    /// @return `Ok(None)` si l’enfant est encore actif, `Ok(Some(exitCode))`
    /// s’il est terminé, sinon une erreur système.
    def tryWait() : Result[Option[int], SystemError] {
        val exitCode : Ptr[int] = alloc[int](usize(1))
        defer free(exitCode)
        if exitCode == null[int]() {
            return Result.Error[Option[int], SystemError](
            new SystemError(
            "process.tryWait",
            SystemErrorCategory.ResourceExhausted,
            uint(0),
            "child"
            )
            )
        }
        val state : int = janus_process_child_try_wait(nativeProcess, exitCode)
        if state < 0 {
            return Result.Error[Option[int], SystemError](
            processError("process.tryWait", "child")
            )
        }
        if state == 0 {
            return Result.Ok[Option[int], SystemError](Option.None[int]())
        }
        return Result.Ok[Option[int], SystemError](
        Option.Some[int](exitCode.load(usize(0)))
        )
    }

    /// Tente d’écrire immédiatement une partie des octets sans bloquer.
    ///
    /// Une taille nulle réussit. Si aucun octet ne peut être accepté immédiatement,
    /// retourne une erreur de catégorie `WouldBlock`.
    /// @param data Zone lisible sur `size` octets.
    /// @param size Nombre maximal d’octets à écrire.
    /// @return `Ok(count)` après progression immédiate, ou une erreur système.
    def tryWrite(
    data : Ptr[byte],
    size : usize
    ) : Result[usize, SystemError] {
        val count : isize = janus_process_child_try_write(
        nativeProcess,
        data,
        size
        )
        if count < isize(0) {
            return Result.Error[usize, SystemError](
            processError("process.tryWrite", "child")
            )
        }
        return Result.Ok[usize, SystemError](numericCast[usize](count))
    }

    /// Écrit tous les octets demandés sur l’entrée standard de l’enfant.
    /// @param data Zone lisible sur `size` octets.
    /// @param size Nombre d’octets à écrire.
    /// @return `Ok(size)` après écriture complète, ou une erreur système.
    def write(
    data : Ptr[byte],
    size : usize
    ) : Result[usize, SystemError] {
        val count : isize = janus_process_child_write(
        nativeProcess,
        data,
        size
        )
        if count < isize(0) {
            return Result.Error[usize, SystemError](
            processError("process.write", "child")
            )
        }
        return Result.Ok[usize, SystemError](numericCast[usize](count))
    }

    /// Écrit les octets UTF-8 d’une chaîne sur l’entrée standard de l’enfant.
    /// @param value Chaîne dont tous les octets sont transmis.
    /// @return `Ok` avec la taille écrite, ou une erreur système.
    def writeText(value : string) : Result[usize, SystemError] {
        return this.write(stringData(value), stringLength(value))
    }

    /// Lit au plus `capacity` octets depuis la sortie standard de l’enfant.
    ///
    /// L’appel bloque jusqu’à la disponibilité de données ou la fin du flux.
    /// @param target Zone inscriptible recevant au plus `capacity` octets.
    /// @param capacity Capacité disponible dans `target`.
    /// @return `Ok(0)` à la fin du flux, `Ok(count)` après lecture, ou une erreur système.
    def read(
    target : Ptr[byte],
    capacity : usize
    ) : Result[usize, SystemError] {
        val count : isize = janus_process_child_read(
        nativeProcess,
        target,
        capacity
        )
        if count < isize(0) {
            return Result.Error[usize, SystemError](
            processError("process.read", "child")
            )
        }
        return Result.Ok[usize, SystemError](numericCast[usize](count))
    }

    /// Tente de lire immédiatement des octets sans bloquer.
    ///
    /// Une taille nulle réussit. `Ok(0)` indique exclusivement la fin du flux;
    /// l’absence de progression immédiate retourne une erreur `WouldBlock`.
    /// @param target Zone inscriptible recevant au plus `capacity` octets.
    /// @param capacity Capacité disponible dans `target`.
    /// @return `Ok(count)`, `Ok(0)` à EOF, ou une erreur système.
    def tryRead(
    target : Ptr[byte],
    capacity : usize
    ) : Result[usize, SystemError] {
        val count : isize = janus_process_child_try_read(
        nativeProcess,
        target,
        capacity
        )
        if count < isize(0) {
            return Result.Error[usize, SystemError](
            processError("process.tryRead", "child")
            )
        }
        return Result.Ok[usize, SystemError](numericCast[usize](count))
    }

    /// Ferme l’entrée standard transmise à l’enfant de façon idempotente.
    /// @return `Ok(true)` après fermeture ou si elle l’était déjà, sinon une erreur système.
    def closeInput() : Result[bool, SystemError] {
        if janus_process_child_close_input(nativeProcess) != 0 {
            return Result.Error[bool, SystemError](
            processError("process.closeInput", "child")
            )
        }
        return Result.Ok[bool, SystemError](true)
    }

    destructor {
        janus_process_child_destroy(nativeProcess)
        nativeProcess = isize(0)
    }
}

/// Lance un processus interactif sans attendre sa terminaison.
///
/// L’entrée et la sortie standard sont reliées à un [[ChildProcess]]. La sortie
/// d’erreur reste héritée du parent afin qu’elle ne puisse pas bloquer l’enfant.
/// @param executable Chemin ou nom de l’exécutable interprété par la plateforme.
/// @param arguments Arguments transmis séparément à l’enfant.
/// @param workingDirectory Répertoire de travail, ou chaîne vide pour hériter du parent.
/// @return `Ok(ChildProcess)` après lancement, ou `Error(SystemError)` si l’enfant ne peut pas démarrer.
def spawnProcess(
executable : string,
arguments : Array[string],
workingDirectory : string
) : Result[ChildProcess, SystemError] {
    val count : usize = arguments.size()
    val argumentData : Ptr[Ptr[byte]] =
    alloc[Ptr[byte]](count)
    defer freeStorage(argumentData)
    if argumentData == null[Ptr[byte]]() && count != usize(0) {
        return Result.Error[ChildProcess, SystemError](
        processSpawnMemoryError(executable)
        )
    }
    val argumentLengths : Ptr[usize] = alloc[usize](count)
    defer free(argumentLengths)
    if argumentLengths == null[usize]() && count != usize(0) {
        return Result.Error[ChildProcess, SystemError](
        processSpawnMemoryError(executable)
        )
    }
    var index : usize = usize(0)
    while index < count {
        val argument : string = arguments.get(index)
        argumentData.initialize(index, stringData(argument))
        argumentLengths.store(index, stringLength(argument))
        index = index + usize(1)
    }
    val process : isize = janus_process_spawn(
    stringData(executable),
    stringLength(executable),
    argumentData,
    argumentLengths,
    count,
    stringData(workingDirectory),
    stringLength(workingDirectory)
    )
    if process < isize(0) {
        return Result.Error[ChildProcess, SystemError](
        processError("process.spawn", executable)
        )
    }
    return Result.Ok[ChildProcess, SystemError](new ChildProcess(process))
}

/// Lance un processus, attend sa terminaison et restitue son résultat propriétaire.
/// @param executable Chemin ou nom de l’exécutable interprété par la plateforme.
/// @param arguments Arguments transmis à l’enfant, sans ajout implicite documenté du nom de l’exécutable.
/// @param workingDirectory Répertoire de travail demandé ; le sens d’une chaîne vide dépend de l’implémentation native.
/// @param captureStdout Active la collecte de la sortie standard dans [[ProcessResult]].
/// @param captureStderr Active la collecte de la sortie d’erreur dans [[ProcessResult]].
/// @return `Ok(ProcessResult)` même si l’enfant termine avec un code non nul, ou `Error(SystemError)` si l’allocation ou le lancement échoue.
def runProcess(
executable : string,
arguments : Array[string],
workingDirectory : string,
captureStdout : bool,
captureStderr : bool
) : Result[ProcessResult, SystemError] {
    val count : usize = arguments.size()
    val argumentData : Ptr[Ptr[byte]] =
    alloc[Ptr[byte]](count)
    defer freeStorage(argumentData)
    if argumentData == null[Ptr[byte]]() && count != usize(0) {
        return Result.Error[ProcessResult, SystemError](
        processMemoryError(executable)
        )
    }
    val argumentLengths : Ptr[usize] = alloc[usize](count)
    defer free(argumentLengths)
    if argumentLengths == null[usize]() && count != usize(0) {
        return Result.Error[ProcessResult, SystemError](
        processMemoryError(executable)
        )
    }
    var index : usize = usize(0)
    while index < count {
        val argument : string = arguments.get(index)
        argumentData.initialize(index, stringData(argument))
        argumentLengths.store(index, stringLength(argument))
        index = index + usize(1)
    }
    val result : isize = janus_process_run(
    stringData(executable),
    stringLength(executable),
    argumentData,
    argumentLengths,
    count,
    stringData(workingDirectory),
    stringLength(workingDirectory),
    captureStdout,
    captureStderr
    )
    if result < isize(0) {
        return Result.Error[ProcessResult, SystemError](
        processError("process.run", executable)
        )
    }
    return Result.Ok[ProcessResult, SystemError](
    new ProcessResult(result)
    )
}
