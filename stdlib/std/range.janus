/// Construit des itérateurs sur des intervalles entiers semi-ouverts.
///
/// [[range]] produit `start` inclus à `end` exclu, par pas de un; l’intervalle est vide lorsque
/// `start >= end`.
/// @example
/// ```janus
/// for index in range(0, 3) {
///     println(index)
/// }
/// ```
module std.range
import std.iterator
import std.option

private class Range(
private var current : int,
private val end : int
) {
    def next() : Option[int] {
        if current >= end {
            return Option.None[int]()
        }
        val value : int = current
        current = current + 1
        return Option.Some[int](value)
    }

    def dispose() : Unit {
        delete this
    }
}

/// Fournit la sémantique de [[range]].
///
/// @param start Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param end Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[Iteratorint]].
def range(start : int, end : int) : Iterator[int] {
    val state : Range = new Range(start, end)
    return new Iterator[int](
    () => state.next(),
    () => state.dispose()
    )
}
