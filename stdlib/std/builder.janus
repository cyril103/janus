/// Décrit un accumulateur qui prend possession des valeurs ajoutées et produit une collection.
///
/// Le devenir de l’accumulateur après [[Builder.result]] dépend de son implémentation.
/// @example
/// ```janus
/// val builder : ArrayBuilder[int] = new ArrayBuilder(2)
/// builder.add(7)
/// val values : Array[int] = builder.result()
/// ```
module std.builder

/// Relie le type d’élément `T` au type de collection produite `C`.
trait Builder[T, C] {
    /// Transfère `value` à l’accumulateur.
    ///
    /// @param value Élément dont l’accumulateur prend possession.
    def add(value : T) : Unit
    /// Produit la collection à partir des éléments accumulés.
    ///
    /// @return Collection construite; son ownership est transféré à l’appelant.
    def result() : C
}
