/// Normalise, compose et inspecte les chemins natifs.
module std.path

import std.result
import std.system

private extern def janus_path_normalize(
path : Ptr[byte],
length : usize,
output : Ptr[Ptr[byte]],
outputLength : Ptr[usize]
) : int
private extern def janus_path_join(
base : Ptr[byte],
baseLength : usize,
child : Ptr[byte],
childLength : usize,
output : Ptr[Ptr[byte]],
outputLength : Ptr[usize]
) : int
private extern def janus_path_is_absolute(
path : Ptr[byte],
length : usize
) : int
private extern def janus_path_component_count(
path : Ptr[byte],
length : usize
) : int
private extern def janus_path_component(
path : Ptr[byte],
length : usize,
index : uint,
output : Ptr[Ptr[byte]],
outputLength : Ptr[usize]
) : int
private extern def janus_path_last_error_code() : uint
private extern def janus_path_last_error_category() : int
private extern def janus_path_free(data : Ptr[byte]) : Unit

private def pathError(
operation : string,
context : string
) : SystemError {
    return new SystemError(
    operation,
    SystemErrorCategory(janus_path_last_error_category()),
    janus_path_last_error_code(),
    context
    )
}

private def pathOutput() : Ptr[Ptr[byte]] {
    val output : Ptr[Ptr[byte]] =
    alloc[Ptr[byte]](usize(1))
    if output == null[Ptr[byte]]() {
        panic("Path output allocation failed\n")
    }
    return output
}

private def lengthOutput() : Ptr[usize] {
    val output : Ptr[usize] = alloc[usize](usize(1))
    if output == null[usize]() {
        panic("Path length allocation failed\n")
    }
    return output
}

/// Représente le type public `Path`.
class Path(
private var nativeData : Ptr[byte],
private val nativeLength : usize
) {
    /// Exécute l’opération publique `view`.
    def view() : string {
        return stringView(nativeData, nativeLength)
    }

    /// Retourne la longueur du chemin normalisé.
    def size() : usize {
        return nativeLength
    }

    /// Indique si le chemin est absolu.
    def isAbsolute() : bool {
        return janus_path_is_absolute(
        nativeData,
        nativeLength
        ) == 1
    }

    /// Exécute l’opération publique `componentCount`.
    def componentCount() : usize {
        val count : int = janus_path_component_count(
        nativeData,
        nativeLength
        )
        if count < 0 {
            return usize(0)
        }
        return usize(count)
    }

    /// Exécute l’opération publique `component`.
    def component(
    index : usize
    ) : Result[Path, SystemError] {
        val output : Ptr[Ptr[byte]] = pathOutput()
        defer free(output)
        val outputLength : Ptr[usize] = lengthOutput()
        defer free(outputLength)
        if janus_path_component(
        nativeData,
        nativeLength,
        uint(index),
        output,
        outputLength
        ) != 0 {
            return Result.Error[Path, SystemError](
            pathError("path.component", this.view())
            )
        }
        return Result.Ok[Path, SystemError](
        new Path(
        output.load(usize(0)),
        outputLength.load(usize(0))
        )
        )
    }

    destructor {
        janus_path_free(nativeData)
        nativeData = null[byte]()
    }
}

/// Exécute l’opération publique `normalizePath`.
def normalizePath(
path : string
) : Result[Path, SystemError] {
    val output : Ptr[Ptr[byte]] = pathOutput()
    defer free(output)
    val outputLength : Ptr[usize] = lengthOutput()
    defer free(outputLength)
    if janus_path_normalize(
    stringData(path),
    stringLength(path),
    output,
    outputLength
    ) != 0 {
        return Result.Error[Path, SystemError](
        pathError("path.normalize", path)
        )
    }
    return Result.Ok[Path, SystemError](
    new Path(
    output.load(usize(0)),
    outputLength.load(usize(0))
    )
    )
}

/// Exécute l’opération publique `joinPath`.
def joinPath(
base : string,
child : string
) : Result[Path, SystemError] {
    val output : Ptr[Ptr[byte]] = pathOutput()
    defer free(output)
    val outputLength : Ptr[usize] = lengthOutput()
    defer free(outputLength)
    if janus_path_join(
    stringData(base),
    stringLength(base),
    stringData(child),
    stringLength(child),
    output,
    outputLength
    ) != 0 {
        return Result.Error[Path, SystemError](
        pathError("path.join", base)
        )
    }
    return Result.Ok[Path, SystemError](
    new Path(
    output.load(usize(0)),
    outputLength.load(usize(0))
    )
    )
}
