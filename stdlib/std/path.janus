/// Normalise, compose et inspecte des chemins selon les règles de la plateforme.
///
/// Les [[Path]] retournés possèdent leur stockage natif. Les séparateurs, racines
/// et notions de chemin absolu sont délégués à l’hôte ; aucune existence sur le
/// système de fichiers n’est vérifiée.
/// @example
/// ```janus
/// val joined = joinPath("var", "log/app.log")
/// match joined {
///     Ok(path) => println(path.view()),
///     Error(error) => println(error.context)
/// }
/// ```
module std.path

import std.result
import std.system

private extern def janus_path_normalize(
path : Ptr[byte],
length : usize,
output : Ptr[Ptr[byte]],
outputLength : Ptr[usize]
) : int
private extern def janus_path_join(
base : Ptr[byte],
baseLength : usize,
child : Ptr[byte],
childLength : usize,
output : Ptr[Ptr[byte]],
outputLength : Ptr[usize]
) : int
private extern def janus_path_is_absolute(
path : Ptr[byte],
length : usize
) : int
private extern def janus_path_component_count(
path : Ptr[byte],
length : usize
) : int
private extern def janus_path_component(
path : Ptr[byte],
length : usize,
index : uint,
output : Ptr[Ptr[byte]],
outputLength : Ptr[usize]
) : int
private extern def janus_path_last_error_code() : uint
private extern def janus_path_last_error_category() : int
private extern def janus_path_free(data : Ptr[byte]) : Unit

private def pathError(
operation : string,
context : string
) : SystemError {
    return new SystemError(
    operation,
    SystemErrorCategory(janus_path_last_error_category()),
    janus_path_last_error_code(),
    context
    )
}

private def pathOutput() : Ptr[Ptr[byte]] {
    val output : Ptr[Ptr[byte]] =
    alloc[Ptr[byte]](usize(1))
    if output == null[Ptr[byte]]() {
        panic("Path output allocation failed\n")
    }
    return output
}

private def lengthOutput() : Ptr[usize] {
    val output : Ptr[usize] = alloc[usize](usize(1))
    if output == null[usize]() {
        panic("Path length allocation failed\n")
    }
    return output
}

/// Chemin natif normalisé possédant son tampon d’octets.
///
/// La vue produite par [[view]] emprunte ce tampon et cesse d’être valide à la
/// destruction du chemin. Un `Path` décrit une syntaxe de chemin, pas une entrée
/// nécessairement présente sur le système de fichiers.
/// @param nativeData Tampon natif normalisé dont l’objet prend possession.
/// @param nativeLength Nombre d’octets du chemin, hors éventuel terminateur natif.
class Path(
private var nativeData : Ptr[byte],
private val nativeLength : usize
) {
    /// Emprunte le chemin normalisé sous forme de chaîne.
    /// @return Vue valide jusqu’à la destruction de ce [[Path]].
    def view() : string {
        return stringView(nativeData, nativeLength)
    }

    /// Retourne la longueur du chemin normalisé en octets.
    /// @return Nombre d’octets de [[view]], hors éventuel terminateur natif.
    def size() : usize {
        return nativeLength
    }

    /// Teste si le chemin possède une racine absolue selon la plateforme.
    /// @return `true` si la syntaxe native considère le chemin absolu.
    def isAbsolute() : bool {
        return janus_path_is_absolute(
        nativeData,
        nativeLength
        ) == 1
    }

    /// Compte les composants du chemin normalisé.
    ///
    /// Une erreur native éventuelle est ramenée à zéro par cette API.
    /// @return Nombre de composants, ou zéro si le chemin n’en a aucun ou si le comptage natif échoue.
    def componentCount() : usize {
        val count : int = janus_path_component_count(
        nativeData,
        nativeLength
        )
        if count < 0 {
            return usize(0)
        }
        return usize(count)
    }

    /// Copie un composant du chemin dans un nouveau [[Path]] propriétaire.
    /// @param index Position du composant, à partir de zéro.
    /// @return `Ok` avec le composant, ou `Error(SystemError)` si l’indice ou le chemin est refusé par l’implémentation native.
    def component(
    index : usize
    ) : Result[Path, SystemError] {
        val output : Ptr[Ptr[byte]] = pathOutput()
        defer free(output)
        val outputLength : Ptr[usize] = lengthOutput()
        defer free(outputLength)
        if janus_path_component(
        nativeData,
        nativeLength,
        uint(index),
        output,
        outputLength
        ) != 0 {
            return Result.Error[Path, SystemError](
            pathError("path.component", this.view())
            )
        }
        return Result.Ok[Path, SystemError](
        new Path(
        output.load(usize(0)),
        outputLength.load(usize(0))
        )
        )
    }

    destructor {
        janus_path_free(nativeData)
        nativeData = null[byte]()
    }
}

/// Normalise un chemin avec les règles lexicales natives.
///
/// Cette opération alloue un [[Path]] mais n’accède pas nécessairement au système
/// de fichiers et ne garantit donc pas que la cible existe.
/// @param path Chemin source, exprimé dans la syntaxe de la plateforme.
/// @return `Ok(Path)` propriétaire, ou `Error(SystemError)` avec l’opération `path.normalize` et le chemin en contexte.
def normalizePath(
path : string
) : Result[Path, SystemError] {
    val output : Ptr[Ptr[byte]] = pathOutput()
    defer free(output)
    val outputLength : Ptr[usize] = lengthOutput()
    defer free(outputLength)
    if janus_path_normalize(
    stringData(path),
    stringLength(path),
    output,
    outputLength
    ) != 0 {
        return Result.Error[Path, SystemError](
        pathError("path.normalize", path)
        )
    }
    return Result.Ok[Path, SystemError](
    new Path(
    output.load(usize(0)),
    outputLength.load(usize(0))
    )
    )
}

/// Joint un chemin enfant à une base puis produit un [[Path]] normalisé.
/// @param base Chemin servant de base dans la syntaxe native.
/// @param child Chemin à joindre ; le traitement d’un enfant absolu dépend des règles natives.
/// @return `Ok(Path)` propriétaire, ou `Error(SystemError)` avec l’opération `path.join` et `base` en contexte.
def joinPath(
base : string,
child : string
) : Result[Path, SystemError] {
    val output : Ptr[Ptr[byte]] = pathOutput()
    defer free(output)
    val outputLength : Ptr[usize] = lengthOutput()
    defer free(outputLength)
    if janus_path_join(
    stringData(base),
    stringLength(base),
    stringData(child),
    stringLength(child),
    output,
    outputLength
    ) != 0 {
        return Result.Error[Path, SystemError](
        pathError("path.join", base)
        )
    }
    return Result.Ok[Path, SystemError](
    new Path(
    output.load(usize(0)),
    outputLength.load(usize(0))
    )
    )
}
