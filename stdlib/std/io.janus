/// Fournit des tampons d’octets et des flux propriétaires avec buffering explicite.
///
/// [[InputStream]] et [[OutputStream]] ferment les fichiers qu’ils ouvrent, mais
/// n’acquièrent pas les handles standard. Les chaînes sont traitées comme octets ;
/// seule [[ByteBuffer.asText]] valide explicitement UTF-8.
/// @example
/// ```janus
/// val opened = openInputStream("notes.txt")
/// match opened {
///     Ok(input) => input.readLine(),
///     Error(error) => println(error.context)
/// }
/// ```
module std.io

import std.option
import std.result
import std.system
import std.error
import std.bytes

private extern def janus_io_open(
borrow path : Ptr[byte],
length : usize,
mode : int
) : isize
private extern def janus_io_read(
handle : isize,
borrow data : Ptr[byte],
capacity : usize
) : isize
private extern def janus_io_write(
handle : isize,
borrow data : Ptr[byte],
offset : usize,
size : usize
) : isize
private extern def janus_io_close(handle : isize) : int
private extern def janus_io_flush(handle : isize) : int
private extern def janus_io_standard_handle(stream : int) : isize
private extern def janus_io_valid_utf8(
borrow data : Ptr[byte],
size : usize
) : int
private extern def janus_io_last_error_code() : uint
private extern def janus_io_last_error_category() : int

/// Décrit l’échec de conversion d’un [[ByteBuffer]] en texte.
enum TextDecodeError derives Copy, Equality, Debug {
    /// Le tampon contient au moins une séquence qui n’est pas un encodage UTF-8 valide.
    InvalidUtf8
}

private def ioError(
operation : string,
context : string
) : SystemError {
    return new SystemError(
    operation,
    SystemErrorCategory(janus_io_last_error_category()),
    janus_io_last_error_code(),
    context
    )
}

private def closedIoError(
operation : string,
context : string
) : SystemError {
    return new SystemError(
    operation,
    SystemErrorCategory.InvalidInput,
    uint(0),
    context
    )
}

private def memoryIoError(
operation : string,
context : string
) : SystemError {
    return new SystemError(
    operation,
    SystemErrorCategory.ResourceExhausted,
    uint(0),
    context
    )
}

/// Tampon binaire redimensionnable possédant son allocation.
///
/// Les pointeurs et vues empruntés sont invalidés par une croissance qui réalloue
/// le stockage et par la destruction. [[clear]] conserve la capacité réservée.
/// @param initialCapacity Nombre initial d’octets à réserver ; zéro est accepté.
class ByteBuffer(initialCapacity : usize) {
    private var nativeData : Ptr[byte] =
    alloc[byte](initialCapacity)
    private var nativeSize : usize = usize(0)
    private var allocated : usize = initialCapacity

    private def ensure(extra : usize) : bool {
        val required : usize = nativeSize + extra
        if required < nativeSize {
            return false
        }
        if required <= allocated && nativeData != null[byte]() {
            return true
        }
        var next : usize = allocated
        if next == usize(0) {
            next = usize(1)
        }
        while next < required {
            val grown : usize = next * usize(2)
            if grown <= next {
                next = required
            } else {
                next = grown
            }
        }
        val resized : Ptr[byte] =
        reallocPreserving[byte](nativeData, next)
        if resized == null[byte]() {
            free(resized)
            return false
        }
        nativeData = adoptReallocation[byte](nativeData, resized)
        allocated = next
        return true
    }

    /// Emprunte le début du stockage alloué.
    /// @return Pointeur lisible sur [[size]] octets, invalidable par une mutation ou la destruction.
    borrow def data() : borrow Ptr[byte] {
        return nativeData
    }

    /// Retourne le nombre d’octets stockés.
    /// @return Longueur logique du contenu.
    borrow def size() : usize {
        return nativeSize
    }

    /// Retourne la capacité actuellement réservée.
    /// @return Nombre d’octets disponibles avant une nouvelle allocation.
    borrow def capacity() : usize {
        return allocated
    }

    /// Indique si le tampon est vide.
    /// @return `true` lorsque [[size]] vaut zéro.
    borrow def isEmpty() : bool {
        return nativeSize == usize(0)
    }

    /// Observe le contenu avec une vue binaire bornée temporaire.
    /// @param action Callback borné recevant la vue complète.
    /// @return Résultat indépendant produit par `action`.
    borrow def withView[U](
    scoped action : (borrow ByteView) => U
    ) : U {
        defer delete action
        val view : ByteView =
        new ByteView(nativeData, usize(0), nativeSize)
        val result : U = action(view)
        delete view
        return move result
    }

    /// Vide le contenu sans libérer la capacité réservée.
    def clear() : Unit {
        nativeSize = usize(0)
    }

    /// Tente de réserver une capacité sans modifier la taille logique.
    /// @param requested Capacité minimale souhaitée.
    /// @return `Ok(true)` après croissance, `Ok(false)` si elle était suffisante, ou une [[CapacityError]].
    def tryReserve(requested : usize) : Result[bool, CapacityError] {
        if requested <= allocated && nativeData != null[byte]() {
            return Result.Ok[bool, CapacityError](false)
        }
        if requested < nativeSize {
            return Result.Ok[bool, CapacityError](false)
        }
        if !this.ensure(requested - nativeSize) {
            return Result.Error[bool, CapacityError](
            CapacityError.AllocationFailed
            )
        }
        return Result.Ok[bool, CapacityError](true)
    }

    /// Copie une zone d’octets à la fin du tampon.
    ///
    /// `source == data()` est pris en charge, mais aucun autre chevauchement n’est
    /// explicitement garanti. L’échec laisse la taille logique inchangée.
    /// @param source Zone lisible sur `count` octets, ou pointeur nul si `count` vaut zéro.
    /// @param count Nombre d’octets à copier.
    /// @return `true` après copie, `false` pour un pointeur nul non vide, un débordement de capacité ou un échec d’allocation.
    def append(
    source : Ptr[byte],
    count : usize
    ) : bool {
        if source == null[byte]() && count != usize(0) {
            return false
        }
        val aliasesBuffer : bool = source == nativeData
        if !this.ensure(count) {
            return false
        }
        borrow val readable : Ptr[byte] =
        if aliasesBuffer { nativeData } else { source }
        var index : usize = usize(0)
        while index < count {
            nativeData.store(
            nativeSize + index,
            readable.load(index)
            )
            index = index + usize(1)
        }
        nativeSize = nativeSize + count
        return true
    }

    /// Ajoute un octet au tampon.
    /// @param value Octet à copier.
    /// @return `true` après ajout, ou `false` si la croissance échoue.
    def appendByte(value : byte) : bool {
        if !this.ensure(usize(1)) {
            return false
        }
        nativeData.store(nativeSize, value)
        nativeSize = nativeSize + usize(1)
        return true
    }

    /// Ajoute les octets de la chaîne sans terminateur supplémentaire.
    /// @param value Chaîne dont les octets sont copiés ; aucune validation UTF-8 n’est effectuée.
    /// @return Le résultat booléen de [[append]].
    def appendText(value : string) : bool {
        return this.append(
        stringData(value),
        stringLength(value)
        )
    }

    /// Indique si le contenu forme une séquence UTF-8 valide.
    /// @return `true` si tous les octets constituent un UTF-8 valide, tampon vide compris.
    borrow def isUtf8() : bool {
        return janus_io_valid_utf8(
        nativeData,
        nativeSize
        ) == 1
    }

    /// Valide le contenu puis l’emprunte comme chaîne UTF-8.
    /// @return `Ok(string)` empruntant le tampon jusqu’à sa mutation ou destruction, ou `Error(InvalidUtf8)`.
    borrow def asText(
    ) : Result[string, TextDecodeError] {
        if !this.isUtf8() {
            return Result.Error[string, TextDecodeError](
            TextDecodeError.InvalidUtf8
            )
        }
        return Result.Ok[string, TextDecodeError](
        stringView(nativeData, nativeSize)
        )
    }

    destructor {
        free(nativeData)
        nativeData = null[byte]()
        nativeSize = usize(0)
        allocated = usize(0)
    }
}

private class LineBufferState(private var line : Option[ByteBuffer]) {
    private def takeLine() : Option[ByteBuffer] {
        val previous : Option[ByteBuffer] = move line
        line = Option.None[ByteBuffer]()
        return move previous
    }

    private def inspectLine(buffer : ByteBuffer) : bool {
        val result : bool = buffer.isEmpty()
        delete line
        line = Option.Some[ByteBuffer](move buffer)
        return result
    }

    private def appendToLine(buffer : ByteBuffer, value : byte) : bool {
        val result : bool = buffer.appendByte(value)
        delete line
        line = Option.Some[ByteBuffer](move buffer)
        return result
    }

    def isEmpty() : bool {
        val previous : Option[ByteBuffer] = this.takeLine()
        return match move previous {
            Some(buffer) => this.inspectLine(move buffer),
            None => true
        }
    }

    def appendByte(value : byte) : bool {
        val previous : Option[ByteBuffer] = this.takeLine()
        return match move previous {
            Some(buffer) => this.appendToLine(move buffer, value),
            None => false
        }
    }

    def some(
    ) : Result[Option[ByteBuffer], SystemError] {
        return Result.Ok[Option[ByteBuffer], SystemError](
        this.takeLine()
        )
    }

    def none(
    ) : Result[Option[ByteBuffer], SystemError] {
        delete this.takeLine()
        return Result.Ok[Option[ByteBuffer], SystemError](
        Option.None[ByteBuffer]()
        )
    }

    def fail(
    error : SystemError
    ) : Result[Option[ByteBuffer], SystemError] {
        delete this.takeLine()
        return Result.Error[Option[ByteBuffer], SystemError](
        error
        )
    }

    destructor {
        delete line
    }
}

/// Flux d’entrée tamponné, propriétaire ou empruntant un handle standard.
///
/// Les lectures consomment d’abord le tampon interne. La fin n’est connue qu’après
/// une lecture native renvoyant zéro. Le destructeur ferme uniquement les handles possédés.
/// @param nativeHandle Descripteur natif lu par le flux.
/// @param ownsHandle `true` si [[close]] et le destructeur doivent fermer ce descripteur.
/// @param streamContext Nom conservé pour contextualiser les erreurs de lecture.
/// @param requestedCapacity Capacité initiale, en octets, du tampon interne.
class InputStream(
private var nativeHandle : isize,
private val ownsHandle : bool,
private val streamContext : string,
private val requestedCapacity : usize
) {
    private var ended : bool = false
    private val bufferCapacity : usize =
    if requestedCapacity == usize(0) {
        usize(1)
    } else {
        requestedCapacity
    }
    private var buffer : Ptr[byte] =
    alloc[byte](bufferCapacity)
    private var bufferSize : usize = usize(0)
    private var bufferOffset : usize = usize(0)

    /// Indique si le flux d’entrée est ouvert.
    /// @return `true` tant que [[close]] n’a pas invalidé le handle.
    borrow def isOpen() : bool {
        return nativeHandle >= isize(0)
    }

    /// Indique si la fin du flux a été atteinte.
    /// @return `true` après observation de la fin native et consommation du tampon restant.
    borrow def isEof() : bool {
        return ended && bufferOffset >= bufferSize
    }

    private def refill() : isize {
        val count : isize = janus_io_read(
        nativeHandle,
        buffer,
        bufferCapacity
        )
        if count >= isize(0) {
            bufferSize = numericCast[usize](count)
            bufferOffset = usize(0)
            if count == isize(0) {
                ended = true
            }
        }
        return count
    }

    /// Copie au plus `capacity` octets depuis le tampon interne.
    ///
    /// Un appel réussi peut rendre moins d’octets que demandé sans signaler la fin.
    /// @param target Zone inscriptible sur `capacity` octets, ou pointeur nul si la capacité vaut zéro.
    /// @param capacity Maximum à copier.
    /// @return `Ok(count)`, avec zéro pour une demande vide ou la fin, ou `Error(SystemError)` si le flux est fermé, le pointeur invalide, l’allocation absente ou la lecture native échoue.
    def read(
    target : Ptr[byte],
    capacity : usize
    ) : Result[usize, SystemError] {
        if nativeHandle < isize(0) {
            return Result.Error[usize, SystemError](
            closedIoError("io.read", streamContext)
            )
        }
        if target == null[byte]() && capacity != usize(0) {
            return Result.Error[usize, SystemError](
            closedIoError("io.read", streamContext)
            )
        }
        if capacity == usize(0) {
            return Result.Ok[usize, SystemError](usize(0))
        }
        if buffer == null[byte]() {
            return Result.Error[usize, SystemError](
            memoryIoError("io.read", streamContext)
            )
        }
        if bufferOffset >= bufferSize {
            val count : isize = this.refill()
            if count < isize(0) {
                return Result.Error[usize, SystemError](
                ioError("io.read", streamContext)
                )
            }
            if count == isize(0) {
                return Result.Ok[usize, SystemError](usize(0))
            }
        }
        val remaining : usize = bufferSize - bufferOffset
        val count : usize =
        if capacity < remaining { capacity } else { remaining }
        var index : usize = usize(0)
        while index < count {
            target.store(
            index,
            buffer.load(bufferOffset + index)
            )
            index = index + usize(1)
        }
        bufferOffset = bufferOffset + count
        return Result.Ok[usize, SystemError](count)
    }

    /// Lit les octets jusqu’au prochain LF ou jusqu’à la fin.
    ///
    /// Le LF est consommé mais non inclus ; un CR précédent est conservé. Le résultat
    /// est binaire et doit être validé avec [[ByteBuffer.asText]] si du texte est attendu.
    /// @return `Ok(Some(ByteBuffer))` pour une ligne, y compris vide avant LF, `Ok(None)` à la fin sans octet, ou `Error(SystemError)`.
    def readLine(
    ) : Result[Option[ByteBuffer], SystemError] {
        if nativeHandle < isize(0) {
            return Result.Error[Option[ByteBuffer], SystemError](
            closedIoError("io.readLine", streamContext)
            )
        }
        if buffer == null[byte]() {
            return Result.Error[Option[ByteBuffer], SystemError](
            memoryIoError("io.readLine", streamContext)
            )
        }
        val state : LineBufferState =
        new LineBufferState(
        Option.Some[ByteBuffer](new ByteBuffer(usize(128)))
        )
        defer delete state
        while true {
            if bufferOffset >= bufferSize {
                val count : isize = this.refill()
                if count < isize(0) {
                    return state.fail(
                    ioError("io.readLine", streamContext)
                    )
                }
                if count == isize(0) {
                    if state.isEmpty() {
                        return state.none()
                    }
                    return state.some()
                }
            }
            val value : byte = buffer.load(bufferOffset)
            bufferOffset = bufferOffset + usize(1)
            if value == byte(10) {
                return state.some()
            }
            if !state.appendByte(value) {
                return state.fail(
                memoryIoError("io.readLine", streamContext)
                )
            }
        }
        return state.fail(
        memoryIoError("io.readLine", streamContext)
        )
    }

    /// Invalide le flux et ferme son handle seulement s’il lui appartient.
    /// @return `Ok(true)` en cas de succès, ou `Error(SystemError)` ; un second appel produit `InvalidInput`.
    def close() : Result[bool, SystemError] {
        if nativeHandle < isize(0) {
            return Result.Error[bool, SystemError](
            closedIoError("io.close", streamContext)
            )
        }
        val handle : isize = nativeHandle
        nativeHandle = isize(-1)
        if ownsHandle && janus_io_close(handle) != 0 {
            return Result.Error[bool, SystemError](
            ioError("io.close", streamContext)
            )
        }
        return Result.Ok[bool, SystemError](true)
    }

    destructor {
        if nativeHandle >= isize(0) {
            val handle : isize = nativeHandle
            nativeHandle = isize(-1)
            if ownsHandle {
                janus_io_close(handle)
            }
        }
        free(buffer)
        buffer = null[byte]()
    }
}

/// Flux de sortie tamponné qui possède éventuellement son handle natif.
///
/// [[write]] ne garantit pas que les octets ont atteint l’hôte ; appeler [[flush]]
/// ou [[close]] pour vider le tampon. Le destructeur tente ces opérations sans exposer leurs erreurs.
/// @param nativeHandle Descripteur natif recevant les octets du flux.
/// @param ownsHandle `true` si [[close]] et le destructeur doivent fermer ce descripteur.
/// @param streamContext Nom conservé pour contextualiser les erreurs d’écriture.
/// @param requestedCapacity Capacité initiale, en octets, du tampon interne.
class OutputStream(
private var nativeHandle : isize,
private val ownsHandle : bool,
private val streamContext : string,
private val requestedCapacity : usize
) {
    private val bufferCapacity : usize =
    if requestedCapacity == usize(0) {
        usize(1)
    } else {
        requestedCapacity
    }
    private var buffer : Ptr[byte] =
    alloc[byte](bufferCapacity)
    private var bufferSize : usize = usize(0)

    /// Indique si le flux de sortie est ouvert.
    /// @return `true` tant que [[close]] n’a pas invalidé le handle.
    borrow def isOpen() : bool {
        return nativeHandle >= isize(0)
    }

    private def drain() : int {
        var offset : usize = usize(0)
        while offset < bufferSize {
            val count : isize = janus_io_write(
            nativeHandle,
            buffer,
            offset,
            bufferSize - offset
            )
            if count <= isize(0) {
                return -1
            }
            offset = offset + numericCast[usize](count)
        }
        bufferSize = usize(0)
        return 0
    }

    /// Copie tous les octets fournis dans le tampon, en le vidant au besoin.
    /// @param source Zone lisible sur `size` octets, ou pointeur nul si `size` vaut zéro.
    /// @param size Nombre d’octets à accepter.
    /// @return `Ok(size)` lorsque tous les octets ont été acceptés, ou `Error(SystemError)` pour état fermé, entrée invalide, mémoire indisponible ou échec d’écriture native.
    def write(
    source : Ptr[byte],
    size : usize
    ) : Result[usize, SystemError] {
        if nativeHandle < isize(0) {
            return Result.Error[usize, SystemError](
            closedIoError("io.write", streamContext)
            )
        }
        if source == null[byte]() && size != usize(0) {
            return Result.Error[usize, SystemError](
            closedIoError("io.write", streamContext)
            )
        }
        if buffer == null[byte]() && size != usize(0) {
            return Result.Error[usize, SystemError](
            memoryIoError("io.write", streamContext)
            )
        }
        var sourceOffset : usize = usize(0)
        while sourceOffset < size {
            if bufferSize == bufferCapacity &&
            this.drain() != 0 {
                return Result.Error[usize, SystemError](
                ioError("io.write", streamContext)
                )
            }
            val availableBytes : usize =
            bufferCapacity - bufferSize
            val remaining : usize = size - sourceOffset
            val count : usize =
            if remaining < availableBytes {
                remaining
            } else {
                availableBytes
            }
            var index : usize = usize(0)
            while index < count {
                buffer.store(
                bufferSize + index,
                source.load(sourceOffset + index)
                )
                index = index + usize(1)
            }
            bufferSize = bufferSize + count
            sourceOffset = sourceOffset + count
        }
        return Result.Ok[usize, SystemError](size)
    }

    /// Copie les octets d’une chaîne dans le flux sans terminateur ajouté.
    /// @param value Chaîne à copier ; son encodage n’est pas transformé ni validé.
    /// @return Le résultat de [[write]], exprimé en octets acceptés.
    def writeText(
    value : string
    ) : Result[usize, SystemError] {
        return this.write(
        stringData(value),
        stringLength(value)
        )
    }

    /// Vide le tampon puis demande le flush du handle natif.
    /// @return `Ok(true)` après les deux étapes, ou `Error(SystemError)` si le flux est fermé ou une étape échoue.
    def flush() : Result[bool, SystemError] {
        if nativeHandle < isize(0) {
            return Result.Error[bool, SystemError](
            closedIoError("io.flush", streamContext)
            )
        }
        if this.drain() != 0 ||
        janus_io_flush(nativeHandle) != 0 {
            return Result.Error[bool, SystemError](
            ioError("io.flush", streamContext)
            )
        }
        return Result.Ok[bool, SystemError](true)
    }

    /// Vide, flush et invalide le flux, puis ferme le handle s’il est possédé.
    ///
    /// La première erreur rencontrée est renvoyée ; le handle est invalidé même en cas d’échec.
    /// @return `Ok(true)` si toutes les étapes réussissent, ou `Error(SystemError)` ; un second appel produit `InvalidInput`.
    def close() : Result[bool, SystemError] {
        if nativeHandle < isize(0) {
            return Result.Error[bool, SystemError](
            closedIoError("io.close", streamContext)
            )
        }
        val handle : isize = nativeHandle
        var failed : bool = false
        var saved : SystemError =
        closedIoError("io.close", streamContext)
        if this.drain() != 0 {
            failed = true
            saved = ioError("io.flush", streamContext)
        }
        nativeHandle = isize(-1)
        if janus_io_flush(handle) != 0 && !failed {
            failed = true
            saved = ioError("io.flush", streamContext)
        }
        if ownsHandle && janus_io_close(handle) != 0 && !failed {
            failed = true
            saved = ioError("io.close", streamContext)
        }
        if failed {
            return Result.Error[bool, SystemError](saved)
        }
        return Result.Ok[bool, SystemError](true)
    }

    destructor {
        if nativeHandle >= isize(0) {
            val handle : isize = nativeHandle
            this.drain()
            nativeHandle = isize(-1)
            janus_io_flush(handle)
            if ownsHandle {
                janus_io_close(handle)
            }
        }
        free(buffer)
        buffer = null[byte]()
    }
}

/// Ouvre un flux d’entrée avec la capacité de tampon demandée.
/// @param path Chemin natif ouvert en lecture.
/// @param bufferCapacity Capacité du tampon interne ; zéro est converti en un octet.
/// @return `Ok(InputStream)` propriétaire, ou `Error(SystemError)` avec l’opération `io.openInput`.
def openInputStreamBuffered(
path : string,
bufferCapacity : usize
) : Result[InputStream, SystemError] {
    val handle : isize = janus_io_open(
    stringData(path),
    stringLength(path),
    int(SystemOpenMode.Read)
    )
    if handle < isize(0) {
        return Result.Error[InputStream, SystemError](
        ioError("io.openInput", path)
        )
    }
    return Result.Ok[InputStream, SystemError](
    new InputStream(
    handle,
    true,
    path,
    bufferCapacity
    )
    )
}

/// Ouvre un flux d’entrée avec le tampon par défaut.
/// @param path Chemin natif ouvert en lecture.
/// @return Le résultat de [[openInputStreamBuffered]] avec une capacité de 4096 octets.
def openInputStream(
path : string
) : Result[InputStream, SystemError] {
    return openInputStreamBuffered(path, usize(4096))
}

/// Ouvre un flux de sortie avec la capacité de tampon demandée.
/// @param path Chemin natif à ouvrir.
/// @param append Si `true`, ouvre en ajout ; sinon utilise le mode d’écriture natif.
/// @param bufferCapacity Capacité du tampon interne ; zéro est converti en un octet.
/// @return `Ok(OutputStream)` propriétaire, ou `Error(SystemError)` avec l’opération `io.openOutput`.
def openOutputStreamBuffered(
path : string,
append : bool,
bufferCapacity : usize
) : Result[OutputStream, SystemError] {
    val mode : SystemOpenMode =
    if append {
        SystemOpenMode.Append
    } else {
        SystemOpenMode.Write
    }
    val handle : isize = janus_io_open(
    stringData(path),
    stringLength(path),
    int(mode)
    )
    if handle < isize(0) {
        return Result.Error[OutputStream, SystemError](
        ioError("io.openOutput", path)
        )
    }
    return Result.Ok[OutputStream, SystemError](
    new OutputStream(
    handle,
    true,
    path,
    bufferCapacity
    )
    )
}

/// Ouvre un flux de sortie avec le tampon par défaut.
/// @param path Chemin natif à ouvrir.
/// @param append Sélectionne l’ajout (`true`) ou l’écriture (`false`).
/// @return Le résultat de [[openOutputStreamBuffered]] avec une capacité de 4096 octets.
def openOutputStream(
path : string,
append : bool
) : Result[OutputStream, SystemError] {
    return openOutputStreamBuffered(
    path,
    append,
    usize(4096)
    )
}

/// Crée un flux tamponné empruntant l’entrée standard.
/// @return `Ok(InputStream)` qui ne fermera pas le handle standard, ou `Error(SystemError)` si celui-ci est indisponible.
def standardInput(
) : Result[InputStream, SystemError] {
    val handle : isize = janus_io_standard_handle(0)
    if handle < isize(0) {
        return Result.Error[InputStream, SystemError](
        ioError("io.stdin", "stdin")
        )
    }
    return Result.Ok[InputStream, SystemError](
    new InputStream(handle, false, "stdin", usize(4096))
    )
}

private def standardOutputFor(
stream : int,
context : string
) : Result[OutputStream, SystemError] {
    val handle : isize = janus_io_standard_handle(stream)
    if handle < isize(0) {
        return Result.Error[OutputStream, SystemError](
        ioError("io.standard", context)
        )
    }
    return Result.Ok[OutputStream, SystemError](
    new OutputStream(handle, false, context, usize(4096))
    )
}

/// Crée un flux tamponné empruntant la sortie standard.
/// @return `Ok(OutputStream)` qui flush mais ne ferme pas le handle standard, ou `Error(SystemError)`.
def standardOutput(
) : Result[OutputStream, SystemError] {
    return standardOutputFor(1, "stdout")
}

/// Crée un flux tamponné empruntant la sortie d’erreur standard.
/// @return `Ok(OutputStream)` qui flush mais ne ferme pas le handle standard, ou `Error(SystemError)`.
def standardError(
) : Result[OutputStream, SystemError] {
    return standardOutputFor(2, "stderr")
}

private struct IoCopyStep(
val count : usize,
val failed : bool,
val error : SystemError
) {}

private def copyStep(
result : Result[usize, SystemError]
) : IoCopyStep {
    return match result {
        Ok(count) => new IoCopyStep(
        count,
        false,
        closedIoError("io.copy", "stream")
        ),
        Error(error) => new IoCopyStep(
        usize(0),
        true,
        error
        )
    }
}

/// Copie un flux d’entrée vers un flux de sortie jusqu’à la fin observée.
///
/// La fonction utilise un tampon temporaire de 4096 octets et laisse la sortie
/// tamponnée : elle n’appelle pas [[OutputStream.flush]].
/// @param input Flux source, consommé depuis sa position courante mais non fermé.
/// @param output Flux destination, alimenté mais non fermé ni flushé.
/// @return `Ok(total)` avec le nombre d’octets acceptés, ou `Error(SystemError)` en cas d’allocation, lecture, écriture, incohérence ou débordement.
def copyStream(
input : InputStream,
output : OutputStream
) : Result[usize, SystemError] {
    val scratch : Ptr[byte] = alloc[byte](usize(4096))
    defer free(scratch)
    if scratch == null[byte]() {
        return Result.Error[usize, SystemError](
        memoryIoError("io.copy", "stream")
        )
    }
    var total : usize = usize(0)
    while true {
        val read : IoCopyStep = copyStep(
        input.read(scratch, usize(4096))
        )
        if read.failed {
            return Result.Error[usize, SystemError](
            read.error
            )
        }
        if read.count == usize(0) {
            return Result.Ok[usize, SystemError](total)
        }
        val written : IoCopyStep = copyStep(
        output.write(scratch, read.count)
        )
        if written.failed {
            return Result.Error[usize, SystemError](
            written.error
            )
        }
        if written.count != read.count ||
        total + written.count < total {
            return Result.Error[usize, SystemError](
            new SystemError(
            "io.copy",
            SystemErrorCategory.Other,
            uint(0),
            "stream"
            )
            )
        }
        total = total + written.count
    }
    return Result.Ok[usize, SystemError](total)
}
