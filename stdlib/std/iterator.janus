/// Définit le protocole de parcours séquentiel et ses combinateurs paresseux.
///
/// Un [[Iterator]] possède sa source et les fermetures nécessaires à son
/// avancement. Les combinateurs marqués `consume` transfèrent cette propriété au
/// nouvel itérateur ; détruire celui-ci libère toute source ou fonction encore
/// détenue. Le module convient aux chaînes de traitement qui évitent de créer
/// des collections intermédiaires.
/// @example
/// ```janus
/// val total : int = values.iterator()
///     .filter((value : int) => value > 0)
///     .map[int]((value : int) => value * 2)
///     .fold[int](0, (sum : int, value : int) => sum + value)
/// ```
module std.iterator
import std.option
import std.builder

/// Décrit une source capable de créer un parcours observant de ses valeurs.
///
/// La contrainte `Copy` permet à l’itérateur produit de rendre des copies sans
/// retirer les éléments de la source. L’instance source reste propriétaire de
/// son contenu et doit vivre aussi longtemps que le parcours.
trait Iterable[T] {
    /// Crée un itérateur positionné avant la première valeur de la source.
    ///
    /// Le parcours ne consomme pas la source et produit des copies de ses
    /// éléments. Chaque appel crée un état de parcours indépendant.
    /// @return Un nouvel [[Iterator]] observant les valeurs dans l’ordre de la source.
    borrow def iterator() : Iterator[T] where T <: Copy
}

/// Regroupe les deux valeurs produites au même rang par [[Iterator.zip]].
///
/// La structure possède `left` et `right`; sa destruction libère donc les
/// valeurs qu’elle contient lorsque leur type le requiert.
/// @param left Valeur provenant de l’itérateur de gauche.
/// @param right Valeur provenant de l’itérateur de droite.
struct ZipItem[A, B](
/// Valeur provenant de l’itérateur de gauche.
val left : A,
/// Valeur provenant de l’itérateur de droite.
val right : B
) {}

/// Associe une valeur à son rang dans un parcours énuméré.
///
/// Les indices commencent à zéro et augmentent d’une unité pour chaque valeur
/// produite par [[Iterator.enumerate]]. La structure possède `value`.
/// @param index Rang de la valeur, à partir de zéro.
/// @param value Valeur possédée provenant de l’itérateur source.
struct Indexed[T](
/// Rang de la valeur, à partir de zéro.
val index : usize,
/// Valeur possédée provenant de l’itérateur source.
val value : T
) {}

private class MapIteratorState[A, B](
private val source : Iterator[A],
private val transform : (A) => B
) {
    def next() : Option[B] {
        val value : Option[A] = source.next()
        return match move value {
            Some(item) => Option.Some[B](transform(move item)),
            None => Option.None[B]()
        }
    }

    def dispose() : Unit {
        delete this
    }

    destructor {
        delete transform
        delete source
    }
}

private class FilterIteratorState[T](
private val source : Iterator[T],
private val predicate : (borrow T) => bool
) {
    def next() : Option[T] {
        var candidate : Option[T] = source.next()
        while match candidate {
            Some(item) => !predicate(item),
            None => false
        } {
            delete candidate
            candidate = source.next()
        }
        return move candidate
    }

    def dispose() : Unit {
        delete this
    }

    destructor {
        delete predicate
        delete source
    }
}

private class TakeIteratorState[T](
private val source : Iterator[T],
private var remaining : usize
) {
    def next() : Option[T] {
        if remaining == usize(0) {
            return Option.None[T]()
        }
        remaining = remaining - usize(1)
        return source.next()
    }

    def dispose() : Unit {
        delete this
    }

    destructor {
        delete source
    }
}

private class ZipIteratorState[A, B](
private val left : Iterator[A],
private val right : Iterator[B]
) {
    private def combine(leftValue : A) : Option[ZipItem[A, B]] {
        val rightValue : Option[B] = right.next()
        return match move rightValue {
            Some(value) =>
            Option.Some[ZipItem[A, B]](
            new ZipItem[A, B](leftValue, move value)
            ),
            None => this.releaseUnpaired(leftValue)
        }
    }

    private def releaseUnpaired(leftValue : A) : Option[ZipItem[A, B]] {
        delete leftValue
        return Option.None[ZipItem[A, B]]()
    }

    def next() : Option[ZipItem[A, B]] {
        val leftValue : Option[A] = left.next()
        return match move leftValue {
            Some(value) => this.combine(move value),
            None => Option.None[ZipItem[A, B]]()
        }
    }

    def dispose() : Unit {
        delete this
    }

    destructor {
        delete left
        delete right
    }
}

private class EnumerateIteratorState[T](
private val source : Iterator[T],
private var index : usize
) {
    private def attachIndex(value : T) : Option[Indexed[T]] {
        val current : usize = index
        index = index + usize(1)
        return Option.Some[Indexed[T]](
        new Indexed[T](current, move value)
        )
    }

    def next() : Option[Indexed[T]] {
        val value : Option[T] = source.next()
        return match move value {
            Some(item) => this.attachIndex(move item),
            None => Option.None[Indexed[T]]()
        }
    }

    def dispose() : Unit {
        delete this
    }

    destructor {
        delete source
    }
}

private class FlatMapIteratorState[A, B](
private val source : Iterator[A],
private val transform : (A) => Iterator[B],
private var current : Option[Iterator[B]]
) {
    private def start(nextIterator : Iterator[B]) : bool {
        delete current
        current = Option.Some[Iterator[B]](move nextIterator)
        return true
    }

    private def startOuter(value : Option[A]) : bool {
        return match move value {
            Some(item) => this.start(transform(move item)),
            None => false
        }
    }

    private def poll(iterator : Iterator[B]) : Option[B] {
        val result : Option[B] = iterator.next()
        delete current
        current = Option.Some[Iterator[B]](move iterator)
        return move result
    }

    private def takeCurrent() : Option[Iterator[B]] {
        val active : Option[Iterator[B]] = move current
        current = Option.None[Iterator[B]]()
        return move active
    }

    def next() : Option[B] {
        while true {
            if isSome[Iterator[B]](current) {
                val active : Option[Iterator[B]] = this.takeCurrent()
                val value : Option[B] = match move active {
                    Some(iterator) => this.poll(move iterator),
                    None => Option.None[B]()
                }
                val available : bool = match value {
                    Some(item) => true,
                    None => false
                }
                if available {
                    return move value
                }
                delete value
                delete current
                current = Option.None[Iterator[B]]()
            }

            val outer : Option[A] = source.next()
            if !this.startOuter(move outer) {
                return Option.None[B]()
            }
        }
        return Option.None[B]()
    }

    def dispose() : Unit {
        delete this
    }

    destructor {
        delete current
        delete transform
        delete source
    }
}

/// Parcours séquentiel, paresseux et propriétaire de son état d’avancement.
///
/// `next` transfère chaque valeur produite à l’appelant. Les combinateurs
/// `consume` déplacent l’itérateur source et les fonctions fournies dans un
/// nouvel état; ils ne peuvent donc plus être utilisés séparément. Détruire un
/// parcours avant son épuisement libère les ressources restantes via `release`.
/// @param advance Fermeture appelée pour produire la prochaine valeur ou `None`.
/// @param release Fermeture appelée une fois lors de la destruction du parcours.
class Iterator[T](
private val advance : () => Option[T],
private val release : () => Unit
) {
    /// Produit la prochaine valeur et avance irréversiblement le parcours.
    ///
    /// Une fois la source épuisée, les appels suivants dépendent de la fermeture
    /// `advance`, mais les itérateurs de ce module continuent de rendre `None`.
    /// @return `Some` contenant la prochaine valeur possédée, ou `None` à la fin.
    def next() : Option[T] {
        return advance()
    }

    /// Transforme paresseusement chaque valeur du parcours.
    ///
    /// Cette méthode consomme le parcours et prend possession de `transform`.
    /// Chaque valeur source est déplacée vers la fonction au moment de l’appel à
    /// `next` du résultat.
    /// @param transform Fonction consommant une valeur source et produisant sa projection.
    /// @return Un itérateur propriétaire des valeurs transformées.
    consume def map[U](transform : (T) => U) : Iterator[U] {
        val state : MapIteratorState[T, U] =
        new MapIteratorState[T, U](move this, move transform)
        return new Iterator[U](
        () => state.next(),
        owningCapture[MapIteratorState[T, U]](
        state, () => state.dispose()
        )
        )
    }

    /// Conserve paresseusement les valeurs qui satisfont le prédicat.
    ///
    /// Le parcours et `predicate` sont consommés. Les valeurs refusées sont
    /// détruites avant la recherche de la suivante.
    /// @param predicate Fonction empruntant chaque valeur candidate pour la tester.
    /// @return Un itérateur produisant uniquement les valeurs acceptées.
    consume def filter(predicate : (borrow T) => bool) : Iterator[T] {
        val state : FilterIteratorState[T] =
        new FilterIteratorState[T](move this, move predicate)
        return new Iterator[T](
        () => state.next(),
        owningCapture[FilterIteratorState[T]](
        state, () => state.dispose()
        )
        )
    }

    /// Limite le parcours aux `count` premières valeurs disponibles.
    ///
    /// Cette méthode consomme la source. Détruire le résultat libère la partie de
    /// la source qui n’a pas été parcourue.
    /// @param count Nombre maximal de valeurs à produire.
    /// @return Un itérateur qui s’arrête après `count` valeurs ou à la fin de la source.
    consume def take(count : usize) : Iterator[T] {
        val state : TakeIteratorState[T] =
        new TakeIteratorState[T](move this, count)
        return new Iterator[T](
        () => state.next(),
        owningCapture[TakeIteratorState[T]](
        state, () => state.dispose()
        )
        )
    }

    /// Parcourt deux sources en parallèle et regroupe leurs valeurs de même rang.
    ///
    /// Les deux itérateurs sont consommés. Le résultat s’arrête dès que l’un des
    /// deux est épuisé; une valeur gauche déjà extraite sans partenaire droit est
    /// détruite, puis les restes des deux sources sont libérés avec le résultat.
    /// @param other Itérateur fournissant le membre droit de chaque paire.
    /// @return Un itérateur de [[ZipItem]], limité par la source la plus courte.
    consume def zip[U](
    other : Iterator[U]
    ) : Iterator[ZipItem[T, U]] {
        val state : ZipIteratorState[T, U] =
        new ZipIteratorState[T, U](move this, move other)
        return new Iterator[ZipItem[T, U]](
        () => state.next(),
        owningCapture[ZipIteratorState[T, U]](
        state, () => state.dispose()
        )
        )
    }

    /// Associe à chaque valeur son rang à partir de zéro.
    ///
    /// Le parcours source est consommé et chaque valeur est déplacée dans un
    /// nouvel [[Indexed]].
    /// @return Un itérateur de couples indice-valeur dans l’ordre source.
    consume def enumerate() : Iterator[Indexed[T]] {
        val state : EnumerateIteratorState[T] =
        new EnumerateIteratorState[T](move this, usize(0))
        return new Iterator[Indexed[T]](
        () => state.next(),
        owningCapture[EnumerateIteratorState[T]](
        state, () => state.dispose()
        )
        )
    }

    /// Transforme chaque valeur en itérateur puis concatène ces parcours.
    ///
    /// L’évaluation est paresseuse et conserve au plus un parcours intérieur
    /// actif. La source et `transform` sont consommés; chaque parcours intérieur
    /// est détruit dès son épuisement.
    /// @param transform Fonction consommant une valeur et produisant son parcours intérieur.
    /// @return Un itérateur produisant successivement toutes les valeurs intérieures.
    consume def flatMap[U](
    transform : (T) => Iterator[U]
    ) : Iterator[U] {
        val state : FlatMapIteratorState[T, U] =
        new FlatMapIteratorState[T, U](
        move this,
        move transform,
        Option.None[Iterator[U]]()
        )
        return new Iterator[U](
        () => state.next(),
        owningCapture[FlatMapIteratorState[T, U]](
        state, () => state.dispose()
        )
        )
    }

    /// Consomme toutes les valeurs dans le constructeur fourni.
    ///
    /// Chaque valeur est déplacée vers [[Builder.add]], puis le résultat est
    /// obtenu par [[Builder.result]]. Le constructeur reste utilisable selon le
    /// contrat de son implémentation.
    /// @param builder Constructeur recevant les valeurs dans l’ordre du parcours.
    /// @return La collection finalisée par le constructeur.
    consume def collectWith[C, B <: Builder[T, C]](
    borrow var builder : B
    ) : C {
        for value in move this {
            builder.add(move value)
        }
        return builder.result()
    }

    /// Réduit le parcours de gauche à droite à partir d’un accumulateur initial.
    ///
    /// Le parcours est consommé. À chaque étape, l’accumulateur courant et la
    /// prochaine valeur sont transmis à `combine`.
    /// @param initial Valeur initiale de l’accumulateur.
    /// @param combine Fonction produisant l’accumulateur de l’étape suivante.
    /// @return L’accumulateur final, ou `initial` si le parcours est vide.
    consume def fold[U](initial : U, combine : (U, T) => U) : U {
        var accumulator : U = initial
        for value in move this {
            accumulator = combine(move accumulator, move value)
        }
        return accumulator
    }

    destructor {
        release()
        delete advance
        delete release
    }
}
