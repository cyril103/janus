/// Définit le protocole de parcours séquentiel et ses combinateurs paresseux.
///
/// Un [[Iterator]] possède sa source et les fermetures nécessaires à son
/// avancement. Les combinateurs marqués `consume` transfèrent cette propriété au
/// nouvel itérateur ; détruire celui-ci libère toute source ou fonction encore
/// détenue. Le module convient aux chaînes de traitement qui évitent de créer
/// des collections intermédiaires.
/// @example
/// ```janus
/// val total : int = values.iterator()
///     .filter((value : int) => value > 0)
///     .map[int]((value : int) => value * 2)
///     .fold[int](0, (sum : int, value : int) => sum + value)
/// ```
module std.iterator
import std.option
import std.builder
import std.result

/// Décrit une source capable de créer un parcours observant de ses valeurs.
///
/// La contrainte `Copy` permet à l’itérateur produit de rendre des copies sans
/// retirer les éléments de la source. L’instance source reste propriétaire de
/// son contenu et doit vivre aussi longtemps que le parcours.
trait Iterable[T] {
    /// Crée un itérateur positionné avant la première valeur de la source.
    ///
    /// Le parcours ne consomme pas la source et produit des copies de ses
    /// éléments. Chaque appel crée un état de parcours indépendant.
    /// @return Un nouvel [[Iterator]] observant les valeurs dans l’ordre de la source.
    borrow def iterator() : Iterator[T] where T <: Copy
}

/// Décrit une source capable de transférer ses valeurs dans un parcours.
///
/// Contrairement à [[Iterable]], cette capacité consomme la source et n'exige
/// pas que ses éléments soient `Copy`. Elle convient donc aux collections de
/// ressources propriétaires.
trait IntoIterable[T] {
    /// Consomme la source et déplace ses éléments dans un itérateur.
    /// @return Un [[Iterator]] propriétaire des valeurs et de l'état restant.
    consume def intoIterator() : Iterator[T]
}

/// Regroupe les deux valeurs produites au même rang par [[Iterator.zip]].
///
/// La structure possède `left` et `right`; sa destruction libère donc les
/// valeurs qu’elle contient lorsque leur type le requiert.
/// @param left Valeur provenant de l’itérateur de gauche.
/// @param right Valeur provenant de l’itérateur de droite.
struct ZipItem[A, B](
    /// Valeur provenant de l’itérateur de gauche.
    val left : A,
    /// Valeur provenant de l’itérateur de droite.
    val right : B
) {}

/// Associe une valeur à son rang dans un parcours énuméré.
///
/// Les indices commencent à zéro et augmentent d’une unité pour chaque valeur
/// produite par [[Iterator.enumerate]]. La structure possède `value`.
/// @param index Rang de la valeur, à partir de zéro.
/// @param value Valeur possédée provenant de l’itérateur source.
struct Indexed[T](
    /// Rang de la valeur, à partir de zéro.
    val index : usize,
    /// Valeur possédée provenant de l’itérateur source.
    val value : T
) {}

/// Regroupe les deux collections produites par [[Iterator.partitionWith]].
/// @param accepted Collection des valeurs dont le prédicat vaut `true`.
/// @param rejected Collection des autres valeurs.
struct PartitionResult[A, B](
    /// Collection des valeurs acceptées, dans l'ordre source.
    val accepted : A,
    /// Collection des valeurs refusées, dans l'ordre source.
    val rejected : B
) {}

private def iteratorInvariant[T]() : T {
    panic("Iterator state invariant violated\n")
}

private def iteratorInvariantDiscard[T, U](value : U) : T {
    delete value
    panic("Iterator branch invariant violated\n")
}

private def takeSome[T](value : Option[T]) : T {
    return match move value {
        Some(item) => move item,
        None => iteratorInvariant[T]()
    }
}

private def takeOk[T, E](value : Result[T, E]) : T {
    return match move value {
        Ok(item) => move item,
        Error(error) => iteratorInvariantDiscard[T, E](move error)
    }
}

private class IteratorValueState[T](private var value : Option[T]) {
    def take() : T {
        val previous : Option[T] = move value
        value = Option.None[T]()
        return takeSome[T](move previous)
    }

    def store(next : T) : Unit {
        delete value
        value = Option.Some[T](move next)
    }

    destructor { delete value }
}

private class MapIteratorState[A, B](
    private val source : Iterator[A],
    private val transform : (A) => B
) {
    def next() : Option[B] {
        val value : Option[A] = source.next()
        return match move value {
            Some(item) => Option.Some[B](transform(move item)),
            None => Option.None[B]()
        }
    }

    def dispose() : Unit {
        delete this
    }

    destructor {
        delete transform
        delete source
    }
}

private class FilterIteratorState[T](
    private val source : Iterator[T],
    private val predicate : (borrow T) => bool
) {
    def next() : Option[T] {
        var candidate : Option[T] = source.next()
        while match candidate {
            Some(item) => !predicate(item),
            None => false
        } {
            delete candidate
            candidate = source.next()
        }
        return move candidate
    }

    def dispose() : Unit {
        delete this
    }

    destructor {
        delete predicate
        delete source
    }
}

private class TakeIteratorState[T](
    private val source : Iterator[T],
    private var remaining : usize
) {
    def next() : Option[T] {
        if remaining == usize(0) {
            return Option.None[T]()
        }
        remaining = remaining - usize(1)
        return source.next()
    }

    def dispose() : Unit {
        delete this
    }

    destructor {
        delete source
    }
}

private class DropIteratorState[T](
    private val source : Iterator[T],
    private var remaining : usize
) {
    def next() : Option[T] {
        while remaining > usize(0) {
            val skipped : Option[T] = source.next()
            if isNone[T](skipped) {
                delete skipped
                remaining = usize(0)
                return Option.None[T]()
            }
            delete skipped
            remaining = remaining - usize(1)
        }
        return source.next()
    }

    def dispose() : Unit { delete this }

    destructor { delete source }
}

private class ChainIteratorState[T](
    private var first : Option[Iterator[T]],
    private val second : Iterator[T]
) {
    private def pollFirst(iterator : Iterator[T]) : Option[T] {
        val value : Option[T] = iterator.next()
        if isSome[T](value) {
            delete first
            first = Option.Some[Iterator[T]](move iterator)
            return move value
        }
        delete value
        delete iterator
        return Option.None[T]()
    }

    def next() : Option[T] {
        if isSome[Iterator[T]](first) {
            val active : Option[Iterator[T]] = move first
            first = Option.None[Iterator[T]]()
            val value : Option[T] = match move active {
                Some(iterator) => this.pollFirst(move iterator),
                None => Option.None[T]()
            }
            if isSome[T](value) {
                return move value
            }
            delete value
        }
        return second.next()
    }

    def dispose() : Unit { delete this }

    destructor {
        delete second
        delete first
    }
}

private class FilterMapIteratorState[A, B](
    private val source : Iterator[A],
    private val transform : (A) => Option[B]
) {
    def next() : Option[B] {
        while true {
            val candidate : Option[A] = source.next()
            if isNone[A](candidate) {
                delete candidate
                return Option.None[B]()
            }
            val mapped : Option[B] = transform(takeSome[A](move candidate))
            if isSome[B](mapped) {
                return move mapped
            }
            delete mapped
        }
        return Option.None[B]()
    }

    def dispose() : Unit { delete this }

    destructor {
        delete transform
        delete source
    }
}

private class TakeWhileIteratorState[T](
    private val source : Iterator[T],
    private val predicate : (borrow T) => bool,
    private var finished : bool
) {
    def next() : Option[T] {
        if finished {
            return Option.None[T]()
        }
        val candidate : Option[T] = source.next()
        val accepted : bool = match candidate {
            Some(item) => predicate(item),
            None => false
        }
        if accepted {
            return move candidate
        }
        delete candidate
        finished = true
        return Option.None[T]()
    }

    def dispose() : Unit { delete this }

    destructor {
        delete predicate
        delete source
    }
}

private class SkipWhileIteratorState[T](
    private val source : Iterator[T],
    private val predicate : (borrow T) => bool,
    private var skipping : bool
) {
    def next() : Option[T] {
        while skipping {
            val candidate : Option[T] = source.next()
            if isNone[T](candidate) {
                delete candidate
                skipping = false
                return Option.None[T]()
            }
            val shouldSkip : bool = match candidate {
                Some(item) => predicate(item),
                None => false
            }
            if !shouldSkip {
                skipping = false
                return move candidate
            }
            delete candidate
        }
        return source.next()
    }

    def dispose() : Unit { delete this }

    destructor {
        delete predicate
        delete source
    }
}

private class ScanIteratorState[A, S, B](
    private val source : Iterator[A],
    private var state : S,
    private val transform : (borrow var S, A) => Option[B],
    private var finished : bool
) {
    def next() : Option[B] {
        if finished {
            return Option.None[B]()
        }
        val candidate : Option[A] = source.next()
        if isNone[A](candidate) {
            delete candidate
            finished = true
            return Option.None[B]()
        }
        val mapped : Option[B] = transform(
            state,
            takeSome[A](move candidate)
        )
        if isNone[B](mapped) {
            finished = true
        }
        return move mapped
    }

    def dispose() : Unit { delete this }

    destructor {
        delete transform
        delete state
        delete source
    }
}

private class ZipIteratorState[A, B](
    private val left : Iterator[A],
    private val right : Iterator[B]
) {
    private def combine(leftValue : A) : Option[ZipItem[A, B]] {
        val rightValue : Option[B] = right.next()
        return match move rightValue {
            Some(value) =>
            Option.Some[ZipItem[A, B]](
                new ZipItem[A, B](move leftValue, move value)
            ),
            None => this.releaseUnpaired(move leftValue)
        }
    }

    private def releaseUnpaired(leftValue : A) : Option[ZipItem[A, B]] {
        delete leftValue
        return Option.None[ZipItem[A, B]]()
    }

    def next() : Option[ZipItem[A, B]] {
        val leftValue : Option[A] = left.next()
        return match move leftValue {
            Some(value) => this.combine(move value),
            None => Option.None[ZipItem[A, B]]()
        }
    }

    def dispose() : Unit {
        delete this
    }

    destructor {
        delete left
        delete right
    }
}

private class EnumerateIteratorState[T](
    private val source : Iterator[T],
    private var index : usize
) {
    private def attachIndex(value : T) : Option[Indexed[T]] {
        val current : usize = index
        index = index + usize(1)
        return Option.Some[Indexed[T]](
            new Indexed[T](current, move value)
        )
    }

    def next() : Option[Indexed[T]] {
        val value : Option[T] = source.next()
        return match move value {
            Some(item) => this.attachIndex(move item),
            None => Option.None[Indexed[T]]()
        }
    }

    def dispose() : Unit {
        delete this
    }

    destructor {
        delete source
    }
}

private class FlatMapIteratorState[A, B](
    private val source : Iterator[A],
    private val transform : (A) => Iterator[B],
    private var current : Option[Iterator[B]]
) {
    private def start(nextIterator : Iterator[B]) : bool {
        delete current
        current = Option.Some[Iterator[B]](move nextIterator)
        return true
    }

    private def startOuter(value : Option[A]) : bool {
        return match move value {
            Some(item) => this.start(transform(move item)),
            None => false
        }
    }

    private def poll(iterator : Iterator[B]) : Option[B] {
        val result : Option[B] = iterator.next()
        delete current
        current = Option.Some[Iterator[B]](move iterator)
        return move result
    }

    private def takeCurrent() : Option[Iterator[B]] {
        val active : Option[Iterator[B]] = move current
        current = Option.None[Iterator[B]]()
        return move active
    }

    def next() : Option[B] {
        while true {
            if isSome[Iterator[B]](current) {
                val active : Option[Iterator[B]] = this.takeCurrent()
                val value : Option[B] = match move active {
                    Some(iterator) => this.poll(move iterator),
                    None => Option.None[B]()
                }
                val available : bool = match value {
                    Some(item) => true,
                    None => false
                }
                if available {
                    return move value
                }
                delete value
                delete current
                current = Option.None[Iterator[B]]()
            }

            val outer : Option[A] = source.next()
            if !this.startOuter(move outer) {
                return Option.None[B]()
            }
        }
        return Option.None[B]()
    }

    def dispose() : Unit {
        delete this
    }

    destructor {
        delete current
        delete transform
        delete source
    }
}

/// Parcours séquentiel, paresseux et propriétaire de son état d’avancement.
///
/// `next` transfère chaque valeur produite à l’appelant. Les combinateurs
/// `consume` déplacent l’itérateur source et les fonctions fournies dans un
/// nouvel état; ils ne peuvent donc plus être utilisés séparément. Détruire un
/// parcours avant son épuisement libère les ressources restantes via `release`.
/// @param advance Fermeture appelée pour produire la prochaine valeur ou `None`.
/// @param release Fermeture appelée une fois lors de la destruction du parcours.
class Iterator[T](
    private val advance : () => Option[T],
    private val release : () => Unit
) extends IntoIterable[T] {
    /// Produit la prochaine valeur et avance irréversiblement le parcours.
    ///
    /// Une fois la source épuisée, les appels suivants dépendent de la fermeture
    /// `advance`, mais les itérateurs de ce module continuent de rendre `None`.
    /// @return `Some` contenant la prochaine valeur possédée, ou `None` à la fin.
    def next() : Option[T] {
        return advance()
    }

    /// Retourne ce parcours en transférant sa propriété.
    /// @return Le même itérateur, déplacé vers l'appelant.
    consume def intoIterator() : Iterator[T] {
        return move this
    }

    /// Transforme paresseusement chaque valeur du parcours.
    ///
    /// Cette méthode consomme le parcours et prend possession de `transform`.
    /// Chaque valeur source est déplacée vers la fonction au moment de l’appel à
    /// `next` du résultat.
    /// @param transform Fonction consommant une valeur source et produisant sa projection.
    /// @return Un itérateur propriétaire des valeurs transformées.
    consume def map[U](transform : (T) => U) : Iterator[U] {
        val state : MapIteratorState[T, U] =
        new MapIteratorState[T, U](move this, move transform)
        return new Iterator[U](
            () => state.next(),
            owningCapture[MapIteratorState[T, U]](
            state, () => state.dispose()
            )
        )
    }

    /// Conserve paresseusement les valeurs qui satisfont le prédicat.
    ///
    /// Le parcours et `predicate` sont consommés. Les valeurs refusées sont
    /// détruites avant la recherche de la suivante.
    /// @param predicate Fonction empruntant chaque valeur candidate pour la tester.
    /// @return Un itérateur produisant uniquement les valeurs acceptées.
    consume def filter(predicate : (borrow T) => bool) : Iterator[T] {
        val state : FilterIteratorState[T] =
        new FilterIteratorState[T](move this, move predicate)
        return new Iterator[T](
            () => state.next(),
            owningCapture[FilterIteratorState[T]](
            state, () => state.dispose()
            )
        )
    }

    /// Limite le parcours aux `count` premières valeurs disponibles.
    ///
    /// Cette méthode consomme la source. Détruire le résultat libère la partie de
    /// la source qui n’a pas été parcourue.
    /// @param count Nombre maximal de valeurs à produire.
    /// @return Un itérateur qui s’arrête après `count` valeurs ou à la fin de la source.
    consume def take(count : usize) : Iterator[T] {
        val state : TakeIteratorState[T] =
        new TakeIteratorState[T](move this, count)
        return new Iterator[T](
            () => state.next(),
            owningCapture[TakeIteratorState[T]](
            state, () => state.dispose()
            )
        )
    }

    /// Ignore paresseusement les `count` premières valeurs disponibles.
    ///
    /// Aucun élément n'est demandé avant le premier `next` du résultat. Les
    /// valeurs ignorées sont détruites immédiatement et dans l'ordre source.
    /// @param count Nombre maximal de valeurs à ignorer.
    /// @return Un itérateur commençant après les valeurs ignorées.
    consume def drop(count : usize) : Iterator[T] {
        val state : DropIteratorState[T] =
        new DropIteratorState[T](move this, count)
        return new Iterator[T](
            () => state.next(),
            owningCapture[DropIteratorState[T]](
            state, () => state.dispose()
            )
        )
    }

    /// Concatène paresseusement ce parcours puis `other`.
    ///
    /// Le second parcours n'est interrogé qu'après l'épuisement du premier.
    /// Détruire le résultat libère les deux sources et leurs restes.
    /// @param other Parcours consommé après la fin du premier.
    /// @return Un itérateur produisant les deux sources dans leur ordre.
    consume def chain(other : Iterator[T]) : Iterator[T] {
        val state : ChainIteratorState[T] =
        new ChainIteratorState[T](
            Option.Some[Iterator[T]](move this),
            move other
        )
        return new Iterator[T](
            () => state.next(),
            owningCapture[ChainIteratorState[T]](
            state, () => state.dispose()
            )
        )
    }

    /// Transforme et filtre chaque valeur en une seule étape paresseuse.
    ///
    /// `Some` produit une valeur; `None` poursuit la recherche sans collection
    /// intermédiaire. La callback consomme chaque valeur demandée.
    /// @param transform Fonction retournant la projection éventuelle.
    /// @return Un itérateur des projections présentes.
    consume def filterMap[U](
        transform : (T) => Option[U]
    ) : Iterator[U] {
        val state : FilterMapIteratorState[T, U] =
        new FilterMapIteratorState[T, U](move this, move transform)
        return new Iterator[U](
            () => state.next(),
            owningCapture[FilterMapIteratorState[T, U]](
            state, () => state.dispose()
            )
        )
    }

    /// Produit les valeurs tant que le prédicat emprunté reste vrai.
    ///
    /// La première valeur refusée est détruite et termine définitivement le
    /// parcours. Les valeurs suivantes restent dans la source jusqu'à la
    /// destruction de l'itérateur.
    /// @param predicate Fonction observant chaque valeur demandée jusqu'au refus.
    /// @return Un itérateur du préfixe accepté.
    consume def takeWhile(
        predicate : (borrow T) => bool
    ) : Iterator[T] {
        val state : TakeWhileIteratorState[T] =
        new TakeWhileIteratorState[T](move this, move predicate, false)
        return new Iterator[T](
            () => state.next(),
            owningCapture[TakeWhileIteratorState[T]](
            state, () => state.dispose()
            )
        )
    }

    /// Ignore les valeurs tant que le prédicat emprunté reste vrai.
    ///
    /// Après le premier refus, le prédicat n'est plus appelé et toutes les
    /// valeurs suivantes sont retransmises directement.
    /// @param predicate Fonction observant le préfixe à ignorer.
    /// @return Un itérateur commençant à la première valeur refusée.
    consume def skipWhile(
        predicate : (borrow T) => bool
    ) : Iterator[T] {
        val state : SkipWhileIteratorState[T] =
        new SkipWhileIteratorState[T](move this, move predicate, true)
        return new Iterator[T](
            () => state.next(),
            owningCapture[SkipWhileIteratorState[T]](
            state, () => state.dispose()
            )
        )
    }

    /// Fait évoluer un état et produit paresseusement des projections.
    ///
    /// La callback emprunte l'état de façon mutable et consomme une valeur.
    /// `None` termine définitivement le parcours; `Some` produit la projection.
    /// @param initial État propriétaire conservé par l'adaptateur.
    /// @param transform Fonction mettant à jour l'état et produisant une valeur éventuelle.
    /// @return Un itérateur possédant la source, l'état et la callback.
    consume def scan[S, U](
        initial : S,
        transform : (borrow var S, T) => Option[U]
    ) : Iterator[U] {
        val state : ScanIteratorState[T, S, U] =
        new ScanIteratorState[T, S, U](
            move this, move initial, move transform, false
        )
        return new Iterator[U](
            () => state.next(),
            owningCapture[ScanIteratorState[T, S, U]](
            state, () => state.dispose()
            )
        )
    }

    /// Parcourt deux sources en parallèle et regroupe leurs valeurs de même rang.
    ///
    /// Les deux itérateurs sont consommés. Le résultat s’arrête dès que l’un des
    /// deux est épuisé; une valeur gauche déjà extraite sans partenaire droit est
    /// détruite, puis les restes des deux sources sont libérés avec le résultat.
    /// @param other Itérateur fournissant le membre droit de chaque paire.
    /// @return Un itérateur de [[ZipItem]], limité par la source la plus courte.
    consume def zip[U](
        other : Iterator[U]
    ) : Iterator[ZipItem[T, U]] {
        val state : ZipIteratorState[T, U] =
        new ZipIteratorState[T, U](move this, move other)
        return new Iterator[ZipItem[T, U]](
            () => state.next(),
            owningCapture[ZipIteratorState[T, U]](
            state, () => state.dispose()
            )
        )
    }

    /// Associe à chaque valeur son rang à partir de zéro.
    ///
    /// Le parcours source est consommé et chaque valeur est déplacée dans un
    /// nouvel [[Indexed]].
    /// @return Un itérateur de couples indice-valeur dans l’ordre source.
    consume def enumerate() : Iterator[Indexed[T]] {
        val state : EnumerateIteratorState[T] =
        new EnumerateIteratorState[T](move this, usize(0))
        return new Iterator[Indexed[T]](
            () => state.next(),
            owningCapture[EnumerateIteratorState[T]](
            state, () => state.dispose()
            )
        )
    }

    /// Transforme chaque valeur en itérateur puis concatène ces parcours.
    ///
    /// L’évaluation est paresseuse et conserve au plus un parcours intérieur
    /// actif. La source et `transform` sont consommés; chaque parcours intérieur
    /// est détruit dès son épuisement.
    /// @param transform Fonction consommant une valeur et produisant son parcours intérieur.
    /// @return Un itérateur produisant successivement toutes les valeurs intérieures.
    consume def flatMap[U](
        transform : (T) => Iterator[U]
    ) : Iterator[U] {
        val state : FlatMapIteratorState[T, U] =
        new FlatMapIteratorState[T, U](
            move this,
            move transform,
            Option.None[Iterator[U]]()
        )
        return new Iterator[U](
            () => state.next(),
            owningCapture[FlatMapIteratorState[T, U]](
            state, () => state.dispose()
            )
        )
    }

    /// Consomme toutes les valeurs dans le constructeur fourni.
    ///
    /// Chaque valeur est déplacée vers [[Builder.add]], puis le résultat est
    /// obtenu par [[Builder.result]]. Le constructeur reste utilisable selon le
    /// contrat de son implémentation.
    /// @param builder Constructeur recevant les valeurs dans l’ordre du parcours.
    /// @return La collection finalisée par le constructeur.
    consume def collectWith[C, B <: Builder[T, C]](
        borrow var builder : B
    ) : C {
        for value in move this {
            builder.add(move value)
        }
        return builder.result()
    }

    /// Réduit le parcours de gauche à droite à partir d’un accumulateur initial.
    ///
    /// Le parcours est consommé. À chaque étape, l’accumulateur courant et la
    /// prochaine valeur sont transmis à `combine`.
    /// @param initial Valeur initiale de l’accumulateur.
    /// @param combine Fonction produisant l’accumulateur de l’étape suivante.
    /// @return L’accumulateur final, ou `initial` si le parcours est vide.
    consume def fold[U](
        initial : U,
        scoped combine : (U, T) => U
    ) : U {
        var accumulator : U = move initial
        for value in move this {
            accumulator = combine(move accumulator, move value)
        }
        return move accumulator
    }

    /// Retourne la première valeur satisfaisant le prédicat.
    ///
    /// Le parcours s'arrête au premier succès. Les valeurs refusées et le reste
    /// de la source sont détruits exactement une fois.
    /// @param predicate Fonction empruntant chaque candidate jusqu'au succès.
    /// @return Première valeur acceptée, ou `None` après épuisement.
    consume def find(
        scoped predicate : (borrow T) => bool
    ) : Option[T] {
        defer delete predicate
        for value in move this {
            if predicate(value) {
                return Option.Some[T](move value)
            }
            delete value
        }
        return Option.None[T]()
    }

    /// Indique si au moins une valeur satisfait le prédicat.
    /// @param predicate Fonction empruntant les valeurs jusqu'au premier succès.
    /// @return `true` au premier succès, sinon `false` après épuisement.
    consume def any(scoped predicate : (borrow T) => bool) : bool {
        defer delete predicate
        for value in move this {
            val accepted : bool = predicate(value)
            delete value
            if accepted {
                return true
            }
        }
        return false
    }

    /// Indique si toutes les valeurs satisfont le prédicat.
    /// @param predicate Fonction empruntant les valeurs jusqu'au premier refus.
    /// @return `false` au premier refus, sinon `true`, y compris à vide.
    consume def all(scoped predicate : (borrow T) => bool) : bool {
        defer delete predicate
        for value in move this {
            val accepted : bool = predicate(value)
            delete value
            if !accepted {
                return false
            }
        }
        return true
    }

    /// Compte toutes les valeurs du parcours.
    /// @return Nombre de valeurs consommées et détruites.
    consume def count() : usize {
        var total : usize = usize(0)
        for value in move this {
            delete value
            total = total + usize(1)
        }
        return total
    }

    /// Réduit un parcours non vide sans accumulateur initial.
    /// @param combine Fonction combinant l'accumulateur et la valeur suivante.
    /// @return Accumulateur final dans `Some`, ou `None` pour une source vide.
    consume def reduce(
        scoped combine : (T, T) => T
    ) : Option[T] {
        defer delete combine
        val first : Option[T] = this.next()
        if isNone[T](first) {
            delete first
            return Option.None[T]()
        }
        val accumulator : IteratorValueState[T] =
        new IteratorValueState[T](move first)
        defer delete accumulator
        for value in move this {
            accumulator.store(combine(accumulator.take(), move value))
        }
        return Option.Some[T](accumulator.take())
    }

    /// Réduit de gauche à droite avec une étape susceptible d'échouer.
    ///
    /// La première erreur est retournée immédiatement : aucune valeur suivante
    /// n'est demandée et le reste de la source est détruit avec le parcours.
    /// @param initial Accumulateur initial propriétaire.
    /// @param combine Étape retournant le prochain accumulateur ou une erreur.
    /// @return Accumulateur final dans `Ok`, ou première erreur dans `Error`.
    consume def tryFold[U, E](
        initial : U,
        scoped combine : (U, T) => Result[U, E]
    ) : Result[U, E] {
        defer delete combine
        val accumulator : IteratorValueState[U] =
        new IteratorValueState[U](Option.Some[U](move initial))
        defer delete accumulator
        for value in move this {
            val step : Result[U, E] = combine(
                accumulator.take(),
                move value
            )
            if isError[U, E](step) {
                return move step
            }
            accumulator.store(takeOk[U, E](move step))
        }
        return Result.Ok[U, E](accumulator.take())
    }

    /// Répartit les valeurs entre deux constructeurs explicites.
    ///
    /// Le prédicat emprunte chaque valeur une fois; la valeur est ensuite
    /// déplacée vers `accepted` pour `true`, sinon vers `rejected`.
    /// @param predicate Fonction choisissant le constructeur de destination.
    /// @param accepted Constructeur des valeurs acceptées.
    /// @param rejected Constructeur des valeurs refusées.
    /// @return Les deux collections finalisées dans leur ordre source relatif.
    consume def partitionWith[
        A,
        B,
        Left <: Builder[T, A],
        Right <: Builder[T, B]
    ](
        scoped predicate : (borrow T) => bool,
        borrow var accepted : Left,
        borrow var rejected : Right
    ) : PartitionResult[A, B] {
        defer delete predicate
        for value in move this {
            if predicate(value) {
                accepted.add(move value)
            } else {
                rejected.add(move value)
            }
        }
        return new PartitionResult[A, B](
            accepted.result(),
            rejected.result()
        )
    }

    destructor {
        release()
        delete advance
        delete release
    }
}
