module std.hashmap
import std.array
import std.builder
import std.hash_probe
import std.hashing
import std.iterator
import std.option

struct MapEntry[K, V](val key : K, val value : V) {
    internal consume def insertInto[H <: Hashing[K]](
    destination : HashMap[K, V, H]
    ) : Unit {
        val previous : Option[V] =
        destination.put(move key, move value)
        delete previous
    }
}

private enum MapSlot[K, V] {
    Empty,
    Occupied(K, V),
    Deleted
}

private class MapEntryIteratorState[
K <: Copy,
V <: Copy,
H <: Hashing[K]
](
private val source : HashMap[K, V, H],
private var index : usize
) {
    def next() : Option[MapEntry[K, V]] {
        var result : Option[MapEntry[K, V]] =
        Option.None[MapEntry[K, V]]()
        while index < source.storageSize() && match result {
            Some(entry) => false,
            None => true
        } {
            result = source.entryAt(index)
            index = index + usize(1)
        }
        return result
    }

    def dispose() : Unit {
        delete this
    }
}

private class MapKeyIteratorState[K <: Copy, V, H <: Hashing[K]](
private val source : HashMap[K, V, H],
private var index : usize
) {
    def next() : Option[K] {
        var result : Option[K] = Option.None[K]()
        while index < source.storageSize() && match result {
            Some(key) => false,
            None => true
        } {
            result = source.keyAt(index)
            index = index + usize(1)
        }
        return result
    }

    def dispose() : Unit {
        delete this
    }
}

private class MapValueIteratorState[K, V <: Copy, H <: Hashing[K]](
private val source : HashMap[K, V, H],
private var index : usize
) {
    def next() : Option[V] {
        var result : Option[V] = Option.None[V]()
        while index < source.storageSize() && match result {
            Some(value) => false,
            None => true
        } {
            result = source.valueAt(index)
            index = index + usize(1)
        }
        return result
    }

    def dispose() : Unit {
        delete this
    }
}

class HashMap[K, V, H <: Hashing[K]](
initialCapacity : usize,
private val hashing : H
) {
    private var slotCapacity : usize =
    normalizedHashCapacity(initialCapacity)
    private var slots : Array[MapSlot[K, V]] =
    new Array[MapSlot[K, V]](slotCapacity)
    private var length : usize = usize(0)
    private var deletedCount : usize = usize(0)

    private def initializeSlots() : Unit {
        while slots.size() < slotCapacity {
            slots.push(MapSlot.Empty[K, V]())
        }
    }

    private def restoreOccupiedMatch(
    index : usize,
    existing : K,
    value : V,
    key : K
    ) : bool {
        val result : bool = hashing.equals(existing, key)
        slots.set(
        index,
        MapSlot.Occupied[K, V](move existing, move value)
        )
        return result
    }

    private def restoreOccupiedFalse(
    index : usize,
    key : K,
    value : V
    ) : bool {
        slots.set(
        index,
        MapSlot.Occupied[K, V](move key, move value)
        )
        return false
    }

    private def restoreDeleted(index : usize) : bool {
        slots.set(index, MapSlot.Deleted[K, V]())
        return false
    }

    private def matchesAt(index : usize, key : K) : bool {
        val slot : MapSlot[K, V] =
        slots.replace(index, MapSlot.Empty[K, V]())
        return match move slot {
            Occupied(existing, value) =>
            this.restoreOccupiedMatch(
            index,
            move existing,
            move value,
            key
            ),
            Empty => false,
            Deleted => this.restoreDeleted(index)
        }
    }

    private def isEmptyAt(index : usize) : bool {
        val slot : MapSlot[K, V] =
        slots.replace(index, MapSlot.Empty[K, V]())
        return match move slot {
            Empty => true,
            Occupied(key, value) =>
            this.restoreOccupiedFalse(index, move key, move value),
            Deleted => this.restoreDeleted(index)
        }
    }

    private def isDeletedAt(index : usize) : bool {
        val slot : MapSlot[K, V] =
        slots.replace(index, MapSlot.Empty[K, V]())
        return match move slot {
            Deleted => this.restoreDeleted(index) || true,
            Empty => false,
            Occupied(key, value) =>
            this.restoreOccupiedFalse(index, move key, move value)
        }
    }

    private def restoreAndCopyEntry(
    index : usize,
    key : K,
    value : V
    ) : Option[MapEntry[K, V]] {
        val result : Option[MapEntry[K, V]] =
        Option.Some[MapEntry[K, V]](
        new MapEntry[K, V](key, value)
        )
        slots.set(
        index,
        MapSlot.Occupied[K, V](move key, move value)
        )
        return result
    }

    private def restoreAndCopyKey(
    index : usize,
    key : K,
    value : V
    ) : Option[K] {
        val result : Option[K] = Option.Some[K](key)
        slots.set(
        index,
        MapSlot.Occupied[K, V](move key, move value)
        )
        return result
    }

    private def restoreAndCopyValue(
    index : usize,
    key : K,
    value : V
    ) : Option[V] {
        val result : Option[V] = Option.Some[V](value)
        slots.set(
        index,
        MapSlot.Occupied[K, V](move key, move value)
        )
        return result
    }

    private def restoreDeletedEntry(
    index : usize
    ) : Option[MapEntry[K, V]] {
        slots.set(index, MapSlot.Deleted[K, V]())
        return Option.None[MapEntry[K, V]]()
    }

    private def restoreDeletedKey(index : usize) : Option[K] {
        slots.set(index, MapSlot.Deleted[K, V]())
        return Option.None[K]()
    }

    private def restoreDeletedValue(index : usize) : Option[V] {
        slots.set(index, MapSlot.Deleted[K, V]())
        return Option.None[V]()
    }

    private def restoreValue(key : K, value : V) : bool {
        val previous : Option[V] = this.put(move key, move value)
        delete previous
        return true
    }

    private def restore(slot : MapSlot[K, V]) : bool {
        return match move slot {
            Occupied(key, value) =>
            this.restoreValue(move key, move value),
            Empty => false,
            Deleted => false
        }
    }

    private def resize(requested : usize) : Unit {
        val previous : Array[MapSlot[K, V]] = move slots
        slotCapacity = normalizedHashCapacity(requested)
        slots = new Array[MapSlot[K, V]](slotCapacity)
        length = usize(0)
        deletedCount = usize(0)
        this.initializeSlots()

        while !previous.isEmpty() {
            val slot : MapSlot[K, V] = previous.pop()
            this.restore(move slot)
        }
        delete previous
    }

    def size() : usize {
        return length
    }

    def isEmpty() : bool {
        return length == usize(0)
    }

    internal def storageSize() : usize {
        this.initializeSlots()
        return slotCapacity
    }

    internal def entryAt(index : usize) : Option[MapEntry[K, V]] {
        this.initializeSlots()
        if index >= slotCapacity {
            return Option.None[MapEntry[K, V]]()
        }
        val slot : MapSlot[K, V] =
        slots.replace(index, MapSlot.Empty[K, V]())
        return match move slot {
            Occupied(key, value) =>
            this.restoreAndCopyEntry(
            index,
            move key,
            move value
            ),
            Empty => Option.None[MapEntry[K, V]](),
            Deleted => this.restoreDeletedEntry(index)
        }
    }

    internal def keyAt(index : usize) : Option[K] {
        this.initializeSlots()
        if index >= slotCapacity {
            return Option.None[K]()
        }
        val slot : MapSlot[K, V] =
        slots.replace(index, MapSlot.Empty[K, V]())
        return match move slot {
            Occupied(key, value) =>
            this.restoreAndCopyKey(index, move key, move value),
            Empty => Option.None[K](),
            Deleted => this.restoreDeletedKey(index)
        }
    }

    internal def valueAt(index : usize) : Option[V] {
        this.initializeSlots()
        if index >= slotCapacity {
            return Option.None[V]()
        }
        val slot : MapSlot[K, V] =
        slots.replace(index, MapSlot.Empty[K, V]())
        return match move slot {
            Occupied(key, value) =>
            this.restoreAndCopyValue(index, move key, move value),
            Empty => Option.None[V](),
            Deleted => this.restoreDeletedValue(index)
        }
    }

    def containsKey(key : K) : bool {
        this.initializeSlots()
        var probe : HashProbe = hashProbe(hashing.hash(key), slotCapacity)
        while probe.hasNext() {
            val index : usize = probe.next()
            if this.matchesAt(index, key) {
                return true
            }
            if this.isEmptyAt(index) {
                return false
            }
        }
        return false
    }

    def getOption(key : K) : Option[V] {
        this.initializeSlots()
        var probe : HashProbe = hashProbe(hashing.hash(key), slotCapacity)
        while probe.hasNext() {
            val index : usize = probe.next()
            if this.matchesAt(index, key) {
                return this.copyValueAt(index)
            }
            if this.isEmptyAt(index) {
                return Option.None[V]()
            }
        }
        return Option.None[V]()
    }

    private def copyValueAt(index : usize) : Option[V] {
        val slot : MapSlot[K, V] =
        slots.replace(index, MapSlot.Empty[K, V]())
        return match move slot {
            Occupied(key, value) =>
            this.restoreAndCopyValue(index, move key, move value),
            Empty => Option.None[V](),
            Deleted => this.restoreDeletedValue(index)
        }
    }

    private def replaceAt(
    index : usize,
    key : K,
    value : V
    ) : Option[V] {
        val slot : MapSlot[K, V] =
        slots.replace(
        index,
        MapSlot.Occupied[K, V](move key, move value)
        )
        return match move slot {
            Occupied(previousKey, previousValue) =>
            this.releaseKey(
            move previousKey,
            move previousValue
            ),
            Empty => Option.None[V](),
            Deleted => Option.None[V]()
        }
    }

    def put(key : K, value : V) : Option[V] {
        this.initializeSlots()
        if hashTableShouldGrow(length, deletedCount, slotCapacity) {
            this.resize(slotCapacity * usize(2))
        }

        var probe : HashProbe = hashProbe(hashing.hash(key), slotCapacity)
        var firstDeleted : usize = usize(0)
        var hasDeleted : bool = false
        var destination : usize = slotCapacity
        var replacing : bool = false
        while probe.hasNext() {
            val index : usize = probe.next()
            if this.matchesAt(index, key) {
                destination = index
                replacing = true
                break
            }
            if this.isDeletedAt(index) && !hasDeleted {
                firstDeleted = index
                hasDeleted = true
            }
            if this.isEmptyAt(index) {
                destination = if hasDeleted {
                    firstDeleted
                } else {
                    index
                }
                break
            }
        }

        if replacing {
            return this.replaceAt(
            destination,
            move key,
            move value
            )
        }
        if destination < slotCapacity {
            slots.set(
            destination,
            MapSlot.Occupied[K, V](move key, move value)
            )
            length = length + usize(1)
            if hasDeleted {
                deletedCount = deletedCount - usize(1)
            }
            return Option.None[V]()
        }
        if hasDeleted {
            slots.set(
            firstDeleted,
            MapSlot.Occupied[K, V](move key, move value)
            )
            length = length + usize(1)
            deletedCount = deletedCount - usize(1)
            return Option.None[V]()
        }
        this.resize(slotCapacity * usize(2))
        return this.put(move key, move value)
    }

    def remove(key : K) : Option[V] {
        this.initializeSlots()
        var probe : HashProbe = hashProbe(hashing.hash(key), slotCapacity)
        while probe.hasNext() {
            val index : usize = probe.next()
            if this.matchesAt(index, key) {
                val removed : MapSlot[K, V] =
                slots.replace(index, MapSlot.Deleted[K, V]())
                length = length - usize(1)
                deletedCount = deletedCount + usize(1)
                return match move removed {
                    Occupied(storedKey, storedValue) =>
                    this.releaseKey(
                    move storedKey,
                    move storedValue
                    ),
                    Empty => Option.None[V](),
                    Deleted => Option.None[V]()
                }
            }
            if this.isEmptyAt(index) {
                return Option.None[V]()
            }
        }
        return Option.None[V]()
    }

    private def releaseKey(key : K, value : V) : Option[V] {
        delete key
        return Option.Some[V](move value)
    }

    def clear() : Unit {
        this.initializeSlots()
        var index : usize = usize(0)
        while index < slotCapacity {
            slots.set(index, MapSlot.Empty[K, V]())
            index = index + usize(1)
        }
        length = usize(0)
        deletedCount = usize(0)
    }

    def entries() : Iterator[MapEntry[K, V]] {
        val state : MapEntryIteratorState[K, V, H] =
        new MapEntryIteratorState[K, V, H](this, usize(0))
        return new Iterator[MapEntry[K, V]](
        () => state.next(),
        () => state.dispose()
        )
    }

    def keys() : Iterator[K] {
        val state : MapKeyIteratorState[K, V, H] =
        new MapKeyIteratorState[K, V, H](this, usize(0))
        return new Iterator[K](
        () => state.next(),
        () => state.dispose()
        )
    }

    def values() : Iterator[V] {
        val state : MapValueIteratorState[K, V, H] =
        new MapValueIteratorState[K, V, H](this, usize(0))
        return new Iterator[V](
        () => state.next(),
        () => state.dispose()
        )
    }

    destructor {
        delete slots
    }
}

class MapBuilder[K, V, H <: Hashing[K]](
initialCapacity : usize,
private val hashing : H
) extends Builder[MapEntry[K, V], HashMap[K, V, H]] {
    private var values : HashMap[K, V, H] =
    new HashMap[K, V, H](initialCapacity, hashing)

    def add(entry : MapEntry[K, V]) : Unit {
        entry.insertInto[H](values)
    }

    def size() : usize {
        return values.size()
    }

    def clear() : Unit {
        values.clear()
    }

    def result() : HashMap[K, V, H] {
        val completed : HashMap[K, V, H] = move values
        values = new HashMap[K, V, H](usize(8), hashing)
        return completed
    }

    destructor {
        delete values
    }
}
