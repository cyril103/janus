/// Fournit une table associative propriétaire fondée sur le hachage.
///
/// [[HashMap]] associe des clés à des valeurs selon une stratégie [[Hashing]],
/// avec sondage linéaire et redimensionnement automatique. Les opérations de
/// recherche sont amorties constantes lorsque les hachages sont bien répartis;
/// l’itération suit l’ordre interne des cases et non l’ordre d’insertion.
/// @example
/// ```janus
/// val scores : HashMap[int, int, IntHashing] =
///     new HashMap[int, int, IntHashing](usize(8), new IntHashing())
/// delete scores.put(7, 42)
/// val score : Option[int] = scores.getOption(7)
/// ```
module std.hashmap
import std.array
import std.builder
import std.hash_probe
import std.hashing
import std.iterator
import std.option

/// Paire propriétaire clé-valeur produite par les parcours d’une [[HashMap]].
///
/// Une entrée possède ses deux membres. Les méthodes `intoKey` et `intoValue`
/// consomment l’entrée, déplacent le membre demandé et détruisent l’autre.
/// @param key Clé dont l’entrée prend possession.
/// @param value Valeur associée dont l’entrée prend possession.
struct MapEntry[K, V](
/// Clé possédée de l’association.
val key : K,
/// Valeur possédée associée à [[MapEntry.key]].
val value : V
) {
    internal consume def insertInto[H <: Hashing[K]](
    destination : HashMap[K, V, H]
    ) : Unit {
        val previous : Option[V] =
        destination.put(move key, move value)
        delete previous
    }

    /// Consomme l’entrée pour n’en conserver que la clé.
    ///
    /// La valeur associée est détruite avant le retour.
    /// @return Clé déplacée hors de l’entrée.
    consume def intoKey() : K {
        delete value
        return move key
    }

    /// Consomme l’entrée pour n’en conserver que la valeur.
    ///
    /// La clé est détruite avant le retour.
    /// @return Valeur déplacée hors de l’entrée.
    consume def intoValue() : V {
        delete key
        return move value
    }
}

/// Décrit l’état interne d’une case de la table à adressage ouvert.
private enum MapSlot[K, V] {
    /// Case jamais occupée, qui termine une recherche par sondage.
    Empty,
    /// Case contenant une clé et sa valeur, toutes deux possédées par la table.
    Occupied(K, V),
    /// Tombstone conservant la continuité des chaînes de sondage après suppression.
    Deleted
}

private class MapEntryIteratorState[
K <: Copy,
V <: Copy,
H <: Hashing[K]
](
private borrow val source : HashMap[K, V, H],
private var index : usize
) {
    def next() : Option[MapEntry[K, V]] {
        var result : Option[MapEntry[K, V]] =
        Option.None[MapEntry[K, V]]()
        while index < source.storageSize() && match result {
            Some(entry) => false,
            None => true
        } {
            result = source.entryAt(index)
            index = index + usize(1)
        }
        return result
    }

    def dispose() : Unit {
        delete this
    }
}

private class MapKeyIteratorState[K <: Copy, V, H <: Hashing[K]](
private borrow val source : HashMap[K, V, H],
private var index : usize
) {
    def next() : Option[K] {
        var result : Option[K] = Option.None[K]()
        while index < source.storageSize() && match result {
            Some(key) => false,
            None => true
        } {
            result = source.keyAt(index)
            index = index + usize(1)
        }
        return result
    }

    def dispose() : Unit {
        delete this
    }
}

private class MapValueIteratorState[K, V <: Copy, H <: Hashing[K]](
private borrow val source : HashMap[K, V, H],
private var index : usize
) {
    def next() : Option[V] {
        var result : Option[V] = Option.None[V]()
        while index < source.storageSize() && match result {
            Some(value) => false,
            None => true
        } {
            result = source.valueAt(index)
            index = index + usize(1)
        }
        return result
    }

    def dispose() : Unit {
        delete this
    }
}

private class MapEntryIntoIteratorState[K, V, H <: Hashing[K]](
private val source : HashMap[K, V, H],
private var index : usize
) {
    def next() : Option[MapEntry[K, V]] {
        while index < source.storageSize() {
            val result : Option[MapEntry[K, V]] =
            source.takeEntryAt(index)
            index = index + usize(1)
            if isSome[MapEntry[K, V]](result) {
                return move result
            }
            delete result
        }
        return Option.None[MapEntry[K, V]]()
    }

    def dispose() : Unit {
        delete this
    }

    destructor {
        delete source
    }
}

/// Table associative propriétaire à adressage ouvert et sondage linéaire.
///
/// La table possède ses clés et ses valeurs, et emprunte la stratégie `hashing`. Une clé
/// existante est reconnue par [[Hashing.equals]] au sein de sa chaîne de sondage.
/// La capacité minimale est 8 et la table se réorganise lorsque valeurs et
/// tombstones approchent 75 % des cases. Les méthodes d’observation copient les
/// résultats concernés; [[HashMap.intoEntries]] transfère au contraire tout le
/// contenu sans copie.
/// @param initialCapacity Capacité souhaitée, normalisée à un minimum de 8.
/// @param hashing Stratégie d’égalité et de hachage empruntée par la table; elle doit rester vivante aussi longtemps qu’elle.
class HashMap[K, V, H <: Hashing[K]](
initialCapacity : usize,
private borrow val hashing : H
) {
    private var slotCapacity : usize =
    normalizedHashCapacity(initialCapacity)
    private var slots : Array[MapSlot[K, V]] =
    new Array[MapSlot[K, V]](slotCapacity)
    private var length : usize = usize(0)
    private var deletedCount : usize = usize(0)

    private def initializeSlots() : Unit {
        while slots.size() < slotCapacity {
            slots.push(MapSlot.Empty[K, V]())
        }
    }

    private def matchesAt(index : usize, borrow key : K) : bool {
        borrow val slot : MapSlot[K, V] = slots.getBorrowed(index)
        return match slot {
            Occupied(existing, value) =>
            hashing.equals(existing, key),
            Empty => false,
            Deleted => false
        }
    }

    private borrow def isEmptyAt(index : usize) : bool {
        borrow val slot : MapSlot[K, V] = slots.getBorrowed(index)
        return match slot {
            Empty => true,
            Occupied(key, value) => false,
            Deleted => false
        }
    }

    private borrow def isDeletedAt(index : usize) : bool {
        borrow val slot : MapSlot[K, V] = slots.getBorrowed(index)
        return match slot {
            Deleted => true,
            Empty => false,
            Occupied(key, value) => false
        }
    }

    private def restoreDeletedEntry(
    index : usize
    ) : Option[MapEntry[K, V]] {
        slots.set(index, MapSlot.Deleted[K, V]())
        return Option.None[MapEntry[K, V]]()
    }

    private def finishTakeEntry(
    key : K,
    value : V
    ) : Option[MapEntry[K, V]] {
        length = length - usize(1)
        deletedCount = deletedCount + usize(1)
        return Option.Some[MapEntry[K, V]](
        new MapEntry[K, V](move key, move value)
        )
    }

    private def restoreEmptyEntryTake(
    index : usize
    ) : Option[MapEntry[K, V]] {
        slots.set(index, MapSlot.Empty[K, V]())
        return Option.None[MapEntry[K, V]]()
    }

    internal def takeEntryAt(
    index : usize
    ) : Option[MapEntry[K, V]] {
        this.initializeSlots()
        if index >= slotCapacity {
            return Option.None[MapEntry[K, V]]()
        }
        val slot : MapSlot[K, V] =
        slots.replace(index, MapSlot.Deleted[K, V]())
        return match move slot {
            Occupied(key, value) =>
            this.finishTakeEntry(move key, move value),
            Empty => this.restoreEmptyEntryTake(index),
            Deleted => this.restoreDeletedEntry(index)
        }
    }

    private def restoreValue(key : K, value : V) : bool {
        val previous : Option[V] = this.put(move key, move value)
        delete previous
        return true
    }

    private def restore(slot : MapSlot[K, V]) : bool {
        return match move slot {
            Occupied(key, value) =>
            this.restoreValue(move key, move value),
            Empty => false,
            Deleted => false
        }
    }

    private def resize(requested : usize) : Unit {
        val previous : Array[MapSlot[K, V]] = move slots
        slotCapacity = normalizedHashCapacity(requested)
        slots = new Array[MapSlot[K, V]](slotCapacity)
        length = usize(0)
        deletedCount = usize(0)
        this.initializeSlots()

        while !previous.isEmpty() {
            val slot : MapSlot[K, V] = previous.pop()
            this.restore(move slot)
        }
        delete previous
    }

    /// Retourne le nombre d’associations stockées.
    /// @return Nombre de cases occupées, hors tombstones.
    borrow def size() : usize {
        return length
    }

    /// Indique si la table ne contient aucune association.
    /// @return `true` lorsque [[HashMap.size]] vaut zéro.
    borrow def isEmpty() : bool {
        return length == usize(0)
    }

    internal borrow def storageSize() : usize {
        return slotCapacity
    }

    internal borrow def entryAt(
    index : usize
    ) : Option[MapEntry[K, V]] where K <: Copy, V <: Copy {
        if index >= slots.size() {
            return Option.None[MapEntry[K, V]]()
        }
        borrow val slot : MapSlot[K, V] = slots.getBorrowed(index)
        return match slot {
            Occupied(key, value) =>
            Option.Some[MapEntry[K, V]](new MapEntry[K, V](key, value)),
            Empty => Option.None[MapEntry[K, V]](),
            Deleted => Option.None[MapEntry[K, V]]()
        }
    }

    internal borrow def keyAt(
    index : usize
    ) : Option[K] where K <: Copy {
        if index >= slots.size() {
            return Option.None[K]()
        }
        borrow val slot : MapSlot[K, V] = slots.getBorrowed(index)
        return match slot {
            Occupied(key, value) => Option.Some[K](key),
            Empty => Option.None[K](),
            Deleted => Option.None[K]()
        }
    }

    internal borrow def valueAt(
    index : usize
    ) : Option[V] where V <: Copy {
        if index >= slots.size() {
            return Option.None[V]()
        }
        borrow val slot : MapSlot[K, V] = slots.getBorrowed(index)
        return match slot {
            Occupied(key, value) => Option.Some[V](value),
            Empty => Option.None[V](),
            Deleted => Option.None[V]()
        }
    }

    /// Teste la présence d’une clé selon la stratégie de la table.
    ///
    /// `key` est seulement observée. Le coût est amorti constant avec un bon
    /// hachage et peut devenir linéaire en présence de nombreuses collisions.
    /// @param key Clé à hacher puis comparer aux clés stockées.
    /// @return `true` si une clé égale est présente.
    def containsKey(borrow key : K) : bool {
        if length == usize(0) {
            return false
        }
        var probe : HashProbe = hashProbe(hashing.hash(key), slotCapacity)
        while probe.hasNext() {
            val index : usize = probe.next()
            if this.matchesAt(index, key) {
                return true
            }
            if this.isEmptyAt(index) {
                return false
            }
        }
        return false
    }

    /// Retourne la valeur associée à la clé, si elle existe.
    ///
    /// La table conserve l’association et rend une copie de la valeur. La
    /// complexité suit celle de [[HashMap.containsKey]].
    /// @param key Clé observée utilisée pour la recherche.
    /// @return `Some` avec une copie de la valeur associée, ou `None` si absente.
    def getOption(
    borrow key : K
    ) : Option[V] where V <: Copy {
        if length == usize(0) {
            return Option.None[V]()
        }
        var probe : HashProbe = hashProbe(hashing.hash(key), slotCapacity)
        while probe.hasNext() {
            val index : usize = probe.next()
            if this.matchesAt(index, key) {
                return this.copyValueAt(index)
            }
            if this.isEmptyAt(index) {
                return Option.None[V]()
            }
        }
        return Option.None[V]()
    }

    /// Observe la valeur associée sans exiger qu'elle soit `Copy`.
    ///
    /// `action` est appelée exactement une fois lorsque la clé existe. La clé
    /// de recherche, la clé stockée et la valeur restent possédées par leurs
    /// propriétaires respectifs.
    /// @param key Clé observée utilisée pour la recherche.
    /// @param action Callback borné recevant un emprunt de la valeur stockée.
    /// @return `true` si la clé était présente et le callback a été appelé.
    def withValue(
    borrow key : K,
    scoped action : (borrow V) => Unit
    ) : bool {
        defer delete action
        if length == usize(0) {
            return false
        }
        var probe : HashProbe = hashProbe(hashing.hash(key), slotCapacity)
        while probe.hasNext() {
            val index : usize = probe.next()
            borrow val slot : MapSlot[K, V] = slots.getBorrowed(index)
            val found : bool = match slot {
                Occupied(storedKey, storedValue) =>
                this.observeEqual(storedKey, key, storedValue, action),
                Empty => false,
                Deleted => false
            }
            if found {
                return true
            }
            if this.isEmptyAt(index) {
                return false
            }
        }
        return false
    }

    private def observeEqual(
    borrow storedKey : K,
    borrow query : K,
    borrow storedValue : V,
    borrow action : (borrow V) => Unit
    ) : bool {
        if hashing.equals(storedKey, query) {
            action(storedValue)
            return true
        }
        return false
    }

    private borrow def copyValueAt(
    index : usize
    ) : Option[V] where V <: Copy {
        borrow val slot : MapSlot[K, V] = slots.getBorrowed(index)
        return match slot {
            Occupied(key, value) => Option.Some[V](value),
            Empty => Option.None[V](),
            Deleted => Option.None[V]()
        }
    }

    private def replaceAt(
    index : usize,
    key : K,
    value : V
    ) : Option[V] {
        val slot : MapSlot[K, V] =
        slots.replace(
        index,
        MapSlot.Occupied[K, V](move key, move value)
        )
        return match move slot {
            Occupied(previousKey, previousValue) =>
            this.releaseKey(
            move previousKey,
            move previousValue
            ),
            Empty => Option.None[V](),
            Deleted => Option.None[V]()
        }
    }

    /// Insère une association ou remplace la valeur d’une clé existante.
    ///
    /// La table prend possession de `key` et `value`. Lors d’un remplacement, la
    /// clé fournie devient la clé stockée, l’ancienne clé est détruite et
    /// l’ancienne valeur est rendue. Une insertion peut réorganiser toutes les
    /// cases pour agrandir la table ou éliminer les tombstones.
    /// @param key Clé déplacée dans la table.
    /// @param value Valeur déplacée dans la table.
    /// @return `Some` avec l’ancienne valeur remplacée, ou `None` pour une nouvelle clé.
    def put(key : K, value : V) : Option[V] {
        this.initializeSlots()
        var probe : HashProbe = hashProbe(hashing.hash(key), slotCapacity)
        var firstDeleted : usize = usize(0)
        var hasDeleted : bool = false
        var destination : usize = slotCapacity
        var replacing : bool = false
        while probe.hasNext() {
            val index : usize = probe.next()
            if this.matchesAt(index, key) {
                destination = index
                replacing = true
                break
            }
            if this.isDeletedAt(index) && !hasDeleted {
                firstDeleted = index
                hasDeleted = true
            }
            if this.isEmptyAt(index) {
                destination = if hasDeleted {
                    firstDeleted
                } else {
                    index
                }
                break
            }
        }

        if replacing {
            return this.replaceAt(
            destination,
            move key,
            move value
            )
        }
        if hashTableShouldGrow(length, deletedCount, slotCapacity) {
            val requested : usize =
            if hashTableShouldGrow(
            length,
            usize(0),
            slotCapacity
            ) {
                slotCapacity * usize(2)
            } else {
                slotCapacity
            }
            this.resize(requested)
            return this.put(move key, move value)
        }
        if destination < slotCapacity {
            slots.set(
            destination,
            MapSlot.Occupied[K, V](move key, move value)
            )
            length = length + usize(1)
            if hasDeleted {
                deletedCount = deletedCount - usize(1)
            }
            return Option.None[V]()
        }
        if hasDeleted {
            slots.set(
            firstDeleted,
            MapSlot.Occupied[K, V](move key, move value)
            )
            length = length + usize(1)
            deletedCount = deletedCount - usize(1)
            return Option.None[V]()
        }
        this.resize(slotCapacity * usize(2))
        return this.put(move key, move value)
    }

    /// Retire l’association et retourne son ancienne valeur.
    ///
    /// La clé de recherche est observée; si une association est trouvée, sa clé
    /// stockée est détruite et sa valeur est transférée à l’appelant. La case
    /// devient un tombstone jusqu’à une réorganisation ultérieure.
    /// @param key Clé à rechercher selon la stratégie de la table.
    /// @return `Some` avec la valeur retirée, ou `None` si la clé est absente.
    def remove(borrow key : K) : Option[V] {
        if length == usize(0) {
            return Option.None[V]()
        }
        var probe : HashProbe = hashProbe(hashing.hash(key), slotCapacity)
        while probe.hasNext() {
            val index : usize = probe.next()
            if this.matchesAt(index, key) {
                val removed : MapSlot[K, V] =
                slots.replace(index, MapSlot.Deleted[K, V]())
                length = length - usize(1)
                deletedCount = deletedCount + usize(1)
                return match move removed {
                    Occupied(storedKey, storedValue) =>
                    this.releaseKey(
                    move storedKey,
                    move storedValue
                    ),
                    Empty => Option.None[V](),
                    Deleted => Option.None[V]()
                }
            }
            if this.isEmptyAt(index) {
                return Option.None[V]()
            }
        }
        return Option.None[V]()
    }

    private def releaseKey(key : K, value : V) : Option[V] {
        delete key
        return Option.Some[V](move value)
    }

    /// Détruit toutes les clés et valeurs tout en conservant la capacité.
    ///
    /// Toutes les cases, tombstones compris, redeviennent vides. L’opération est
    /// linéaire dans la capacité de stockage.
    def clear() : Unit {
        this.initializeSlots()
        var index : usize = usize(0)
        while index < slotCapacity {
            slots.set(index, MapSlot.Empty[K, V]())
            index = index + usize(1)
        }
        length = usize(0)
        deletedCount = usize(0)
    }

    /// Crée un parcours observant de copies des associations.
    ///
    /// La table reste propriétaire de son contenu et doit vivre pendant le
    /// parcours. L’ordre correspond aux cases internes et peut changer après une
    /// insertion ou un redimensionnement.
    /// @return Un [[Iterator]] d’entrées copiées; exige clés et valeurs `Copy`.
    borrow def entries(
    ) : Iterator[MapEntry[K, V]] where K <: Copy, V <: Copy {
        val state : MapEntryIteratorState[K, V, H] =
        new MapEntryIteratorState[K, V, H](this, usize(0))
        return new Iterator[MapEntry[K, V]](
        () => state.next(),
        owningCapture[MapEntryIteratorState[K, V, H]](
        state, () => state.dispose()
        )
        )
    }

    /// Crée un parcours observant de copies des clés.
    ///
    /// La table n’est pas consommée et doit rester vivante pendant le parcours;
    /// l’ordre n’est ni trié ni garanti comme ordre d’insertion.
    /// @return Un [[Iterator]] de clés copiées; exige `K <: Copy`.
    borrow def keys() : Iterator[K] where K <: Copy {
        val state : MapKeyIteratorState[K, V, H] =
        new MapKeyIteratorState[K, V, H](this, usize(0))
        return new Iterator[K](
        () => state.next(),
        owningCapture[MapKeyIteratorState[K, V, H]](
        state, () => state.dispose()
        )
        )
    }

    /// Crée un parcours observant de copies des valeurs.
    ///
    /// La table conserve les associations et doit vivre pendant le parcours. Les
    /// valeurs suivent l’ordre interne des cases de leurs clés.
    /// @return Un [[Iterator]] de valeurs copiées; exige `V <: Copy`.
    borrow def values() : Iterator[V] where V <: Copy {
        val state : MapValueIteratorState[K, V, H] =
        new MapValueIteratorState[K, V, H](this, usize(0))
        return new Iterator[V](
        () => state.next(),
        owningCapture[MapValueIteratorState[K, V, H]](
        state, () => state.dispose()
        )
        )
    }

    /// Consomme la table et transfère ses associations à un parcours.
    ///
    /// Chaque entrée produite reçoit la clé et la valeur de sa case sans copie.
    /// Détruire prématurément l’itérateur détruit la table et toutes les
    /// associations qui n’ont pas été extraites.
    /// @return Un [[Iterator]] propriétaire des [[MapEntry]] de la table.
    consume def intoEntries() : Iterator[MapEntry[K, V]] {
        val state : MapEntryIntoIteratorState[K, V, H] =
        new MapEntryIntoIteratorState[K, V, H](move this, usize(0))
        return new Iterator[MapEntry[K, V]](
        () => state.next(),
        owningCapture[MapEntryIntoIteratorState[K, V, H]](
        state, () => state.dispose()
        )
        )
    }

    destructor {
        delete slots
    }
}

/// Constructeur mutable de [[HashMap]] à partir de [[MapEntry]].
///
/// Le constructeur possède la table en cours. `add` consomme chaque entrée et
/// détruit toute valeur remplacée. [[MapBuilder.result]] transfère la table
/// terminée puis réinitialise le constructeur avec une capacité de 8.
/// @param initialCapacity Capacité initiale souhaitée pour la table accumulée.
/// @param hashing Stratégie empruntée et réutilisée après chaque résultat.
class MapBuilder[K, V, H <: Hashing[K]](
initialCapacity : usize,
private borrow val hashing : H
) extends Builder[MapEntry[K, V], HashMap[K, V, H]] {
    private var values : HashMap[K, V, H] =
    new HashMap[K, V, H](initialCapacity, hashing)

    /// Ajoute une valeur.
    ///
    /// L’entrée est consommée. Si sa clé existe déjà, la valeur précédemment
    /// accumulée est détruite.
    /// @param entry Association dont la clé et la valeur sont transférées au constructeur.
    def add(entry : MapEntry[K, V]) : Unit {
        entry.insertInto[H](values)
    }

    /// Retourne le nombre d’associations accumulées.
    /// @return Nombre de clés distinctes dans la table en cours.
    borrow def size() : usize {
        return values.size()
    }

    /// Détruit toutes les associations accumulées sans changer la capacité.
    def clear() : Unit {
        values.clear()
    }

    /// Produit la table associative construite.
    ///
    /// La table courante est déplacée vers l’appelant. Le constructeur reste
    /// utilisable avec une nouvelle table vide de capacité initiale 8.
    /// @return [[HashMap]] possédant les associations accumulées.
    def result() : HashMap[K, V, H] {
        val completed : HashMap[K, V, H] = move values
        values = new HashMap[K, V, H](usize(8), hashing)
        return completed
    }

    destructor {
        delete values
    }
}
