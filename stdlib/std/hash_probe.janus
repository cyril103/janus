/// Fournit le sondage linéaire circulaire utilisé par les collections hachées.
///
/// Une sonde visite au plus une fois chaque case d’une capacité non nulle. Les
/// fonctions de ce module centralisent aussi la capacité minimale et le seuil de
/// croissance employés par [[HashMap]] et [[HashSet]].
/// @example
/// ```janus
/// val capacity : usize = normalizedHashCapacity(usize(3))
/// var probe : HashProbe = hashProbe(usize(42), capacity)
/// while probe.hasNext() {
///     val slot : usize = probe.next()
/// }
/// ```
module std.hash_probe

/// État d’un sondage linéaire circulaire borné à une table entière.
///
/// Chaque appel à [[HashProbe.next]] avance d’une case modulo `capacity`.
/// L’instance n’accède pas à la table et ne possède aucune de ses valeurs.
/// Une capacité nulle n’est pas valide pour une sonde créée par [[hashProbe]].
/// @param index Première case qui sera produite.
/// @param capacity Nombre maximal de cases à visiter; doit être non nul.
/// @param checked Nombre de cases considérées comme déjà visitées.
struct HashProbe(
private var index : usize,
private val capacity : usize,
private var checked : usize
) {
    /// Indique si une case non encore visitée reste disponible.
    /// @return `true` avant que `capacity` indices aient été produits.
    def hasNext() : bool {
        return checked < capacity
    }

    /// Retourne l’indice courant puis avance circulairement d’une case.
    ///
    /// L’appelant doit vérifier [[HashProbe.hasNext]] pour ne pas dépasser le
    /// nombre de cases de la table.
    /// @return Le prochain indice de case à examiner.
    def next() : usize {
        val current : usize = index
        index = (index + usize(1)) % capacity
        checked = checked + usize(1)
        return current
    }
}

/// Applique la capacité minimale des tables hachées.
/// @param requested Capacité souhaitée par l’appelant.
/// @return `requested` s’il vaut au moins 8, sinon 8.
def normalizedHashCapacity(requested : usize) : usize {
    return if requested < usize(8) {
        usize(8)
    } else {
        requested
    }
}

/// Indique si la table doit être agrandie avant une insertion.
///
/// Les cases supprimées comptent comme occupées pour déclencher soit un
/// nettoyage à capacité constante, soit un agrandissement. Le seuil correspond
/// à 75 % de la capacité, insertion projetée comprise.
/// @param length Nombre de valeurs actuellement présentes.
/// @param deletedCount Nombre de tombstones issus de suppressions.
/// @param capacity Nombre total de cases disponibles.
/// @return `true` si l’insertion suivante atteint ou dépasse le seuil.
def hashTableShouldGrow(
length : usize,
deletedCount : usize,
capacity : usize
) : bool {
    val threshold : usize = capacity - capacity / usize(4)
    return length + deletedCount + usize(1) >= threshold
}

/// Crée une sonde circulaire à partir du hachage.
/// @param hash Hachage dont le reste détermine la première case.
/// @param capacity Nombre de cases à visiter; doit être strictement positif.
/// @return Une sonde neuve pouvant produire exactement `capacity` indices.
def hashProbe(hash : usize, capacity : usize) : HashProbe {
    return new HashProbe(hash % capacity, capacity, usize(0))
}
