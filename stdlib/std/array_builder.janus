/// Construit des tableaux propriétaires à partir de valeurs ou d’itérateurs.
///
/// [[ArrayBuilder]] possède chaque valeur ajoutée. [[ArrayBuilder.result]] transfère le tableau
/// achevé et réinitialise le constructeur pour permettre sa réutilisation.
/// @example
/// ```janus
/// val builder : ArrayBuilder[int] = new ArrayBuilder(2)
/// builder.add(10)
/// val values : Array[int] = builder.result()
/// ```
module std.array_builder
import std.array
import std.builder
import std.iterator
import std.option
import std.result

private def collectionInvariant[T]() : T {
    panic("Array collection state invariant violated\n")
}

private def collectionInvariantDiscard[T, U](value : U) : T {
    delete value
    panic("Array collection branch invariant violated\n")
}

private def takeCollectedSome[T](value : Option[T]) : T {
    return match move value {
        Some(item) => move item,
        None => collectionInvariant[T]()
    }
}

private def takeCollectedOk[T, E](value : Result[T, E]) : T {
    return match move value {
        Ok(item) => move item,
        Error(error) => collectionInvariantDiscard[T, E](move error)
    }
}

private def takeCollectedError[T, E](value : Result[T, E]) : E {
    return match move value {
        Ok(item) => collectionInvariantDiscard[E, T](move item),
        Error(error) => move error
    }
}

/// Accumule des éléments propriétaires dans un tableau redimensionnable.
///
/// @param initialCapacity Nombre d’emplacements réservés avant le premier ajout.
class ArrayBuilder[T](
    initialCapacity : usize
) extends Builder[T, Array[T]] {
    private var values : Array[T] =
    new Array[T](initialCapacity)

    /// Déplace une valeur à la fin du tableau en construction.
    ///
    /// @param value Élément dont le constructeur prend possession.
    def add(value : T) : Unit {
        values.push(move value)
    }

    /// Épuise la source et ajoute ses éléments dans leur ordre d’itération.
    ///
    /// @param source Source parcourue jusqu’à sa fin.
    def addAll[C <: Iterable[T]](
        borrow source : C
    ) : Unit where T <: Copy {
        for value in source {
            this.add(value)
        }
    }

    /// Compte les éléments actuellement accumulés.
    ///
    /// @return Nombre d’éléments que produirait immédiatement [[result]].
    pure borrow def size() : usize {
        return values.size()
    }

    /// Détruit les éléments accumulés et rend le constructeur vide.
    def clear() : Unit {
        values.clear()
    }

    /// Transfère les éléments accumulés dans un nouveau tableau.
    ///
    /// Le constructeur reste utilisable et repart avec une capacité initiale nulle.
    ///
    /// @return Tableau propriétaire contenant les éléments dans leur ordre d’ajout.
    def result() : Array[T] {
        val completed : Array[T] = move values
        values = new Array[T](usize(0))
        return move completed
    }

    destructor {
        delete values
    }
}

/// Épuise un itérateur dans un nouveau tableau propriétaire.
///
/// @param source Itérateur consommé pendant la collecte.
/// @return Tableau contenant les valeurs dans leur ordre d’itération.
def collectArray[T](source : Iterator[T]) : Array[T] {
    val builder : ArrayBuilder[T] =
    new ArrayBuilder[T](usize(0))
    defer delete builder
    return source.collectWith[Array[T], ArrayBuilder[T]](builder)
}

/// Collecte les succès jusqu'à la première erreur.
///
/// La source n'est plus interrogée après `Error`. Le constructeur et ses
/// succès partiels sont alors détruits, ainsi que le reste de l'itérateur.
/// @param source Parcours de résultats consommé dans l'ordre.
/// @return Tableau des succès, ou première erreur rencontrée.
def collectResult[T, E](
    source : Iterator[Result[T, E]]
) : Result[Array[T], E] {
    val builder : ArrayBuilder[T] = new ArrayBuilder[T](usize(0))
    defer delete builder
    for current in move source {
        if isError[T, E](current) {
            return Result.Error[Array[T], E](
                takeCollectedError[T, E](move current)
            )
        }
        builder.add(takeCollectedOk[T, E](move current))
    }
    return Result.Ok[Array[T], E](builder.result())
}

/// Collecte les valeurs présentes jusqu'à la première absence.
///
/// La source n'est plus interrogée après `None`. Le constructeur et ses
/// valeurs partielles sont alors détruits avec le reste du parcours.
/// @param source Parcours d'options consommé dans l'ordre.
/// @return Tableau dans `Some`, ou `None` à la première absence.
def collectOption[T](source : Iterator[Option[T]]) : Option[Array[T]] {
    val builder : ArrayBuilder[T] = new ArrayBuilder[T](usize(0))
    defer delete builder
    for current in move source {
        if isNone[T](current) {
            delete current
            return Option.None[Array[T]]()
        }
        builder.add(takeCollectedSome[T](move current))
    }
    return Option.Some[Array[T]](builder.result())
}
