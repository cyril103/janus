/// Construit des tableaux propriétaires à partir de valeurs ou d’itérateurs.
///
/// [[ArrayBuilder]] possède chaque valeur ajoutée. [[ArrayBuilder.result]] transfère le tableau
/// achevé et réinitialise le constructeur pour permettre sa réutilisation.
/// @example
/// ```janus
/// val builder : ArrayBuilder[int] = new ArrayBuilder(2)
/// builder.add(10)
/// val values : Array[int] = builder.result()
/// ```
module std.array_builder
import std.array
import std.builder
import std.iterator

/// Accumule des éléments propriétaires dans un tableau redimensionnable.
///
/// @param initialCapacity Nombre d’emplacements réservés avant le premier ajout.
class ArrayBuilder[T](
initialCapacity : usize
) extends Builder[T, Array[T]] {
    private var values : Array[T] =
    new Array[T](initialCapacity)

    /// Déplace une valeur à la fin du tableau en construction.
    ///
    /// @param value Élément dont le constructeur prend possession.
    def add(value : T) : Unit {
        values.push(move value)
    }

    /// Épuise la source et ajoute ses éléments dans leur ordre d’itération.
    ///
    /// @param source Source parcourue jusqu’à sa fin.
    def addAll[C <: Iterable[T]](
    borrow source : C
    ) : Unit where T <: Copy {
        for value in source {
            this.add(value)
        }
    }

    /// Compte les éléments actuellement accumulés.
    ///
    /// @return Nombre d’éléments que produirait immédiatement [[result]].
    borrow def size() : usize {
        return values.size()
    }

    /// Détruit les éléments accumulés et rend le constructeur vide.
    def clear() : Unit {
        values.clear()
    }

    /// Transfère les éléments accumulés dans un nouveau tableau.
    ///
    /// Le constructeur reste utilisable et repart avec une capacité initiale nulle.
    ///
    /// @return Tableau propriétaire contenant les éléments dans leur ordre d’ajout.
    def result() : Array[T] {
        val completed : Array[T] = move values
        values = new Array[T](usize(0))
        return completed
    }

    destructor {
        delete values
    }
}

/// Épuise un itérateur dans un nouveau tableau propriétaire.
///
/// @param source Itérateur consommé pendant la collecte.
/// @return Tableau contenant les valeurs dans leur ordre d’itération.
def collectArray[T](source : Iterator[T]) : Array[T] {
    val builder : ArrayBuilder[T] =
    new ArrayBuilder[T](usize(0))
    defer delete builder
    return source.collectWith[Array[T], ArrayBuilder[T]](builder)
}
