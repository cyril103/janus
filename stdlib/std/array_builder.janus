/// Construit des tableaux propriétaires à partir de valeurs ou d’itérateurs.
///
/// [[ArrayBuilder]] possède chaque valeur ajoutée. [[ArrayBuilder.result]] transfère le tableau
/// achevé et réinitialise le constructeur pour permettre sa réutilisation.
/// @example
/// ```janus
/// val builder : ArrayBuilder[int] = new ArrayBuilder[int](usize(2))
/// builder.add(10)
/// val values : Array[int] = builder.result()
/// ```
module std.array_builder
import std.array
import std.builder
import std.iterator

/// Définit [[ArrayBuilder]], avec les garanties et la propriété décrites par ses méthodes.
class ArrayBuilder[T](
initialCapacity : usize
) extends Builder[T, Array[T]] {
    private var values : Array[T] =
    new Array[T](initialCapacity)

    /// Ajoute une valeur.
    ///
    /// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    def add(value : T) : Unit {
        values.push(move value)
    }

    /// Ajoute tous les éléments de la source.
    ///
    /// @return Résultat de type [[usize]].
    def addAll[C <: Iterable[T]](source : C) : Unit {
        for value in source {
            this.add(value)
        }
    }

    /// Retourne le nombre d’éléments accumulés.
    ///
    /// @return Résultat de type [[usize]].
    def size() : usize {
        return values.size()
    }

    /// Réinitialise l’état.
    def clear() : Unit {
        values.clear()
    }

    /// Transfère les éléments accumulés dans un nouveau tableau.
    ///
    /// @return Résultat de type [[ArrayT]].
    def result() : Array[T] {
        val completed : Array[T] = move values
        values = new Array[T](usize(0))
        return completed
    }

    destructor {
        delete values
    }
}

/// Fournit la sémantique de [[collectArray]].
///
/// @param source Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[ArrayT]].
def collectArray[T](source : Iterator[T]) : Array[T] {
    val builder : ArrayBuilder[T] =
    new ArrayBuilder[T](usize(0))
    defer delete builder
    return source.collectWith[Array[T], ArrayBuilder[T]](builder)
}
