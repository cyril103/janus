/// Fournit les assertions communes des tests unitaires Janus.
///
/// Une assertion échouée affiche les valeurs compatibles avec `Debug`, puis
/// déclenche une panique que le runner isole dans le processus du test courant.
/// Les paniques attendues se déclarent avec `/// @shouldPanic [message]` sur la
/// fonction `/// @test` afin que le processus parent puisse les distinguer.
/// @example
/// ```janus
/// import std.testing
/// assertEqual[int](2 + 2, 4)
/// assertTrue(true)
/// ```
module std.testing

import std.option
import std.result
import std.bytes
import std.fs
import std.path
import std.system
import std.validated

/// Possède un répertoire temporaire unique et le supprime à sa destruction.
///
/// [[cleanup]] expose le résultat du nettoyage récursif et idempotent. Le
/// destructeur applique le même nettoyage en best-effort lorsque `preserve`
/// vaut `false`; `true` conserve toute l’arborescence pour inspection.
/// @param location Chemin propriétaire du répertoire déjà créé.
/// @param preserve Politique de conservation appliquée à la destruction.
class TestTemporaryDirectory(
    private val location : Path,
    private val preserve : bool
) {
    private var cleaned : bool = false

    /// Emprunte le chemin natif du répertoire.
    /// @return Vue valide jusqu’à la destruction de cette ressource.
    borrow def path() : string {
        return location.view()
    }

    /// Supprime récursivement le répertoire temporaire de façon observable.
    ///
    /// Après un premier succès, les appels suivants retournent `Ok(true)` sans
    /// retoucher le chemin, afin de ne pas supprimer une éventuelle ressource
    /// recréée au même emplacement.
    /// @return `Ok(true)` après nettoyage ou après un succès précédent, ou l’erreur structurée du premier échec.
    def cleanup() : Result[bool, SystemError] {
        if cleaned {
            return Result.Ok[bool, SystemError](true)
        }
        val removed : Result[bool, SystemError] =
        removeDirectoryAll(location.view())
        if isOk[bool, SystemError](removed) {
            cleaned = true
        }
        return removed
    }

    destructor {
        if !preserve && !cleaned {
            val removed : Result[bool, SystemError] =
            this.cleanup()
            isOk[bool, SystemError](removed)
        }
        delete location
    }
}

/// Crée une ressource temporaire propre au test courant.
/// @param preserve Conserve le répertoire à la destruction si `true`.
/// @return Ressource propriétaire unique, ou erreur système de création.
def testTemporaryDirectory(
    preserve : bool
) : Result[TestTemporaryDirectory, SystemError] {
    val created : Result[Path, SystemError] =
    createTemporaryDirectory("janus-test")
    return match move created {
        Ok(path) => Result.Ok[TestTemporaryDirectory, SystemError](
            new TestTemporaryDirectory(move path, preserve)
        ),
        Error(error) => Result.Error[TestTemporaryDirectory, SystemError](
            error
        )
    }
}

/// Interrompt explicitement le test avec un message descriptif.
/// @param message Raison affichée par le runner avant de classer le test en échec.
def fail(message : string) : Unit {
    panic(message)
}

/// Vérifie qu’une condition est vraie.
/// @param condition Condition attendue à `true`.
def assertTrue(condition : bool) : Unit {
    if !condition {
        panic("assertTrue failed\n")
    }
}

/// Vérifie qu’une condition est fausse.
/// @param condition Condition attendue à `false`.
def assertFalse(condition : bool) : Unit {
    if condition {
        panic("assertFalse failed\n")
    }
}

/// Compare deux valeurs disposant des capacités `Equality` et `Debug`.
/// @param actual Valeur obtenue.
/// @param expected Valeur attendue.
def assertEqual[T <: Equality & Debug](actual : T, expected : T) : Unit {
    if actual != expected {
        println("assertEqual failed")
        print("  expected: ")
        debug(expected)
        print("  actual:   ")
        debug(actual)
        panic("assertEqual failed\n")
    }
}

/// Vérifie que deux valeurs comparables sont différentes.
/// @param actual Valeur obtenue.
/// @param expected Valeur qui ne doit pas être obtenue.
def assertNotEqual[T <: Equality & Debug](actual : T, expected : T) : Unit {
    if actual == expected {
        println("assertNotEqual failed")
        print("  unexpected: ")
        debug(actual)
        panic("assertNotEqual failed\n")
    }
}

/// Compare deux valeurs par emprunt, y compris lorsqu’elles ne sont pas copiables.
/// @param actual Valeur observée sans transfert de propriété.
/// @param expected Valeur attendue observée sans transfert de propriété.
def assertBorrowedEqual[T <: Equality & Debug](
    borrow actual : T,
    borrow expected : T
) : Unit {
    if actual != expected {
        println("assertBorrowedEqual failed")
        print("  expected: ")
        debug(expected)
        print("  actual:   ")
        debug(actual)
        panic("assertBorrowedEqual failed\n")
    }
}

/// Vérifie qu’une option contient une valeur.
/// @param value Option inspectée sans déplacer son contenu.
def assertSome[T](borrow value : Option[T]) : Unit {
    if !isSome[T](value) {
        panic("assertSome failed: expected Some, got None\n")
    }
}

/// Vérifie qu’une option est vide.
/// @param value Option inspectée sans déplacer son contenu.
def assertNone[T](borrow value : Option[T]) : Unit {
    if !isNone[T](value) {
        panic("assertNone failed: expected None, got Some\n")
    }
}

/// Vérifie qu’une option contient une valeur satisfaisant un prédicat.
///
/// Le contenu est seulement emprunté et la callback ne peut pas s’échapper :
/// les valeurs non copiables restent donc la propriété de l’option.
/// @param value Option inspectée sans déplacer son contenu.
/// @param predicate Condition bornée appelée uniquement pour `Some`.
def assertSomeWhere[T](
    borrow value : Option[T],
    scoped predicate : (borrow T) => bool
) : Unit {
    defer delete predicate
    val accepted : bool = match value {
        Some(item) => predicate(item),
        None => false
    }
    if !accepted {
        panic("assertSomeWhere failed: expected matching Some\n")
    }
}

/// Vérifie qu’un résultat représente un succès.
/// @param value Résultat inspecté sans déplacer son contenu.
def assertOk[T, E](borrow value : Result[T, E]) : Unit {
    if !isOk[T, E](value) {
        panic("assertOk failed: expected Ok, got Error\n")
    }
}

/// Vérifie qu’un résultat représente une erreur.
/// @param value Résultat inspecté sans déplacer son contenu.
def assertError[T, E](borrow value : Result[T, E]) : Unit {
    if !isError[T, E](value) {
        panic("assertError failed: expected Error, got Ok\n")
    }
}

/// Vérifie que la valeur de succès satisfait un prédicat sans la consommer.
/// @param value Résultat inspecté sans déplacer sa branche active.
/// @param predicate Condition bornée appelée uniquement pour `Ok`.
def assertOkWhere[T, E](
    borrow value : Result[T, E],
    scoped predicate : (borrow T) => bool
) : Unit {
    defer delete predicate
    val accepted : bool = match value {
        Ok(item) => predicate(item),
        Error(error) => false
    }
    if !accepted {
        panic("assertOkWhere failed: expected matching Ok\n")
    }
}

/// Vérifie que l’erreur satisfait un prédicat sans la consommer.
/// @param value Résultat inspecté sans déplacer sa branche active.
/// @param predicate Condition bornée appelée uniquement pour `Error`.
def assertErrorWhere[T, E](
    borrow value : Result[T, E],
    scoped predicate : (borrow E) => bool
) : Unit {
    defer delete predicate
    val accepted : bool = match value {
        Ok(item) => false,
        Error(error) => predicate(error)
    }
    if !accepted {
        panic("assertErrorWhere failed: expected matching Error\n")
    }
}

/// Vérifie qu'une validation contient une valeur valide.
/// @param value Validation inspectée sans déplacer sa branche active.
def assertValid[T, E](borrow value : Validated[T, E]) : Unit {
    if !std.validated.isValid[T, E](value) {
        panic("assertValid failed: expected Valid, got Invalid\n")
    }
}

/// Vérifie qu'une validation contient des erreurs.
/// @param value Validation inspectée sans déplacer sa branche active.
def assertInvalid[T, E](borrow value : Validated[T, E]) : Unit {
    if !std.validated.isInvalid[T, E](value) {
        panic("assertInvalid failed: expected Invalid, got Valid\n")
    }
}

/// Vérifie que la valeur valide satisfait un prédicat sans la consommer.
/// @param value Validation inspectée sans déplacer sa branche active.
/// @param predicate Condition bornée appelée uniquement pour `Valid`.
def assertValidWhere[T, E](
    borrow value : Validated[T, E],
    scoped predicate : (borrow T) => bool
) : Unit {
    defer delete predicate
    val accepted : bool = match value {
        Valid(item) => predicate(item),
        Invalid(errors) => false
    }
    if !accepted {
        panic("assertValidWhere failed: expected matching Valid\n")
    }
}

/// Vérifie que le tableau d'erreurs satisfait un prédicat sans le consommer.
/// @param value Validation inspectée sans déplacer sa branche active.
/// @param predicate Condition bornée appelée uniquement pour `Invalid`.
def assertInvalidWhere[T, E](
    borrow value : Validated[T, E],
    scoped predicate : (borrow Array[E]) => bool
) : Unit {
    defer delete predicate
    val accepted : bool = match value {
        Valid(item) => false,
        Invalid(errors) => predicate(errors)
    }
    if !accepted {
        panic("assertInvalidWhere failed: expected matching Invalid\n")
    }
}

/// Compare exactement deux vues binaires bornées.
/// @param actual Suite d’octets obtenue.
/// @param expected Suite d’octets attendue.
def assertBytesEqual(
    borrow actual : ByteView,
    borrow expected : ByteView
) : Unit {
    if actual.size() != expected.size() {
        println("assertBytesEqual failed")
        print("  expected size: ")
        debug(expected.size())
        print("  actual size:   ")
        debug(actual.size())
        panic("assertBytesEqual failed: different sizes\n")
    }

    var index : usize = usize(0)
    while index < actual.size() {
        if actual.get(index) != expected.get(index) {
            println("assertBytesEqual failed")
            print("  index:    ")
            debug(index)
            print("  expected: ")
            debug(expected.get(index))
            print("  actual:   ")
            debug(actual.get(index))
            panic("assertBytesEqual failed: different bytes\n")
        }
        index = index + usize(1)
    }
}
