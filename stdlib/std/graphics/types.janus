/// Identifie le bouton de souris dont l’état est interrogé.
enum MouseButton derives Copy, Equality, Debug {
    /// Bouton principal, généralement situé à gauche.
    Left,
    /// Bouton secondaire, généralement situé à droite.
    Right,
    /// Bouton central, généralement actionné par la molette.
    Middle,
    /// Premier bouton latéral de la souris.
    Side,
    /// Bouton supplémentaire de la souris.
    Extra,
    /// Bouton de navigation vers l’avant.
    Forward,
    /// Bouton de navigation vers l’arrière.
    Back
}

/// Sélectionne l’échantillonnage appliqué lorsqu’une texture change de taille à l’écran.
enum TextureFilter derives Copy, Equality, Debug {
    /// Choisit le texel le plus proche, ce qui conserve un aspect net et pixellisé.
    Point,
    /// Interpole les texels voisins dans le niveau de détail courant.
    Bilinear,
    /// Interpole les texels voisins et les niveaux de détail adjacents.
    Trilinear,
    /// Réduit le flou des textures vues en biais avec un niveau anisotrope 4x.
    Anisotropic4x,
    /// Réduit le flou des textures vues en biais avec un niveau anisotrope 8x.
    Anisotropic8x,
    /// Réduit le flou des textures vues en biais avec un niveau anisotrope 16x.
    Anisotropic16x
}

/// Détermine comment la couleur dessinée se combine avec les pixels déjà présents.
enum BlendMode derives Copy, Equality, Debug {
    /// Compose la source selon son canal alpha pour produire la transparence ordinaire.
    Alpha,
    /// Additionne la contribution de la source à la destination, notamment pour les effets lumineux.
    Additive,
    /// Multiplie source et destination.
    Multiplied,
    /// Additionne séparément les canaux de couleur.
    AddColors,
    /// Soustrait les canaux de couleur source.
    SubtractColors,
    /// Compose une source dont l’alpha est déjà prémultiplié.
    AlphaPremultiply,
    /// Utilise les facteurs de blend personnalisés configurés côté raylib.
    Custom,
    /// Utilise des facteurs personnalisés distincts pour couleur et alpha.
    CustomSeparate
}

/// Sélectionne la répétition des coordonnées hors de la texture.
enum TextureWrap derives Copy, Equality, Debug {
    /// Répète la texture.
    Repeat,
    /// Bloque les coordonnées sur les texels de bord.
    Clamp,
    /// Répète la texture en miroir.
    MirrorRepeat,
    /// Répète en miroir avec blocage sur les bords.
    MirrorClamp
}

/// Format mémoire des pixels d’une image ou d’une texture raylib 6.
enum PixelFormat derives Copy, Equality, Debug {
    /// Un canal de luminance sur 8 bits.
    UncompressedGrayscale = 1,
    /// Luminance et alpha sur 8 bits chacun.
    UncompressedGrayAlpha = 2,
    /// Rouge, vert et bleu non compressés sur 16 bits.
    UncompressedR5G6B5 = 3,
    /// Rouge, vert et bleu non compressés sur 24 bits.
    UncompressedR8G8B8 = 4,
    /// Couleur 16 bits avec un bit alpha.
    UncompressedR5G5B5A1 = 5,
    /// Quatre canaux non compressés de 4 bits.
    UncompressedR4G4B4A4 = 6,
    /// Quatre canaux non compressés de 8 bits.
    UncompressedR8G8B8A8 = 7,
    /// Un canal flottant de 32 bits.
    UncompressedR32 = 8,
    /// Trois canaux flottants de 32 bits.
    UncompressedR32G32B32 = 9,
    /// Quatre canaux flottants de 32 bits.
    UncompressedR32G32B32A32 = 10,
    /// Un canal flottant de 16 bits.
    UncompressedR16 = 11,
    /// Trois canaux flottants de 16 bits.
    UncompressedR16G16B16 = 12,
    /// Quatre canaux flottants de 16 bits.
    UncompressedR16G16B16A16 = 13,
    /// Compression DXT1 sans canal alpha.
    CompressedDxt1Rgb = 14,
    /// Compression DXT1 avec canal alpha.
    CompressedDxt1Rgba = 15,
    /// Compression DXT3 avec canal alpha.
    CompressedDxt3Rgba = 16,
    /// Compression DXT5 avec canal alpha.
    CompressedDxt5Rgba = 17,
    /// Compression ETC1 sans canal alpha.
    CompressedEtc1Rgb = 18,
    /// Compression ETC2 sans canal alpha.
    CompressedEtc2Rgb = 19,
    /// Compression ETC2 EAC avec canal alpha.
    CompressedEtc2EacRgba = 20,
    /// Compression PowerVR sans canal alpha.
    CompressedPvrtRgb = 21,
    /// Compression PowerVR avec canal alpha.
    CompressedPvrtRgba = 22,
    /// Compression ASTC en blocs de 4 par 4 pixels.
    CompressedAstc4x4Rgba = 23,
    /// Compression ASTC en blocs de 8 par 8 pixels.
    CompressedAstc8x8Rgba = 24
}

/// Sélectionne l’axe extensible d’une texture neuf-patch.
enum NPatchLayout derives Copy, Equality, Debug {
    /// Découpage complet en neuf zones.
    NinePatch,
    /// Trois zones superposées dont la zone centrale s’étire verticalement.
    ThreePatchVertical,
    /// Trois zones côte à côte dont la zone centrale s’étire horizontalement.
    ThreePatchHorizontal
}

/// Identifie un bouton de manette indépendamment du libellé propre au fabricant.
enum GamepadButton derives Copy, Equality, Debug {
    /// Bouton non reconnu ou sans correspondance connue.
    Unknown,
    /// Direction haute de la croix directionnelle.
    LeftFaceUp,
    /// Direction droite de la croix directionnelle.
    LeftFaceRight,
    /// Direction basse de la croix directionnelle.
    LeftFaceDown,
    /// Direction gauche de la croix directionnelle.
    LeftFaceLeft,
    /// Bouton supérieur du groupe situé à droite.
    RightFaceUp,
    /// Bouton droit du groupe situé à droite.
    RightFaceRight,
    /// Bouton inférieur du groupe situé à droite.
    RightFaceDown,
    /// Bouton gauche du groupe situé à droite.
    RightFaceLeft,
    /// Bouton supérieur de tranche gauche.
    LeftTrigger1,
    /// Bouton inférieur ou gâchette de tranche gauche.
    LeftTrigger2,
    /// Bouton supérieur de tranche droite.
    RightTrigger1,
    /// Bouton inférieur ou gâchette de tranche droite.
    RightTrigger2,
    /// Bouton central situé à gauche.
    MiddleLeft,
    /// Bouton central de la manette.
    Middle,
    /// Bouton central situé à droite.
    MiddleRight,
    /// Clic du stick analogique gauche.
    LeftThumb,
    /// Clic du stick analogique droit.
    RightThumb
}

/// Identifie un axe analogique de manette dont la position peut être interrogée.
enum GamepadAxis derives Copy, Equality, Debug {
    /// Déplacement horizontal du stick gauche.
    LeftX,
    /// Déplacement vertical du stick gauche.
    LeftY,
    /// Déplacement horizontal du stick droit.
    RightX,
    /// Déplacement vertical du stick droit.
    RightY,
    /// Course analogique de la gâchette gauche.
    LeftTrigger,
    /// Course analogique de la gâchette droite.
    RightTrigger
}
private extern def janus_graphics_rgba(
red : ubyte,
green : ubyte,
blue : ubyte,
alpha : ubyte
) : uint
/// Paire de coordonnées flottantes pour une position, une dimension ou une direction en deux dimensions.
struct Vector2(
/// Coordonnée horizontale dans l’unité attendue par l’opération graphique.
val x : float,
/// Coordonnée verticale dans l’unité attendue par l’opération graphique.
val y : float
)
derives Copy, Equality, Debug {}

/// Zone rectangulaire décrite par son origine et ses dimensions flottantes.
struct Rectangle(
/// Coordonnée horizontale du coin supérieur gauche.
val x : float,
/// Coordonnée verticale du coin supérieur gauche.
val y : float,
/// Largeur du rectangle dans l’unité attendue par l’opération graphique.
val width : float,
/// Hauteur du rectangle dans l’unité attendue par l’opération graphique.
val height : float
) derives Copy, Equality, Debug {}

/// Décrit les bordures fixes d’une texture neuf-patch.
struct NPatchInfo(
/// Région source découpée dans la texture.
val source : Rectangle,
/// Largeur fixe de la bordure gauche.
val left : int,
/// Hauteur fixe de la bordure supérieure.
val top : int,
/// Largeur fixe de la bordure droite.
val right : int,
/// Hauteur fixe de la bordure inférieure.
val bottom : int,
/// Organisation des zones fixes et extensibles.
val layout : NPatchLayout
) derives Copy, Equality, Debug {}

/// Couleur RGBA stockée sous la représentation entière compacte produite par [[rgba]].
///
/// @param packedValue Représentation compacte transmise sans conversion aux opérations graphiques.
struct Color(private val packedValue : uint)
derives Copy, Equality, Debug {
    /// Lit la représentation entière compacte de la couleur, sans conversion.
    ///
    /// @return La valeur RGBA compacte conservée par cette couleur.
    def packed() : uint {
        return packedValue
    }
}
/// Construit une couleur à partir de ses quatre canaux RGBA.
///
/// @param red Intensité rouge de 0 à 255.
/// @param green Intensité verte de 0 à 255.
/// @param blue Intensité bleue de 0 à 255.
/// @param alpha Opacité de 0 (transparent) à 255 (opaque).
/// @return Une couleur contenant les quatre canaux fournis.
def rgba(red : ubyte, green : ubyte, blue : ubyte, alpha : ubyte) : Color {
    return new Color(janus_graphics_rgba(red, green, blue, alpha))
}

/// Construit un vecteur sans modifier ses composantes.
///
/// @param x Composante horizontale.
/// @param y Composante verticale.
/// @return Un vecteur contenant les deux composantes fournies.
def vector2(x : float, y : float) : Vector2 {
    return new Vector2(x, y)
}

/// Construit un rectangle sans normaliser son origine ni ses dimensions.
///
/// @param x Coordonnée horizontale de l’origine.
/// @param y Coordonnée verticale de l’origine.
/// @param width Largeur conservée telle quelle.
/// @param height Hauteur conservée telle quelle.
/// @return Un rectangle contenant exactement les quatre valeurs fournies.
def rectangle(x : float, y : float, width : float, height : float) : Rectangle {
    return new Rectangle(x, y, width, height)
}

/// Alias de [[rgba]] pour construire une couleur RGBA.
///
/// @param red Intensité rouge de 0 à 255.
/// @param green Intensité verte de 0 à 255.
/// @param blue Intensité bleue de 0 à 255.
/// @param alpha Opacité de 0 (transparent) à 255 (opaque).
/// @return Une couleur contenant les quatre canaux fournis.
def colorRgba(
red : ubyte,
green : ubyte,
blue : ubyte,
alpha : ubyte
) : Color {
    return rgba(red, green, blue, alpha)
}

/// Alias de [[rgb]] pour construire une couleur opaque.
///
/// @param red Intensité rouge de 0 à 255.
/// @param green Intensité verte de 0 à 255.
/// @param blue Intensité bleue de 0 à 255.
/// @return Une couleur dont l’opacité vaut 255.
def colorRgb(red : ubyte, green : ubyte, blue : ubyte) : Color {
    return rgb(red, green, blue)
}

/// Construit une couleur opaque à partir de ses canaux rouge, vert et bleu.
///
/// @param red Intensité rouge de 0 à 255.
/// @param green Intensité verte de 0 à 255.
/// @param blue Intensité bleue de 0 à 255.
/// @return Une couleur dont l’opacité vaut 255.
def rgb(red : ubyte, green : ubyte, blue : ubyte) : Color {
    return rgba(red, green, blue, 255)
}

/// Couleur noire opaque prédéfinie.
val Black : Color = new Color(255)
/// Couleur blanche opaque prédéfinie.
val White : Color = new Color(4294967295)
/// Couleur rouge opaque prédéfinie.
val Red : Color = new Color(3861460991)
/// Couleur verte opaque prédéfinie.
val Green : Color = new Color(14954751)
/// Couleur bleue opaque prédéfinie.
val Blue : Color = new Color(7991807)

/// Renvoie la couleur noire opaque prédéfinie.
///
/// @return La constante de couleur noire.
def black() : Color {
    return Black
}

/// Renvoie la couleur blanche opaque prédéfinie.
///
/// @return La constante de couleur blanche.
def white() : Color {
    return White
}

/// Renvoie la couleur rouge opaque prédéfinie.
///
/// @return La constante de couleur rouge.
def red() : Color {
    return Red
}

/// Renvoie la couleur verte opaque prédéfinie.
///
/// @return La constante de couleur verte.
def green() : Color {
    return Green
}

/// Renvoie la couleur bleue opaque prédéfinie.
///
/// @return La constante de couleur bleue.
def blue() : Color {
    return Blue
}
