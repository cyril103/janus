/// Énumère les valeurs de [[GamepadAxis]] reconnues par le backend ou l’algorithme.
enum GamepadAxis derives Copy, Equality, Debug {
    /// Variante `LeftX`, correspondant à cette valeur précise.
    ///
    /// @param red Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param green Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param blue Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param alpha Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @return Résultat de type [[uint]].
    LeftX,
    /// Variante `LeftY`, correspondant à cette valeur précise.
    ///
    /// @param red Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param green Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param blue Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param alpha Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @return Résultat de type [[uint]].
    LeftY,
    /// Variante `RightX`, correspondant à cette valeur précise.
    ///
    /// @param red Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param green Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param blue Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param alpha Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @return Résultat de type [[uint]].
    RightX,
    /// Variante `RightY`, correspondant à cette valeur précise.
    ///
    /// @param red Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param green Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param blue Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param alpha Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @return Résultat de type [[uint]].
    RightY,
    /// Variante `LeftTrigger`, correspondant à cette valeur précise.
    ///
    /// @param red Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param green Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param blue Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param alpha Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @return Résultat de type [[uint]].
    LeftTrigger,
    /// Variante `RightTrigger`, correspondant à cette valeur précise.
    ///
    /// @param red Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param green Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param blue Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param alpha Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @return Résultat de type [[uint]].
    RightTrigger
}
private extern def janus_graphics_rgba(
red : ubyte,
green : ubyte,
blue : ubyte,
alpha : ubyte
) : uint
/// Définit [[Vector2]], avec les garanties et la propriété décrites par ses méthodes.
struct Vector2(
/// Coordonnée horizontale dans l’unité attendue par l’opération graphique.
val x : float,
/// Coordonnée verticale dans l’unité attendue par l’opération graphique.
val y : float
)
derives Copy, Equality, Debug {}

/// Définit [[Rectangle]], avec les garanties et la propriété décrites par ses méthodes.
struct Rectangle(
/// Coordonnée horizontale du coin supérieur gauche.
val x : float,
/// Coordonnée verticale du coin supérieur gauche.
val y : float,
/// Largeur du rectangle dans l’unité attendue par l’opération graphique.
val width : float,
/// Hauteur du rectangle dans l’unité attendue par l’opération graphique.
val height : float
) derives Copy, Equality, Debug {}

/// Définit [[Color]], avec les garanties et la propriété décrites par ses méthodes.
struct Color(private val packedValue : uint)
derives Copy, Equality, Debug {
    /// Fournit la sémantique de [[packed]].
    ///
    /// @return Résultat de type [[uint]].
    def packed() : uint {
        return packedValue
    }
}
/// Fournit la sémantique de [[rgba]].
///
/// @param red Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param green Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param blue Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param alpha Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[Color]].
def rgba(red : ubyte, green : ubyte, blue : ubyte, alpha : ubyte) : Color {
    return new Color(janus_graphics_rgba(red, green, blue, alpha))
}

/// Fournit la sémantique de [[vector2]].
///
/// @param x Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param y Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[Vector2]].
def vector2(x : float, y : float) : Vector2 {
    return new Vector2(x, y)
}

/// Fournit la sémantique de [[rectangle]].
///
/// @param x Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param y Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param width Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param height Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[Rectangle]].
def rectangle(x : float, y : float, width : float, height : float) : Rectangle {
    return new Rectangle(x, y, width, height)
}

/// Fournit la sémantique de [[colorRgba]].
///
/// @param red Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param green Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param blue Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param alpha Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[Color]].
def colorRgba(
red : ubyte,
green : ubyte,
blue : ubyte,
alpha : ubyte
) : Color {
    return rgba(red, green, blue, alpha)
}

/// Fournit la sémantique de [[colorRgb]].
///
/// @param red Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param green Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param blue Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[Color]].
def colorRgb(red : ubyte, green : ubyte, blue : ubyte) : Color {
    return rgb(red, green, blue)
}

/// Fournit la sémantique de [[rgb]].
///
/// @param red Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param green Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param blue Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[Color]].
def rgb(red : ubyte, green : ubyte, blue : ubyte) : Color {
    return rgba(red, green, blue, 255)
}

/// Expose la valeur publique `Black`.
///
/// @return Résultat de type [[Color]].
val Black : Color = new Color(255)
/// Expose la valeur publique `White`.
///
/// @return Résultat de type [[Color]].
val White : Color = new Color(4294967295)
/// Expose la valeur publique `Red`.
///
/// @return Résultat de type [[Color]].
val Red : Color = new Color(3861460991)
/// Expose la valeur publique `Green`.
///
/// @return Résultat de type [[Color]].
val Green : Color = new Color(14954751)
/// Expose la valeur publique `Blue`.
///
/// @return Résultat de type [[Color]].
val Blue : Color = new Color(7991807)

/// Fournit la sémantique de [[black]].
///
/// @return Résultat de type [[Color]].
def black() : Color {
    return Black
}

/// Fournit la sémantique de [[white]].
///
/// @return Résultat de type [[Color]].
def white() : Color {
    return White
}

/// Fournit la sémantique de [[red]].
///
/// @return Résultat de type [[Color]].
def red() : Color {
    return Red
}

/// Fournit la sémantique de [[green]].
///
/// @return Résultat de type [[Color]].
def green() : Color {
    return Green
}

/// Fournit la sémantique de [[blue]].
///
/// @return Résultat de type [[Color]].
def blue() : Color {
    return Blue
}
