private extern def janus_graphics_rgba(
red : ubyte,
green : ubyte,
blue : ubyte,
alpha : ubyte
) : uint
/// Représente le type public `Vector2`.
struct Vector2(
/// Expose le membre public `x`.
val x : float,
/// Expose le membre public `y`.
val y : float
)
derives Copy, Equality, Debug {}

/// Représente le type public `Rectangle`.
struct Rectangle(
/// Expose le membre public `x`.
val x : float,
/// Expose le membre public `y`.
val y : float,
/// Expose le membre public `width`.
val width : float,
/// Expose le membre public `height`.
val height : float
) derives Copy, Equality, Debug {}

/// Représente le type public `Color`.
struct Color(private val packedValue : uint)
derives Copy, Equality, Debug {
    /// Exécute l’opération publique `packed`.
    def packed() : uint {
        return packedValue
    }
}
/// Exécute l’opération publique `rgba`.
def rgba(red : ubyte, green : ubyte, blue : ubyte, alpha : ubyte) : Color {
    return new Color(janus_graphics_rgba(red, green, blue, alpha))
}

/// Exécute l’opération publique `vector2`.
def vector2(x : float, y : float) : Vector2 {
    return new Vector2(x, y)
}

/// Exécute l’opération publique `rectangle`.
def rectangle(x : float, y : float, width : float, height : float) : Rectangle {
    return new Rectangle(x, y, width, height)
}

/// Exécute l’opération publique `colorRgba`.
def colorRgba(
red : ubyte,
green : ubyte,
blue : ubyte,
alpha : ubyte
) : Color {
    return rgba(red, green, blue, alpha)
}

/// Exécute l’opération publique `colorRgb`.
def colorRgb(red : ubyte, green : ubyte, blue : ubyte) : Color {
    return rgb(red, green, blue)
}

/// Exécute l’opération publique `rgb`.
def rgb(red : ubyte, green : ubyte, blue : ubyte) : Color {
    return rgba(red, green, blue, 255)
}

/// Expose la valeur publique `Black`.
val Black : Color = new Color(255)
/// Expose la valeur publique `White`.
val White : Color = new Color(4294967295)
/// Expose la valeur publique `Red`.
val Red : Color = new Color(3861460991)
/// Expose la valeur publique `Green`.
val Green : Color = new Color(14954751)
/// Expose la valeur publique `Blue`.
val Blue : Color = new Color(7991807)

/// Exécute l’opération publique `black`.
def black() : Color {
    return Black
}

/// Exécute l’opération publique `white`.
def white() : Color {
    return White
}

/// Exécute l’opération publique `red`.
def red() : Color {
    return Red
}

/// Exécute l’opération publique `green`.
def green() : Color {
    return Green
}

/// Exécute l’opération publique `blue`.
def blue() : Color {
    return Blue
}
