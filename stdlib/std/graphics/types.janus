    /// Touche clavier Space.
    Space = 32,
    /// Touche clavier Apostrophe.
    Apostrophe = 39,
    /// Touche clavier Comma.
    Comma = 44,
    /// Touche clavier Minus.
    Minus = 45,
    /// Touche clavier Period.
    Period = 46,
    /// Touche clavier Slash.
    Slash = 47,
