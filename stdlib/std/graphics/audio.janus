/// Pilote le périphérique audio et les ressources propriétaires [[Sound]] et [[Music]].
///
/// Appelez [[initAudio]] avant tout chargement, conservez les ressources pendant leur lecture,
/// détruisez-les, puis terminez par [[closeAudio]].
/// @example
/// ```janus
/// if initAudio() {
///     val sound : Sound = loadSound("click.wav")
///     sound.play()
///     delete sound
///     closeAudio()
/// }
/// ```
module std.graphics.audio
import std.c

private extern def janus_graphics_init_audio() : bool
private extern def janus_graphics_close_audio() : Unit
private extern def janus_graphics_set_master_volume(volume : float) : Unit
private extern def janus_graphics_load_sound(fileName : Ptr[byte]) : owned Ptr[byte]
private extern def janus_graphics_sound_is_valid(handle : Ptr[byte]) : bool
private extern def janus_graphics_unload_sound(handle : Ptr[byte]) : Unit
private extern def janus_graphics_play_sound(handle : Ptr[byte]) : Unit
private extern def janus_graphics_stop_sound(handle : Ptr[byte]) : Unit
private extern def janus_graphics_sound_is_playing(handle : Ptr[byte]) : bool
private extern def janus_graphics_set_sound_volume(
handle : Ptr[byte],
volume : float
) : Unit
private extern def janus_graphics_set_sound_pitch(
handle : Ptr[byte],
pitch : float
) : Unit
private extern def janus_graphics_set_sound_pan(
handle : Ptr[byte],
pan : float
) : Unit
private extern def janus_graphics_load_music(fileName : Ptr[byte]) : owned Ptr[byte]
private extern def janus_graphics_music_is_valid(handle : Ptr[byte]) : bool
private extern def janus_graphics_unload_music(handle : Ptr[byte]) : Unit
private extern def janus_graphics_play_music(handle : Ptr[byte]) : Unit
private extern def janus_graphics_stop_music(handle : Ptr[byte]) : Unit
private extern def janus_graphics_update_music(handle : Ptr[byte]) : Unit
private extern def janus_graphics_music_is_playing(handle : Ptr[byte]) : bool
private extern def janus_graphics_set_music_volume(
handle : Ptr[byte],
volume : float
) : Unit
private extern def janus_graphics_set_music_pitch(
handle : Ptr[byte],
pitch : float
) : Unit
private extern def janus_graphics_set_music_pan(
handle : Ptr[byte],
pan : float
) : Unit
/// Possède un effet sonore chargé; sa destruction décharge le handle natif.
///
/// @param handle Ressource native créée par le backend et désormais possédée par l’objet.
class Sound(private val handle : Ptr[byte]) {
    /// Indique si le handle référence encore un son valide dans le backend chargé.
    ///
    /// @return `true` si les opérations de lecture sont possibles; sinon `false`.
    def isValid() : bool {
        return janus_graphics_sound_is_valid(handle)
    }

    /// Lance la lecture du son s’il est valide et si le périphérique audio reste ouvert.
    def play() : Unit {
        janus_graphics_play_sound(handle)
    }

    /// Arrête la lecture du son s’il est valide.
    def stop() : Unit {
        janus_graphics_stop_sound(handle)
    }

    /// Indique si le son est en cours de lecture.
    ///
    /// @return `true` si le son valide est actuellement lu; sinon `false`.
    def isPlaying() : bool {
        return janus_graphics_sound_is_playing(handle)
    }

    /// Règle le volume du son.
    ///
    /// @param volume Gain transmis au backend pour ce son.
    def setVolume(volume : float) : Unit {
        janus_graphics_set_sound_volume(handle, volume)
    }

    /// Règle la hauteur du son.
    ///
    /// @param pitch Facteur de hauteur transmis au backend pour ce son.
    def setPitch(pitch : float) : Unit {
        janus_graphics_set_sound_pitch(handle, pitch)
    }

    /// Règle la panoramique du son.
    ///
    /// @param pan Position stéréo transmise au backend pour ce son.
    def setPan(pan : float) : Unit {
        janus_graphics_set_sound_pan(handle, pan)
    }

    destructor {
        janus_graphics_unload_sound(handle)
    }
}

/// Possède un flux musical chargé; sa destruction décharge le handle natif.
///
/// @param handle Flux natif créé par le backend et désormais possédé par l’objet.
class Music(private val handle : Ptr[byte]) {
    /// Indique si le handle référence encore un flux valide dans le backend chargé.
    ///
    /// @return `true` si les opérations de lecture sont possibles; sinon `false`.
    def isValid() : bool {
        return janus_graphics_music_is_valid(handle)
    }

    /// Lance la lecture du flux s’il est valide et si le périphérique audio reste ouvert.
    def play() : Unit {
        janus_graphics_play_music(handle)
    }

    /// Arrête la lecture du flux s’il est valide.
    def stop() : Unit {
        janus_graphics_stop_music(handle)
    }

    /// Alimente le flux musical en cours; appelez cette méthode régulièrement pendant sa lecture.
    def update() : Unit {
        janus_graphics_update_music(handle)
    }

    /// Indique si la musique est en cours de lecture.
    ///
    /// @return `true` si le flux valide est actuellement lu; sinon `false`.
    def isPlaying() : bool {
        return janus_graphics_music_is_playing(handle)
    }

    /// Règle le volume de la musique.
    ///
    /// @param volume Gain transmis au backend pour ce flux.
    def setVolume(volume : float) : Unit {
        janus_graphics_set_music_volume(handle, volume)
    }

    /// Règle la hauteur de la musique.
    ///
    /// @param pitch Facteur de hauteur transmis au backend pour ce flux.
    def setPitch(pitch : float) : Unit {
        janus_graphics_set_music_pitch(handle, pitch)
    }

    /// Règle la panoramique de la musique.
    ///
    /// @param pan Position stéréo transmise au backend pour ce flux.
    def setPan(pan : float) : Unit {
        janus_graphics_set_music_pan(handle, pan)
    }

    destructor {
        janus_graphics_unload_music(handle)
    }
}

/// Charge le backend, ouvre le périphérique audio et le rend prêt au chargement.
///
/// @return `true` si le périphérique est prêt; `false` si le backend ou l’ouverture échoue.
def initAudio() : bool {
    return janus_graphics_init_audio()
}

/// Ferme le périphérique audio s’il est ouvert.
///
/// Détruisez les [[Sound]] et [[Music]] chargés avant cet appel.
def closeAudio() : Unit {
    janus_graphics_close_audio()
}

/// Règle le volume audio principal.
///
/// @param volume Gain global transmis au backend lorsque le périphérique est prêt.
def setMasterVolume(volume : float) : Unit {
    janus_graphics_set_master_volume(volume)
}

/// Charge entièrement un effet sonore depuis un fichier, après [[initAudio]].
///
/// @param fileName Chemin du fichier à décoder.
/// @return Ressource propriétaire; [[Sound.isValid]] vaut `false` si le chargement échoue.
def loadSound(fileName : string) : Sound {
    return new Sound(janus_graphics_load_sound(cstr(fileName)))
}

/// Ouvre un flux musical depuis un fichier, après [[initAudio]].
///
/// @param fileName Chemin du fichier à diffuser.
/// @return Ressource propriétaire; [[Music.isValid]] vaut `false` si le chargement échoue.
def loadMusic(fileName : string) : Music {
    return new Music(janus_graphics_load_music(cstr(fileName)))
}
