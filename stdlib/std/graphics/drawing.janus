private val graphicsStartTime : Instant = monotonicNow()
private var graphicsPreviousFrameTime : Instant = graphicsStartTime

private def pixelCoordinate(value : float) : int {
    if value != value {
        return 0
    }
    if value <= numericCast[float](-2147483648.0) {
        return -2147483648
    }
    if value >= numericCast[float](2147483520.0) {
        return 2147483647
    }
    return numericCast[int](value)
}

/// Décrit la transformation entre l’espace monde et l’écran utilisée par [[beginCamera]].
class Camera2D(
/// Décalage horizontal de la caméra dans l’espace écran, exprimé en pixels.
var offsetX : float,
/// Décalage vertical de la caméra dans l’espace écran, exprimé en pixels.
var offsetY : float,
/// Coordonnée horizontale du point suivi dans l’espace monde.
var targetX : float,
/// Coordonnée verticale du point suivi dans l’espace monde.
var targetY : float,
/// Rotation de la vue en degrés autour de la cible.
var rotation : float,
/// Facteur d’agrandissement de la vue; `1.0` conserve l’échelle native.
var zoom : float
) {}

/// Tente de charger le backend graphique sans créer de fenêtre.
///
/// @return `true` si le backend est disponible, `false` si son chargement a échoué.
def graphicsAvailable() : bool {
    return janus_graphics_available()
}

/// Renvoie le dernier diagnostic produit pendant le chargement du backend graphique.
///
/// @return Pointeur emprunté vers un texte appartenant au runtime; il ne doit pas être libéré par l’appelant.
extern("janus_graphics_last_error") def graphicsLastError() : borrow Ptr[byte]

/// Charge le backend et crée la fenêtre de rendu.
///
/// @param width Largeur initiale en pixels, strictement positive.
/// @param height Hauteur initiale en pixels, strictement positive.
/// @param title Texte affiché dans la barre de titre.
/// @return `true` si la fenêtre est prête; `false` si le backend est indisponible, les dimensions sont invalides ou la création échoue.
def initWindow(width : int, height : int, title : string) : bool {
    return janus_graphics_init_window(width, height, cstr(title))
}

/// Indique si la boucle de rendu doit se terminer.
///
/// @return `true` si aucune fenêtre n’est initialisée ou si sa fermeture a été demandée; sinon `false`.
def windowShouldClose() : bool {
    return janus_graphics_window_should_close()
}

/// Termine les modes de rendu encore actifs, puis ferme la fenêtre si elle est ouverte.
def closeWindow() : Unit {
    janus_graphics_close_window()
}

/// Indique si la fenêtre occupe tout l’écran.
///
/// @return `true` si la fenêtre initialisée est en plein écran; sinon `false`.
def isWindowFullscreen() : bool {
    return janus_graphics_is_window_fullscreen()
}

/// Indique si la fenêtre est masquée.
///
/// @return `true` si la fenêtre initialisée est masquée; sinon `false`.
def isWindowHidden() : bool {
    return janus_graphics_is_window_hidden()
}

/// Indique si la fenêtre est réduite.
///
/// @return `true` si la fenêtre initialisée est réduite; sinon `false`.
def isWindowMinimized() : bool {
    return janus_graphics_is_window_minimized()
}

/// Indique si la fenêtre est agrandie.
///
/// @return `true` si la fenêtre initialisée est agrandie; sinon `false`.
def isWindowMaximized() : bool {
    return janus_graphics_is_window_maximized()
}

/// Indique si la fenêtre possède le focus.
///
/// @return `true` si la fenêtre initialisée reçoit les entrées; sinon `false`.
def isWindowFocused() : bool {
    return janus_graphics_is_window_focused()
}

/// Indique si la fenêtre a été redimensionnée pendant le cadre courant.
///
/// @return `true` lorsqu’un redimensionnement est signalé pour ce cadre; sinon `false`.
def isWindowResized() : bool {
    return janus_graphics_is_window_resized()
}

/// Bascule la fenêtre initialisée entre plein écran et mode fenêtré.
def toggleFullscreen() : Unit {
    janus_graphics_toggle_fullscreen()
}

/// Agrandit la fenêtre initialisée.
def maximizeWindow() : Unit {
    janus_graphics_maximize_window()
}

/// Réduit la fenêtre initialisée.
def minimizeWindow() : Unit {
    janus_graphics_minimize_window()
}

/// Restaure la fenêtre initialisée après réduction ou agrandissement.
def restoreWindow() : Unit {
    janus_graphics_restore_window()
}

/// Modifie le titre de la fenêtre.
///
/// @param title Nouveau texte de la barre de titre.
def setWindowTitle(title : string) : Unit {
    janus_graphics_set_window_title(cstr(title))
}

/// Déplace la fenêtre aux coordonnées demandées.
///
/// @param x Abscisse en pixels de la fenêtre sur l’écran.
/// @param y Ordonnée en pixels de la fenêtre sur l’écran.
def setWindowPosition(x : int, y : int) : Unit {
    janus_graphics_set_window_position(x, y)
}

/// Redimensionne la fenêtre.
///
/// @param width Nouvelle largeur en pixels, strictement positive.
/// @param height Nouvelle hauteur en pixels, strictement positive.
def setWindowSize(width : int, height : int) : Unit {
    janus_graphics_set_window_size(width, height)
}

/// Autorise ou interdit le redimensionnement de la fenêtre.
///
/// Une fenêtre redimensionnable peut aussi être agrandie par le gestionnaire de fenêtres.
///
/// @param resizable `true` pour autoriser le redimensionnement; `false` pour le bloquer.
def setWindowResizable(resizable : bool) : Unit {
    janus_graphics_set_window_resizable(resizable)
}

/// Règle l’opacité de la fenêtre.
///
/// @param opacity Opacité transmise au backend pour la fenêtre initialisée.
def setWindowOpacity(opacity : float) : Unit {
    janus_graphics_set_window_opacity(opacity)
}

/// Lit la largeur courante de la zone de rendu.
///
/// @return Largeur en pixels, ou `0` si le backend n’est pas chargé.
def screenWidth() : int {
    return janus_graphics_screen_width()
}

/// Lit la hauteur courante de la zone de rendu.
///
/// @return Hauteur en pixels, ou `0` si le backend n’est pas chargé.
def screenHeight() : int {
    return janus_graphics_screen_height()
}

/// Règle la fréquence d’images cible.
///
/// @param framesPerSecond Nombre d’images par seconde transmis au limiteur du backend.
def setTargetFps(framesPerSecond : int) : Unit {
    janus_graphics_set_target_fps(framesPerSecond)
}

/// Empile le mode de mélange courant et active le nouveau mode pour les dessins suivants.
///
/// Chaque appel effectif doit être apparié à [[endBlend]]; les modes peuvent être imbriqués.
/// @param mode Mode alpha ou additif à activer.
def beginBlend(mode : BlendMode) : Unit {
    janus_graphics_begin_blend(int(mode))
}

/// Termine le dernier mode ouvert par [[beginBlend]] et restaure le mode précédent.
def endBlend() : Unit {
    janus_graphics_end_blend()
}

/// Limite les dessins suivants à un rectangle écran.
/// @param area Zone rectangulaire concernée.
def beginScissor(area : Rectangle) : Unit {
    janus_graphics_begin_scissor(pixelCoordinate(area.x), pixelCoordinate(area.y), pixelCoordinate(area.width), pixelCoordinate(area.height))
}

/// Termine la limitation rectangulaire active.
def endScissor() : Unit {
    janus_graphics_end_scissor()
}

/// Mesure le temps monotone écoulé depuis le précédent appel à cette fonction.
///
/// Le premier appel mesure depuis l’initialisation du module.
/// @return Durée mesurée; l’appel devient le nouveau point de référence.
def frameTime() : Duration {
    val current : Instant = monotonicNow()
    val duration : Duration =
    current.durationSince(graphicsPreviousFrameTime)
    graphicsPreviousFrameTime = current
    return duration
}

/// Mesure le temps monotone écoulé depuis l’initialisation du module.
///
/// @return Durée totale sans modifier le point de référence de [[frameTime]].
def elapsedTime() : Duration {
    return monotonicNow().durationSince(graphicsStartTime)
}

/// Ouvre un cadre de rendu sur une fenêtre initialisée.
///
/// Un second appel avant [[endDrawing]] est ignoré.
def beginDrawing() : Unit {
    janus_graphics_begin_drawing()
}

/// Présente et ferme le cadre ouvert par [[beginDrawing]].
///
/// Fermez d’abord toute caméra active avec [[endCamera]]; sinon l’appel est ignoré.
def endDrawing() : Unit {
    janus_graphics_end_drawing()
}

/// Active la transformation 2D pour les dessins suivants du cadre courant.
///
/// L’appel exige un cadre ouvert et aucune autre caméra active; appariez-le à [[endCamera]].
/// @param camera Transformation entre coordonnées monde et pixels écran.
def beginCamera(camera : Camera2D) : Unit {
    janus_graphics_begin_camera(
    camera.offsetX,
    camera.offsetY,
    camera.targetX,
    camera.targetY,
    camera.rotation,
    camera.zoom
    )
}

/// Termine la transformation ouverte par [[beginCamera]] et revient aux coordonnées écran.
def endCamera() : Unit {
    janus_graphics_end_camera()
}

/// Convertit une position en pixels écran vers l’espace monde d’une caméra.
///
/// @param position Position dans l’espace écran.
/// @param camera Transformation à inverser.
/// @return Position monde, ou `(0, 0)` si le backend n’est pas chargé.
def screenToWorld(position : Vector2, camera : Camera2D) : Vector2 {
    return vector2(
    janus_graphics_screen_to_world_x(
    position.x,
    position.y,
    camera.offsetX,
    camera.offsetY,
    camera.targetX,
    camera.targetY,
    camera.rotation,
    camera.zoom
    ),
    janus_graphics_screen_to_world_y(
    position.x,
    position.y,
    camera.offsetX,
    camera.offsetY,
    camera.targetX,
    camera.targetY,
    camera.rotation,
    camera.zoom
    )
    )
}

/// Convertit une position monde en pixels écran selon une caméra.
///
/// @param position Position dans l’espace monde.
/// @param camera Transformation à appliquer.
/// @return Position en pixels écran, ou `(0, 0)` si le backend n’est pas chargé.
def worldToScreen(position : Vector2, camera : Camera2D) : Vector2 {
    return vector2(
    janus_graphics_world_to_screen_x(
    position.x,
    position.y,
    camera.offsetX,
    camera.offsetY,
    camera.targetX,
    camera.targetY,
    camera.rotation,
    camera.zoom
    ),
    janus_graphics_world_to_screen_y(
    position.x,
    position.y,
    camera.offsetX,
    camera.offsetY,
    camera.targetX,
    camera.targetY,
    camera.rotation,
    camera.zoom
    )
    )
}

/// Efface le rendu avec la couleur d’arrière-plan.
///
/// @param color Couleur appliquée à tous les pixels du cadre courant.
def clearBackground(color : Color) : Unit {
    janus_graphics_clear_background(color.packed())
}

/// Efface le rendu avec la couleur fournie.
///
/// @param color Couleur appliquée à tous les pixels du cadre courant.
def clearColor(color : Color) : Unit {
    clearBackground(color)
}

/// Dessine un pixel dans le cadre courant.
///
/// @param x Abscisse en pixels, dans l’espace de rendu actif.
/// @param y Ordonnée en pixels, dans l’espace de rendu actif.
/// @param color Couleur du pixel.
def drawPixel(x : int, y : int, color : Color) : Unit {
    janus_graphics_draw_pixel(x, y, color.packed())
}

/// Dessine un pixel à une position vectorielle, après conversion des coordonnées en entiers.
///
/// @param position Position dans l’espace de rendu actif.
/// @param color Couleur du pixel.
def drawPixelAt(position : Vector2, color : Color) : Unit {
    drawPixel(pixelCoordinate(position.x), pixelCoordinate(position.y), color)
}

/// Trace un segment entre deux positions entières du cadre courant.
///
/// @param startX Abscisse du premier point dans l’espace de rendu actif.
/// @param startY Ordonnée du premier point dans l’espace de rendu actif.
/// @param endX Abscisse du second point dans l’espace de rendu actif.
/// @param endY Ordonnée du second point dans l’espace de rendu actif.
/// @param color Couleur du segment.
def drawLine(
startX : int,
startY : int,
endX : int,
endY : int,
color : Color
) : Unit {
    janus_graphics_draw_line(startX, startY, endX, endY, color.packed())
}

/// Trace un segment entre deux vecteurs, après conversion de leurs coordonnées en entiers.
///
/// @param start Premier point dans l’espace de rendu actif.
/// @param end Second point dans l’espace de rendu actif.
/// @param color Couleur du segment.
def drawLineBetween(start : Vector2, end : Vector2, color : Color) : Unit {
    drawLine(
    pixelCoordinate(start.x),
    pixelCoordinate(start.y),
    pixelCoordinate(end.x),
    pixelCoordinate(end.y),
    color
    )
}

/// Dessine un disque centré sur une position entière du cadre courant.
///
/// @param centerX Abscisse du centre dans l’espace de rendu actif.
/// @param centerY Ordonnée du centre dans l’espace de rendu actif.
/// @param radius Rayon dans l’unité de l’espace de rendu actif.
/// @param color Couleur de remplissage.
def drawCircle(
centerX : int,
centerY : int,
radius : float,
color : Color
) : Unit {
    janus_graphics_draw_circle(centerX, centerY, radius, color.packed())
}

/// Dessine un disque centré sur un vecteur, après conversion du centre en entiers.
///
/// @param center Centre dans l’espace de rendu actif.
/// @param radius Rayon dans l’unité de cet espace.
/// @param color Couleur de remplissage.
def drawCircleAt(center : Vector2, radius : float, color : Color) : Unit {
    drawCircle(pixelCoordinate(center.x), pixelCoordinate(center.y), radius, color)
}

/// Dessine un rectangle plein dans le cadre courant.
///
/// @param x Abscisse du coin supérieur gauche dans l’espace de rendu actif.
/// @param y Ordonnée du coin supérieur gauche dans l’espace de rendu actif.
/// @param width Largeur dans l’unité de cet espace.
/// @param height Hauteur dans l’unité de cet espace.
/// @param color Couleur de remplissage.
def drawRectangle(
x : int,
y : int,
width : int,
height : int,
color : Color
) : Unit {
    janus_graphics_draw_rectangle(x, y, width, height, color.packed())
}

/// Dessine un rectangle plein décrit par une zone, après conversion de ses composantes en entiers.
///
/// @param area Position et dimensions dans l’espace de rendu actif.
/// @param color Couleur de remplissage.
def drawRectangleArea(area : Rectangle, color : Color) : Unit {
    drawRectangle(
    pixelCoordinate(area.x),
    pixelCoordinate(area.y),
    pixelCoordinate(area.width),
    pixelCoordinate(area.height),
    color
    )
}

/// Dessine une chaîne avec la police par défaut dans le cadre courant.
///
/// @param text Texte à afficher.
/// @param x Abscisse en pixels de l’origine du texte.
/// @param y Ordonnée en pixels de l’origine du texte.
/// @param fontSize Taille de police en pixels.
/// @param color Couleur du texte.
def drawText(
text : string,
x : int,
y : int,
fontSize : int,
color : Color
) : Unit {
    janus_graphics_draw_text(cstr(text), x, y, fontSize, color.packed())
}

/// Dessine une chaîne à une position vectorielle, après conversion de celle-ci en entiers.
///
/// @param text Texte à afficher.
/// @param position Origine du texte en pixels écran.
/// @param fontSize Taille de police en pixels.
/// @param color Couleur du texte.
def drawTextAt(
text : string,
position : Vector2,
fontSize : int,
color : Color
) : Unit {
    drawText(
    text,
    pixelCoordinate(position.x),
    pixelCoordinate(position.y),
    fontSize,
    color
    )
}

/// Trace un segment flottant avec une épaisseur donnée.
/// @param start Point ou couleur initiale.
/// @param end Point ou couleur finale.
/// @param thickness Épaisseur du trait en pixels.
/// @param color Couleur appliquée.
def drawLineEx(start : Vector2, end : Vector2, thickness : float, color : Color) : Unit {
    janus_graphics_draw_line_ex(start.x, start.y, end.x, end.y, thickness, color.packed())
}

/// Trace l’interpolation cubique de raylib entre deux points.
/// @param start Point ou couleur initiale.
/// @param end Point ou couleur finale.
/// @param thickness Épaisseur du trait en pixels.
/// @param color Couleur appliquée.
def drawLineBezier(start : Vector2, end : Vector2, thickness : float, color : Color) : Unit {
    janus_graphics_draw_line_bezier(start.x, start.y, end.x, end.y, thickness, color.packed())
}

/// Trace un segment discontinu avec les tailles de tiret et d’espace indiquées.
/// @param start Point ou couleur initiale.
/// @param end Point ou couleur finale.
/// @param dashSize Longueur des tirets.
/// @param spaceSize Longueur des espaces.
/// @param color Couleur appliquée.
def drawLineDashed(start : Vector2, end : Vector2, dashSize : int, spaceSize : int, color : Color) : Unit {
    janus_graphics_draw_line_dashed(start.x, start.y, end.x, end.y, dashSize, spaceSize, color.packed())
}

/// Dessine un disque avec un dégradé radial entre deux couleurs.
/// @param center Centre dans le repère actif.
/// @param radius Rayon de la forme.
/// @param inner Couleur centrale.
/// @param outer Couleur périphérique.
def drawCircleGradient(center : Vector2, radius : float, inner : Color, outer : Color) : Unit {
    janus_graphics_draw_circle_gradient(center.x, center.y, radius, inner.packed(), outer.packed())
}

/// Dessine un secteur de disque rempli.
/// @param center Centre dans le repère actif.
/// @param radius Rayon de la forme.
/// @param startAngle Angle initial en degrés.
/// @param endAngle Angle final en degrés.
/// @param segments Nombre de segments de l’approximation.
/// @param color Couleur appliquée.
def drawCircleSector(center : Vector2, radius : float, startAngle : float, endAngle : float, segments : int, color : Color) : Unit {
    janus_graphics_draw_circle_sector(center.x, center.y, radius, startAngle, endAngle, segments, color.packed(), false)
}

/// Trace le contour d’un secteur de disque.
/// @param center Centre dans le repère actif.
/// @param radius Rayon de la forme.
/// @param startAngle Angle initial en degrés.
/// @param endAngle Angle final en degrés.
/// @param segments Nombre de segments de l’approximation.
/// @param color Couleur appliquée.
def drawCircleSectorLines(center : Vector2, radius : float, startAngle : float, endAngle : float, segments : int, color : Color) : Unit {
    janus_graphics_draw_circle_sector(center.x, center.y, radius, startAngle, endAngle, segments, color.packed(), true)
}

/// Trace le contour d’un cercle.
/// @param center Centre dans le repère actif.
/// @param radius Rayon de la forme.
/// @param color Couleur appliquée.
def drawCircleLines(center : Vector2, radius : float, color : Color) : Unit {
    janus_graphics_draw_circle_lines(pixelCoordinate(center.x), pixelCoordinate(center.y), radius, color.packed())
}

/// Dessine une ellipse pleine.
/// @param center Centre dans le repère actif.
/// @param radiusX Demi-largeur de l’ellipse.
/// @param radiusY Demi-hauteur de l’ellipse.
/// @param color Couleur appliquée.
def drawEllipse(center : Vector2, radiusX : float, radiusY : float, color : Color) : Unit {
    janus_graphics_draw_ellipse(pixelCoordinate(center.x), pixelCoordinate(center.y), radiusX, radiusY, color.packed(), false)
}

/// Trace le contour d’une ellipse.
/// @param center Centre dans le repère actif.
/// @param radiusX Demi-largeur de l’ellipse.
/// @param radiusY Demi-hauteur de l’ellipse.
/// @param color Couleur appliquée.
def drawEllipseLines(center : Vector2, radiusX : float, radiusY : float, color : Color) : Unit {
    janus_graphics_draw_ellipse(pixelCoordinate(center.x), pixelCoordinate(center.y), radiusX, radiusY, color.packed(), true)
}

/// Dessine un anneau ou une portion d’anneau.
/// @param center Centre dans le repère actif.
/// @param innerRadius Rayon intérieur.
/// @param outerRadius Rayon extérieur.
/// @param startAngle Angle initial en degrés.
/// @param endAngle Angle final en degrés.
/// @param segments Nombre de segments de l’approximation.
/// @param color Couleur appliquée.
def drawRing(center : Vector2, innerRadius : float, outerRadius : float, startAngle : float, endAngle : float, segments : int, color : Color) : Unit {
    janus_graphics_draw_ring(center.x, center.y, innerRadius, outerRadius, startAngle, endAngle, segments, color.packed(), false)
}

/// Trace le contour d’un anneau ou d’une portion d’anneau.
/// @param center Centre dans le repère actif.
/// @param innerRadius Rayon intérieur.
/// @param outerRadius Rayon extérieur.
/// @param startAngle Angle initial en degrés.
/// @param endAngle Angle final en degrés.
/// @param segments Nombre de segments de l’approximation.
/// @param color Couleur appliquée.
def drawRingLines(center : Vector2, innerRadius : float, outerRadius : float, startAngle : float, endAngle : float, segments : int, color : Color) : Unit {
    janus_graphics_draw_ring(center.x, center.y, innerRadius, outerRadius, startAngle, endAngle, segments, color.packed(), true)
}

/// Dessine un rectangle avec origine et rotation.
/// @param area Zone rectangulaire concernée.
/// @param origin Point de pivot.
/// @param rotation Rotation en degrés.
/// @param color Couleur appliquée.
def drawRectanglePro(area : Rectangle, origin : Vector2, rotation : float, color : Color) : Unit {
    janus_graphics_draw_rectangle_pro(area.x, area.y, area.width, area.height, origin.x, origin.y, rotation, color.packed())
}

/// Dessine un rectangle avec un dégradé vertical.
/// @param area Zone rectangulaire concernée.
/// @param top Couleur supérieure.
/// @param bottom Couleur inférieure.
def drawRectangleGradientVertical(area : Rectangle, top : Color, bottom : Color) : Unit {
    janus_graphics_draw_rectangle_gradient(pixelCoordinate(area.x), pixelCoordinate(area.y), pixelCoordinate(area.width), pixelCoordinate(area.height), top.packed(), bottom.packed(), false)
}

/// Dessine un rectangle avec un dégradé horizontal.
/// @param area Zone rectangulaire concernée.
/// @param left Couleur gauche.
/// @param right Couleur droite.
def drawRectangleGradientHorizontal(area : Rectangle, left : Color, right : Color) : Unit {
    janus_graphics_draw_rectangle_gradient(pixelCoordinate(area.x), pixelCoordinate(area.y), pixelCoordinate(area.width), pixelCoordinate(area.height), left.packed(), right.packed(), true)
}

/// Dessine un rectangle avec une couleur distincte à chaque sommet.
/// @param area Zone rectangulaire concernée.
/// @param topLeft Couleur du sommet supérieur gauche.
/// @param bottomLeft Couleur du sommet inférieur gauche.
/// @param bottomRight Couleur du sommet inférieur droit.
/// @param topRight Couleur du sommet supérieur droit.
def drawRectangleGradient(area : Rectangle, topLeft : Color, bottomLeft : Color, bottomRight : Color, topRight : Color) : Unit {
    janus_graphics_draw_rectangle_gradient_ex(area.x, area.y, area.width, area.height, topLeft.packed(), bottomLeft.packed(), bottomRight.packed(), topRight.packed())
}

/// Trace le contour d’un rectangle avec une épaisseur flottante.
/// @param area Zone rectangulaire concernée.
/// @param thickness Épaisseur du trait en pixels.
/// @param color Couleur appliquée.
def drawRectangleLines(area : Rectangle, thickness : float, color : Color) : Unit {
    janus_graphics_draw_rectangle_lines(area.x, area.y, area.width, area.height, thickness, color.packed())
}

/// Dessine un rectangle à coins arrondis.
/// @param area Zone rectangulaire concernée.
/// @param roundness Rapport du rayon des coins.
/// @param segments Nombre de segments de l’approximation.
/// @param color Couleur appliquée.
def drawRectangleRounded(area : Rectangle, roundness : float, segments : int, color : Color) : Unit {
    janus_graphics_draw_rectangle_rounded(area.x, area.y, area.width, area.height, roundness, segments, numericCast[float](0.0), color.packed(), false)
}

/// Trace le contour d’un rectangle à coins arrondis.
/// @param area Zone rectangulaire concernée.
/// @param roundness Rapport du rayon des coins.
/// @param segments Nombre de segments de l’approximation.
/// @param thickness Épaisseur du trait en pixels.
/// @param color Couleur appliquée.
def drawRectangleRoundedLines(area : Rectangle, roundness : float, segments : int, thickness : float, color : Color) : Unit {
    janus_graphics_draw_rectangle_rounded(area.x, area.y, area.width, area.height, roundness, segments, thickness, color.packed(), true)
}

/// Dessine un triangle plein; les sommets sont attendus dans le sens antihoraire.
/// @param first Premier point ou rectangle.
/// @param second Deuxième point ou rectangle.
/// @param third Troisième point.
/// @param color Couleur appliquée.
def drawTriangle(first : Vector2, second : Vector2, third : Vector2, color : Color) : Unit {
    janus_graphics_draw_triangle(first.x, first.y, second.x, second.y, third.x, third.y, color.packed(), false)
}

/// Trace le contour d’un triangle.
/// @param first Premier point ou rectangle.
/// @param second Deuxième point ou rectangle.
/// @param third Troisième point.
/// @param color Couleur appliquée.
def drawTriangleLines(first : Vector2, second : Vector2, third : Vector2, color : Color) : Unit {
    janus_graphics_draw_triangle(first.x, first.y, second.x, second.y, third.x, third.y, color.packed(), true)
}

/// Dessine un polygone régulier.
/// @param center Centre dans le repère actif.
/// @param sides Nombre de côtés.
/// @param radius Rayon de la forme.
/// @param rotation Rotation en degrés.
/// @param color Couleur appliquée.
def drawPolygon(center : Vector2, sides : int, radius : float, rotation : float, color : Color) : Unit {
    janus_graphics_draw_polygon(center.x, center.y, sides, radius, rotation, numericCast[float](0.0), color.packed(), false)
}

/// Trace le contour d’un polygone régulier.
/// @param center Centre dans le repère actif.
/// @param sides Nombre de côtés.
/// @param radius Rayon de la forme.
/// @param rotation Rotation en degrés.
/// @param thickness Épaisseur du trait en pixels.
/// @param color Couleur appliquée.
def drawPolygonLines(center : Vector2, sides : int, radius : float, rotation : float, thickness : float, color : Color) : Unit {
    janus_graphics_draw_polygon(center.x, center.y, sides, radius, rotation, thickness, color.packed(), true)
}

/// Trace une ligne brisée depuis `count` vecteurs contigus.
/// @param points Pointeur vers des Vector2 contigus appartenant à l’appelant.
/// @param count Nombre de vecteurs lisibles.
/// @param color Couleur appliquée.
def drawLineStrip(points : Ptr[Vector2], count : int, color : Color) : Unit {
    janus_graphics_draw_point_sequence(points, count, numericCast[float](0.0), color.packed(), 0)
}

/// Dessine un éventail de triangles depuis `count` vecteurs contigus.
/// @param points Pointeur vers des Vector2 contigus appartenant à l’appelant.
/// @param count Nombre de vecteurs lisibles.
/// @param color Couleur appliquée.
def drawTriangleFan(points : Ptr[Vector2], count : int, color : Color) : Unit {
    janus_graphics_draw_point_sequence(points, count, numericCast[float](0.0), color.packed(), 1)
}

/// Dessine une bande de triangles depuis `count` vecteurs contigus.
/// @param points Pointeur vers des Vector2 contigus appartenant à l’appelant.
/// @param count Nombre de vecteurs lisibles.
/// @param color Couleur appliquée.
def drawTriangleStrip(points : Ptr[Vector2], count : int, color : Color) : Unit {
    janus_graphics_draw_point_sequence(points, count, numericCast[float](0.0), color.packed(), 2)
}

/// Trace une spline linéaire depuis `count` vecteurs contigus.
/// @param points Pointeur vers des Vector2 contigus appartenant à l’appelant.
/// @param count Nombre de vecteurs lisibles.
/// @param thickness Épaisseur du trait en pixels.
/// @param color Couleur appliquée.
def drawSplineLinear(points : Ptr[Vector2], count : int, thickness : float, color : Color) : Unit {
    janus_graphics_draw_point_sequence(points, count, thickness, color.packed(), 3)
}

/// Trace une B-spline cubique depuis `count` vecteurs contigus.
/// @param points Pointeur vers des Vector2 contigus appartenant à l’appelant.
/// @param count Nombre de vecteurs lisibles.
/// @param thickness Épaisseur du trait en pixels.
/// @param color Couleur appliquée.
def drawSplineBasis(points : Ptr[Vector2], count : int, thickness : float, color : Color) : Unit {
    janus_graphics_draw_point_sequence(points, count, thickness, color.packed(), 4)
}

/// Trace une spline Catmull-Rom depuis `count` vecteurs contigus.
/// @param points Pointeur vers des Vector2 contigus appartenant à l’appelant.
/// @param count Nombre de vecteurs lisibles.
/// @param thickness Épaisseur du trait en pixels.
/// @param color Couleur appliquée.
def drawSplineCatmullRom(points : Ptr[Vector2], count : int, thickness : float, color : Color) : Unit {
    janus_graphics_draw_point_sequence(points, count, thickness, color.packed(), 5)
}

/// Trace une spline de Bézier quadratique depuis `count` vecteurs contigus.
/// @param points Pointeur vers des Vector2 contigus appartenant à l’appelant.
/// @param count Nombre de vecteurs lisibles.
/// @param thickness Épaisseur du trait en pixels.
/// @param color Couleur appliquée.
def drawSplineBezierQuadratic(points : Ptr[Vector2], count : int, thickness : float, color : Color) : Unit {
    janus_graphics_draw_point_sequence(points, count, thickness, color.packed(), 6)
}

/// Trace une spline de Bézier cubique depuis `count` vecteurs contigus.
/// @param points Pointeur vers des Vector2 contigus appartenant à l’appelant.
/// @param count Nombre de vecteurs lisibles.
/// @param thickness Épaisseur du trait en pixels.
/// @param color Couleur appliquée.
def drawSplineBezierCubic(points : Ptr[Vector2], count : int, thickness : float, color : Color) : Unit {
    janus_graphics_draw_point_sequence(points, count, thickness, color.packed(), 7)
}

/// Trace un segment de spline linéaire.
/// @param first Premier point ou rectangle.
/// @param second Deuxième point ou rectangle.
/// @param thickness Épaisseur du trait en pixels.
/// @param color Couleur appliquée.
def drawSplineSegmentLinear(first : Vector2, second : Vector2, thickness : float, color : Color) : Unit {
    janus_graphics_draw_spline_segment(first.x, first.y, second.x, second.y, numericCast[float](0.0), numericCast[float](0.0), numericCast[float](0.0), numericCast[float](0.0), thickness, color.packed(), 0)
}

/// Trace un segment de B-spline cubique.
/// @param first Premier point ou rectangle.
/// @param second Deuxième point ou rectangle.
/// @param third Troisième point.
/// @param fourth Quatrième point.
/// @param thickness Épaisseur du trait en pixels.
/// @param color Couleur appliquée.
def drawSplineSegmentBasis(first : Vector2, second : Vector2, third : Vector2, fourth : Vector2, thickness : float, color : Color) : Unit {
    janus_graphics_draw_spline_segment(first.x, first.y, second.x, second.y, third.x, third.y, fourth.x, fourth.y, thickness, color.packed(), 1)
}

/// Trace un segment de spline Catmull-Rom.
/// @param first Premier point ou rectangle.
/// @param second Deuxième point ou rectangle.
/// @param third Troisième point.
/// @param fourth Quatrième point.
/// @param thickness Épaisseur du trait en pixels.
/// @param color Couleur appliquée.
def drawSplineSegmentCatmullRom(first : Vector2, second : Vector2, third : Vector2, fourth : Vector2, thickness : float, color : Color) : Unit {
    janus_graphics_draw_spline_segment(first.x, first.y, second.x, second.y, third.x, third.y, fourth.x, fourth.y, thickness, color.packed(), 2)
}

/// Trace un segment de Bézier quadratique.
/// @param first Premier point ou rectangle.
/// @param control Point de contrôle.
/// @param end Point ou couleur finale.
/// @param thickness Épaisseur du trait en pixels.
/// @param color Couleur appliquée.
def drawSplineSegmentBezierQuadratic(first : Vector2, control : Vector2, end : Vector2, thickness : float, color : Color) : Unit {
    janus_graphics_draw_spline_segment(first.x, first.y, control.x, control.y, end.x, end.y, numericCast[float](0.0), numericCast[float](0.0), thickness, color.packed(), 3)
}

/// Trace un segment de Bézier cubique.
/// @param first Premier point ou rectangle.
/// @param control1 Premier point de contrôle.
/// @param control2 Second point de contrôle.
/// @param end Point ou couleur finale.
/// @param thickness Épaisseur du trait en pixels.
/// @param color Couleur appliquée.
def drawSplineSegmentBezierCubic(first : Vector2, control1 : Vector2, control2 : Vector2, end : Vector2, thickness : float, color : Color) : Unit {
    janus_graphics_draw_spline_segment(first.x, first.y, control1.x, control1.y, control2.x, control2.y, end.x, end.y, thickness, color.packed(), 4)
}

private def splinePoint(first : Vector2, second : Vector2, third : Vector2, fourth : Vector2, amount : float, kind : int) : Vector2 {
    return vector2(
    janus_graphics_spline_point_component(first.x, first.y, second.x, second.y, third.x, third.y, fourth.x, fourth.y, amount, kind, false),
    janus_graphics_spline_point_component(first.x, first.y, second.x, second.y, third.x, third.y, fourth.x, fourth.y, amount, kind, true)
    )
}

/// Évalue un segment de spline linéaire pour `amount` compris entre 0 et 1.
/// @param first Premier point ou rectangle.
/// @param second Deuxième point ou rectangle.
/// @param amount Position normalisée sur la courbe.
/// @return Position calculée dans le repère de l’appel.
def splinePointLinear(first : Vector2, second : Vector2, amount : float) : Vector2 {
    val empty : Vector2 = vector2(numericCast[float](0.0), numericCast[float](0.0))
    return splinePoint(first, second, empty, empty, amount, 0)
}

/// Évalue un segment de B-spline cubique.
/// @param first Premier point ou rectangle.
/// @param second Deuxième point ou rectangle.
/// @param third Troisième point.
/// @param fourth Quatrième point.
/// @param amount Position normalisée sur la courbe.
/// @return Position calculée dans le repère de l’appel.
def splinePointBasis(first : Vector2, second : Vector2, third : Vector2, fourth : Vector2, amount : float) : Vector2 {
    return splinePoint(first, second, third, fourth, amount, 1)
}

/// Évalue un segment de spline Catmull-Rom.
/// @param first Premier point ou rectangle.
/// @param second Deuxième point ou rectangle.
/// @param third Troisième point.
/// @param fourth Quatrième point.
/// @param amount Position normalisée sur la courbe.
/// @return Position calculée dans le repère de l’appel.
def splinePointCatmullRom(first : Vector2, second : Vector2, third : Vector2, fourth : Vector2, amount : float) : Vector2 {
    return splinePoint(first, second, third, fourth, amount, 2)
}

/// Évalue une courbe de Bézier quadratique.
/// @param first Premier point ou rectangle.
/// @param control Point de contrôle.
/// @param end Point ou couleur finale.
/// @param amount Position normalisée sur la courbe.
/// @return Position calculée dans le repère de l’appel.
def splinePointBezierQuadratic(first : Vector2, control : Vector2, end : Vector2, amount : float) : Vector2 {
    return splinePoint(first, control, end, vector2(numericCast[float](0.0), numericCast[float](0.0)), amount, 3)
}

/// Évalue une courbe de Bézier cubique.
/// @param first Premier point ou rectangle.
/// @param control1 Premier point de contrôle.
/// @param control2 Second point de contrôle.
/// @param end Point ou couleur finale.
/// @param amount Position normalisée sur la courbe.
/// @return Position calculée dans le repère de l’appel.
def splinePointBezierCubic(first : Vector2, control1 : Vector2, control2 : Vector2, end : Vector2, amount : float) : Vector2 {
    return splinePoint(first, control1, control2, end, amount, 4)
}

/// Teste le chevauchement de deux rectangles.
/// @param first Premier point ou rectangle.
/// @param second Deuxième point ou rectangle.
/// @return `true` lorsque le test ou l’opération réussit.
def collisionRectangles(first : Rectangle, second : Rectangle) : bool {
    return janus_graphics_collision_rectangles(first.x, first.y, first.width, first.height, second.x, second.y, second.width, second.height)
}

/// Teste le chevauchement de deux cercles.
/// @param firstCenter Centre du premier cercle.
/// @param firstRadius Rayon du premier cercle.
/// @param secondCenter Centre du second cercle.
/// @param secondRadius Rayon du second cercle.
/// @return `true` lorsque le test ou l’opération réussit.
def collisionCircles(firstCenter : Vector2, firstRadius : float, secondCenter : Vector2, secondRadius : float) : bool {
    return janus_graphics_collision_circles(firstCenter.x, firstCenter.y, firstRadius, secondCenter.x, secondCenter.y, secondRadius)
}

/// Teste le chevauchement d’un cercle et d’un rectangle.
/// @param center Centre dans le repère actif.
/// @param radius Rayon de la forme.
/// @param area Zone rectangulaire concernée.
/// @return `true` lorsque le test ou l’opération réussit.
def collisionCircleRectangle(center : Vector2, radius : float, area : Rectangle) : bool {
    return janus_graphics_collision_circle_rectangle(center.x, center.y, radius, area.x, area.y, area.width, area.height)
}

/// Teste le chevauchement d’un cercle et d’un segment.
/// @param center Centre dans le repère actif.
/// @param radius Rayon de la forme.
/// @param start Point ou couleur initiale.
/// @param end Point ou couleur finale.
/// @return `true` lorsque le test ou l’opération réussit.
def collisionCircleLine(center : Vector2, radius : float, start : Vector2, end : Vector2) : bool {
    return janus_graphics_collision_circle_line(center.x, center.y, radius, start.x, start.y, end.x, end.y)
}

/// Teste si un point appartient à un rectangle.
/// @param point Position soumise au calcul.
/// @param area Zone rectangulaire concernée.
/// @return `true` lorsque le test ou l’opération réussit.
def collisionPointRectangle(point : Vector2, area : Rectangle) : bool {
    return janus_graphics_collision_point_rectangle(point.x, point.y, area.x, area.y, area.width, area.height)
}

/// Teste si un point appartient à un cercle.
/// @param point Position soumise au calcul.
/// @param center Centre dans le repère actif.
/// @param radius Rayon de la forme.
/// @return `true` lorsque le test ou l’opération réussit.
def collisionPointCircle(point : Vector2, center : Vector2, radius : float) : bool {
    return janus_graphics_collision_point_circle(point.x, point.y, center.x, center.y, radius)
}

/// Teste si un point appartient à un triangle.
/// @param point Position soumise au calcul.
/// @param first Premier point ou rectangle.
/// @param second Deuxième point ou rectangle.
/// @param third Troisième point.
/// @return `true` lorsque le test ou l’opération réussit.
def collisionPointTriangle(point : Vector2, first : Vector2, second : Vector2, third : Vector2) : bool {
    return janus_graphics_collision_point_triangle(point.x, point.y, first.x, first.y, second.x, second.y, third.x, third.y)
}

/// Teste si un point se trouve près d’un segment selon une marge en pixels.
/// @param point Position soumise au calcul.
/// @param start Point ou couleur initiale.
/// @param end Point ou couleur finale.
/// @param threshold Seuil du test.
/// @return `true` lorsque le test ou l’opération réussit.
def collisionPointLine(point : Vector2, start : Vector2, end : Vector2, threshold : int) : bool {
    return janus_graphics_collision_point_line(point.x, point.y, start.x, start.y, end.x, end.y, threshold)
}

/// Teste si un point appartient au polygone défini par `count` vecteurs contigus.
/// @param point Position soumise au calcul.
/// @param points Pointeur vers des Vector2 contigus appartenant à l’appelant.
/// @param count Nombre de vecteurs lisibles.
/// @return `true` lorsque le test ou l’opération réussit.
def collisionPointPolygon(point : Vector2, points : Ptr[Vector2], count : int) : bool {
    return janus_graphics_collision_point_polygon(point.x, point.y, points, count)
}

/// Teste l’intersection de deux segments.
/// @param firstStart Origine du premier segment.
/// @param firstEnd Extrémité du premier segment.
/// @param secondStart Origine du second segment.
/// @param secondEnd Extrémité du second segment.
/// @return `true` lorsque le test ou l’opération réussit.
def collisionLines(firstStart : Vector2, firstEnd : Vector2, secondStart : Vector2, secondEnd : Vector2) : bool {
    return janus_graphics_collision_lines(firstStart.x, firstStart.y, firstEnd.x, firstEnd.y, secondStart.x, secondStart.y, secondEnd.x, secondEnd.y)
}

/// Renvoie le point d’intersection de deux segments, ou `(0, 0)` s’ils ne se croisent pas.
/// @param firstStart Origine du premier segment.
/// @param firstEnd Extrémité du premier segment.
/// @param secondStart Origine du second segment.
/// @param secondEnd Extrémité du second segment.
/// @return Position calculée dans le repère de l’appel.
def collisionLinesPoint(firstStart : Vector2, firstEnd : Vector2, secondStart : Vector2, secondEnd : Vector2) : Vector2 {
    return vector2(
    janus_graphics_collision_lines_component(firstStart.x, firstStart.y, firstEnd.x, firstEnd.y, secondStart.x, secondStart.y, secondEnd.x, secondEnd.y, false),
    janus_graphics_collision_lines_component(firstStart.x, firstStart.y, firstEnd.x, firstEnd.y, secondStart.x, secondStart.y, secondEnd.x, secondEnd.y, true)
    )
}

/// Calcule le rectangle d’intersection de deux rectangles.
/// @param first Premier point ou rectangle.
/// @param second Deuxième point ou rectangle.
/// @return Rectangle calculé, nul lorsqu’aucune zone ne convient.
def collisionRectangle(first : Rectangle, second : Rectangle) : Rectangle {
    return rectangle(
    janus_graphics_collision_rectangle_x(first.x, first.y, first.width, first.height, second.x, second.y, second.width, second.height),
    janus_graphics_collision_rectangle_y(first.x, first.y, first.width, first.height, second.x, second.y, second.width, second.height),
    janus_graphics_collision_rectangle_width(first.x, first.y, first.width, first.height, second.x, second.y, second.width, second.height),
    janus_graphics_collision_rectangle_height(first.x, first.y, first.width, first.height, second.x, second.y, second.width, second.height)
    )
}
