/// Charge les textures, fontes, cibles de rendu, shaders et animations propriétaires.
///
/// Chaque classe libère son handle natif à sa destruction. Vérifiez [[Texture.isValid]] ou son
/// équivalent, gardez la ressource vivante pendant son usage et détruisez-la avant [[closeWindow]].
/// @example
/// ```janus
/// val texture : Texture = loadTexture("player.png")
/// if texture.isValid() {
///     texture.draw(10, 20, White)
/// }
/// delete texture
/// ```
module std.graphics.resources
import std.c
import std.graphics.types

private extern def janus_graphics_load_font(
fileName : Ptr[byte],
fontSize : int
) : Ptr[byte]
private extern def janus_graphics_load_font_utf8(
fileName : Ptr[byte],
fontSize : int,
characters : Ptr[byte]
) : Ptr[byte]
private extern def janus_graphics_font_is_valid(handle : Ptr[byte]) : bool
private extern def janus_graphics_unload_font(handle : Ptr[byte]) : Unit
private extern def janus_graphics_draw_text_font(
handle : Ptr[byte],
text : Ptr[byte],
x : float,
y : float,
fontSize : float,
spacing : float,
color : uint
) : Unit
private extern def janus_graphics_measure_text_width(
handle : Ptr[byte],
text : Ptr[byte],
fontSize : float,
spacing : float
) : float
private extern def janus_graphics_measure_text_height(
handle : Ptr[byte],
text : Ptr[byte],
fontSize : float,
spacing : float
) : float
private extern def janus_graphics_load_texture(fileName : Ptr[byte]) : Ptr[byte]
private extern def janus_graphics_texture_is_valid(handle : Ptr[byte]) : bool
private extern def janus_graphics_texture_width(handle : Ptr[byte]) : int
private extern def janus_graphics_texture_height(handle : Ptr[byte]) : int
private extern def janus_graphics_unload_texture(handle : Ptr[byte]) : Unit
private extern def janus_graphics_draw_texture(
handle : Ptr[byte],
x : int,
y : int,
tint : uint
) : Unit
private extern def janus_graphics_draw_texture_pro(
handle : Ptr[byte],
sourceX : float,
sourceY : float,
sourceWidth : float,
sourceHeight : float,
destinationX : float,
destinationY : float,
destinationWidth : float,
destinationHeight : float,
originX : float,
originY : float,
rotation : float,
tint : uint
) : Unit
private extern def janus_graphics_set_texture_filter(
handle : Ptr[byte],
filter : int
) : Unit
private extern def janus_graphics_load_render_texture(
width : int,
height : int
) : Ptr[byte]
private extern def janus_graphics_render_texture_is_valid(
handle : Ptr[byte]
) : bool
private extern def janus_graphics_render_texture_width(handle : Ptr[byte]) : int
private extern def janus_graphics_render_texture_height(handle : Ptr[byte]) : int
private extern def janus_graphics_unload_render_texture(handle : Ptr[byte]) : Unit
private extern def janus_graphics_begin_render_texture(handle : Ptr[byte]) : Unit
private extern def janus_graphics_end_render_texture() : Unit
private extern def janus_graphics_draw_render_texture_pro(
handle : Ptr[byte],
sourceX : float,
sourceY : float,
sourceWidth : float,
sourceHeight : float,
destinationX : float,
destinationY : float,
destinationWidth : float,
destinationHeight : float,
originX : float,
originY : float,
rotation : float,
tint : uint
) : Unit
private extern def janus_graphics_load_fragment_shader(
fragmentFile : Ptr[byte]
) : Ptr[byte]
private extern def janus_graphics_load_shader(
vertexFile : Ptr[byte],
fragmentFile : Ptr[byte]
) : Ptr[byte]
private extern def janus_graphics_shader_is_valid(handle : Ptr[byte]) : bool
private extern def janus_graphics_unload_shader(handle : Ptr[byte]) : Unit
private extern def janus_graphics_begin_shader(handle : Ptr[byte]) : Unit
private extern def janus_graphics_end_shader() : Unit
private extern def janus_graphics_shader_location(
handle : Ptr[byte],
name : Ptr[byte]
) : int
private extern def janus_graphics_set_shader_float(
handle : Ptr[byte],
location : int,
value : float
) : Unit
private extern def janus_graphics_set_shader_vector2(
handle : Ptr[byte],
location : int,
x : float,
y : float
) : Unit
private extern def janus_graphics_set_shader_color(
handle : Ptr[byte],
location : int,
color : uint
) : Unit
private extern def janus_graphics_set_shader_int(
handle : Ptr[byte],
location : int,
value : int
) : Unit
/// Définit [[Texture]], avec les garanties et la propriété décrites par ses méthodes.
class Texture(private val handle : Ptr[byte]) {
    /// Indique si la texture est valide.
    ///
    /// @return Résultat de type [[bool]].
    def isValid() : bool {
        return janus_graphics_texture_is_valid(handle)
    }

    /// Retourne la largeur de la texture.
    ///
    /// @return Résultat de type [[int]].
    def width() : int {
        return janus_graphics_texture_width(handle)
    }

    /// Retourne la hauteur de la texture.
    ///
    /// @return Résultat de type [[int]].
    def height() : int {
        return janus_graphics_texture_height(handle)
    }

    /// Fournit la sémantique de [[draw]].
    ///
    /// @param x Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param y Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param tint Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    def draw(x : int, y : int, tint : Color) : Unit {
        janus_graphics_draw_texture(handle, x, y, tint.packed())
    }

    /// Fournit la sémantique de [[drawAt]].
    ///
    /// @param position Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param tint Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    def drawAt(position : Vector2, tint : Color) : Unit {
        janus_graphics_draw_texture(
        handle,
        int(position.x),
        int(position.y),
        tint.packed()
        )
    }

    /// Fournit la sémantique de [[drawPro]].
    ///
    /// @param source Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param destination Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param origin Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param rotation Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param tint Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    def drawPro(
    source : Rectangle,
    destination : Rectangle,
    origin : Vector2,
    rotation : float,
    tint : Color
    ) : Unit {
        janus_graphics_draw_texture_pro(
        handle,
        source.x,
        source.y,
        source.width,
        source.height,
        destination.x,
        destination.y,
        destination.width,
        destination.height,
        origin.x,
        origin.y,
        rotation,
        tint.packed()
        )
    }

    /// Fournit la sémantique de [[drawFrame]].
    ///
    /// @param frame Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param frameWidth Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param frameHeight Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param columns Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param position Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param scale Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param rotation Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param flipX Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param flipY Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param tint Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    def drawFrame(
    frame : int,
    frameWidth : int,
    frameHeight : int,
    columns : int,
    position : Vector2,
    scale : float,
    rotation : float,
    flipX : bool,
    flipY : bool,
    tint : Color
    ) : Unit {
        val column : int = frame % columns
        val row : int = frame / columns
        var sourceWidth : float = float(frameWidth)
        var sourceHeight : float = float(frameHeight)
        if flipX {
            sourceWidth = -sourceWidth
        }
        if flipY {
            sourceHeight = -sourceHeight
        }
        janus_graphics_draw_texture_pro(
        handle,
        float(column * frameWidth),
        float(row * frameHeight),
        sourceWidth,
        sourceHeight,
        position.x,
        position.y,
        float(frameWidth) * scale,
        float(frameHeight) * scale,
        float(0.0),
        float(0.0),
        rotation,
        tint.packed()
        )
    }

    /// Règle le filtre d’échantillonnage de la texture.
    ///
    /// @param filter Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    def setFilter(filter : TextureFilter) : Unit {
        janus_graphics_set_texture_filter(handle, int(filter))
    }

    destructor {
        janus_graphics_unload_texture(handle)
    }
}

/// Définit [[Font]], avec les garanties et la propriété décrites par ses méthodes.
class Font(private val handle : Ptr[byte]) {
    /// Indique si la fonte est valide.
    ///
    /// @return Résultat de type [[bool]].
    def isValid() : bool {
        return janus_graphics_font_is_valid(handle)
    }

    /// Fournit la sémantique de [[draw]].
    ///
    /// @param text Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param position Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param fontSize Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param spacing Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param color Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    def draw(
    text : string,
    position : Vector2,
    fontSize : float,
    spacing : float,
    color : Color
    ) : Unit {
        janus_graphics_draw_text_font(
        handle,
        cstr(text),
        position.x,
        position.y,
        fontSize,
        spacing,
        color.packed()
        )
    }

    /// Fournit la sémantique de [[measure]].
    ///
    /// @param text Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param fontSize Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param spacing Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @return Résultat de type [[Vector2]].
    def measure(
    text : string,
    fontSize : float,
    spacing : float
    ) : Vector2 {
        return vector2(
        janus_graphics_measure_text_width(
        handle,
        cstr(text),
        fontSize,
        spacing
        ),
        janus_graphics_measure_text_height(
        handle,
        cstr(text),
        fontSize,
        spacing
        )
        )
    }

    destructor {
        janus_graphics_unload_font(handle)
    }
}

/// Définit [[RenderTexture]], avec les garanties et la propriété décrites par ses méthodes.
class RenderTexture(private val handle : Ptr[byte]) {
    /// Indique si la texture de rendu est valide.
    ///
    /// @return Résultat de type [[bool]].
    def isValid() : bool {
        return janus_graphics_render_texture_is_valid(handle)
    }

    /// Retourne la largeur de la texture de rendu.
    ///
    /// @return Résultat de type [[int]].
    def width() : int {
        return janus_graphics_render_texture_width(handle)
    }

    /// Retourne la hauteur de la texture de rendu.
    ///
    /// @return Résultat de type [[int]].
    def height() : int {
        return janus_graphics_render_texture_height(handle)
    }

    /// Fournit la sémantique de [[begin]].
    def begin() : Unit {
        janus_graphics_begin_render_texture(handle)
    }

    /// Fournit la sémantique de [[drawPro]].
    ///
    /// @param source Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param destination Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param origin Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param rotation Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param tint Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    def drawPro(
    source : Rectangle,
    destination : Rectangle,
    origin : Vector2,
    rotation : float,
    tint : Color
    ) : Unit {
        janus_graphics_draw_render_texture_pro(
        handle,
        source.x,
        source.y,
        source.width,
        source.height,
        destination.x,
        destination.y,
        destination.width,
        destination.height,
        origin.x,
        origin.y,
        rotation,
        tint.packed()
        )
    }

    destructor {
        janus_graphics_unload_render_texture(handle)
    }
}

/// Définit [[Shader]], avec les garanties et la propriété décrites par ses méthodes.
class Shader(private val handle : Ptr[byte]) {
    /// Indique si le shader est valide.
    ///
    /// @return Résultat de type [[bool]].
    def isValid() : bool {
        return janus_graphics_shader_is_valid(handle)
    }

    /// Fournit la sémantique de [[begin]].
    def begin() : Unit {
        janus_graphics_begin_shader(handle)
    }

    /// Fournit la sémantique de [[location]].
    ///
    /// @param name Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @return Résultat de type [[int]].
    def location(name : string) : int {
        return janus_graphics_shader_location(handle, cstr(name))
    }

    /// Affecte une valeur flottante à l’uniforme.
    ///
    /// @param location Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    def setFloat(location : int, value : float) : Unit {
        janus_graphics_set_shader_float(handle, location, value)
    }

    /// Affecte un vecteur 2D à l’uniforme.
    ///
    /// @param location Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    def setVector2(location : int, value : Vector2) : Unit {
        janus_graphics_set_shader_vector2(
        handle,
        location,
        value.x,
        value.y
        )
    }

    /// Affecte une couleur à l’uniforme.
    ///
    /// @param location Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    def setColor(location : int, value : Color) : Unit {
        janus_graphics_set_shader_color(handle, location, value.packed())
    }

    /// Affecte une valeur entière à l’uniforme.
    ///
    /// @param location Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param value Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    def setInt(location : int, value : int) : Unit {
        janus_graphics_set_shader_int(handle, location, value)
    }

    destructor {
        janus_graphics_unload_shader(handle)
    }
}

/// Définit [[SpriteAnimation]], avec les garanties et la propriété décrites par ses méthodes.
class SpriteAnimation(
/// Texture propriétaire contenant la feuille de sprites découpée en images.
val texture : Texture,
/// Largeur en pixels d’une image dans la feuille de sprites.
val frameWidth : int,
/// Hauteur en pixels d’une image dans la feuille de sprites.
val frameHeight : int,
/// Nombre d’images disposées sur chaque ligne de la texture.
val columns : int,
/// Nombre total d’images de l’animation; il doit être strictement positif pour [[advance]].
val frameCount : int,
/// Indice zéro-based de l’image actuellement dessinée.
var currentFrame : int
) {
    /// Fournit la sémantique de [[advance]].
    ///
    /// @return Résultat de type [[int]].
    def advance() : int {
        currentFrame = (currentFrame + 1) % frameCount
        return currentFrame
    }

    /// Réinitialise l’état.
    def reset() : Unit {
        currentFrame = 0
    }

    /// Fournit la sémantique de [[draw]].
    ///
    /// @param position Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param scale Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param rotation Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param flipX Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param flipY Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    /// @param tint Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
    def draw(
    position : Vector2,
    scale : float,
    rotation : float,
    flipX : bool,
    flipY : bool,
    tint : Color
    ) : Unit {
        texture.drawFrame(
        currentFrame,
        frameWidth,
        frameHeight,
        columns,
        position,
        scale,
        rotation,
        flipX,
        flipY,
        tint
        )
    }
}

/// Charge une texture depuis un fichier.
///
/// @param fileName Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[Texture]].
def loadTexture(fileName : string) : Texture {
    return new Texture(janus_graphics_load_texture(cstr(fileName)))
}

/// Charge une fonte à la taille demandée.
///
/// @param fileName Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param fontSize Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[Font]].
def loadFont(fileName : string, fontSize : int) : Font {
    return new Font(janus_graphics_load_font(cstr(fileName), fontSize))
}

/// Charge une fonte limitée aux caractères UTF-8 fournis.
///
/// @param fileName Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param fontSize Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param characters Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[Font]].
def loadFontUtf8(
fileName : string,
fontSize : int,
characters : string
) : Font {
    return new Font(
    janus_graphics_load_font_utf8(
    cstr(fileName),
    fontSize,
    cstr(characters)
    )
    )
}

/// Crée une texture de rendu aux dimensions demandées.
///
/// @param width Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param height Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[RenderTexture]].
def loadRenderTexture(width : int, height : int) : RenderTexture {
    return new RenderTexture(janus_graphics_load_render_texture(width, height))
}

/// Fournit la sémantique de [[endRenderTexture]].
def endRenderTexture() : Unit {
    janus_graphics_end_render_texture()
}

/// Charge un shader de fragment depuis un fichier.
///
/// @param fragmentFile Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[Shader]].
def loadFragmentShader(fragmentFile : string) : Shader {
    return new Shader(
    janus_graphics_load_fragment_shader(cstr(fragmentFile))
    )
}

/// Charge un shader de sommet et de fragment.
///
/// @param vertexFile Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @param fragmentFile Valeur utilisée par cette opération; consultez le type de l’argument pour son domaine.
/// @return Résultat de type [[Shader]].
def loadShader(vertexFile : string, fragmentFile : string) : Shader {
    return new Shader(
    janus_graphics_load_shader(cstr(vertexFile), cstr(fragmentFile))
    )
}

/// Fournit la sémantique de [[endShader]].
def endShader() : Unit {
    janus_graphics_end_shader()
}
