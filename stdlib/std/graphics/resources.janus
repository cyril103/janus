/// Possède une image CPU native et la libère à sa destruction.
/// @param handle Image native dont la propriété est transférée à cette ressource.
class Image(private val handle : Ptr[byte]) {
    /// Indique si l’image contient des pixels valides.
    /// @return `true` lorsque le test ou l’opération réussit.
    def isValid() : bool {
        return janus_graphics_image_is_valid(handle)
    }

    /// Renvoie la largeur de l’image CPU.
    /// @return Valeur entière rapportée par la ressource.
    def width() : int {
        return janus_graphics_image_width(handle)
    }

    /// Renvoie la hauteur de l’image CPU.
    /// @return Valeur entière rapportée par la ressource.
    def height() : int {
        return janus_graphics_image_height(handle)
    }

    /// Renvoie le nombre de niveaux de mipmap.
    /// @return Valeur entière rapportée par la ressource.
    def mipmaps() : int {
        return janus_graphics_image_mipmaps(handle)
    }

    /// Renvoie la valeur entière de [[PixelFormat]].
    /// @return Valeur entière rapportée par la ressource.
    def formatValue() : int {
        return janus_graphics_image_format(handle)
    }

    /// Encode l’image dans un fichier.
    /// @param fileName Chemin transmis au chargeur natif.
    /// @return `true` lorsque le test ou l’opération réussit.
    def export(fileName : string) : bool {
        return janus_graphics_export_image(handle, cstr(fileName))
    }

    /// Exporte l’image sous forme de tableau C dans un fichier source.
    /// @param fileName Chemin transmis au chargeur natif.
    /// @return `true` lorsque le test ou l’opération réussit.
    def exportAsCode(fileName : string) : bool {
        return janus_graphics_export_image_code(handle, cstr(fileName))
    }

    /// Duplique les pixels dans une image indépendante.
    /// @return Nouvelle image propriétaire, invalide si le backend échoue.
    def copy() : Image {
        return new Image(janus_graphics_copy_image(
        handle, float(0.0), float(0.0), float(0.0), float(0.0), false
        ))
    }

    /// Copie une région dans une image indépendante.
    /// @param area Zone rectangulaire concernée.
    /// @return Nouvelle image propriétaire, invalide si le backend échoue.
    def region(area : Rectangle) : Image {
        return new Image(janus_graphics_copy_image(
        handle, area.x, area.y, area.width, area.height, true
        ))
    }

    /// Extrait un canal RGBA sous forme d’image en niveaux de gris.
    /// @param selected Indice du canal RGBA.
    /// @return Nouvelle image propriétaire, invalide si le backend échoue.
    def channel(selected : int) : Image {
        return new Image(janus_graphics_image_channel(handle, selected))
    }

    /// Convertit le format mémoire des pixels.
    /// @param format Format de pixels demandé.
    def convert(format : PixelFormat) : Unit {
        janus_graphics_transform_image(handle, 0, int(format), 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), uint(0), uint(0))
    }

    /// Agrandit le canevas aux dimensions puissances de deux.
    /// @param fill Couleur des pixels nouvellement créés.
    def toPowerOfTwo(fill : Color) : Unit {
        janus_graphics_transform_image(handle, 1, 0, 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), fill.packed(), uint(0))
    }

    /// Réduit l’image à une région.
    /// @param area Zone rectangulaire concernée.
    def crop(area : Rectangle) : Unit {
        janus_graphics_transform_image(handle, 2, 0, 0, 0, 0,
        area.x, area.y, area.width, area.height, float(0.0), uint(0), uint(0))
    }

    /// Recadre autour des pixels assez opaques.
    /// @param threshold Seuil du test.
    def alphaCrop(threshold : float) : Unit {
        janus_graphics_transform_image(handle, 3, 0, 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), threshold, uint(0), uint(0))
    }

    /// Remplace les pixels sous le seuil alpha.
    /// @param color Couleur appliquée.
    /// @param threshold Seuil du test.
    def alphaClear(color : Color, threshold : float) : Unit {
        janus_graphics_transform_image(handle, 4, 0, 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), threshold, color.packed(), uint(0))
    }

    /// Applique le canal alpha d’une autre image.
    /// @param mask Image fournissant le canal alpha.
    def alphaMask(mask : Image) : Unit {
        janus_graphics_image_alpha_mask(handle, mask.handle)
    }

    /// Prémultiplie les couleurs par leur alpha.
    def alphaPremultiply() : Unit {
        janus_graphics_transform_image(handle, 5, 0, 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), uint(0), uint(0))
    }

    /// Applique un flou gaussien approché.
    /// @param size Taille du voisinage.
    def blurGaussian(size : int) : Unit {
        janus_graphics_transform_image(handle, 6, size, 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), uint(0), uint(0))
    }

    /// Applique un noyau carré contenant `kernelSize * kernelSize` flottants contigus.
    /// @param kernel Noyau carré de flottants contigus.
    /// @param kernelSize Côté du noyau carré.
    def convolve(kernel : Ptr[float], kernelSize : int) : Unit {
        janus_graphics_image_convolution(handle, kernel, kernelSize)
    }

    /// Redimensionne avec interpolation bicubique.
    /// @param width Largeur en pixels.
    /// @param height Hauteur en pixels.
    def resize(width : int, height : int) : Unit {
        janus_graphics_transform_image(handle, 7, width, height, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), uint(0), uint(0))
    }

    /// Redimensionne au voisin le plus proche.
    /// @param width Largeur en pixels.
    /// @param height Hauteur en pixels.
    def resizeNearest(width : int, height : int) : Unit {
        janus_graphics_transform_image(handle, 8, width, height, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), uint(0), uint(0))
    }

    /// Change le canevas sans étirer les pixels.
    /// @param width Largeur en pixels.
    /// @param height Hauteur en pixels.
    /// @param offsetX Décalage horizontal.
    /// @param offsetY Décalage vertical.
    /// @param fill Couleur des pixels nouvellement créés.
    def resizeCanvas(width : int, height : int, offsetX : int, offsetY : int, fill : Color) : Unit {
        janus_graphics_transform_image(handle, 9, width, height, offsetX, offsetY,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), fill.packed(), uint(0))
    }

    /// Calcule les niveaux de mipmap.
    def generateMipmaps() : Unit {
        janus_graphics_transform_image(handle, 10, 0, 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), uint(0), uint(0))
    }

    /// Réduit la profondeur des canaux par diffusion d’erreur.
    /// @param redBits Bits rouges conservés.
    /// @param greenBits Bits verts conservés.
    /// @param blueBits Bits bleus conservés.
    /// @param alphaBits Bits alpha conservés.
    def dither(redBits : int, greenBits : int, blueBits : int, alphaBits : int) : Unit {
        janus_graphics_transform_image(handle, 11, redBits, greenBits, blueBits, alphaBits,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), uint(0), uint(0))
    }

    /// Retourne verticalement les pixels.
    def flipVertical() : Unit {
        janus_graphics_transform_image(handle, 12, 0, 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), uint(0), uint(0))
    }

    /// Retourne horizontalement les pixels.
    def flipHorizontal() : Unit {
        janus_graphics_transform_image(handle, 13, 0, 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), uint(0), uint(0))
    }

    /// Fait pivoter les pixels.
    /// @param degrees Angle entier de rotation.
    def rotate(degrees : int) : Unit {
        janus_graphics_transform_image(handle, 14, degrees, 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), uint(0), uint(0))
    }

    /// Fait pivoter de 90 degrés dans le sens horaire.
    def rotateClockwise() : Unit {
        janus_graphics_transform_image(handle, 15, 0, 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), uint(0), uint(0))
    }

    /// Fait pivoter de 90 degrés dans le sens antihoraire.
    def rotateCounterClockwise() : Unit {
        janus_graphics_transform_image(handle, 16, 0, 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), uint(0), uint(0))
    }

    /// Multiplie les pixels par une couleur.
    /// @param color Couleur appliquée.
    def tint(color : Color) : Unit {
        janus_graphics_transform_image(handle, 17, 0, 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), color.packed(), uint(0))
    }

    /// Inverse les canaux colorés.
    def invert() : Unit {
        janus_graphics_transform_image(handle, 18, 0, 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), uint(0), uint(0))
    }

    /// Convertit les pixels en niveaux de gris.
    def grayscale() : Unit {
        janus_graphics_transform_image(handle, 19, 0, 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), uint(0), uint(0))
    }

    /// Corrige le contraste.
    /// @param value Intensité de correction.
    def contrast(value : float) : Unit {
        janus_graphics_transform_image(handle, 20, 0, 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), value, uint(0), uint(0))
    }

    /// Corrige la luminosité.
    /// @param value Intensité de correction.
    def brightness(value : int) : Unit {
        janus_graphics_transform_image(handle, 21, value, 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), uint(0), uint(0))
    }

    /// Remplace une couleur exacte.
    /// @param color Couleur appliquée.
    /// @param replacement Couleur de remplacement.
    def replaceColor(color : Color, replacement : Color) : Unit {
        janus_graphics_transform_image(handle, 22, 0, 0, 0, 0,
        float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), color.packed(), replacement.packed())
    }

    /// Calcule les limites des pixels assez opaques.
    /// @param threshold Seuil du test.
    /// @return Rectangle calculé, nul lorsqu’aucune zone ne convient.
    def alphaBorder(threshold : float) : Rectangle {
        return rectangle(
        janus_graphics_image_alpha_border_x(handle, threshold),
        janus_graphics_image_alpha_border_y(handle, threshold),
        janus_graphics_image_alpha_border_width(handle, threshold),
        janus_graphics_image_alpha_border_height(handle, threshold)
        )
    }

    /// Lit un pixel.
    /// @param x Coordonnée horizontale.
    /// @param y Coordonnée verticale.
    /// @return Couleur lue dans l’image.
    def colorAt(x : int, y : int) : Color {
        return new Color(janus_graphics_image_color(handle, x, y))
    }

    /// Remplit toute l’image.
    /// @param color Couleur appliquée.
    def clear(color : Color) : Unit {
        janus_graphics_draw_on_image(handle, 0, float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), float(0.0), 0, color.packed())
    }

    /// Écrit un pixel dans l’image CPU.
    /// @param x Coordonnée horizontale.
    /// @param y Coordonnée verticale.
    /// @param color Couleur appliquée.
    def drawPixel(x : int, y : int, color : Color) : Unit {
        janus_graphics_draw_on_image(handle, 1, float(x), float(y), float(0.0), float(0.0), float(0.0), float(0.0), 0, color.packed())
    }

    /// Trace un segment dans l’image CPU.
    /// @param start Point ou couleur initiale.
    /// @param end Point ou couleur finale.
    /// @param thickness Épaisseur du trait en pixels.
    /// @param color Couleur appliquée.
    def drawLine(start : Vector2, end : Vector2, thickness : int, color : Color) : Unit {
        janus_graphics_draw_on_image(handle, 2, start.x, start.y, end.x, end.y, float(0.0), float(0.0), thickness, color.packed())
    }

    /// Dessine un disque dans l’image CPU.
    /// @param center Centre dans le repère actif.
    /// @param radius Rayon de la forme.
    /// @param color Couleur appliquée.
    def drawCircle(center : Vector2, radius : int, color : Color) : Unit {
        janus_graphics_draw_on_image(handle, 3, center.x, center.y, float(radius), float(0.0), float(0.0), float(0.0), 0, color.packed())
    }

    /// Trace un cercle dans l’image CPU.
    /// @param center Centre dans le repère actif.
    /// @param radius Rayon de la forme.
    /// @param color Couleur appliquée.
    def drawCircleLines(center : Vector2, radius : int, color : Color) : Unit {
        janus_graphics_draw_on_image(handle, 4, center.x, center.y, float(radius), float(0.0), float(0.0), float(0.0), 0, color.packed())
    }

    /// Dessine un rectangle dans l’image CPU.
    /// @param area Zone rectangulaire concernée.
    /// @param color Couleur appliquée.
    def drawRectangle(area : Rectangle, color : Color) : Unit {
        janus_graphics_draw_on_image(handle, 5, area.x, area.y, area.width, area.height, float(0.0), float(0.0), 0, color.packed())
    }

    /// Trace un rectangle dans l’image CPU.
    /// @param area Zone rectangulaire concernée.
    /// @param thickness Épaisseur du trait en pixels.
    /// @param color Couleur appliquée.
    def drawRectangleLines(area : Rectangle, thickness : int, color : Color) : Unit {
        janus_graphics_draw_on_image(handle, 6, area.x, area.y, area.width, area.height, float(0.0), float(0.0), thickness, color.packed())
    }

    /// Dessine un triangle dans l’image CPU.
    /// @param first Premier point ou rectangle.
    /// @param second Deuxième point ou rectangle.
    /// @param third Troisième point.
    /// @param color Couleur appliquée.
    def drawTriangle(first : Vector2, second : Vector2, third : Vector2, color : Color) : Unit {
        janus_graphics_draw_on_image(handle, 7, first.x, first.y, second.x, second.y, third.x, third.y, 0, color.packed())
    }

    /// Dessine un triangle à couleurs interpolées.
    /// @param first Premier point ou rectangle.
    /// @param second Deuxième point ou rectangle.
    /// @param third Troisième point.
    /// @param firstColor Couleur du premier sommet.
    /// @param secondColor Couleur du deuxième sommet.
    /// @param thirdColor Couleur du troisième sommet.
    def drawTriangleColors(first : Vector2, second : Vector2, third : Vector2, firstColor : Color, secondColor : Color, thirdColor : Color) : Unit {
        janus_graphics_draw_triangle_colors_on_image(
        handle, first.x, first.y, second.x, second.y, third.x, third.y,
        firstColor.packed(), secondColor.packed(), thirdColor.packed()
        )
    }

    /// Trace un triangle dans l’image CPU.
    /// @param first Premier point ou rectangle.
    /// @param second Deuxième point ou rectangle.
    /// @param third Troisième point.
    /// @param color Couleur appliquée.
    def drawTriangleLines(first : Vector2, second : Vector2, third : Vector2, color : Color) : Unit {
        janus_graphics_draw_on_image(handle, 8, first.x, first.y, second.x, second.y, third.x, third.y, 0, color.packed())
    }

    /// Dessine un éventail de triangles dans l’image CPU.
    /// @param points Pointeur vers des Vector2 contigus appartenant à l’appelant.
    /// @param count Nombre de vecteurs lisibles.
    /// @param color Couleur appliquée.
    def drawTriangleFan(points : Ptr[Vector2], count : int, color : Color) : Unit {
        janus_graphics_draw_points_on_image(handle, points, count, color.packed(), false)
    }

    /// Dessine une bande de triangles dans l’image CPU.
    /// @param points Pointeur vers des Vector2 contigus appartenant à l’appelant.
    /// @param count Nombre de vecteurs lisibles.
    /// @param color Couleur appliquée.
    def drawTriangleStrip(points : Ptr[Vector2], count : int, color : Color) : Unit {
        janus_graphics_draw_points_on_image(handle, points, count, color.packed(), true)
    }

    /// Compose une image source.
    /// @param source Image source.
    /// @param sourceArea Région lue dans la source.
    /// @param destination Rectangle de destination.
    /// @param tint Couleur multiplicative.
    def drawImage(source : Image, sourceArea : Rectangle, destination : Rectangle, tint : Color) : Unit {
        janus_graphics_draw_image(handle, source.handle, sourceArea.x, sourceArea.y,
        sourceArea.width, sourceArea.height, destination.x, destination.y,
        destination.width, destination.height, tint.packed())
    }

    /// Dessine du texte dans l’image CPU.
    /// @param text Texte UTF-8 rendu.
    /// @param x Coordonnée horizontale.
    /// @param y Coordonnée verticale.
    /// @param fontSize Hauteur de police en pixels.
    /// @param color Couleur appliquée.
    def drawText(text : string, x : int, y : int, fontSize : int, color : Color) : Unit {
        janus_graphics_draw_text_on_image(handle, cstr(text), x, y, fontSize, color.packed())
    }

    /// Téléverse les pixels dans une texture GPU.
    /// @return Nouvelle texture GPU propriétaire, invalide si le téléversement échoue.
    def toTexture() : Texture {
        return new Texture(janus_graphics_texture_from_image(handle))
    }

    destructor {
        janus_graphics_unload_image(handle)
    }
}
/// Possède une texture native et la libère à sa destruction.
///
/// @param handle Texture native transférée par une fonction de chargement.
class Texture(private val handle : Ptr[byte]) {
    /// Indique si la texture est valide.
    ///
    /// @return Validité signalée par le backend pour le handle chargé.
    def isValid() : bool {
        return janus_graphics_texture_is_valid(handle)
    }

    /// Retourne la largeur de la texture.
    ///
    /// @return Largeur en pixels rapportée par le backend.
    def width() : int {
        return janus_graphics_texture_width(handle)
    }

    /// Retourne la hauteur de la texture.
    ///
    /// @return Hauteur en pixels rapportée par le backend.
    def height() : int {
        return janus_graphics_texture_height(handle)
    }

    /// Dessine la texture entière aux coordonnées entières données.
    ///
    /// @param x Coordonnée horizontale de destination.
    /// @param y Coordonnée verticale de destination.
    /// @param tint Couleur multiplicative transmise au backend.
    def draw(x : int, y : int, tint : Color) : Unit {
        janus_graphics_draw_texture(handle, x, y, tint.packed())
    }

    /// Dessine la texture entière après conversion tronquée de la position en entiers.
    ///
    /// @param position Coordonnées flottantes converties en `int` avant le dessin.
    /// @param tint Couleur multiplicative transmise au backend.
    def drawAt(position : Vector2, tint : Color) : Unit {
        janus_graphics_draw_texture_at(handle, position.x, position.y, tint.packed())
    }

    /// Dessine la texture avec rotation et échelle uniforme.
    /// @param position Paramètre interprété selon le contrat de cette opération raylib.
    /// @param rotation Rotation en degrés.
    /// @param scale Échelle du motif.
    /// @param tint Couleur multiplicative.
    def drawEx(position : Vector2, rotation : float, scale : float, tint : Color) : Unit {
        janus_graphics_draw_texture_ex(handle, position.x, position.y, rotation, scale, tint.packed())
    }

    /// Dessine une zone source à une position flottante.
    /// @param source Image source.
    /// @param position Paramètre interprété selon le contrat de cette opération raylib.
    /// @param tint Couleur multiplicative.
    def drawRegion(source : Rectangle, position : Vector2, tint : Color) : Unit {
        janus_graphics_draw_texture_rec(handle, source.x, source.y, source.width, source.height, position.x, position.y, tint.packed())
    }

    /// Dessine une zone source dans un rectangle de destination avec origine et rotation.
    ///
    /// @param source Zone lue dans la texture; des dimensions négatives sont transmises telles quelles.
    /// @param destination Rectangle où la zone est dessinée.
    /// @param origin Point d’origine dans le rectangle de destination.
    /// @param rotation Angle transmis au backend graphique.
    /// @param tint Couleur multiplicative du dessin.
    def drawPro(
    source : Rectangle,
    destination : Rectangle,
    origin : Vector2,
    rotation : float,
    tint : Color
    ) : Unit {
        janus_graphics_draw_texture_pro(
        handle,
        source.x,
        source.y,
        source.width,
        source.height,
        destination.x,
        destination.y,
        destination.width,
        destination.height,
        origin.x,
        origin.y,
        rotation,
        tint.packed()
        )
    }

    /// Dessine une texture neuf-patch en préservant ses bordures.
    /// @param info Paramètre interprété selon le contrat de cette opération raylib.
    /// @param destination Rectangle de destination.
    /// @param origin Point de pivot.
    /// @param rotation Rotation en degrés.
    /// @param tint Couleur multiplicative.
    def drawNPatch(
    info : NPatchInfo,
    destination : Rectangle,
    origin : Vector2,
    rotation : float,
    tint : Color
    ) : Unit {
        janus_graphics_draw_texture_npatch(
        handle, info.source.x, info.source.y, info.source.width,
        info.source.height, info.left, info.top, info.right, info.bottom,
        int(info.layout), destination.x, destination.y, destination.width,
        destination.height, origin.x, origin.y, rotation, tint.packed()
        )
    }

    /// Utilise une région de cette texture pour les primitives géométriques raylib.
    /// @param source Image source.
    def useForShapes(source : Rectangle) : Unit {
        janus_graphics_set_shapes_texture(
        handle, source.x, source.y, source.width, source.height
        )
    }

    /// Dessine une image d’une feuille régulière, indexée ligne par ligne.
    ///
    /// `columns` sert de diviseur et doit donc être non nul.
    ///
    /// @param frame Indice utilisé pour calculer colonne et ligne, sans contrôle de plage.
    /// @param frameWidth Largeur en pixels de chaque image.
    /// @param frameHeight Hauteur en pixels de chaque image.
    /// @param columns Nombre d’images par ligne.
    /// @param position Coin de destination de l’image.
    /// @param scale Facteur appliqué aux dimensions de destination.
    /// @param rotation Angle transmis au backend graphique.
    /// @param flipX Inverse le signe de la largeur source lorsqu’il vaut `true`.
    /// @param flipY Inverse le signe de la hauteur source lorsqu’il vaut `true`.
    /// @param tint Couleur multiplicative du dessin.
    def drawFrame(
    frame : int,
    frameWidth : int,
    frameHeight : int,
    columns : int,
    position : Vector2,
    scale : float,
    rotation : float,
    flipX : bool,
    flipY : bool,
    tint : Color
    ) : Unit {
        val column : int = frame % columns
        val row : int = frame / columns
        var sourceWidth : float = float(frameWidth)
        var sourceHeight : float = float(frameHeight)
        if flipX {
            sourceWidth = -sourceWidth
        }
        if flipY {
            sourceHeight = -sourceHeight
        }
        janus_graphics_draw_texture_pro(
        handle,
        float(column * frameWidth),
        float(row * frameHeight),
        sourceWidth,
        sourceHeight,
        position.x,
        position.y,
        float(frameWidth) * scale,
        float(frameHeight) * scale,
        float(0.0),
        float(0.0),
        rotation,
        tint.packed()
        )
    }

    /// Règle le filtre d’échantillonnage de la texture.
    ///
    /// @param filter Mode converti en entier et appliqué au handle natif.
    def setFilter(filter : TextureFilter) : Unit {
        janus_graphics_set_texture_filter(handle, int(filter))
    }

    /// Règle la répétition des coordonnées hors de la texture.
    /// @param wrap Paramètre interprété selon le contrat de cette opération raylib.
    def setWrap(wrap : TextureWrap) : Unit {
        janus_graphics_set_texture_wrap(handle, int(wrap))
    }

    /// Génère la chaîne complète de mipmaps GPU.
    def generateMipmaps() : Unit {
        janus_graphics_generate_texture_mipmaps(handle)
    }

    destructor {
        janus_graphics_unload_texture(handle)
    }
}

/// Possède une fonte native et la libère à sa destruction.
///
/// @param handle Fonte native transférée par une fonction de chargement.
class Font(private val handle : Ptr[byte]) {
    /// Indique si la fonte est valide.
    ///
    /// @return Validité signalée par le backend pour le handle chargé.
    def isValid() : bool {
        return janus_graphics_font_is_valid(handle)
    }

    /// Dessine une chaîne avec cette fonte, sa taille, son espacement et sa couleur.
    ///
    /// @param text Texte converti en chaîne C pour le backend.
    /// @param position Coordonnées de départ du dessin.
    /// @param fontSize Taille de fonte transmise en pixels.
    /// @param spacing Espacement transmis entre caractères.
    /// @param color Couleur du texte.
    def draw(
    text : string,
    position : Vector2,
    fontSize : float,
    spacing : float,
    color : Color
    ) : Unit {
        janus_graphics_draw_text_font(
        handle,
        cstr(text),
        position.x,
        position.y,
        fontSize,
        spacing,
        color.packed()
        )
    }

    /// Mesure séparément la largeur et la hauteur d’une chaîne sans la dessiner.
    ///
    /// @param text Texte converti en chaîne C pour les deux mesures.
    /// @param fontSize Taille de fonte utilisée pour les deux mesures.
    /// @param spacing Espacement entre caractères utilisé pour les deux mesures.
    /// @return Vecteur `(largeur, hauteur)` rapporté par le backend.
    def measure(
    text : string,
    fontSize : float,
    spacing : float
    ) : Vector2 {
        return vector2(
        janus_graphics_measure_text_width(
        handle,
        cstr(text),
        fontSize,
        spacing
        ),
        janus_graphics_measure_text_height(
        handle,
        cstr(text),
        fontSize,
        spacing
        )
        )
    }

    destructor {
        janus_graphics_unload_font(handle)
    }
}

/// Possède une cible de rendu native et la libère à sa destruction.
///
/// @param handle Cible de rendu native transférée par [[loadRenderTexture]].
class RenderTexture(private val handle : Ptr[byte]) {
    /// Indique si la texture de rendu est valide.
    ///
    /// @return Validité signalée par le backend pour le handle créé.
    def isValid() : bool {
        return janus_graphics_render_texture_is_valid(handle)
    }

    /// Retourne la largeur de la texture de rendu.
    ///
    /// @return Largeur en pixels rapportée par le backend.
    def width() : int {
        return janus_graphics_render_texture_width(handle)
    }

    /// Retourne la hauteur de la texture de rendu.
    ///
    /// @return Hauteur en pixels rapportée par le backend.
    def height() : int {
        return janus_graphics_render_texture_height(handle)
    }

    /// Active cette cible pour les dessins suivants dans l’état graphique global.
    def begin() : Unit {
        janus_graphics_begin_render_texture(handle)
    }

    /// Dessine une zone de la cible dans un rectangle avec origine et rotation.
    ///
    /// @param source Zone lue dans la cible de rendu.
    /// @param destination Rectangle de destination.
    /// @param origin Point d’origine dans le rectangle de destination.
    /// @param rotation Angle transmis au backend graphique.
    /// @param tint Couleur multiplicative du dessin.
    def drawPro(
    source : Rectangle,
    destination : Rectangle,
    origin : Vector2,
    rotation : float,
    tint : Color
    ) : Unit {
        janus_graphics_draw_render_texture_pro(
        handle,
        source.x,
        source.y,
        source.width,
        source.height,
        destination.x,
        destination.y,
        destination.width,
        destination.height,
        origin.x,
        origin.y,
        rotation,
        tint.packed()
        )
    }

    destructor {
        janus_graphics_unload_render_texture(handle)
    }
}

/// Possède un programme shader natif et le libère à sa destruction.
///
/// @param handle Programme natif transféré par une fonction de chargement de shader.
class Shader(private val handle : Ptr[byte]) {
    /// Indique si le shader est valide.
    ///
    /// @return Validité signalée par le backend pour le handle chargé.
    def isValid() : bool {
        return janus_graphics_shader_is_valid(handle)
    }

    /// Active ce shader pour les dessins suivants dans l’état graphique global.
    def begin() : Unit {
        janus_graphics_begin_shader(handle)
    }

    /// Recherche l’emplacement natif d’un uniforme par son nom.
    ///
    /// @param name Nom converti en chaîne C pour la recherche.
    /// @return Indice d’emplacement rapporté par le backend, sans interprétation.
    def location(name : string) : int {
        return janus_graphics_shader_location(handle, cstr(name))
    }

    /// Affecte une valeur flottante à l’uniforme.
    ///
    /// @param location Emplacement obtenu auprès du backend, par exemple avec [[location]].
    /// @param value Flottant transmis à l’uniforme.
    def setFloat(location : int, value : float) : Unit {
        janus_graphics_set_shader_float(handle, location, value)
    }

    /// Affecte un vecteur 2D à l’uniforme.
    ///
    /// @param location Emplacement obtenu auprès du backend, par exemple avec [[location]].
    /// @param value Composantes `x` et `y` transmises à l’uniforme.
    def setVector2(location : int, value : Vector2) : Unit {
        janus_graphics_set_shader_vector2(
        handle,
        location,
        value.x,
        value.y
        )
    }

    /// Affecte une couleur à l’uniforme.
    ///
    /// @param location Emplacement obtenu auprès du backend, par exemple avec [[location]].
    /// @param value Couleur empaquetée transmise à l’uniforme.
    def setColor(location : int, value : Color) : Unit {
        janus_graphics_set_shader_color(handle, location, value.packed())
    }

    /// Affecte une valeur entière à l’uniforme.
    ///
    /// @param location Emplacement obtenu auprès du backend, par exemple avec [[location]].
    /// @param value Entier transmis à l’uniforme.
    def setInt(location : int, value : int) : Unit {
        janus_graphics_set_shader_int(handle, location, value)
    }

    destructor {
        janus_graphics_unload_shader(handle)
    }
}

/// Associe une texture propriétaire à un découpage régulier et à un indice d’image mutable.
class SpriteAnimation(
/// Texture propriétaire contenant la feuille de sprites découpée en images.
val texture : Texture,
/// Largeur en pixels d’une image dans la feuille de sprites.
val frameWidth : int,
/// Hauteur en pixels d’une image dans la feuille de sprites.
val frameHeight : int,
/// Nombre d’images disposées sur chaque ligne de la texture.
val columns : int,
/// Nombre total d’images de l’animation; il doit être strictement positif pour [[advance]].
val frameCount : int,
/// Indice zéro-based de l’image actuellement dessinée.
var currentFrame : int
) {
    /// Avance d’une image puis revient à zéro après la dernière.
    ///
    /// `frameCount` sert de diviseur et doit être strictement positif.
    ///
    /// @return Nouvel indice `(currentFrame + 1) % frameCount`.
    def advance() : int {
        currentFrame = (currentFrame + 1) % frameCount
        return currentFrame
    }

    /// Replace l’indice courant à zéro.
    def reset() : Unit {
        currentFrame = 0
    }

    /// Dessine l’image courante via [[Texture.drawFrame]].
    ///
    /// @param position Coin de destination de l’image.
    /// @param scale Facteur appliqué à sa largeur et sa hauteur.
    /// @param rotation Angle transmis au backend graphique.
    /// @param flipX Inverse horizontalement la zone source lorsqu’il vaut `true`.
    /// @param flipY Inverse verticalement la zone source lorsqu’il vaut `true`.
    /// @param tint Couleur multiplicative du dessin.
    def draw(
    position : Vector2,
    scale : float,
    rotation : float,
    flipX : bool,
    flipY : bool,
    tint : Color
    ) : Unit {
        texture.drawFrame(
        currentFrame,
        frameWidth,
        frameHeight,
        columns,
        position,
        scale,
        rotation,
        flipX,
        flipY,
        tint
        )
    }

    destructor {
        delete texture
    }
}

/// Charge une texture depuis un fichier.
///
/// @param fileName Chemin converti en chaîne C et transmis au chargeur natif.
/// @return Texture propriétaire; vérifier [[Texture.isValid]] avant de l’utiliser.
def loadImage(fileName : string) : Image {
    return new Image(janus_graphics_load_image(cstr(fileName)))
}

/// Charge des pixels RAW depuis un fichier avec leur description explicite.
/// @param fileName Chemin transmis au chargeur natif.
/// @param width Largeur en pixels.
/// @param height Hauteur en pixels.
/// @param format Format de pixels demandé.
/// @param headerSize Octets ignorés avant les pixels RAW.
/// @return Nouvelle image propriétaire, invalide si le backend échoue.
def loadRawImage(fileName : string, width : int, height : int, format : PixelFormat, headerSize : int) : Image {
    return new Image(janus_graphics_load_raw_image(
    cstr(fileName), width, height, int(format), headerSize
    ))
}

/// Décode une image depuis `dataSize` octets contigus en mémoire.
/// @param fileType Extension du format encodé.
/// @param data Octets encodés appartenant à l’appelant.
/// @param dataSize Nombre d’octets lisibles.
/// @return Nouvelle image propriétaire, invalide si le backend échoue.
def loadImageFromMemory(fileType : string, data : Ptr[byte], dataSize : int) : Image {
    return new Image(janus_graphics_load_image_memory(
    cstr(fileType), data, dataSize
    ))
}

/// Capture le tampon écran courant dans une image CPU.
/// @return Nouvelle image propriétaire, invalide si le backend échoue.
def loadImageFromScreen() : Image {
    return new Image(janus_graphics_load_image_screen())
}

/// Crée une image de texte avec la police par défaut.
/// @param text Texte UTF-8 rendu.
/// @param fontSize Hauteur de police en pixels.
/// @param color Couleur appliquée.
/// @return Nouvelle image propriétaire, invalide si le backend échoue.
def imageText(text : string, fontSize : int, color : Color) : Image {
    return new Image(janus_graphics_image_text(cstr(text), fontSize, color.packed()))
}

/// Génère une image remplie d’une couleur.
/// @param width Largeur en pixels.
/// @param height Hauteur en pixels.
/// @param color Couleur appliquée.
/// @return Nouvelle image propriétaire, invalide si le backend échoue.
def generateImageColor(width : int, height : int, color : Color) : Image {
    return new Image(janus_graphics_generate_image(
    width, height, 0, 0, 0, float(0.0), color.packed(), uint(0), cstr("")
    ))
}

/// Génère un dégradé linéaire; `direction` est exprimée en degrés.
/// @param width Largeur en pixels.
/// @param height Hauteur en pixels.
/// @param direction Direction du dégradé en degrés.
/// @param start Point ou couleur initiale.
/// @param end Point ou couleur finale.
/// @return Nouvelle image propriétaire, invalide si le backend échoue.
def generateImageGradientLinear(width : int, height : int, direction : int, start : Color, end : Color) : Image {
    return new Image(janus_graphics_generate_image(
    width, height, 1, direction, 0, float(0.0), start.packed(), end.packed(), cstr("")
    ))
}

/// Génère un dégradé radial.
/// @param width Largeur en pixels.
/// @param height Hauteur en pixels.
/// @param density Concentration du dégradé.
/// @param inner Couleur centrale.
/// @param outer Couleur périphérique.
/// @return Nouvelle image propriétaire, invalide si le backend échoue.
def generateImageGradientRadial(width : int, height : int, density : float, inner : Color, outer : Color) : Image {
    return new Image(janus_graphics_generate_image(
    width, height, 2, 0, 0, density, inner.packed(), outer.packed(), cstr("")
    ))
}

/// Génère un dégradé carré.
/// @param width Largeur en pixels.
/// @param height Hauteur en pixels.
/// @param density Concentration du dégradé.
/// @param inner Couleur centrale.
/// @param outer Couleur périphérique.
/// @return Nouvelle image propriétaire, invalide si le backend échoue.
def generateImageGradientSquare(width : int, height : int, density : float, inner : Color, outer : Color) : Image {
    return new Image(janus_graphics_generate_image(
    width, height, 3, 0, 0, density, inner.packed(), outer.packed(), cstr("")
    ))
}

/// Génère un damier.
/// @param width Largeur en pixels.
/// @param height Hauteur en pixels.
/// @param checksX Largeur d’une case.
/// @param checksY Hauteur d’une case.
/// @param first Premier point ou rectangle.
/// @param second Deuxième point ou rectangle.
/// @return Nouvelle image propriétaire, invalide si le backend échoue.
def generateImageChecked(width : int, height : int, checksX : int, checksY : int, first : Color, second : Color) : Image {
    return new Image(janus_graphics_generate_image(
    width, height, 4, checksX, checksY, float(0.0), first.packed(), second.packed(), cstr("")
    ))
}

/// Génère un bruit blanc.
/// @param width Largeur en pixels.
/// @param height Hauteur en pixels.
/// @param factor Proportion de bruit.
/// @return Nouvelle image propriétaire, invalide si le backend échoue.
def generateImageWhiteNoise(width : int, height : int, factor : float) : Image {
    return new Image(janus_graphics_generate_image(
    width, height, 5, 0, 0, factor, uint(0), uint(0), cstr("")
    ))
}

/// Génère un bruit de Perlin.
/// @param width Largeur en pixels.
/// @param height Hauteur en pixels.
/// @param offsetX Décalage horizontal.
/// @param offsetY Décalage vertical.
/// @param scale Échelle du motif.
/// @return Nouvelle image propriétaire, invalide si le backend échoue.
def generateImagePerlinNoise(width : int, height : int, offsetX : int, offsetY : int, scale : float) : Image {
    return new Image(janus_graphics_generate_image(
    width, height, 6, offsetX, offsetY, scale, uint(0), uint(0), cstr("")
    ))
}

/// Génère un motif cellulaire.
/// @param width Largeur en pixels.
/// @param height Hauteur en pixels.
/// @param tileSize Taille des cellules.
/// @return Nouvelle image propriétaire, invalide si le backend échoue.
def generateImageCellular(width : int, height : int, tileSize : int) : Image {
    return new Image(janus_graphics_generate_image(
    width, height, 7, tileSize, 0, float(0.0), uint(0), uint(0), cstr("")
    ))
}

/// Génère une image contenant du texte adapté aux dimensions demandées.
/// @param width Largeur en pixels.
/// @param height Hauteur en pixels.
/// @param text Texte UTF-8 rendu.
/// @return Nouvelle image propriétaire, invalide si le backend échoue.
def generateImageText(width : int, height : int, text : string) : Image {
    return new Image(janus_graphics_generate_image(
    width, height, 8, 0, 0, float(0.0), uint(0), uint(0), cstr(text)
    ))
}

/// Charge une nouvelle image CPU propriétaire.
/// @param fileName Chemin transmis au chargeur natif.
/// @return Nouvelle texture GPU propriétaire, invalide si le téléversement échoue.
def loadTexture(fileName : string) : Texture {
    return new Texture(janus_graphics_load_texture(cstr(fileName)))
}

/// Charge une fonte à la taille demandée.
///
/// @param fileName Chemin converti en chaîne C et transmis au chargeur natif.
/// @param fontSize Taille demandée au chargeur natif.
/// @return Fonte propriétaire, y compris lorsque son handle est invalide.
def loadFont(fileName : string, fontSize : int) : Font {
    return new Font(janus_graphics_load_font(cstr(fileName), fontSize))
}

/// Charge une fonte limitée aux caractères UTF-8 fournis.
///
/// @param fileName Chemin converti en chaîne C et transmis au chargeur natif.
/// @param fontSize Taille demandée au chargeur natif.
/// @param characters Chaîne UTF-8 convertie en chaîne C pour sélectionner les glyphes.
/// @return Fonte propriétaire, y compris lorsque son handle est invalide.
def loadFontUtf8(
fileName : string,
fontSize : int,
characters : string
) : Font {
    return new Font(
    janus_graphics_load_font_utf8(
    cstr(fileName),
    fontSize,
    cstr(characters)
    )
    )
}

/// Crée une texture de rendu aux dimensions demandées.
///
/// @param width Largeur en pixels transmise au backend.
/// @param height Hauteur en pixels transmise au backend.
/// @return Cible propriétaire; vérifier [[RenderTexture.isValid]] avant de l’utiliser.
def loadRenderTexture(width : int, height : int) : RenderTexture {
    return new RenderTexture(janus_graphics_load_render_texture(width, height))
}

/// Termine le rendu dans la cible active et restaure l’état géré par le backend.
def endRenderTexture() : Unit {
    janus_graphics_end_render_texture()
}

/// Charge un shader de fragment depuis un fichier.
///
/// @param fragmentFile Chemin du fragment shader, converti en chaîne C.
/// @return Shader propriétaire; vérifier [[Shader.isValid]] avant de l’utiliser.
def loadFragmentShader(fragmentFile : string) : Shader {
    return new Shader(
    janus_graphics_load_fragment_shader(cstr(fragmentFile))
    )
}

/// Charge un shader de sommet et de fragment.
///
/// @param vertexFile Chemin du vertex shader, converti en chaîne C.
/// @param fragmentFile Chemin du fragment shader, converti en chaîne C.
/// @return Shader propriétaire; vérifier [[Shader.isValid]] avant de l’utiliser.
def loadShader(vertexFile : string, fragmentFile : string) : Shader {
    return new Shader(
    janus_graphics_load_shader(cstr(vertexFile), cstr(fragmentFile))
    )
}

/// Désactive le shader courant et restaure l’état géré par le backend.
def endShader() : Unit {
    janus_graphics_end_shader()
}
