import std.array as arrays

var sequence : int = 0
var destroyed : int = 0

class Resource(val id : int) {
    destructor { destroyed = destroyed + 1 }
}

def next(expected : int) : int {
    if sequence != expected {
        panic("array literal evaluation order changed\n")
    }
    sequence = sequence + 1
    return expected + 10
}

def main() : int {
    val ordered : arrays.Array[int] = [next(0), next(1), next(2)]
    defer delete ordered
    val inferred : arrays.Array[int] = [4, 5, 6]
    defer delete inferred
    val empty : arrays.Array[int] = []
    defer delete empty
    val bytes : arrays.Array[ubyte] = [0xF0, 0x90, 0x90, 0x90, 0xF0]
    defer delete bytes
    val nested : arrays.Array[arrays.Array[int]] = [[7, 8], [9]]
    defer delete nested
    val resources : arrays.Array[Resource] =
    [new Resource(1), new Resource(2), new Resource(3)]
    delete resources
    if ordered.size() != usize(3) || ordered.get(usize(0)) != 10 ||
       ordered.get(usize(2)) != 12 || inferred.get(usize(1)) != 5 ||
       !empty.isEmpty() || bytes.get(usize(4)) != ubyte(0xF0) ||
       nested.size() != usize(2) || destroyed != 3 {
        return 1
    }
    return 0
}
