import std.array
import std.deque
import std.hashing
import std.hashmap
import std.hashset
import std.ordering
import std.option
import std.error
import std.io
import std.priority_queue
import std.result
import std.bytes

var releases : int = 0

class Resource(val id : int) {
    destructor { releases = releases + 1 }
}

def viewSize(borrow view : ByteView) : usize { return view.size() }

def secondByte(borrow view : ByteView) : int {
    return view.withSlice[int](
    usize(1),
    usize(1),
    (borrow slice : ByteView) => int(slice.get(usize(0)))
    )
}

def main() : int {
    val resources : Array[Resource] = new Array[Resource](usize(3))
    resources.push(new Resource(1))
    resources.push(new Resource(2))
    resources.push(new Resource(3))
    println(resources.retain(
    (borrow value : Resource) => value.id % 2 != 0
    ))
    println(releases)

    val extra : Array[Resource] = new Array[Resource](usize(2))
    extra.push(new Resource(4))
    extra.push(new Resource(5))
    println(resources.extend(extra.intoIterator()))
    for value in resources.drain() {
        println(value.id)
        delete value
    }
    println(releases)

    val ordering : IntOrdering = new IntOrdering()
    val numbers : Array[int] = new Array[int](usize(3))
    numbers.push(3)
    numbers.push(1)
    numbers.push(2)
    numbers.sortBy[IntOrdering](ordering)
    for value in numbers.drain() { println(value) }

    val deque : Deque[int] = new Deque[int](usize(1))
    println(std.result.isOk[bool, CapacityError](
    deque.tryReserve(usize(8))
    ) && deque.capacity() >= usize(8))
    val dequeValues : Array[int] = new Array[int](usize(2))
    dequeValues.push(7)
    dequeValues.push(8)
    println(deque.extend(dequeValues.intoIterator()))
    for value in deque.drain() { println(value) }

    val hashing : IntHashing = new IntHashing()
    val set : HashSet[int, IntHashing] =
    new HashSet[int, IntHashing](usize(1), hashing)
    println(std.result.isOk[bool, CapacityError](
    set.tryReserve(usize(20))
    ) && set.capacity() >= usize(20))
    set.add(1)
    set.add(2)
    set.add(3)
    println(set.retain((borrow value : int) => value % 2 != 0))
    val setValues : Array[int] = new Array[int](usize(2))
    setValues.push(3)
    setValues.push(4)
    println(set.extend(setValues.intoIterator()))
    println(set.size())
    delete set

    val map : HashMap[int, int, IntHashing] =
    new HashMap[int, int, IntHashing](usize(1), hashing)
    println(std.result.isOk[bool, CapacityError](
    map.tryReserve(usize(20))
    ) && map.capacity() >= usize(20))
    val _first : Option[int] = map.put(1, 10)
    val _second : Option[int] = map.put(2, 20)
    println(map.withEntry(
    1,
    (borrow key : int, borrow value : int) => {
        println(key)
        println(value)
    }
    ))
    println(map.retain(
    (borrow key : int, borrow value : int) => value >= 20
    ))
    val entries : Array[MapEntry[int, int]] =
    new Array[MapEntry[int, int]](usize(1))
    entries.push(new MapEntry[int, int](3, 30))
    println(map.extend(entries.intoIterator()))
    var drained : int = 0
    for entry in map.drainEntries() {
        drained = drained + 1
    }
    println(drained)

    val empty : Array[int] = new Array[int](usize(0))
    println(std.result.isError[int, AccessError](empty.tryPop()))
    println(std.result.isOk[bool, CapacityError](
    empty.tryReserve(usize(8))
    ))
    delete empty

    val emptyDeque : Deque[int] = new Deque[int](usize(1))
    println(std.result.isError[int, AccessError](
    emptyDeque.tryPopFront()
    ))
    delete emptyDeque

    val emptyQueue : Queue[int] = new Queue[int](usize(1))
    println(std.result.isOk[bool, CapacityError](
    emptyQueue.tryReserve(usize(8))
    ) && emptyQueue.capacity() >= usize(8))
    println(std.result.isError[int, AccessError](
    emptyQueue.tryDequeue()
    ))
    delete emptyQueue

    val priority : PriorityQueue[int] = new PriorityQueue[int](
    usize(1),
    (borrow left : int, borrow right : int) => left < right
    )
    println(std.result.isOk[bool, CapacityError](
    priority.tryReserve(usize(8))
    ) && priority.capacity() >= usize(8))
    println(std.result.isError[int, AccessError](priority.tryDequeue()))
    delete priority

    val buffer : ByteBuffer = new ByteBuffer(usize(0))
    println(std.result.isOk[bool, CapacityError](
    buffer.tryReserve(usize(16))
    ))
    buffer.appendByte(byte(10))
    buffer.appendByte(byte(20))
    println(buffer.withView[usize](
    (borrow view : ByteView) => viewSize(view)
    ))
    println(buffer.withView[int](
    (borrow view : ByteView) => secondByte(view)
    ))
    delete buffer

    delete hashing
    delete ordering
    return 0
}
