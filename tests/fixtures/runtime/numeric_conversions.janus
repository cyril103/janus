import std.numeric
import std.result

def main() : int {
    var high : long = long(128)
    var low : long = long(-129)
    var negative : int = -1
    var fraction : double = -12.75
    var zero : double = 0.0
    val maximumLong : long = 9223372036854775807
    val minimumLong : long = -9223372036854775808
    val aboveFloat : double = 350000000000000000000000000000000000000.0
    val infinity : double = 1.0 / zero
    val negativeInfinity : double = -1.0 / zero
    val nan : double = zero / zero

    println(saturatingCast[byte](high))
    println(saturatingCast[byte](low))
    println(saturatingCast[ubyte](negative))
    println(saturatingCast[int](infinity))
    println(saturatingCast[int](negativeInfinity))
    println(saturatingCast[int](nan))
    println(truncatingCast[int](fraction))
    println(truncatingCast[ubyte](negative))
    println(truncatingCast[int](infinity))
    println(truncatingCast[int](nan))

    println(match checkedCast[ubyte](255) {
        Ok(item) => int(item), Error(error) => -100 - int(error)
    })
    println(match checkedCast[ubyte](256) {
        Ok(item) => int(item), Error(error) => -100 - int(error)
    })
    println(match checkedCast[ubyte](negative) {
        Ok(item) => int(item), Error(error) => -100 - int(error)
    })
    println(match checkedCast[int](fraction) {
        Ok(item) => item, Error(error) => -100 - int(error)
    })
    println(match checkedCast[int](infinity) {
        Ok(item) => item, Error(error) => -100 - int(error)
    })
    println(match checkedCast[float](16777217) {
        Ok(item) => item,
        Error(error) => numericCast[float](100 + int(error))
    })
    println(match checkedCast[float](0.5f) {
        Ok(item) => item,
        Error(error) => numericCast[float](100 + int(error))
    })
    println(match checkedCast[double](maximumLong) {
        Ok(item) => 1, Error(error) => -100 - int(error)
    })
    println(match checkedCast[double](minimumLong) {
        Ok(item) => 1, Error(error) => -100 - int(error)
    })
    println(saturatingCast[float](infinity))
    println(saturatingCast[float](negativeInfinity))
    println(saturatingCast[float](nan))
    println(saturatingCast[float](aboveFloat))
    println(truncatingCast[byte](long(128)))
    println(truncatingCast[ushort](long(-1)))
    return 0
}
