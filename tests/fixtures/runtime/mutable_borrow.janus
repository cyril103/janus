import std.io
import std.array
import std.slice

class Counter(var value : int) {
    borrow def read() : int { return value }
    def add(amount : int) : Unit { value = value + amount }
}

def increment(borrow var counter : Counter) : Unit {
    counter.add(1)
}

def increase(borrow var value : int) : Unit {
    value = value + 1
}

def main() : int {
    var number : int = 1
    if true {
        borrow var editable : int = number
        editable = 4
    }
    increase(number)

    val counter : Counter = new Counter(2)
    increment(counter)

    println(number)
    println(counter.read())

    val values : Array[int] = new Array[int](usize(2))
    values.push(10)
    values.push(20)
    if true {
        borrow var first : int = values.getMutable(usize(0))
        first = 30
    }
    println(values.get(usize(0)))
    if true {
        borrow val observed : int = values.getMutable(usize(0))
        println(observed)
    }

    val slice : MutableSlice[int] =
    new MutableSlice[int](values, usize(0), values.size())
    if true {
        borrow var second : int = slice.getMutable(usize(1))
        second = 40
    }
    println(slice.get(usize(1)))
    delete slice
    delete values
    delete counter
    return 0
}
