import std.array
import std.fs
import std.io
import std.option
import std.process
import std.system
import std.bytes

def argumentEquals(index : usize, expected : string) : bool {
    return match programArgument(index) {
        Some(value) => value == expected,
        None => false
    }
}

def environmentEquals(
result : Result[Option[EnvironmentValue], SystemError],
expected : string
) : bool {
    return match move result {
        Ok(option) => match move option {
            Some(value) => environmentValueEquals(move value, expected),
            None => false
        },
        Error(error) => false
    }
}

def environmentValueEquals(
value : EnvironmentValue,
expected : string
) : bool {
    val matches : bool = value.view() == expected
    delete value
    return matches
}

def environmentMissing(
result : Result[Option[EnvironmentValue], SystemError]
) : bool {
    return match move result {
        Ok(option) => match move option {
            Some(value) => rejectEnvironment(move value),
            None => true
        },
        Error(error) => false
    }
}

def rejectEnvironment(value : EnvironmentValue) : bool {
    delete value
    return false
}

def boolResult(result : Result[bool, SystemError]) : bool {
    return match result {
        Ok(value) => value,
        Error(error) => false
    }
}

def childMain() : int {
    val argumentsValid : bool =
    programArgumentCount() == usize(4) &&
    argumentEquals(usize(1), "--child") &&
    argumentEquals(usize(2), "argument avec espaces") &&
    argumentEquals(usize(3), "béta")
    val environmentValid : bool = environmentEquals(
    environmentVariable("JANUS_PROCESS_TEST"),
    "valeur-béta"
    )
    val marker : bool = writeMarkerResult(
    openSystemFile(
    "child-marker.txt",
    SystemOpenMode.Write
    )
    )
    val standardOutputResult : Result[OutputStream, SystemError] =
    standardOutput()
    val outputWritten : bool = match move standardOutputResult {
        Ok(stream) => writeChildOutput(move stream),
        Error(error) => false
    }
    val standardErrorResult : Result[OutputStream, SystemError] =
    standardError()
    val errorWritten : bool = match move standardErrorResult {
        Ok(stream) => writeChildError(move stream),
        Error(error) => false
    }
    return if argumentsValid && environmentValid && marker &&
    outputWritten && errorWritten { 23 } else { 24 }
}

def writeMarkerResult(
result : Result[SystemFile, SystemError]
) : bool {
    return match move result {
        Ok(file) => writeMarker(move file),
        Error(error) => false
    }
}

def writeMarker(file : SystemFile) : bool {
    val written : bool = match file.write(
    stringData("ok"),
    usize(2)
    ) {
        Ok(count) => count == usize(2),
        Error(error) => false
    }
    val closed : bool = boolResult(file.close())
    delete file
    return written && closed
}

def writeChildOutput(stream : OutputStream) : bool {
    val written : bool = match stream.writeText("child-out\n") {
        Ok(count) => count == usize(10),
        Error(error) => false
    }
    val closed : bool = boolResult(stream.close())
    delete stream
    return written && closed
}

def writeChildError(stream : OutputStream) : bool {
    val written : bool = match stream.writeText("child-err\n") {
        Ok(count) => count == usize(10),
        Error(error) => false
    }
    val closed : bool = boolResult(stream.close())
    delete stream
    return written && closed
}

def usizeResult(
result : Result[usize, SystemError],
expected : usize
) : bool {
    return match result {
        Ok(value) => value == expected,
        Error(error) => false
    }
}

def writeInteractiveOutput(
stream : OutputStream,
data : Ptr[byte],
size : usize
) : bool {
    val written : bool = usizeResult(stream.write(data, size), size)
    val closed : bool = boolResult(stream.close())
    delete stream
    return written && closed
}

def interactiveOutput(
result : Result[OutputStream, SystemError],
data : Ptr[byte],
size : usize
) : bool {
    return match move result {
        Ok(stream) => writeInteractiveOutput(move stream, data, size),
        Error(error) => false
    }
}

def useInteractiveInput(input : InputStream) : int {
    val data : Ptr[byte] = alloc[byte](usize(5))
    defer free(data)
    val count : usize = match input.read(data, usize(5)) {
        Ok(value) => value,
        Error(error) => usize(0)
    }
    val echoed : bool = count == usize(5) && interactiveOutput(
    standardOutput(),
    data,
    count
    )
    delete input
    return if echoed { 0 } else { 2 }
}

def interactiveChildMain() : int {
    val result : Result[InputStream, SystemError] = standardInput()
    return match move result {
        Ok(input) => useInteractiveInput(move input),
        Error(error) => 2
    }
}

def silentChildMain() : int {
    val result : Result[InputStream, SystemError] = standardInput()
    return match move result {
        Ok(input) => waitForSilentInput(move input),
        Error(error) => 2
    }
}

def waitForSilentInput(input : InputStream) : int {
    val data : Ptr[byte] = alloc[byte](usize(1))
    defer free(data)
    val ignored : Result[usize, SystemError] = input.read(data, usize(1))
    delete input
    return 0
}

def nonBlockingChild(child : ChildProcess) : bool {
    val data : Ptr[byte] = alloc[byte](usize(1))
    defer free(data)
    val unavailable : bool = match child.tryRead(data, usize(1)) {
        Ok(value) => false,
        Error(error) => error.category == SystemErrorCategory.WouldBlock
    }
    val emptyRead : bool = usizeResult(child.tryRead(data, usize(0)), usize(0))
    val emptyWrite : bool = usizeResult(child.tryWrite(data, usize(0)), usize(0))
    delete child
    return unavailable && emptyRead && emptyWrite
}

def nonBlockingResult(result : Result[ChildProcess, SystemError]) : bool {
    return match move result {
        Ok(child) => nonBlockingChild(move child),
        Error(error) => false
    }
}

def asynchronousStop(child : ChildProcess) : bool {
    val running : bool = match child.tryWait() {
        Ok(state) => match state {
            Some(code) => false,
            None => true
        },
        Error(error) => false
    }
    val stopped : bool = boolResult(child.terminate())
    var finished : bool = false
    var attempts : usize = usize(0)
    while !finished && attempts < usize(10000000) {
        finished = match child.tryWait() {
            Ok(state) => match state {
                Some(code) => true,
                None => false
            },
            Error(error) => false
        }
        attempts = attempts + usize(1)
    }
    delete child
    return running && stopped && finished
}

def asynchronousStopResult(
result : Result[ChildProcess, SystemError]
) : bool {
    return match move result {
        Ok(child) => asynchronousStop(move child),
        Error(error) => false
    }
}

def exchangeWithChild(child : ChildProcess) : bool {
    val sent : bool = usizeResult(child.writeText("ping\n"), usize(5))
    val received : Ptr[byte] = alloc[byte](usize(5))
    defer free(received)
    val chunk : Ptr[byte] = alloc[byte](usize(5))
    defer free(chunk)
    var offset : usize = usize(0)
    while offset < usize(5) {
        val count : usize = match child.read(
        chunk,
        usize(5) - offset
        ) {
            Ok(value) => value,
            Error(error) => usize(0)
        }
        if count == usize(0) {
            delete child
            return false
        }
        var index : usize = usize(0)
        while index < count {
            received.store(offset + index, chunk.load(index))
            index = index + usize(1)
        }
        offset = offset + count
    }
    val matches : bool = stringView(received, usize(5)) == "ping\n"
    val closed : bool = boolResult(child.closeInput())
    delete child
    return sent && matches && closed
}

def interactiveResult(
result : Result[ChildProcess, SystemError]
) : bool {
    return match move result {
        Ok(child) => exchangeWithChild(move child),
        Error(error) => false
    }
}

def markerMatches(
result : Result[FileData, SystemError]
) : bool {
    return match move result {
        Ok(data) => markerDataMatches(move data),
        Error(error) => false
    }
}

def markerDataMatches(data : FileData) : bool {
    val matches : bool = match data.asText() {
        Ok(text) => text == "ok",
        Error(error) => false
    }
    delete data
    return matches
}

def viewEquals(borrow view : ByteView, expected : string) : bool {
    return view.withPointer[bool](
    (borrow data : Ptr[byte], offset : usize, size : usize) =>
    offset == usize(0) && stringView(data, size) == expected
    )
}

def inspectChild(result : ProcessResult, root : string) : bool {
    println(true)
    println(result.exitCode() == 23)
    println(result.withStdoutView[bool](
    (borrow view : ByteView) => viewEquals(view, "child-out\n")
    ))
    println(result.withStderrView[bool](
    (borrow view : ByteView) => viewEquals(view, "child-err\n")
    ))
    delete result
    val markerPath : Result[Path, SystemError] = joinPath(
    root,
    "child-marker.txt"
    )
    val marker : bool = match move markerPath {
        Ok(path) => markerPathMatches(move path),
        Error(error) => false
    }
    return marker
}

def markerPathMatches(path : Path) : bool {
    val matches : bool = markerMatches(readFile(path.view()))
    delete path
    return matches
}

def processResult(
result : Result[ProcessResult, SystemError],
root : string
) : bool {
    return match move result {
        Ok(process) => inspectChild(move process, root),
        Error(error) => reportProcessStartFailure()
    }
}

def reportProcessStartFailure() : bool {
    println(false)
    println(false)
    println(false)
    println(false)
    return false
}

def missingProcess(
result : Result[ProcessResult, SystemError]
) : bool {
    return match move result {
        Ok(process) => rejectProcess(move process),
        Error(error) =>
        error.operation == "process.run" &&
        error.category == SystemErrorCategory.NotFound &&
        error.nativeCode > uint(0) &&
        error.context == "janus-process-definitely-missing-6d52b"
    }
}

def refusedProcess(
result : Result[ProcessResult, SystemError],
expectedContext : string
) : bool {
    return match move result {
        Ok(process) => rejectProcess(move process),
        Error(error) =>
        error.operation == "process.run" &&
        error.nativeCode > uint(0) &&
        error.context == expectedContext
    }
}

def rejectProcess(process : ProcessResult) : bool {
    delete process
    return false
}

def runParent(root : Path, executable : string) : int {
    val arguments : Array[string] = new Array[string](usize(3))
    arguments.push("--child")
    arguments.push("argument avec espaces")
    arguments.push("béta")
    println(processResult(
    runProcess(executable, arguments, root.view(), true, true),
    root.view()
    ))
    delete arguments
    val interactiveArguments : Array[string] =
    new Array[string](usize(1))
    interactiveArguments.push("--interactive-child")
    println(interactiveResult(spawnProcess(
    executable,
    interactiveArguments,
    ""
    )))
    delete interactiveArguments
    val silentArguments : Array[string] = new Array[string](usize(1))
    silentArguments.push("--silent-child")
    println(nonBlockingResult(spawnProcess(
    executable,
    silentArguments,
    ""
    )))
    println(asynchronousStopResult(spawnProcess(
    executable,
    silentArguments,
    ""
    )))
    delete silentArguments
    val missingArguments : Array[string] =
    new Array[string](usize(0))
    println(missingProcess(runProcess(
    "janus-process-definitely-missing-6d52b",
    missingArguments,
    "",
    true,
    true
    )))
    delete missingArguments
    val refusedArguments : Array[string] =
    new Array[string](usize(0))
    println(refusedProcess(runProcess(
    root.view(),
    refusedArguments,
    "",
    true,
    true
    ), root.view()))
    delete refusedArguments
    val markerPath : Result[Path, SystemError] =
    joinPath(root.view(), "child-marker.txt")
    val removedMarker : bool = match move markerPath {
        Ok(path) => removeMarker(move path),
        Error(error) => false
    }
    println(removedMarker)
    println(boolResult(removeDirectory(root.view())))
    delete root
    return 0
}

def removeMarker(path : Path) : bool {
    val removed : bool = boolResult(removeFile(path.view()))
    delete path
    return removed
}

def parentTemporary(
result : Result[Path, SystemError],
executable : string
) : int {
    return match move result {
        Ok(root) => runParent(move root, executable),
        Error(error) => 1
    }
}

def main() : int {
    if programArgumentCount() > usize(1) &&
    argumentEquals(usize(1), "--child") {
        return childMain()
    }
    if programArgumentCount() > usize(1) &&
    argumentEquals(usize(1), "--interactive-child") {
        return interactiveChildMain()
    }
    if programArgumentCount() > usize(1) &&
    argumentEquals(usize(1), "--silent-child") {
        return silentChildMain()
    }
    println(programArgumentCount() >= usize(1))
    println(environmentEquals(
    environmentVariable("JANUS_PROCESS_TEST"),
    "valeur-béta"
    ))
    println(environmentMissing(
    environmentVariable("JANUS_PROCESS_MISSING_6D52B")
    ))
    return match programArgument(usize(0)) {
        Some(executable) => parentTemporary(
        createTemporaryDirectory("janus-process"),
        executable
        ),
        None => 1
    }
}
