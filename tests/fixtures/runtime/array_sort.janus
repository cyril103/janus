import std.array

struct Entry(val key : int, val originalIndex : int)
derives Copy, Equality, Debug {}

class ComparisonCounter(private var count : int) {
    def less(left : int, right : int) : bool {
        count = count + 1
        return left < right
    }

    def value() : int {
        return count
    }
}

def isSorted(borrow values : Array[int]) : bool {
    var index : usize = usize(1)
    while index < values.size() {
        if values.get(index) < values.get(index - usize(1)) {
            return false
        }
        index = index + usize(1)
    }
    return true
}

def isStableByKey(borrow entries : Array[Entry]) : bool {
    var index : usize = usize(1)
    while index < entries.size() {
        val previous : Entry = entries.get(index - usize(1))
        val current : Entry = entries.get(index)
        if current.key < previous.key ||
        (current.key == previous.key &&
        current.originalIndex < previous.originalIndex) {
            return false
        }
        index = index + usize(1)
    }
    return true
}

def exerciseEdgeCases() : bool {
    val empty : Array[int] = new Array[int](usize(0))
    defer delete empty
    empty.sortWith((left : int, right : int) => left < right)

    val singleton : Array[int] = new Array[int](usize(1))
    defer delete singleton
    singleton.push(7)
    singleton.sortWith((left : int, right : int) => left < right)

    val sorted : Array[int] = new Array[int](usize(6))
    defer delete sorted
    val reversed : Array[int] = new Array[int](usize(6))
    defer delete reversed
    var value : int = 0
    while value < 6 {
        sorted.push(value)
        reversed.push(5 - value)
        value = value + 1
    }
    sorted.sortWith((left : int, right : int) => left < right)
    reversed.sortWith((left : int, right : int) => left < right)
    return empty.size() == usize(0) && singleton.get(usize(0)) == 7 &&
    isSorted(sorted) && isSorted(reversed)
}

def exerciseDuplicatesAndStability() : bool {
    val duplicates : Array[int] = new Array[int](usize(10))
    defer delete duplicates
    val equal : Array[int] = new Array[int](usize(64))
    defer delete equal
    var index : int = 0
    while index < 10 {
        duplicates.push((index * 7) % 4)
        index = index + 1
    }
    index = 0
    while index < 64 {
        equal.push(9)
        index = index + 1
    }
    duplicates.sortWith((left : int, right : int) => left < right)
    equal.sortWith((left : int, right : int) => left < right)

    val entries : Array[Entry] = new Array[Entry](usize(48))
    defer delete entries
    index = 0
    while index < 48 {
        entries.push(new Entry((index * 7) % 5, index))
        index = index + 1
    }
    entries.sortWith(
    (left : Entry, right : Entry) => left.key < right.key
    )
    return isSorted(duplicates) && isSorted(equal) && isStableByKey(entries)
}

def exercisePseudoRandom() : bool {
    val values : Array[int] = new Array[int](usize(2048))
    defer delete values
    var state : int = 1729
    var index : int = 0
    while index < 2048 {
        state = (state * 25173 + 13849) % 65521
        values.push(state)
        index = index + 1
    }
    values.sortWith((left : int, right : int) => left < right)
    return isSorted(values)
}

def exerciseComplexityGuard() : bool {
    val count : int = 65536
    val values : Array[int] = new Array[int](usize(65536))
    defer delete values
    var index : int = 0
    while index < count {
        values.push(count - index)
        index = index + 1
    }
    val counter : ComparisonCounter = new ComparisonCounter(0)
    defer delete counter
    val comparison : (borrow int, borrow int) => bool =
    (borrow left : int, borrow right : int) => counter.less(left, right)
    values.sortWith(move comparison)
    return isSorted(values) && counter.value() < 4000000
}

def main() : int {
    println(exerciseEdgeCases())
    println(exerciseDuplicatesAndStability())
    println(exercisePseudoRandom())
    println(exerciseComplexityGuard())
    return 0
}
