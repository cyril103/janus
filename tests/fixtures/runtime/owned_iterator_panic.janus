import std.array
import std.iterator
import std.result

class Resource(val id : int) {
    destructor {
        println(id)
    }
}

def explode(
    total : Resource,
    value : Resource
) : Result[Resource, Resource] {
    defer delete total
    defer delete value
    panic("owned iterator failure\n")
}

def main() : int {
    val values : Array[Resource] = new Array[Resource](usize(3))
    var id : int = 1
    while id <= 3 {
        val value : Resource = new Resource(id)
        values.push(move value)
        id = id + 1
    }
    val folded : Result[Resource, Resource] = values.intoIterator()
    .tryFold[Resource, Resource](
        new Resource(10),
        (total : Resource, value : Resource) =>
        explode(move total, move value)
    )
    delete folded
    return 0
}
