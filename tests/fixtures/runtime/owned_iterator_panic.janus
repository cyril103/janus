import std.array

class Resource(val id : int) {
    destructor {
        println(id)
    }
}

def main() : int {
    val values : Array[Resource] = new Array[Resource](usize(3))
    var id : int = 1
    while id <= 3 {
        val value : Resource = new Resource(id)
        values.push(move value)
        id = id + 1
    }
    for value in values.intoIterator() {
        defer delete value
        panic("owned iterator failure\n")
    }
    return 0
}
