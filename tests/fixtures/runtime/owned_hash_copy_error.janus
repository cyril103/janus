import std.hashing
import std.hashmap

class Resource(val key : int) {}

def main() : int {
    val hashing : IntHashing = new IntHashing()
    defer delete hashing
    val values : HashMap[int, Resource, IntHashing] =
    new HashMap[int, Resource, IntHashing](usize(1), hashing)
    defer delete values
    values.getOption(1)
    return 0
}
