import std.array
import std.array_builder
import std.math
import std.option
import std.text

def main() : int {
    val values : Array[int] = new Array[int](usize(3))
    defer delete values
    values.push(6)
    values.push(7)
    values.push(29)

    val text : TextBuilder = new TextBuilder()
    defer delete text
    text.append("sum=")
    text.appendInt(values.fold[int](
        0,
        (total : int, value : int) => total + value
    ))
    println(text.view())
    println(gcd(usize(54), usize(24)))
    println(is_prime(usize(29)))
    val doubled : Array[int] = collectArray[int](
    values.iterator().map[int]((value : int) => value * 2)
    )
    defer delete doubled
    println(doubled.fold[int](
        0,
        (total : int, value : int) => total + value
    ))
    val retainedOption : Option[int] = Option.Some[int](42)
    val retainedValue : int = match retainedOption {
        Some(value) => value,
        None => 0
    }
    println(retainedValue)
    return 0
}
