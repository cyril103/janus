class Resource(val identifier : int) {
    destructor {
        println(identifier)
    }
}

struct Box(val resource : Resource) {}

def releaseFromReturn() : int {
    val resource : Resource = new Resource(1)
    defer delete resource
    return 42
}

def main() : int {
    println(releaseFromReturn())
    val box : Box = new Box(new Resource(2))
    defer delete box
    return 0
}

