{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://janus-lang.org/schemas/registry/v1/index.schema.json",
  "title": "Janus registry v1 package index",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "package", "releases"],
  "properties": {
    "protocolVersion": {"const": "1"},
    "package": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}/[a-z][a-z0-9_-]{0,63}$"},
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "metadataUrl", "metadataSha256", "yanked"],
        "properties": {
          "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
          "metadataUrl": {"type": "string", "pattern": "^https://(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._~+-]+)*$"},
          "metadataSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "yanked": {"type": "boolean"},
          "yankReason": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    }
  }
}
