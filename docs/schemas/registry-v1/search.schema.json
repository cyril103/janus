{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://janus-lang.org/schemas/registry/v1/search.schema.json",
  "title": "Janus registry v1 search results",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "packages"],
  "properties": {
    "protocolVersion": {"const": "1"},
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "latestVersion"],
        "properties": {
          "package": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}/[a-z][a-z0-9_-]{0,63}$"},
          "latestVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
          "description": {"type": "string", "maxLength": 1024}
        }
      }
    }
  }
}
