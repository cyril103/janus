{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://janus-lang.org/schemas/registry/v1/discovery.schema.json",
  "title": "Janus registry protocol discovery",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "versions"],
  "properties": {
    "protocolVersion": {"const": "1"},
    "versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "type": "object",
        "required": ["protocolVersion"],
        "properties": {"protocolVersion": {"const": "1"}}
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "apiBase"],
        "properties": {
          "protocolVersion": {"type": "string", "pattern": "^[1-9][0-9]*$"},
          "apiBase": {"type": "string", "pattern": "^https://(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._~+-]+)*$"}
        }
      }
    }
  }
}
