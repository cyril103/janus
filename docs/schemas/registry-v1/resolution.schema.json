{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://janus-lang.org/schemas/registry/v1/resolution.schema.json",
  "title": "Janus registry v1 resolved lock record",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requested", "selected"],
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "registry", "requirement"],
      "properties": {
        "package": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}/[a-z][a-z0-9_-]{0,63}$"},
        "registry": {"type": "string", "pattern": "^https://(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._~+-]+)*$"},
        "requirement": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  },
  "properties": {
    "protocolVersion": {"const": "1"},
    "requested": {"$ref": "#/$defs/identity"},
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "registry", "version", "metadataSha256", "archiveSha256"],
      "properties": {
        "package": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}/[a-z][a-z0-9_-]{0,63}$"},
        "registry": {"type": "string", "pattern": "^https://(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._~+-]+)*$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
        "metadataSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "archiveSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
