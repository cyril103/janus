enum Option[T] { Some(T), None }
struct Marker(val value : Unit) {}

def identity[T](value : T) : T {
    return move value
}

def consumeUnit(value : Unit) : Unit {
    return value
}

def main() : int {
    val marker : Marker = new Marker(unit)
    val result : Option[Unit] = Option.Some[Unit](marker.value)
    val callback : (Unit) => Unit =
        (value : Unit) => consumeUnit(identity[Unit](value))
    callback(match result { Some(value) => value, None => unit })
    delete callback
    return 0
}
