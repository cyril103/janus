class Box[T](var value : T) {
    borrow def get() : T where T <: Copy {
        return value
    }

    def set(next : T) : Unit {
        delete value
        value = move next
    }

    destructor {
        delete value
    }
}

def main() : int {
    val integers : Box[int] = new Box[int](41)
    defer delete integers
    integers.set(42)
    val result : int = integers.get()

    val text : Box[string] = new Box[string]("Janus")
    defer delete text
    val _message : string = text.get()

    return result
}
