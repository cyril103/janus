def main() : int {
    val floating : double = 42.75
    val integer : int = numericCast[int](floating)
    val truth : bool = bool(integer)
    val codepoint : char = char(955)

    println(integer)
    println(truth)
    println(codepoint)

    val data : Ptr[int] = alloc[int](usize(1))
    borrow val view : Ptr[int] = data
    view.store(usize(0), integer)
    val result : int = view.load(usize(0))
    free(data)
    return result
}
