def main() : int {
    val result : int = 10 + 3 * 2
    val remainder : int = result % 5
    val _floating : double = 1.5 * 2.0 + 1.0
    val _ordered : bool = result >= 16 && remainder == 1
    val _sameText : bool = "Janus" == "Janus"
    val _characterOrder : bool = 'a' < 'b'
    val _logical : bool = !false || false
    return result
}
