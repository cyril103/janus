import std.option
import std.range
import std.result

def keepOdd(value : int) : Option[int] {
    if value % 2 == 1 {
        return Option.Some[int](value)
    }
    return Option.None[int]()
}

def checkedAdd(total : int, value : int) : Result[int, string] {
    if value < 0 {
        return Result.Error[int, string]("negative value")
    }
    return Result.Ok[int, string](total + value)
}

def main() : int {
    var total : int = 0

    for pair in range(1, 4).zip[int](range(10, 13)) {
        total = total + pair.left + pair.right
    }

    for indexed in range(5, 8).enumerate() {
        total = total + numericCast[int](indexed.index) + indexed.value
    }

    for value in range(1, 4).flatMap[int](
        (item : int) => range(item, item + 2)
    ) {
        total = total + value
    }

    val checked : Result[int, string] = range(0, 10)
    .drop(2)
    .takeWhile((borrow value : int) => value < 8)
    .filterMap[int]((value : int) => keepOdd(value))
    .tryFold[int, string](
        0,
        (sum : int, value : int) => checkedAdd(sum, value)
    )
    total = total + match checked {
        Ok(value) => value,
        Error(error) => 0
    }

    return total
}
