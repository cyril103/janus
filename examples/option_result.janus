import std.option
import std.result

def main() : int {
    val option : Option[int] = Option.Some[int](40)
    val result : Result[int, string] = Result.Ok[int, string](2)

    println(isSome[int](option))
    val incremented : Option[int] = std.option.map[int, int](
    option,
    (value : int) => value + 1
    )
    val left : int = std.option.unwrapOr[int](incremented, 0)
    val right : int = match result {
        Ok(value) => value,
        Error(message) => 0
    }
    return left + right
}
