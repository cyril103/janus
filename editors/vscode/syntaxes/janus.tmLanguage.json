{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Janus",
  "scopeName": "source.janus",
  "patterns": [
    {
      "name": "comment.line.double-slash.janus",
      "match": "//.*$"
    },
    {
      "name": "keyword.control.janus",
      "match": "\\b(if|else|match|for|in|while|break|continue|return|defer|delete|move|consume|staticAssert)\\b"
    },
    {
      "name": "storage.type.janus",
      "match": "\\b(class|trait|enum|const|pure|tailrec|def|val|var|private|internal|extern|module|import|extends|new|destructor|borrow)\\b"
    },
    {
      "captures": {
        "3": {
          "name": "keyword.control.janus"
        }
      },
      "match": "^(\\s*)(private\\s+)?(extend)\\b"
    },
    {
      "name": "support.type.primitive.janus",
      "match": "\\b(int|double|byte|char|bool|string|unit|usize)\\b"
    },
    {
      "name": "constant.language.janus",
      "match": "\\b(true|false)\\b"
    },
    {
      "name": "keyword.operator.assignment.compound.janus",
      "match": "(?:<<=|>>=|[+\\-*/%&|^]=)"
    },
    {
      "name": "keyword.operator.arrow.janus",
      "match": "=>"
    },
    {
      "name": "keyword.operator.pipeline.janus",
      "match": "\\|>"
    },
    {
      "name": "keyword.operator.bitwise.janus",
      "match": "(?<![&|])(?:<<|>>|[&|^])(?![&|])"
    },
    {
      "name": "punctuation.definition.array.janus",
      "match": "[\\[\\]]"
    },
    {
      "name": "punctuation.separator.array.janus",
      "match": ","
    },
    {
      "name": "string.quoted.double.janus",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.janus",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.janus",
      "match": "\\b(?:0[xX][0-9a-fA-F]+(?:_[0-9a-fA-F]+)*|0[bB][01]+(?:_[01]+)*|[0-9]+(?:_[0-9]+)*(?:(?:\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)f?|[0-9]+(?:_[0-9]+)*)\\b"
    }
  ]
}
