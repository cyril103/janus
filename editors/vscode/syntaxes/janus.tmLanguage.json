{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Janus",
  "scopeName": "source.janus",
  "patterns": [
    {
      "name": "comment.line.double-slash.janus",
      "match": "//.*$"
    },
    {
      "name": "meta.construction.named.janus",
      "begin": "\\b(new)\\s+([\\p{L}_][\\p{L}\\p{N}_.]*)(?:\\s*\\[[^{}\\n]*\\])?\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.janus"
        },
        "2": {
          "name": "entity.name.type.janus"
        },
        "3": {
          "name": "punctuation.definition.struct.janus"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.struct.janus"
        }
      },
      "patterns": [
        {
          "name": "variable.other.member.janus",
          "match": "(?<=[{,])\\s*([\\p{L}_][\\p{L}\\p{N}_]*)(?=\\s*[:,}])"
        },
        {
          "include": "#expression-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    {
      "name": "keyword.control.janus",
      "match": "\\b(if|else|match|for|in|while|break|continue|return|using|defer|delete|move|consume|staticAssert)\\b"
    },
    {
      "name": "storage.type.janus",
      "match": "\\b(class|struct|trait|enum|const|pure|tailrec|def|val|var|private|internal|extern|module|import|extends|new|destructor|borrow)\\b"
    },
    {
      "name": "storage.type.function.janus",
      "match": "\\b(Fn|FnMut|FnOnce)\\b(?=\\s*\\()"
    },
    {
      "captures": {
        "3": {
          "name": "keyword.control.janus"
        }
      },
      "match": "^(\\s*)(private\\s+)?(extend)\\b"
    },
    {
      "name": "support.type.primitive.janus",
      "match": "\\b(int|double|byte|char|bool|string|Unit|usize)\\b"
    },
    {
      "name": "constant.language.janus",
      "match": "\\b(true|false|unit)\\b"
    },
    {
      "name": "keyword.operator.assignment.compound.janus",
      "match": "(?:<<=|>>=|[+\\-*/%&|^]=)"
    },
    {
      "name": "keyword.operator.arrow.janus",
      "match": "=>"
    },
    {
      "name": "keyword.operator.pipeline.janus",
      "match": "\\|>"
    },
    {
      "name": "keyword.operator.bitwise.janus",
      "match": "(?<![&|])(?:<<|>>|[&|^])(?![&|])"
    },
    {
      "name": "punctuation.definition.array.janus",
      "match": "[\\[\\]]"
    },
    {
      "name": "punctuation.separator.array.janus",
      "match": ","
    },
    {
      "name": "punctuation.separator.key-value.janus",
      "match": ":(?!:)"
    },
    {
      "name": "string.quoted.double.janus",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.janus",
          "match": "\\\\(?:u\\{[0-9A-Fa-f]{1,6}\\}|[0nrt\\\\'\"])"
        }
      ]
    },
    {
      "name": "string.quoted.single.janus",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.janus",
          "match": "\\\\(?:u\\{[0-9A-Fa-f]{1,6}\\}|[0nrt\\\\'\"])"
        }
      ]
    },
    {
      "name": "constant.numeric.janus",
      "match": "\\b(?:0[xX][0-9a-fA-F]+(?:_[0-9a-fA-F]+)*|0[bB][01]+(?:_[01]+)*|[0-9]+(?:_[0-9]+)*(?:(?:\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)f?|[0-9]+(?:_[0-9]+)*)\\b"
    },
    {
      "name": "variable.other.identifier.janus",
      "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:_|\\p{L})[\\p{L}\\p{M}\\p{N}\\p{Pc}]*(?![\\p{L}\\p{M}\\p{N}_])"
    }
  ],
  "repository": {
    "expression-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#expression-braces"
        },
        {
          "include": "$self"
        }
      ]
    }
  }
}
